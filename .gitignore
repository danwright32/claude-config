.DS_Store
*.syncbak
*.log
.last-applied
# Python bytecode cache. claude-sync's rsync excludes already stop these from
# being staged into payload/; this is the second line of defence, so one that
# arrives by any other route still cannot be committed and travel between Macs.
__pycache__/
*.pyc
# A Mac's own file, often holding a secret, and any copy of one (claude-config#675, #1089). The same
# second line: claude-sync's excludes (LOCAL_FILE_GLOBS) keep these out of payload/, and this keeps
# one that arrives by any other route out of a commit to this public repository.
*.local.json
*.local.json.*
*.local.json~
.last-success
.sync-lock/
state/
.outage-log
.last-sent
.last-received
.hook-tests
.resolved/
.send-suite-verdicts
.behind-skips
.sent-over-untested
.reconcile-outcome
.send-refused
.ci-unreadable-since
.resurrected-reported
.unloadable-notified*
.ci-red-since
.my-push
.mods-seen
.trees-seen

# The TypeScript compiler pinned for the mods type check (#803), installed per checkout with
# npm ci --prefix tools/typescript
/tools/typescript/node_modules/
