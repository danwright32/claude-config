#!/usr/bin/env bash
#
# claude-sync — two-way sync of selected ~/.claude config between Macs via git.
#
# Syncs ONLY: hooks/, skills/ (minus plugin-managed), agents/, commands/, and the
# `hooks` block of settings.json. NEVER touches: your memory store, session
# history, caches, model/effort/plugins, or your local permission list.
#
# Usage:
#   claude-sync push              # send THIS Mac's config to the shared repo
#   claude-sync pull              # bring the shared repo's config onto THIS Mac
#   claude-sync sync              # two-way: send local changes, then receive remote
#   claude-sync watch             # foreground: sync on every change (needs fswatch)
#   claude-sync status            # show what differs, no changes
#   claude-sync recheck           # run the hook suite and record what it said, so a fixed failure stops being reported
#   claude-sync forget-clone DIR  # drop one checkout from the register, when it has gone for good
#   claude-sync hold 30 "why"     # stop the watcher committing for a while, so you can commit
#   claude-sync release           # lift that hold now rather than waiting for it to run out
#   claude-sync clean-backups     # remove the .syncbak copies a pull left beside your files
#   claude-sync next-lesson       # the next free lesson number, so none is picked by eye
#   claude-sync check-lessons     # fail if two lessons share a number
#   claude-sync lesson L174       # one lesson in full, with its provenance
#   claude-sync cite-scan L2      # which synced files cite that lesson number
#   claude-sync check-skills      # fail if a plugin and the skills folder provide the same skill
#   claude-sync install-autosync  # background: fswatch watcher + periodic receive-timer
#   claude-sync help
#
# Env overrides (mainly for tests): CLAUDE_HOME, SYNC_REPO, SYNC_NO_GIT=1,
#   SYNC_INTERVAL, SYNC_FSWATCH, SYNC_SKIP_SECRET_SCAN, SYNC_NO_NOTIFY,
#   SYNC_SKIP_LESSON_CHECK=1 (publish a rule file despite a duplicate number),
#   SYNC_NO_CITATION_PREFILTER=1 (scan every synced file for a lesson citation
#   instead of grepping for candidates first: the pre-#53 path, kept so the two
#   can be compared)
set -euo pipefail

# WHAT THIS RUN IS DOING, captured before anything can shift the positional parameters. It is
# written into the run's scratch note (see scratch_note_this_run), which is the only evidence a
# killed run leaves of itself (claude-config#314).
SYNC_RUN_ARGV="${*:-<no arguments>}"

CLAUDE_HOME="${CLAUDE_HOME:-$HOME/.claude}"
SYNC_REPO="${SYNC_REPO:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}"
PAYLOAD="$SYNC_REPO/payload"
LAST_APPLIED_FILE="$SYNC_REPO/.last-applied"   # commit whose payload is on this Mac
TOKEN="__CLAUDE_HOME__"
MERGED_RULE_FILES=""   # rule files merged this run (see merge_rule_files)
REFUSED_SKILL_EXCLUDES=()   # skills entries this run declined to carry (see refuse_unloadable_skills)
PRESERVED_CONFLICTS=""   # copies set aside by THIS run (see preserve_local_conflicts)
SYNC_LOCK="${SYNC_LOCK:-$SYNC_REPO/.sync-lock}"   # one mutating run at a time (#21)
LOCK_HELD=0
# How often a wait loop in this file looks again (claude-config#205). ONE setting, because every
# wait here is the same decision said twice: how finely a run notices that the thing it is waiting
# for has ended. Two of them had drifted to different numbers for no reason anybody recorded.
#
# A tenth of a second. In production the difference between this and two seconds is invisible
# beside a hook suite that runs for minutes, and the granularity was never load bearing. In the
# test suite it IS the cost: fifteen real pulls run against a STUB runner that returns in
# milliseconds, and each one sat in a two second sleep waiting for a process that had already
# gone, for 59 seconds of section time measured on 2026-08-30.
#
# Every deadline in this file is measured against the CLOCK rather than by adding up these sleeps
# (L226), so shortening this shortens no timeout. That was made true of the lock's own deadline in
# the same change; it had been counting iterations, and a shorter poll would have divided it by
# twenty with nothing saying so.
SYNC_POLL_INTERVAL="${SYNC_POLL_INTERVAL:-0.1}"
case "$SYNC_POLL_INTERVAL" in
  ''|*[!0-9.]*|.|*.*.*)
    # Said, not swallowed. A poll interval nobody can read costs only speed, so it is not worth
    # refusing a sync over, but a setting that is silently ignored looks exactly like one that is
    # in force (L320, L11).
    echo "claude-sync: SYNC_POLL_INTERVAL='$SYNC_POLL_INTERVAL' is not a number of seconds, so the default of 0.1 is being used instead. No deadline is affected: they are all measured against the clock." >&2
    SYNC_POLL_INTERVAL=0.1 ;;
esac
LAST_SUCCESS_FILE="$SYNC_REPO/.last-success"   # last time the shared repo was reachable (#22)
# When config last actually MOVED, in either direction (#75). Distinct from .last-success, which
# only says the repo was reachable: a Mac can reach GitHub every hour for weeks while nothing
# crosses in either direction, and that is precisely the drift status exists to make visible.
LAST_SENT_FILE="$SYNC_REPO/.last-sent"
LAST_RECEIVED_FILE="$SYNC_REPO/.last-received"
# The last verdict the post-pull hook suite reached, and the runner's own words with it
# (claude-config#182). One file, not two: evidence kept somewhere with a retention schedule of its
# own is gone before the investigation that needs it arrives (L202), and scratch is swept hourly.
BEHIND_SKIPS_FILE="$SYNC_REPO/.behind-skips"   # sends in a row that could not go out (#323)
CI_UNREADABLE_SINCE_FILE="$SYNC_REPO/.ci-unreadable-since"   # since when no CI verdict could be read (#327)
CI_RED_SINCE_FILE="$SYNC_REPO/.ci-red-since"   # since when the shared repo's head has been red (#336)
RESURRECTED_REPORTED_FILE="$SYNC_REPO/.resurrected-reported"   # leftovers already reported once (#331)
HOOK_TESTS_FILE="$SYNC_REPO/.hook-tests"
# The last verdict each send-side suite reached, against a digest of the hooks it judged (#269).
# Untracked and per clone, because it records what has been RUN here rather than what the config
# is. It exists to bound cost: the watcher fires a send on every file event, so without it a suite
# that stays red is paid for again on every save, with the sync lock held throughout.
SEND_VERDICTS_FILE="$SYNC_REPO/.send-suite-verdicts"
# Where a version dropped by an automatic conflict resolution is kept (claude-config#183). Outside
# the mirrored config on purpose: under $CLAUDE_HOME it would become exactly the stale file nobody
# deletes that #177 exists to stop leaving behind, and it would then travel to the other Mac.
RESOLVED_DIR="$SYNC_REPO/.resolved"
# Every clone on this Mac that has done work of its own (claude-config#189). Outside every clone
# on purpose, because its whole job is to be readable from a clone other than the one that wrote
# it, and outside $CLAUDE_HOME because anything in there travels to the other Mac and this
# describes THIS one. A clone appends itself the first time it takes the lock, which is the first
# time it can hold a verdict at all, so the list is derived from what has actually run rather than
# from what somebody remembered to write down (L41, L96).
CLONE_REGISTRY="${SYNC_CLONE_REGISTRY:-$HOME/.claude-sync-clones}"
# A session about to commit deliberately can hold the WATCHER off (#262). Outside every clone, for
# the same reason as the registry above: the watcher runs from a different clone than the one a
# session works in, so a marker inside either of them reaches only itself.
#
# It holds only the automatic send. `claude-sync send` typed by a person is not the thing being
# held off, and a command that refuses the person who set the hold is a dead control (L109).
SYNC_HOLD_FILE="${SYNC_HOLD_FILE:-$HOME/.claude-sync-hold}"
# How long a hold lasts when none is named. It fails OPEN on purpose: a hold that outlives the
# session that took it silently stops the sync, and #196 already records how hard a watcher that
# has stopped sending is to notice from outside (L523).
SYNC_HOLD_MINUTES="${SYNC_HOLD_MINUTES:-30}"
STATE_DIR="$SYNC_REPO/state"   # what each Mac has applied, published so verify can compare (#23)
# One file per Mac, holding the first number of the band that Mac mints lesson numbers from. Unlike
# everything else outside payload/, this is TRACKED and shared: a band nobody else can see cannot
# stop anybody else claiming it (#44).
LESSON_BANDS_DIR="$SYNC_REPO/lesson-bands"
LESSON_BAND=""   # this Mac's band, once resolved (see lesson_band_locked)

# Skills that the plugins install & manage — excluded so the repo stays clean
# and plugin updates don't create churn. Edit this list if you install one of
# these standalone and want it synced.
PLUGIN_SKILLS=(agents-sdk cloudflare cloudflare-email-service durable-objects \
  sandbox-sdk turnstile-spin web-perf workers-best-practices wrangler \
  plannotator-compound)

# `audits` is here since claude-config#224. LESSONS.md cites audits/2026-07-27-issue-audit/ and
# audits/2026-08-29-test-speed-audit/ as the full provenance for two batches of lessons, and the
# directory was not synced, so on the other Mac those pointers named files that do not exist and a
# lesson's evidence could not be read there at all. It is nine markdown files and half a megabyte,
# which is cheaper than a rule whose reasoning is unreachable on the machine reading it.
MIRROR_DIRS=(hooks agents commands audits)   # full mirror (no overlap with plugins)
# Floor for the top-level rule files, not the whole list. The real list is derived
# from CLAUDE.md's own @imports by top_files_in(); this seed only guarantees that
# an existing setup keeps syncing these three even if CLAUDE.md temporarily stops
# referencing them. Do NOT add new files here: reference them from CLAUDE.md and
# they sync automatically. A hand-maintained mirror of another source of truth
# drifts, and that drift is exactly how CLAUDE.md once arrived referencing a
# LESSONS.md the sync had never been told about.
TOP_FILES_SEED=(CLAUDE.md RTK.md LESSONS.md)

# never copy nested VCS/OS cruft (some skills are git clones with their own .git),
# nor the conflict copies preserve_local_conflicts leaves behind: those are local
# evidence of one Mac's own edit and must never travel to the other Mac.
# Python bytecode caches are the same category: build output, not config. They are
# also actively unsafe to sync, because Python decides whether to trust a cached
# .pyc by comparing a timestamp against its source, and rsync between two Macs is
# exactly what makes that timestamp lie. A travelling cache can shadow an edited
# hook. Regenerating one locally costs nothing.
COMMON_EXCLUDES=(--exclude=.git --exclude=.git/ --exclude=.DS_Store --exclude=*.conflict-* \
  --exclude=__pycache__ --exclude=__pycache__/ --exclude=*.pyc)

# desktop alert (no-op if disabled or the notifier isn't installed)
notify(){
  [ "${SYNC_NO_NOTIFY:-0}" = "1" ] && return 0
  local n="${SYNC_NOTIFIER:-terminal-notifier}"
  command -v "$n" >/dev/null 2>&1 && "$n" -title "claude-sync" -message "$1" >/dev/null 2>&1 || true
}
# On failure, notify ONLY when run non-interactively (the background auto-sync job),
# so the silent log-only failure becomes visible; interactive users see stderr.
die(){ echo "claude-sync: $*" >&2; [ -t 2 ] || notify "$*"; exit 1; }

# Is this string empty, or nothing but whitespace? Asked with `case` and never by substituting the
# whitespace away, which is what every one of the callers below used to do. `${s// }` builds a whole
# new string, and under the bash macOS ships (3.2) the cost is superlinear in the NUMBER OF MATCHES:
# measured on this Mac at 1,536 matches it took 11.5 seconds and at 3,072 it took 82, while this
# answers either in milliseconds. The strings asked about here are lists of findings, of duplicate
# lesson numbers, of unresolved conflict copies, so they are longest exactly when something is wrong
# and the report is worth having (claude-config#117). It also reads a value of nothing but newlines
# as blank, which the old form did not, and which is what every caller meant.
is_blank(){ case "${1-}" in *[![:space:]]*) return 1 ;; *) return 0 ;; esac; }

# ---------- an outage is judged by how LONG, not by what kind (#22) ----------
# Losing the network for a moment and GitHub being down for a morning arrive on exactly the
# same code path, so classifying them by KIND makes one benign blip and a real outage
# indistinguishable, and alerting on both trains the alert to be ignored. It is then the
# real one that goes unread (L77). So: fail either way and always write to the log, but
# only raise a desktop alert once syncing has been failing for longer than the threshold.
record_sync_success(){ date +%s > "$LAST_SUCCESS_FILE" 2>/dev/null || true; }
# Called ONLY where something really crossed: a push that went through, an apply that wrote at
# least one file. Stamping on every run instead would make a Mac that syncs hourly with nothing to
# do look permanently fresh, which is the reassurance that hides the drift (L106).
record_sent(){     date +%s > "$LAST_SENT_FILE" 2>/dev/null || true; }

# ---- the send stamp is a property of the RUN, not of which subcommand was typed (#79, #82) ----
# record_sent used to be called only from inside the two branches that themselves run a push, so a
# run that sent by any other route left .last-sent unwritten. `push` is exactly such a route, and
# status then reported "last sent: never, nothing has gone up from this clone" over a branch
# provably level with origin (measured 2026-08-18: three commits pushed, `git ls-remote` confirming
# the remote head matched this Mac, and no stamp on disk). "Never sent" is also what a genuinely
# wedged send looks like, so a real one-way outage was indistinguishable from a bookkeeping gap
# (L11, L98). And a report of what changed must be assembled from the finished state rather than
# from one of the code paths that change it (L78).
#
# So: this run was HOLDING work to send, and by the end it holds nothing the repo does not have.
# Both halves are needed. Without the first, a Mac with nothing to do would stamp on every run and
# read as permanently fresh (L106); without the second, a failed push would stamp anyway.
SEND_PENDING=0
note_unsent_work(){ SEND_PENDING=1; }

record_sent_if_shipped(){
  have_git || return 0
  [ "${SEND_PENDING:-0}" = "1" ] || return 0
  local up n
  up="$(git -C "$SYNC_REPO" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)"
  # Nothing to be level WITH, so nothing can be claimed about whether anything crossed. A message
  # may only claim what its check measured (L11), and no stamp reads as "not yet", which is true.
  [ -n "$up" ] || return 0
  n="$(git -C "$SYNC_REPO" rev-list --count "$up..HEAD" 2>/dev/null || echo unknown)"
  case "$n" in ''|*[!0-9]*) return 0 ;; esac      # unreadable is not evidence of a send (L50)
  [ "$n" -eq 0 ] || return 0
  # The one case this reads wrongly, said out loud rather than left to be discovered: a rebase that
  # DROPS this Mac's commit (because the same content already went up from elsewhere) also ends
  # level, and would stamp. The work is in the shared repo either way, which is what the indicator
  # is asked about, so the reading is defensible where it is wrong.
  record_sent
}
record_received(){ date +%s > "$LAST_RECEIVED_FILE" 2>/dev/null || true; }

# The threshold below was chosen by judgement, not measurement, and BOTH ways of being wrong
# are invisible in use: too low it alerts on blips until the alert is ignored, too high a
# real outage goes unreported for most of a day. So every decision is recorded with the gap
# it was judging, and status reports the tally, which is what makes the number answerable
# after a month of real use rather than a guess nobody can check. (#24)
OUTAGE_LOG="$SYNC_REPO/.outage-log"
OUTAGE_LOG_MAX="${SYNC_OUTAGE_LOG_MAX:-500}"

record_outage_decision(){   # $1 = quiet|alert   $2 = gap in seconds, or empty if unknown
  # The threshold IN FORCE at the time is part of the record. Without it the tally reads as
  # though every decision was judged by the current setting, so the moment the threshold is
  # tuned (which is the whole point of collecting this) the summary starts describing the
  # data wrongly, and it is the summary you would draw the conclusion from.
  printf '%s %s %s %s\n' "$(date +%s)" "$1" "${2:-unknown}" "${SYNC_OUTAGE_ALERT_AFTER:-10800}" >> "$OUTAGE_LOG" 2>/dev/null || true
  # Bounded, and the trim is stated rather than silent: an unbounded local log is the kind of
  # thing nobody notices until it matters.
  local n
  # `grep -c` prints its answer AND reports failure when it counts nothing, so an `|| echo 0`
  # fallback runs as well and the value becomes two lines. Every numeric test on it then errors
  # with "integer expression expected" rather than answering, while it still reads like a number
  # wherever it is printed (claude-config#172). A MISSING file exits 2 with no output and the
  # fallback is right; only an existing but EMPTY one doubles it, which is why it survives.
  n="$(grep -c . "$OUTAGE_LOG" 2>/dev/null || true)"
  case "$n" in ''|*[!0-9]*) n=0 ;; esac
  if [ "${n:-0}" -gt "$OUTAGE_LOG_MAX" ]; then
    tail -n "$OUTAGE_LOG_MAX" "$OUTAGE_LOG" > "$OUTAGE_LOG.trim" 2>/dev/null \
      && mv -f "$OUTAGE_LOG.trim" "$OUTAGE_LOG" 2>/dev/null || true
  fi
}

report_outage_tally(){
  [ -s "$OUTAGE_LOG" ] || return 0
  local quiet=0 alerted=0 bad=0 kind gap thr ts seen=""
  while read -r ts kind gap thr; do
    [ -n "${ts:-}" ] || continue
    case "$kind" in
      quiet)  quiet=$((quiet+1)) ;;
      alert)  alerted=$((alerted+1)) ;;
      # A line that does not parse is COUNTED and reported, never skipped into silence: an
      # unreadable record and no record at all must not look the same (L11).
      *)      bad=$((bad+1)); continue ;;
    esac
    case " $seen " in *" ${thr:-unknown} "*) ;; *) seen="$seen ${thr:-unknown}" ;; esac
  done < "$OUTAGE_LOG"
  echo "--- outage decisions so far: $quiet quiet, $alerted alerted ---"
  # Says what the numbers can and cannot support. A tally spanning more than one threshold
  # cannot be read as evidence about any single one of them.
  if [ "$(printf '%s' "$seen" | wc -w | tr -d ' ')" -gt 1 ]; then
    echo "  judged under different thresholds ($(printf '%s' "${seen# }" | tr ' ' ',')s), so these counts are not evidence about any one of them"
  else
    echo "  threshold in force:${seen:-  unknown}s"
  fi
  [ "$bad" -gt 0 ] && echo "  $bad record(s) unreadable and not counted"
  return 0
}

die_transient(){   # $1 = message. Fails like die(), but stays quiet during a short outage.
  local msg="$1" last now gap threshold="${SYNC_OUTAGE_ALERT_AFTER:-10800}"   # 3 hours
  now="$(date +%s)"
  last="$(cat "$LAST_SUCCESS_FILE" 2>/dev/null || true)"
  # A marker that will not parse must never compare as "recent" and silence a real outage:
  # an unusable value goes to the fail-safe side, which here means alerting (L50).
  case "$last" in ''|*[!0-9]*) last="" ;; esac
  # A success stamped in the FUTURE is not usable evidence, and it is the dangerous
  # direction: it makes the gap NEGATIVE, which is smaller than any threshold, so it reads
  # as "synced moments ago" and silences the alert for as long as it stays ahead. A folder
  # restored from a backup, or carried off a machine whose clock was wrong, lands exactly
  # there. Merely OLD is already handled, because a large gap alerts by definition. (#25)
  if [ -n "$last" ] && [ "$last" -gt "$now" ] 2>/dev/null; then last=""; fi
  if [ -n "$last" ]; then
    gap=$((now - last))
    if [ "$gap" -lt "$threshold" ]; then
      # Deliberately NOT die(): same failure, same exit code, same log line, no alert.
      record_outage_decision quiet "$gap"
      echo "claude-sync: $msg Syncing last worked $(age_in_words "$gap"), which is inside the $(duration_in_words "$threshold") window, so this is being logged without raising an alert." >&2
      exit 1
    fi
    record_outage_decision alert "$gap"
    die "$msg Syncing has now been failing for $(duration_in_words "$gap")."
  fi
  record_outage_decision alert unknown
  # No usable record of a success. That is NOT evidence of a brief blip, and a message may
  # only claim what its check actually measured (L11), so say what is unknown and alert.
  die "$msg There is no record of this Mac ever reaching the shared repo, so how long this has been failing is unknown."
}
have_git(){ [ "${SYNC_NO_GIT:-0}" != "1" ]; }

# ---------- one mutating run at a time (#21) ----------
# The fswatch watcher fires a send on every edit, the launchd timer runs a full two-way
# sync, and a run started by hand can land on top of either. All three stage into the same
# payload and drive git in the same repo, so they were free to collide: bursty sessions
# routinely push several sends inside a minute. Read-only commands (status, next-lesson,
# check-lessons, help) are deliberately NOT locked, because status is what a refusal tells
# you to run and a diagnosis that hangs on the condition it diagnoses is worse than none.
lock_owner_alive(){ [ -n "${1:-}" ] && kill -0 "$1" 2>/dev/null; }

# The identity every git command that can WRITE a commit runs under, including the rebase inside
# `pull --rebase`, which is not obvious: the tool already passed this to its own two commits so it
# would not depend on whoever's machine it runs on, and then left the rebase to find one ambiently.
# A Mac hides that, because git there quietly invents user@hostname when none is configured. A
# machine where git refuses to guess instead fails the pull, and the failure arrives as "both Macs
# changed the same config", which is not what happened and is not something the person can fix
# (#52, found the first time this ran anywhere but a Mac).
SYNC_GIT_IDENTITY=(-c user.name="claude-config-sync" -c user.email="sync@localhost")

# ---------- the two things BSD and GNU spell differently ----------
# Asked for once here rather than at seven call sites, because neither accepts the other's flag and
# the failure is not a clean one: `stat -f %m FILE` on GNU means "file system status" and prints a
# multi-line block about the filesystem while exiting non-zero, so a plain `||` fallback would
# concatenate that block with the real answer. Each result is therefore VALIDATED as a bare number
# before it is believed, and an unreadable path prints nothing at all, which every caller already
# treats as no evidence rather than as a value (L50).
file_mtime(){   # path -> unix timestamp, or nothing
  local m
  m="$(stat -f %m "$1" 2>/dev/null || true)"
  case "$m" in ''|*[!0-9]*) m="$(stat -c %Y "$1" 2>/dev/null || true)" ;; esac
  case "$m" in ''|*[!0-9]*) return 0 ;; esac
  printf '%s\n' "$m"
}

# Every mtime in ONE call rather than a process per entry (claude-config#191).
#
# scratch_in_dir asked file_mtime for each matching entry, which is a `stat` process each.
# claude-config#115 removed the six full directory reads and left this behind. Measured 2026-08-23,
# with 963 entries in the tool's own scratch directory after a day of interrupted runs:
# `claude-sync status` took 6.5 seconds of which the sweep was 5.6, and 0.8 without it. The cost
# grows with exactly the condition the report exists to describe, so the worse the leftovers, the
# slower the command that tells you about them, and status is the command a person is told to run.
#
# Three ways of asking, in order, and the shape of the answer decides whether it is used. Not
# merely whether it is EMPTY: GNU stat reads -f as "file system status" rather than as a format, so
# the BSD spelling there produces plenty of output that is not a list of mtimes at all, and taking
# non-empty for usable would feed that straight into the age test (L156, L215). So every line has
# to look like one, and anything else falls through to the next way of asking.
#
# The last way is the original one, a process per path. It is not a formality: an answer of nothing
# would be indistinguishable from a directory with no leftovers in it, which is the reassuring
# reading and the wrong one, and it is what stops a sweep silently reclaiming nothing.
# SYNC_NO_BATCH_STAT=1 forces it, so the fallback is reachable in a test rather than only on a
# machine that has neither spelling (L173).
file_mtimes(){   # newline separated paths on stdin -> "<mtime><TAB><path>" per line
  local list out p m tab bad
  list="$(cat)"
  [ -n "$list" ] || return 0
  tab="$(printf '\t')"
  if [ "${SYNC_NO_BATCH_STAT:-0}" != "1" ]; then
    for out in bsd gnu; do
      case "$out" in
        bsd) out="$(printf '%s\n' "$list" | tr '\n' '\0' | xargs -0 stat -f "%m%t%N" 2>/dev/null || true)" ;;
        gnu) out="$(printf '%s\n' "$list" | tr '\n' '\0' | xargs -0 stat -c "%Y${tab}%n" 2>/dev/null || true)" ;;
      esac
      [ -n "$out" ] || continue
      # Rejected if ANY line is the wrong shape, never if merely some are: a half understood answer
      # would silently drop whatever it could not express, and those are leftovers nobody reclaims.
      # `grep -v`, never `grep -qv`: the quiet form leaves on its first match and kills the
      # producer, and under pipefail the pipeline then reports that death rather than the answer
      # (L183). This one reads all of its input, so there is no early exit to be killed by.
      bad="$(printf '%s\n' "$out" | grep -vE "^[0-9]+${tab}" || true)"
      [ -n "$bad" ] && continue
      printf '%s\n' "$out"
      return 0
    done
  fi
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    m="$(file_mtime "$p")"
    [ -n "$m" ] || continue
    printf '%s\t%s\n' "$m" "$p"
  done <<SCRATCHMTEOF
$list
SCRATCHMTEOF
  return 0
}

# Same split. `date -r` takes a timestamp on BSD and a FILE on GNU, so the GNU form is tried only
# when the BSD one produced nothing.
date_from_epoch(){   # unix timestamp, strftime format -> formatted date, or nothing
  local out
  # Validated BEFORE either backend sees it. BSD `date -r ""` does not fail: it succeeds and
  # answers 1969-12-31, so a marker whose timestamp could not be read would have been reported to
  # the person as a confident date instead of the "an unknown date" its caller already had ready
  # (L50). Found by the check asking what this returns when it cannot read its input.
  case "${1:-}" in ''|*[!0-9]*) return 0 ;; esac
  out="$(date -r "$1" "$2" 2>/dev/null || true)"
  [ -n "$out" ] || out="$(date -d "@$1" "$2" 2>/dev/null || true)"
  printf '%s' "$out"
}

# A gap in seconds as something a person reads without doing arithmetic (#75). The whole point of
# the stamps is telling "an hour" from "three weeks" at a glance, and a raw timestamp does not.
# Anything that is not a whole number of seconds, INCLUDING a negative gap from a clock that went
# backwards, says so rather than being rendered as a confident duration (L50).
# THE one place a length of time becomes words (#77). It used to be three: raw minutes in the
# outage message, raw whole days in the conflict copy list, and this. The same gap then read three
# different ways depending which part of the output you were in, and one of them told somebody
# their sync had been failing for "0 minutes", which is not a duration anybody can act on.
duration_in_words(){   # seconds -> "less than a minute", "5 minutes", "2 days", "3 weeks"
  local s="${1:-}" n unit
  case "$s" in ''|*[!0-9]*) printf 'an unknown length of time'; return 0 ;; esac
  if [ "$s" -lt 60 ]; then printf 'less than a minute'; return 0; fi
  if   [ "$s" -lt 5400 ];    then n=$(( (s + 30) / 60 ));         unit=minute
  elif [ "$s" -lt 129600 ];  then n=$(( (s + 1800) / 3600 ));     unit=hour
  elif [ "$s" -lt 1209600 ]; then n=$(( (s + 43200) / 86400 ));   unit=day
  elif [ "$s" -lt 5184000 ]; then n=$(( (s + 302400) / 604800 )); unit=week
  else                            n=$(( (s + 1296000) / 2592000 )); unit=month
  fi
  if [ "$n" -eq 1 ]; then printf '1 %s' "$unit"; else printf '%s %ss' "$n" "$unit"; fi
}

# The same span said as a point in the past. Split from duration_in_words because a conflict copy
# is reported with the suffix "old" and a send with the suffix "ago", and only one of them wants it
# baked in.
age_in_words(){   # seconds -> "just now", "5 minutes ago", "3 weeks ago"
  local s="${1:-}"
  case "$s" in ''|*[!0-9]*) printf 'an unknown time ago'; return 0 ;; esac
  if [ "$s" -lt 45 ]; then printf 'just now'; return 0; fi
  printf '%s ago' "$(duration_in_words "$s")"
}

# How long this lock has existed, in seconds. Unknown counts as 0 (not stale), so a lock
# whose age cannot be read is left alone rather than broken on a guess.
lock_age_seconds(){
  local m now
  m="$(file_mtime "$SYNC_LOCK/pid")"
  case "$m" in ''|*[!0-9]*) printf '0'; return 0 ;; esac
  now="$(date +%s)"
  if [ "$m" -gt "$now" ]; then printf '0'; return 0; fi   # a future mtime is not evidence of age
  printf '%s' "$((now - m))"
}

acquire_lock(){
  # `max` is SECONDS, measured against the clock. It used to be counted in turns of this loop, one
  # `sleep 1` each, which is a timer built by adding up its own sleeps: it measured iterations, and
  # every turn also forks `sleep` and reads two files, so a busy Mac reached the ceiling later than
  # the number said (L226). It went unnoticed while the sleep was exactly one second and the two
  # readings happened to agree. Shortening the poll to a tenth (#205) would have turned a 90 second
  # wait into a 9 second one with nothing anywhere reporting the change.
  local broke=0 max="${SYNC_LOCK_WAIT:-90}" pid lock_host="" lock_t0
  case "$max" in ''|*[!0-9]*) max=90 ;; esac
  lock_t0="$(date +%s)"
  lock_wait_expired(){   # -> true once `max` seconds have really passed since the first attempt
    local _lw_now
    _lw_now="$(date +%s)"
    [ "$(( _lw_now - lock_t0 ))" -ge "$max" ]
  }
  while ! mkdir "$SYNC_LOCK" 2>/dev/null; do
    pid="$(cat "$SYNC_LOCK/pid" 2>/dev/null || true)"
    # Our OWN lock, met again. reexec_after_self_update runs the updated script with
    # `exec`, which replaces the process image and keeps the SAME pid, so the resumed run
    # arrives back here holding a lock it took before the update. Without this it waits
    # the full timeout for itself and then dies, which is how every self-update test in
    # the suite failed the first time this lock was added.
    [ -n "$pid" ] && [ "$pid" = "$$" ] && return 0
    # A lock older than any plausible run is broken REGARDLESS of whether its recorded pid
    # looks alive. Liveness alone is not enough for a folder copied or restored from a
    # backup: the pid in it belongs to a process on a DIFFERENT machine, and if some
    # unrelated process here happens to hold that number, the lock reads as held for ever
    # and syncing never resumes. Age is the evidence that survives the move. (#25)
    # One hour, and that number is measured rather than guessed: on 2026-08-17 a live sync of
    # the real 4.7MB payload took 6 seconds and a fresh clone plus full first pull took 4, so
    # the ceiling is roughly 600x the slowest real run. It matters more than the other
    # thresholds here because being wrong LOW starts a second run on top of a live one.
    # Whose lock is it? If THIS machine took it, the recorded pid is authoritative and the
    # clock is not consulted at all: a clock jumping forward (a correction, a timezone change,
    # a wake from sleep) would otherwise make a live lock look ancient and let a second run
    # start on top of a running one, which is the collision the lock exists to prevent. Age is
    # the fallback only for a lock from ELSEWHERE, which is the restored-folder case it was
    # actually written for (#25), where the pid refers to a process on another machine and
    # means nothing here. Wedging is detectable now that an outage alerts after hours without
    # a successful sync; a silent collision would never surface, so this is the safe
    # direction. A lock with no machine recorded predates this and falls back to age. (#29)
    lock_host="$(cat "$SYNC_LOCK/host" 2>/dev/null || true)"
    if [ -n "$lock_host" ] && [ "$lock_host" = "$(sync_hostname)" ] && lock_owner_alive "$pid"; then
      lock_wait_expired && return 1
      sleep "$SYNC_POLL_INTERVAL"
      continue
    fi
    if [ "$(lock_age_seconds)" -gt "${SYNC_LOCK_MAX_AGE:-3600}" ] 2>/dev/null; then
      echo "claude-sync: broke a stale lock in $SYNC_LOCK (older than ${SYNC_LOCK_MAX_AGE:-3600}s, so no run can still be holding it)." >&2
      rm -rf "$SYNC_LOCK" 2>/dev/null || true
      broke=$((broke+1))
      [ "$broke" -le 5 ] && continue
    fi
    if ! lock_owner_alive "$pid"; then
      # A crashed run must not wedge syncing for good, so a lock whose owner is gone has
      # to be breakable. This reading deliberately does NOT decide who takes over: two
      # runs can reach here together and both judge the same dead pid. The mkdir at the
      # top of the loop is the arbiter and only one of them can win it. Re-reading the pid
      # first means a lock a NEW live run has just created is left alone (L157: acting on
      # a judgement formed before an atomic step reopens the race it appears to close).
      # What remains is a window of microseconds where two runs break the SAME dead lock,
      # and the result of that is two overlapping runs, which is exactly what happened
      # before this existed. So it is never worse than not locking, and the common cases
      # (a live holder, an ordinary crash) are closed.
      if [ "$pid" = "$(cat "$SYNC_LOCK/pid" 2>/dev/null || true)" ]; then
        rm -rf "$SYNC_LOCK" 2>/dev/null || true
        broke=$((broke+1))
        # Bounded: a lock that cannot be removed at all (a permissions problem, a full
        # disk) must time out like any other, never spin here forever.
        [ "$broke" -le 5 ] && continue
      fi
    fi
    lock_wait_expired && return 1
    sleep "$SYNC_POLL_INTERVAL"
  done
  printf '%s\n' "$$" > "$SYNC_LOCK/pid" 2>/dev/null || true
  # Which machine holds it, so a lock met later can be judged by the right evidence (#29).
  printf '%s\n' "$(sync_hostname)" > "$SYNC_LOCK/host" 2>/dev/null || true
  return 0
}

release_lock(){
  [ "${LOCK_HELD:-0}" = 1 ] || return 0
  # Only ever remove OUR OWN lock. If this run's lock was broken by someone else while it
  # was still going, the directory now belongs to them and removing it would hand a third
  # run in on top of both.
  [ "$(cat "$SYNC_LOCK/pid" 2>/dev/null || true)" = "$$" ] && rm -rf "$SYNC_LOCK" 2>/dev/null
  LOCK_HELD=0
  return 0
}

# A DISPOSABLE directory is not a clone worth remembering (claude-config#295).
#
# The register is appended to and, by design, never pruned: pruning would be a read modify write
# over the one record saying where the other clones are. So one hand made debug scenario under
# /private/tmp put a throwaway checkout into it permanently, and every pull afterwards ended with
# "the checkout at /private/tmp/dbg/B is on a commit this clone has never seen ... Run
# 'git -C /private/tmp/dbg/B fetch' there". That line carries no action anybody would take: the
# directory is disposable and the OS will clear it, at which point the entry points at nothing. A
# notice with no remedy, printed on every run, is what teaches a reader to skip the whole report.
#
# Refused on the way IN, and skipped on the way OUT, because the entries already recorded cannot be
# pruned and would otherwise keep talking for ever.
#
# SYNC_TEMP_ROOTS is the list, newline separated, so a path holding a space is still one entry. The
# suite sets it to somewhere unusable, because its own clones live under the real temp directory
# and every section about clone discovery would otherwise have nothing to discover; the one section
# that is ABOUT this rule unsets it and puts its fixture under the real one.
sync_temp_roots(){
  if [ -n "${SYNC_TEMP_ROOTS+set}" ]; then printf '%s\n' "$SYNC_TEMP_ROOTS"; return 0; fi
  [ -n "${TMPDIR:-}" ] && printf '%s\n' "${TMPDIR%/}"
  printf '%s\n' /tmp /private/tmp /var/tmp /var/folders /private/var/folders
  return 0
}

is_under_temp_dir(){   # $1 = an absolute path -> 0 when it sits under a disposable root
  local p="${1%/}" r
  [ -n "$p" ] || return 1
  while IFS= read -r r; do
    [ -n "$r" ] || continue
    r="${r%/}"
    [ "$p" = "$r" ] && return 0
    case "$p" in "$r"/*) return 0 ;; esac
  done <<TEMP_ROOTS
$(sync_temp_roots)
TEMP_ROOTS
  return 1
}

# This clone, written down where a sibling can read it (claude-config#189).
#
# Appended once, never rewritten, so a run that dies part way through cannot lose the entries
# already there (L105). A clone that has gone is not pruned either: the reader checks each entry
# still holds a claude-sync, and pruning would mean a read, modify, write over the one record that
# says where the other clones are.
#
# Silent on every failure. This is a convenience for a later status, and a run that pulled config
# must not fail because a note about itself could not be written.
register_this_clone(){
  local me
  me="$(cd "$SYNC_REPO" 2>/dev/null && pwd -P)" || return 0
  [ -n "$me" ] || return 0
  # A directory holding no claude-sync is not a clone of this tool, whatever else it is.
  [ -f "$SYNC_REPO/claude-sync" ] || return 0
  # Nor is a disposable one (claude-config#295): recording it is permanent and what it says stops
  # being true the moment the OS clears the directory.
  is_under_temp_dir "$me" && return 0
  if [ -f "$CLONE_REGISTRY" ] && grep -qxF "$me" "$CLONE_REGISTRY" 2>/dev/null; then return 0; fi
  printf '%s\n' "$me" >> "$CLONE_REGISTRY" 2>/dev/null || true
  return 0
}

# ONE named entry out of the register, on request (claude-config#306).
#
# The register is appended to and never pruned, deliberately: an automatic sweep would be a read
# modify write over the one record saying where the other clones are. But a real checkout that is
# deleted or renamed then reports "not there any more. Remove the line from ... if it has gone for
# good" on every receive, for ever, and that named a remedy the tool would not perform, in a file,
# with no command to do it. A notice carrying no action anybody takes, repeated on every run, is
# what teaches a reader to skip the whole report.
#
# This is not the sweep the design rejected. It removes exactly the ONE line the person names, and
# nothing else, which is why it is safe to do at all.
#
# It runs UNDER THE LOCK, which is the whole reason the read modify write is safe here:
# register_this_clone appends from inside with_lock, so holding it is what stops an append landing
# between the read and the rename and being lost (L5). Written to a temp file and renamed, never
# edited in place.
do_forget_clone(){   # $1 = the directory to forget
  local want="${1:-}" tmp n
  [ -n "$want" ] || die "forget-clone needs the directory to forget, exactly as it appears in $CLONE_REGISTRY. Run 'claude-sync pull' to see the ones being reported."
  if [ ! -f "$CLONE_REGISTRY" ]; then
    echo "There is no clone register at $CLONE_REGISTRY, so there was no entry for $want to remove."
    return 0
  fi
  n="$(grep -cxF -- "$want" "$CLONE_REGISTRY" 2>/dev/null || true)"
  case "$n" in ''|*[!0-9]*) n=0 ;; esac
  if [ "$n" -eq 0 ]; then
    # A DIFFERENT answer from having removed something, or a mistyped path reads as a successful
    # removal and the notice it was meant to settle comes straight back (L98, L11).
    echo "No entry for $want was in the clone register, so nothing was removed. The paths it holds are listed in $CLONE_REGISTRY."
    return 0
  fi
  tmp="$(scratch_file)" || die "no scratch file could be made, so the clone register was left exactly as it is."
  grep -vxF -- "$want" "$CLONE_REGISTRY" > "$tmp" 2>/dev/null || true
  mv "$tmp" "$CLONE_REGISTRY" 2>/dev/null || { rm -f "$tmp"; die "the clone register at $CLONE_REGISTRY could not be rewritten, so it was left exactly as it is."; }
  echo "Removed $want from the clone register; it will not be reported again."
  return 0
}

with_lock(){   # $@ = the command to run while holding the lock
  local rc=0
  # Re-entrant within one run: do_send falls through to do_sync, and a second acquire
  # there would deadlock against this run's own lock.
  if [ "${LOCK_HELD:-0}" = 1 ]; then "$@"; return $?; fi
  acquire_lock || die "another claude-sync run is already running and still holds $SYNC_LOCK, so this one stopped instead of working on the same files at the same time. Nothing was changed. Run 'claude-sync status' to see where things stand."
  LOCK_HELD=1
  # Here rather than in each command, and here rather than in a read-only one: a clone that has
  # taken the lock is a clone that can leave a record behind, and status changes nothing by design.
  register_this_clone
  # An EXIT trap, not a line after the call: every failure in here leaves through die(),
  # and a lock kept by a run that died would mean the first network blip wedges syncing
  # until somebody noticed by hand.
  # Both handlers, because `trap ... EXIT` REPLACES whatever was registered rather than
  # adding to it, and cleanup_applied_log is already installed at the top level. Setting
  # only release_lock here silently unregistered it and left a temp file behind on every
  # pull, which the suite caught immediately.
  # Commits already waiting when this run started (a hand commit to the tool, a run that died
  # between committing and pushing). Read BEFORE the command, because afterwards there is no way
  # to tell work that was waiting from work that never existed.
  # Before anything else this run does, and after the lock, because concluding a rebase is a write
  # to the repository and two runs doing it at once is the failure the lock exists for
  # (claude-config#324). A run that finds a real conflict stops here rather than working around it.
  recover_unfinished_rebase
  if have_git && unpushed_commits; then note_unsent_work; fi
  # In the trap, not on a line after the call: every failure in here leaves through die(), and a
  # run that pushed and then died on something later still sent what it sent.
  # The sweep rides HERE (claude-config#314), on the one trap every mutating command reaches and
  # no read-only one does, and last, so a run's own scratch is removed by the handlers before it
  # and cannot be counted as somebody else's leftover.
  trap 'record_sent_if_shipped; clear_behind_skips_if_caught_up; release_lock; cleanup_applied_log; reap_scratch_if_due' EXIT
  "$@" || rc=$?
  release_lock
  # After release_lock, never before: this is where the minutes of hook suite behind the closing
  # line are paid, and #181 measured what paying them under the lock does to the watch daemon.
  # Only on success, because a run that failed installed nothing to report and left through die()
  # anyway; `if` rather than `&&`, which under set -e would abort the run when rc is non-zero.
  if [ "$rc" -eq 0 ]; then flush_pending_report; fi
  return $rc
}

# ---- which plugins load on this Mac (#48) ----
# Every plugin used to be enabled at user scope, so all seven loaded into every session in every
# project: roughly 7,700 tokens of Vercel, Figma and Stripe before any of it was used, plus a 53KB
# Vercel knowledge graph injected at session start in a directory with no code in it. The fix is to
# enable each plugin in the projects that use it.
#
# `enabledPlugins` lives in the part of settings.json this tool deliberately never carries (model,
# effort and plugins stay private to each Mac). Carrying it would apply THIS Mac's project survey to
# a Mac holding different projects, turning a fix here into a regression there. So it stays per Mac,
# and status SAYS SO: two Macs quietly diverging with nothing able to report it is the failure worth
# making visible (L148).
report_user_scope_plugins(){
  local settings on off
  settings="$CLAUDE_HOME/settings.json"
  [ -f "$settings" ] || return 0
  command -v jq >/dev/null 2>&1 || return 0
  if ! jq -e '.enabledPlugins' "$settings" >/dev/null 2>&1; then
    # A real state with real consequences (every installed plugin loads in every project), and the
    # state this Mac was in. Saying nothing would report it as fine.
    echo "--- plugins ---"
    echo "  no plugin enablement recorded on this Mac, so every installed plugin loads in every project. This setting is per Mac and is never synced."
    return 0
  fi
  on="$(jq -r '[.enabledPlugins | to_entries[] | select(.value == true) | (.key | split("@")[0])] | sort | join(", ")' "$settings" 2>/dev/null || true)"
  off="$(jq -r '[.enabledPlugins | to_entries[] | select(.value == false) | (.key | split("@")[0])] | sort | join(", ")' "$settings" 2>/dev/null || true)"
  echo "--- plugins (per Mac, never synced) ---"
  echo "  enabled everywhere on this Mac: ${on:-<none>}"
  echo "  off at user scope, so only where a project turns them on: ${off:-<none>}"
  return 0
}

# ---- a skill provided twice (#49) ----
# Nine Cloudflare skills existed as byte identical copies in ~/.claude/skills/ AND inside the
# cloudflare plugin, so each was listed twice in every session and both were paid for. Nothing
# detected it; it was found by hand while auditing. Installing any plugin can shadow a skill of the
# same name, either a local one or one that syncs between the Macs, and neither copy says anything
# about the other.
#
# Derived from the plugin install record rather than from a list kept beside it, so a plugin
# installed later is covered without anybody remembering to add it (L96).
plugin_skill_names(){   # prints "skill<TAB>plugin"
  local reg paths ip name plug
  reg="$CLAUDE_HOME/plugins/installed_plugins.json"
  [ -f "$reg" ] || return 0
  if command -v jq >/dev/null 2>&1; then
    paths="$(jq -r '.plugins // {} | to_entries[] | .key as $k | .value[]? | select(.installPath) | "\(.installPath)\t\($k)"' "$reg" 2>/dev/null || true)"
  else
    # No jq: read the install paths out of the file directly rather than answering "none", which
    # would read exactly like a machine with no duplicates at all (L98).
    paths="$(grep -oE '"installPath"[[:space:]]*:[[:space:]]*"[^"]+"' "$reg" 2>/dev/null | sed 's/.*: *"//; s/"$//; s/$/\t<unknown plugin>/' || true)"
  fi
  while IFS="$(printf '\t')" read -r ip plug; do
    [ -n "${ip:-}" ] || continue
    [ -d "$ip/skills" ] || continue
    for name in "$ip/skills"/*; do
      [ -d "$name" ] || continue
      printf '%s\t%s\n' "${name##*/}" "${plug%%@*}"
    done
  done <<PLUGINPATHS
$paths
PLUGINPATHS
  return 0
}

# Every skill a plugin provides that ALSO exists locally or in the payload, as
# "skill<TAB>plugin<TAB>where". One definition, used by the check and by status.
duplicate_plugin_skills(){
  local name plug where
  while IFS="$(printf '\t')" read -r name plug; do
    [ -n "${name:-}" ] || continue
    where=""
    [ -d "$CLAUDE_HOME/skills/$name" ] && where="the skills folder on this Mac"
    if [ -d "$PAYLOAD/skills/$name" ]; then
      if [ -n "$where" ]; then where="$where and the synced payload"; else where="the synced payload"; fi
    fi
    [ -n "$where" ] || continue
    printf '%s\t%s\t%s\n' "$name" "$plug" "$where"
  done < <(plugin_skill_names)
  return 0
}

# Returns 0 when it found something to report, 1 when there was nothing, so a caller can tell the
# two apart without re-deriving the answer.
report_duplicate_plugin_skills(){
  local name plug where found=""
  while IFS="$(printf '\t')" read -r name plug where; do
    [ -n "${name:-}" ] || continue
    found+="  $name: provided by the $plug plugin AND by $where, so it is listed twice in every session"$'\n'
  done < <(duplicate_plugin_skills)
  [ -z "$found" ] && return 1
  echo "--- skills provided twice (#49) ---"
  printf '%s' "$found"
  echo "  Delete the copy under skills/ and keep the plugin as the single source, or uninstall the plugin."
  return 0
}

do_check_skills(){
  local n
  n="$(plugin_skill_names | grep -c . || true)"
  if [ "${n:-0}" -eq 0 ]; then
    # Zero plugin skills read is NOT the same answer as no duplicates found. Reported as a pass, a
    # Mac that cannot see its plugins would be indistinguishable from a clean one (L98).
    echo "no plugin skills were found under $CLAUDE_HOME/plugins, so there is nothing to compare the local skills against. That is an answer about this Mac, not a clean bill of health."
    return 0
  fi
  if report_duplicate_plugin_skills; then
    die "a skill is provided twice (named above). Each duplicate is listed twice in every session and paid for twice."
  fi
  echo "no skill is provided twice ($n plugin skills read, none of them also under skills/ or in the payload)"
  return 0
}

# ---- skills entries that cannot load (#50) ----
# A skill is a DIRECTORY holding a SKILL.md whose frontmatter carries a name and a description.
# Anything else under skills/ is inert: payload/skills/humanizer/ and payload/skills/stop-slop/
# held no SKILL.md at all, and two loose markdown files sat directly under skills/ where nothing
# reads them. All four synced between both Macs for months, because a skill that cannot load is
# indistinguishable from one that works until somebody tries to invoke it.
#
# Prints "entry<TAB>reason" for each one, so every report can name the entry and say why in one
# line rather than counting them.
skill_frontmatter(){   # $1 = a SKILL.md
  awk 'NR==1 && $0 !~ /^---[[:space:]]*$/ { exit } NR==1 { next } /^---[[:space:]]*$/ { exit } { print }' "$1" 2>/dev/null
}

# Whether a frontmatter block carries FIELD with a value that is not just blanks.
#
# A loop over the text rather than `printf '%s' "$fm" | grep -qE` (claude-config#162). `grep -q`
# leaves on its first match, its producer is killed by SIGPIPE, and under `pipefail` the pipeline's
# status becomes that death, so a field that WAS there is reported as missing. Whether it bites
# depends on how big the block is and where in it the match falls, which makes it a size threshold
# nobody is watching, and the file's own header claimed every site whose producer is a whole program
# had been converted while these two sat in it (L183, L217).
#
# It reads to the END rather than stopping at the first match, deliberately: an early break out of a
# loop fed by a here-document is the same shape again, and there is nothing to gain from leaving
# early on a block this size.
skill_frontmatter_has(){   # $1 = a field name   $2 = the frontmatter block
  local line rest found=0
  while IFS= read -r line; do
    case "$line" in
      "$1:"*)
        rest="${line#"$1:"}"
        # The leading blanks stripped off, so "name:   " counts as empty exactly as the regex it
        # replaced did: it required a non-space character after the colon.
        rest="${rest#"${rest%%[![:space:]]*}"}"
        [ -n "$rest" ] && found=1 ;;
    esac
  done <<FRONTMATTER
$2
FRONTMATTER
  [ "$found" -eq 1 ]
}

# The VALUE of a frontmatter field, read the same way skill_frontmatter_has decides a field is
# present, so the two cannot disagree about what counts as set (L70).
skill_frontmatter_value(){   # $1 = a field name   $2 = the frontmatter block
  local line rest val=""
  while IFS= read -r line; do
    case "$line" in
      "$1:"*)
        rest="${line#"$1:"}"
        rest="${rest#"${rest%%[![:space:]]*}"}"
        [ -n "$rest" ] && val="$rest" ;;
    esac
  done <<FRONTMATTER
$2
FRONTMATTER
  printf '%s' "$val"
}

# TWO SKILLS CLAIMING THE SAME JOB (claude-config#331). The duplicate check above compares FOLDER
# NAMES against the plugins, which cannot see this: on 2026-09-07 a skill folder renamed on one Mac
# was resurrected under its old name by the other, and the two folders carried identical
# `description` frontmatter. The description is what the assistant chooses on, so that is two
# skills for one job and the choice between them is arbitrary. Grouped by description rather than
# by name, because the names are exactly what differ.
duplicate_local_skill_jobs(){   # prints "description<TAB>folder folder ..."
  local dir="$CLAUDE_HOME/skills" e base fm d skip pskill
  [ -d "$dir" ] || return 0
  {
    for e in "$dir"/*; do
      [ -d "$e" ] || continue
      base="${e##*/}"
      case "$base" in .*) continue ;; esac
      # A plugin manages these and the sync deliberately never carries them, so naming one here
      # would report a problem about something this tool does not touch, exactly as
      # unloadable_skill_entries already refuses to. A flag rather than `continue 2`, because this
      # loop has no outer loop to continue.
      skip=0
      for pskill in ${PLUGIN_SKILLS[@]+"${PLUGIN_SKILLS[@]}"}; do
        [ "$base" = "$pskill" ] && { skip=1; break; }
      done
      [ "$skip" = 1 ] && continue
      [ -f "$e/SKILL.md" ] || continue
      fm="$(skill_frontmatter "$e/SKILL.md")"
      d="$(skill_frontmatter_value description "$fm")"
      [ -n "$d" ] || continue
      printf '%s\t%s\n' "$d" "$base"
    done
  } | awk -F'\t' '{ f[$1] = f[$1] " " $2; n[$1]++ }
                  END { for (d in n) if (n[d] > 1) { sub(/^ /, "", f[d]); print d "\t" f[d] } }'
  return 0
}

# Returns 0 when it found something, 1 when there was nothing, matching its neighbour above.
report_duplicate_skill_jobs(){
  local d folders found=""
  while IFS="$(printf '\t')" read -r d folders; do
    [ -n "${d:-}" ] || continue
    found="$found  $folders: same description, so they are two skills competing for one job and the choice between them is arbitrary"$'\n'
  done < <(duplicate_local_skill_jobs)
  [ -z "$found" ] && return 1
  echo "--- skills claiming the same job (claude-config#331) ---"
  printf '%s' "$found"
  echo "  Keep one and delete the other, or give each a description saying when it applies rather than the same one twice."
  return 0
}

unloadable_skill_entries(){   # $1 = a skills directory
  local dir="$1" e base sk fm s
  [ -d "$dir" ] || return 0
  for e in "$dir"/*; do
    [ -e "$e" ] || continue
    base="${e##*/}"
    case "$base" in .*) continue ;; esac
    # A plugin manages these and the sync deliberately never carries them, so judging them here
    # would report a problem about something this tool does not touch.
    for s in "${PLUGIN_SKILLS[@]}"; do [ "$base" = "$s" ] && continue 2; done
    if [ ! -d "$e" ]; then
      printf '%s\ta bare file directly under skills/ is not a skill, so nothing reads it\n' "$base"
      continue
    fi
    sk="$e/SKILL.md"
    if [ ! -f "$sk" ]; then
      printf '%s\tthe directory holds no SKILL.md, so nothing can load it\n' "$base"
      continue
    fi
    # The frontmatter block only. A file whose BODY happens to carry "name:" would otherwise
    # answer for a file that has no frontmatter at all (L135).
    fm="$(skill_frontmatter "$sk")"
    if ! skill_frontmatter_has name "$fm"; then
      printf '%s\tits SKILL.md carries no name in the frontmatter\n' "$base"
      continue
    fi
    if ! skill_frontmatter_has description "$fm"; then
      printf '%s\tits SKILL.md carries no description in the frontmatter, so nothing can tell when to use it\n' "$base"
      continue
    fi
  done
  return 0
}

# Excludes for the skills mirror, plus the report. Refusing quietly would leave the entry looking
# like ordinary config that simply had not synced yet, so the same run that declines to carry it
# says which one and why (#50).
# The apply mirrors the payload over skills/ with --delete, so anything here that the payload does
# not carry is DELETED from this Mac. An entry that cannot load is deliberately never carried, which
# means "refuse to carry it" silently became "delete it from the other Mac" for any half-built or
# broken skill folder somebody has. Protect them, with no report: the staging half already names
# them on every send, and saying it twice per sync is how a warning stops being read (#62).
protect_unloadable_local_skills(){
  local entry reason
  while IFS="$(printf '\t')" read -r entry reason; do
    [ -n "${entry:-}" ] || continue
    REFUSED_SKILL_EXCLUDES+=(--exclude="/$entry")
  done < <(unloadable_skill_entries "$CLAUDE_HOME/skills")
  return 0
}

refuse_unloadable_skills(){   # $1 = the skills directory to judge  $2 = where it is going (a verb for the report)  $3 = "prune" to clear entries holding no files at all
  local entry reason named=""
  while IFS="$(printf '\t')" read -r entry reason; do
    [ -n "${entry:-}" ] || continue
    # An entry holding NO FILES has nothing to lose, and git cannot carry the deletion of an empty
    # directory, so hand-deleting it on one Mac leaves the other reporting it for ever. Clear it
    # here and the reports stop. Anything holding a file is refused and LEFT ALONE, however
    # unloadable: declining to carry something is not a reason to destroy it (L5). Only ever in the
    # payload, never in somebody's own skills folder, where a half-built skill is theirs (#62).
    # The exclusion goes on FIRST and stays on even when the payload copy is pruned. The mirror
    # runs with --delete, so an entry missing from the payload and not excluded is deleted from
    # THIS MAC, and the first version of the prune did exactly that to a folder holding the
    # person's own work. The suite caught it (L5).
    REFUSED_SKILL_EXCLUDES+=(--exclude="/$entry")
    if [ "${3:-}" = prune ] && [ -d "$1/$entry" ] && [ -z "$(find "$1/$entry" -type f 2>/dev/null | awk 'NR <= 1')" ]; then
      rm -rf "$1/$entry"
      named+="  skills/$entry: $reason, and it held no files at all, so it was removed from the payload and will stop being reported"$'\n'
      continue
    fi
    named+="  skills/$entry: $reason"$'\n'
  done < <(unloadable_skill_entries "$1")
  [ -z "$named" ] && return 0
  echo "claude-sync: these entries under skills/ cannot load, so they were NOT $2 and nothing else about this run was affected:" >&2
  printf '%s' "$named" >&2
  notify "skills that cannot load were not $2"
  return 0
}

skill_excludes(){ for s in "${PLUGIN_SKILLS[@]}"; do printf -- "--exclude=%s\n" "$s"; done; }

# LC_ALL=C so the substitution is bytewise. A UTF-8 locale makes sed refuse a file holding a byte
# sequence it cannot decode ("illegal byte sequence"), which would empty the stream rather than
# fail loudly, and the caller compares what comes out.
tok(){ LC_ALL=C sed "s|$CLAUDE_HOME|$TOKEN|g"; }   # real home -> placeholder
detok(){ LC_ALL=C sed "s|$TOKEN|$CLAUDE_HOME|g"; } # placeholder -> this Mac's home

# ---- the home path substitution covers every mirrored file, not one (#87) ----
# tok/detok existed and were wired to settings.hooks.json ALONE, so every other payload file was
# carried verbatim and an absolute home path inside one was simply wrong on whichever Mac did not
# author it. #86 fixed the eight that existed and added a guard, but two of them cannot be written
# as a tilde at all: they are scriptPath values handed to the Workflow tool, which expands neither
# a tilde nor a variable, so they were left carrying a placeholder the model has to substitute at
# call time. That is a rule living only in a prompt (L27). Doing it here makes it a property of
# the file.
#
# Only the MIRRORED trees. The top-level rule files are deliberately left alone: they are merged
# entry by entry by merge_rule_files, and rewriting their bytes underneath a three-way merge would
# change what the merge is comparing. They are prose, where a tilde reads correctly anyway.
tokenized_path(){   # $1 = path relative to the payload
  local d
  for d in "${MIRROR_DIRS[@]}" skills; do
    case "${1:-}" in "$d"/*) return 0 ;; esac
  done
  return 1
}

# Rewrite this Mac's home path to the token, in place, across the staged payload. Runs on the way
# UP, after the mirror and before the secret scan.
#
# `cat >` rather than `mv`: the mode bits belong to the file (a hook has to stay executable) and a
# move would replace them with the temp file's. grep -I picks the candidates in one pass and skips
# binaries, so nothing that cannot survive a text rewrite is ever handed to sed.
tokenize_payload(){
  local d f tmp
  [ -n "${CLAUDE_HOME:-}" ] || return 0
  for d in "${MIRROR_DIRS[@]}" skills; do
    [ -d "$PAYLOAD/$d" ] || continue
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      tmp="$(scratch_file)"
      if tok < "$f" > "$tmp" 2>/dev/null; then cat "$tmp" > "$f"; fi
      rm -f "$tmp"
    done < <(grep -rIl --exclude-dir=.git -F -- "$CLAUDE_HOME" "$PAYLOAD/$d" 2>/dev/null || true)
  done
  return 0
}

# The payload tree as it should land on THIS Mac, for the apply to copy FROM.
#
# A materialised copy rather than a rewrite after the fact, because the apply compares checksums:
# with the token still in the payload, every tokenized file differs from its local counterpart on
# every run, so rsync would copy it every time and the change summary would name files nothing had
# changed. A report that names unchanged files is a report nobody reads (L36).
#
# When no file in the tree carries the token, the payload directory itself is returned and nothing
# is copied, so the ordinary case costs one grep.
EXPANDED_ROOT=""
cleanup_expanded(){ if [ -n "$EXPANDED_ROOT" ]; then rm -rf "$EXPANDED_ROOT"; EXPANDED_ROOT=""; fi; return 0; }
apply_source_dir(){   # $1 = a mirrored tree name -> prints the directory to copy from
  local src="$PAYLOAD/$1" dst hit rel tmp
  if ! grep -rIq --exclude-dir=.git -F -- "$TOKEN" "$src" 2>/dev/null; then
    printf '%s' "$src"; return 0
  fi
  [ -n "$EXPANDED_ROOT" ] || EXPANDED_ROOT="$(scratch_dir)"
  dst="$EXPANDED_ROOT/$1"
  mkdir -p "$dst"
  rsync -a --delete "${COMMON_EXCLUDES[@]}" "$src/" "$dst/" 2>/dev/null || { printf '%s' "$src"; return 0; }
  while IFS= read -r hit; do
    [ -n "$hit" ] || continue
    rel="${hit#"$src"/}"
    [ -f "$dst/$rel" ] || continue
    tmp="$(scratch_file)"
    if detok < "$dst/$rel" > "$tmp" 2>/dev/null; then cat "$tmp" > "$dst/$rel"; fi
    rm -f "$tmp"
  done < <(grep -rIl --exclude-dir=.git -F -- "$TOKEN" "$src" 2>/dev/null || true)
  printf '%s' "$dst"
}

# The payload's copy of one path, as it should look on THIS Mac. EVERY comparison between the two
# sides has to go through this. A tokenized file never equals its payload copy byte for byte, so a
# raw comparison reads it as locally ahead on every single run, holds it back on every apply, and
# the other Mac's edits to it silently stop arriving: the pull still reports success and the file
# simply never changes again.
payload_local_view(){   # $1 = path relative to the payload
  [ -f "$PAYLOAD/$1" ] || return 1
  if tokenized_path "$1" && grep -Iq -F -- "$TOKEN" "$PAYLOAD/$1" 2>/dev/null; then
    detok < "$PAYLOAD/$1"
  else
    cat "$PAYLOAD/$1"
  fi
}

# Is the payload's copy of this path ALREADY what belongs on this Mac (claude-config#313)?
#
# A tokenized file never equals its payload copy byte for byte: the payload holds __CLAUDE_HOME__
# and the live copy holds this Mac's own home path. Every comparison in the apply already goes
# through payload_local_view for that reason; the status dry run did not, so it reported three
# files as differing on every single run (skills/plan-council/SKILL.md and both of
# skills/production-ready/) when nothing had moved at all. The one report that would reveal genuine
# drift permanently carried three false alarms, and a report that cries wolf is one people stop
# reading (L36, L182).
#
# Derived from the substitution rule itself rather than from a list of those three names (L41,
# L96), and asked PER FILE: a tokenized file whose text has also really changed still differs here,
# so carrying the token is not a way to disappear from the report.
#
# It answers about THIS CAUSE ONLY, and every one of the four conditions is load-bearing, because
# whatever this excuses is excused under a sentence naming the placeholder and a message may claim
# only what it measured (L11). A file rsync flags for a timestamp or a group, whose bytes are
# identical on both sides, is a different fact with a different remedy and is left to be reported
# as it always was: the first cut here asked only whether the CONTENT matched, which swallowed
# every one of those and reported them under this cause.
payload_differs_only_by_home_path(){   # $1 = path relative to the payload
  local tmp rc
  [ -f "$PAYLOAD/$1" ] && [ -f "$CLAUDE_HOME/$1" ] || return 1
  # Only the mirrored trees are substituted at all, so nothing outside them can differ this way.
  tokenized_path "$1" || return 1
  # The payload must really carry the placeholder. Without this the question is unanswerable and
  # the answer would be about some other difference.
  grep -Iq -F -- "$TOKEN" "$PAYLOAD/$1" 2>/dev/null || return 1
  # Identical raw bytes means the difference rsync reported is not in the content at all.
  cmp -s "$PAYLOAD/$1" "$CLAUDE_HOME/$1" && return 1
  tmp="$(scratch_file)"
  payload_local_view "$1" > "$tmp" 2>/dev/null || { rm -f "$tmp"; return 1; }
  rc=0; cmp -s "$tmp" "$CLAUDE_HOME/$1" || rc=$?
  rm -f "$tmp"
  return "$rc"
}

# The same view of a payload file as it was at some past commit, for the conflict path, which asks
# what this Mac last applied. grep -I decides whether the blob is text, so a binary is never
# handed to sed.
blob_local_view(){   # $1 = path relative to the payload  $2 = commit
  local tmp rc=0
  tmp="$(scratch_file)"
  git -C "$SYNC_REPO" show "$2:payload/$1" > "$tmp" 2>/dev/null || rc=1
  if [ "$rc" -eq 0 ]; then
    if tokenized_path "$1" && grep -Iq -F -- "$TOKEN" "$tmp" 2>/dev/null; then detok < "$tmp"; else cat "$tmp"; fi
  fi
  rm -f "$tmp"
  return "$rc"
}

# Leading "@name" import lines of one rule file, as bare names. Only plain
# filenames are returned: an absolute or ~ path points outside the synced set, and
# a path with a slash lives inside a directory that is already mirrored.
imports_in_file(){   # $1 = file
  local line target
  [ -f "$1" ] || return 0
  while IFS= read -r line; do
    case "$line" in '@'?*) ;; *) continue ;; esac
    target="${line#@}"
    target="${target%%[[:space:]]*}"
    case "$target" in ''|/*|'~'*|*/*) continue ;; esac
    printf '%s\n' "$target"
  done < "$1"
  return 0
}

# The top-level rule files for a given tree ($CLAUDE_HOME when sending, $PAYLOAD
# when receiving): the seed, plus everything CLAUDE.md references, plus everything
# those files reference in turn. Transitive, because a rule file may pull in
# another, and a set that stopped at one hop would leave the second file unsynced
# while the dangling-reference check flagged it as missing.
# Space-delimited strings, not arrays: bash 3.2 (the macOS default) treats
# "${arr[@]}" on an empty array as an unbound variable under `set -u`.
top_files_in(){   # $1 = directory
  local seen=" " pending="${TOP_FILES_SEED[*]}" f imp
  while ! is_blank "$pending"; do
    f="${pending%% *}"; pending="${pending#"$f"}"; pending="${pending# }"
    [ -n "$f" ] || continue
    case "$seen" in *" $f "*) continue ;; esac
    seen+="$f "
    while IFS= read -r imp; do
      [ -n "$imp" ] && pending+=" $imp"
    done < <(imports_in_file "$1/$f")
  done
  printf '%s\n' $seen
  return 0
}

# The lesson numbers in a rule file are assigned by hand, so two Macs working the
# same day both reach for the same one and neither can see the other's yet. The file
# promises the numbering is stable for reference, so a duplicate quietly breaks every
# reference to it. Seen 2026-07-29: six lessons claiming three numbers, plus an
# earlier duplicate that had gone unnoticed for a day (#15).
# Prints one line per duplicate, per file. Empty output means the numbering is sound.
# ---- what counts as a lesson entry at all (claude-config#164) ----
# The canonical form is `- **Lnnn. ...`, and every tool in this file reads only that: the duplicate
# checker, the number minter, the index generator and `claude-sync lesson`. So an entry written any
# other way is invisible to ALL of them at once, they agree with each other, and all of them are
# wrong together.
#
# Measured 2026-08-22: a `### L511.` heading and a bare `- L511.` list item sat in LESSONS.md read
# by nothing. They were absent from the generated index that loads into every session, `lesson L511`
# answered that it was not in the file while the file held two entries labelled L511, and
# `next-lesson` went on offering 511 as free, so the next lesson written on either Mac would have
# collided with `check-lessons` still reporting the numbering sound.
#
# The recogniser is deliberately LOOSER than the canonical form: leading blanks, any list marker,
# any heading depth, and the bold optional. What it finds that is not canonical is a hard failure
# naming the file and the line, because a checker that only sees what it can parse reports success
# when it matches nothing, and that is the one class it can otherwise never report (L100, L96).
LESSON_DECL_RE='^[[:blank:]]*([-*+][[:blank:]]+|#{1,6}[[:blank:]]+)?(\*\*)?L[0-9]+\.'

# Is this rule file one lessons are WRITTEN in, rather than one they are rendered into? Asked in
# one place, so the three readers below cannot drift into three different answers (L41).
lesson_source_file(){   # $1 = path relative to the config root
  ! is_derived_rule_file "$1"
}

# Every lesson number a file CLAIMS, in whatever shape it is written. This is what decides which
# numbers are taken, so a malformed entry can never have its number handed out a second time even
# when the refusal below has been overridden. Being wrong here costs a collision, which is the one
# thing the whole band mechanism exists to prevent, and a refusal somebody has switched off must
# not take the numbering with it.
lesson_numbers_in(){   # $1.. = files -> one bare number per line, unsorted
  grep -hoE "$LESSON_DECL_RE" "$@" 2>/dev/null | grep -oE 'L[0-9]+' | grep -oE '[0-9]+' || true
}

# The entries nothing here can read. Prints "file:line: text" for each, so the report can name what
# to go and fix rather than only that something is wrong (L11, L80).
# PROSE THAT BELONGS TO NO LESSON (claude-config#332).
#
# On 2026-09-07 the tail of an entry's citation was sitting loose at the top level of LESSONS.md,
# unindented, and had already been published, so both Macs carried it. Nothing reported it, and it
# masked a second divergence: report_pending_conflicts decides a set-aside copy is resolved by
# asking whether its WORDS appear anywhere in the live file, deliberately word level rather than
# line level (L278), and the stray paragraph supplied that match. The corrected text sat only in
# the conflict copy while the report said nothing. The corruption was its own alibi, so the fix is
# not a cleverer resolution check, it is a file that cannot supply a false match.
#
# A SECTION PREAMBLE is not a fault, and getting that wrong would have been worse than the defect:
# prose under a heading, before that section's first entry, is how both the file's own top note and
# the "Test speed" section are written. Measured against the real file before this shipped: 556
# entries, and top level prose in five places, of which one was a preamble. A rule that refused
# preambles would have refused every publish from either Mac for ever (L172, L147). So the counter
# resets at every heading: prose is prose until that section's first entry, and orphaned after it.
orphaned_lesson_prose(){   # $1 = tree to inspect -> "file:line:text"
  local f
  for f in $(top_files_in "$1"); do
    [ -f "$1/$f" ] || continue
    # The generated index is excluded by the same predicate its neighbour uses, for the same
    # reason: it is a rendering of these lessons rather than a place any of them live.
    lesson_source_file "$f" || continue
    awk -v file="$f" '
      /^## /                  { seen = 0; next }
      /^#/                    { next }
      /^[[:space:]]*$/        { next }
      /^- \*\*L[0-9]+\./      { seen = 1; next }
      /^[ \t]/                { next }
      seen == 1               { printf "%s:%d:%s\n", file, NR, substr($0, 1, 80) }
    ' "$1/$f" 2>/dev/null || true
  done
  return 0
}

malformed_lesson_entries(){   # $1 = tree to inspect
  local f line
  for f in $(top_files_in "$1"); do
    [ -f "$1/$f" ] || continue
    # The generated index is EXCLUDED, and by the predicate that already decides a file is derived
    # rather than by naming it a second time here. Its own entries are `- Lnnn.` with no bold,
    # which is exactly the shape refused here, because it is a RENDERING of these lessons rather
    # than a place any of them live. Without this the check is red on every machine for ever, about
    # a file nobody writes by hand.
    lesson_source_file "$f" || continue
    while IFS= read -r line; do
      [ -n "$line" ] || continue
      printf '%s:%s\n' "$f" "$line"
    done < <(grep -nE "$LESSON_DECL_RE" "$1/$f" 2>/dev/null | grep -vE "^[0-9]+:- \*\*L[0-9]+\." || true)
  done
  return 0
}

duplicate_lesson_numbers(){   # $1 = tree to inspect
  local f line
  for f in $(top_files_in "$1"); do
    [ -f "$1/$f" ] || continue
    lesson_source_file "$f" || continue
    # Counted from the numbers a file CLAIMS, not from the canonical entries alone, or two entries
    # sharing one number are a duplicate only while both happen to be written correctly, and the
    # pair that is hardest to notice is the pair the scan cannot see (claude-config#164).
    while IFS= read -r line; do
      [ -n "$line" ] || continue
      printf '%s: %s\n' "$f" "$line"
    done < <(lesson_numbers_in "$1/$f" | sed 's/^/L/' | sort | uniq -c \
             | awk '$1 > 1 { printf "%s used %s times\n", $2, $1 }')
  done
  return 0
}

# One past the highest number in use, never a gap: a skipped number was skipped
# deliberately (the audit's L6 was reviewed and rejected), so reusing it would
# resurrect a retired reference.
# ---- the lessons index (#63) ----
# LESSONS.md is 179 entries and about 116 KB, and CLAUDE.md used to import the whole of it into
# every session in every project. Each entry is written to be read closely, so the cost is attention
# spread across 179 of them as much as it is tokens. The session loads this index instead (the
# number, its section, and the rule sentence), and the full entry is read on demand.
#
# DERIVED from LESSONS.md on every send and every apply, never maintained beside it: a list kept by
# hand next to the thing it mirrors drifts the moment one of them is edited, and the drift is
# silent (L41). A hand edit here is therefore overwritten, which is the point.
LESSON_INDEX_FILE="LESSONS-INDEX.md"

# The file the index above is generated FROM. Named here so the merge recovery and the index
# generator cannot drift into two spellings of one path (L41).
LESSONS_FILE="LESSONS.md"

# Is this synced path a file whose CONTENT is a function of another file? Asked in one place, so
# the sites that have to know cannot drift into three different lists (L41). Two copies of a
# derived file are not two people's work in conflict: they are two correct renderings of two
# different inputs, and the input is what actually merges.
is_derived_rule_file(){   # $1 = path relative to the payload
  [ "${1:-}" = "$LESSON_INDEX_FILE" ]
}

lesson_index_body(){   # $1 = the full lessons file
  local n
  [ -f "$1" ] || return 0
  n="$(grep -c '^- \*\*L[0-9]\+\.' "$1" 2>/dev/null || true)"
  printf '# Lessons index (generated, do not edit)\n\n'
  printf 'One line per lesson: the rule itself, without the body or the provenance. Generated from\n'
  printf 'LESSONS.md, which is NOT loaded into the session. %s lessons.\n\n' "${n:-0}"
  printf 'To read one in full, with its evidence: `~/claude-config-sync/claude-sync lesson L174`, or\n'
  printf 'read the entry straight out of ~/.claude/LESSONS.md. Do that whenever a rule below is about\n'
  printf 'to decide something: the body is where the failure it came from is described.\n'
  # The whole file is read into an array first, rather than walked with getline. getline CONSUMES
  # the line it reads, so a continuation loop had no way to put back a line that turned out to
  # start the NEXT entry, and an entry whose bold marker never closes therefore swallowed every
  # entry after it until one happened to contain a `**` (claude-config#194). With the lines in
  # hand the loop can simply stop at a boundary and the next entry is still there to be rendered.
  awk '
    { line[NR] = $0 }
    END {
      for (i = 1; i <= NR; i++) {
        if (line[i] ~ /^## /) { section = substr(line[i], 4); continue }
        if (line[i] !~ /^- \*\*L[0-9]+\./) continue
        rest = substr(line[i], index(line[i], "- **") + 4)
        # The rule sentence is bold and routinely wraps onto later lines, so read on until it
        # closes. Bounded by the three things that can only be the start of something else.
        j = i
        while (index(rest, "**") == 0 && j < NR) {
          nxt = line[j + 1]
          if (nxt ~ /^- \*\*L[0-9]+\./ || nxt ~ /^## / || nxt ~ /^[[:space:]]*$/) break
          # Stripped and then joined with ONE space, unconditionally. Replacing the leading
          # whitespace with a space did the right thing for an INDENTED continuation and nothing
          # at all for an unindented one, which then joined with no separator: L517 shipped into
          # the generated index reading "across everycombination of inputs" (claude-config#192).
          # This does not depend on every future author indenting their wraps correctly.
          sub(/^[[:space:]]+/, "", nxt)
          rest = rest " " nxt
          j++
        }
        end = index(rest, "**")
        rule = (end > 0) ? substr(rest, 1, end - 1) : rest
        gsub(/[[:space:]]+/, " ", rule)
        sub(/[[:space:]]+$/, "", rule)
        if (section != lastsec) { printf "\n## %s\n\n", section; lastsec = section }
        printf "- %s\n", rule
      }
    }
  ' "$1"
  return 0
}

# The lesson numbers a file renders in each of the two canonical shapes. Two one line helpers
# rather than the pattern written out at each call site, so the pair the check below compares
# cannot drift into asking two different questions (L107, L41).
canonical_lesson_numbers(){ grep -hoE '^- \*\*L[0-9]+\.' "$@" 2>/dev/null | grep -oE '[0-9]+' | sort -u -n || true; }
index_lesson_numbers(){     grep -hoE '^- L[0-9]+\.'      "$@" 2>/dev/null | grep -oE '[0-9]+' | sort -u -n || true; }

# Do the index and the lessons file beside it actually agree? Every failure path in
# write_lesson_index returns 0 in silence, so a generation that failed, truncated, or could not
# write left whatever stale index was already on disk and every session went on loading it. A
# stale index and a correct one look identical to a reader (L98).
#
# It reads the two FILES rather than checking inside the writer, because a check that lives only
# in the writer cannot see an index that was right when written and has gone stale since (L225).
# Silent when they agree: a warning printed on every run is one nobody reads (L36).
verify_lesson_index(){   # $1 = tree holding LESSONS.md and the index
  local src="$1/LESSONS.md" idx="$1/$LESSON_INDEX_FILE" missing extra
  [ -f "$src" ] || return 0
  if [ ! -f "$idx" ]; then
    echo "claude-sync: $1/LESSONS.md is here but $LESSON_INDEX_FILE is not, so every session in every project is loading no lessons index at all. Nothing here could write it; check the permissions on $1." >&2
    return 1
  fi
  missing="$(comm -23 <(canonical_lesson_numbers "$src") <(index_lesson_numbers "$idx") | sed 's/^/L/' | tr '\n' ' ')"
  extra="$(comm -13 <(canonical_lesson_numbers "$src") <(index_lesson_numbers "$idx") | sed 's/^/L/' | tr '\n' ' ')"
  [ -z "$missing" ] && [ -z "$extra" ] && return 0
  # Both faults are reported, never as an else-if: a truncated rewrite commits the two at once,
  # and dying at the first sends somebody back for a second run to discover the second (L11).
  echo "claude-sync: $LESSON_INDEX_FILE does not match the LESSONS.md beside it in $1, so the index every session loads is not what the lessons file says.${missing:+ Missing from the index: $missing.}${extra:+ In the index but not in LESSONS.md: $extra.} Nothing was reverted; the next run regenerates it, and if this repeats the index is not writable." >&2
  notify "$LESSON_INDEX_FILE disagrees with LESSONS.md"
  return 1
}

# Writes the index beside the lessons file, and ONLY when it differs. CLAUDE.md and everything it
# imports are watched, so rewriting one on every sync would re-trigger the watcher for ever.
# Where an unreadable lesson entry IS, not where it is presumed to have come from
# (claude-config#248). The message used to say "a lesson entry that ARRIVED is not written as
# ...", and the comment above it stated the assumption outright: "this is the path such an entry
# actually arrives on, since the other Mac is where somebody wrote it". On 2026-08-31 a pull on
# Dans-MacBook-Pro reported L530 that way, and git history shows L530 was never in the shared
# payload: it was written on that Mac and had been held back unsent. Anyone acting on the message
# goes and investigates a Mac that had nothing wrong with it.
#
# The payload is the copy the other Mac published, so an entry present there arrived and an entry
# absent from it was written here. That is a fact this can READ rather than presume.
#
# Called from write_lesson_index, which is the one place that runs whenever the lessons file is
# next looked at on either path, so a locally written entry is reported within seconds of the
# watcher's next send rather than at the next pull somebody happens to run (claude-config#249).
# Once per run, because the send falls through to a reconcile and would otherwise say it twice.
MALFORMED_LESSONS_REPORTED=0
report_malformed_lessons(){   # $1 = tree holding LESSONS.md
  local bad payload_bad ptexts line txt arrived="" local_only=""
  [ "${MALFORMED_LESSONS_REPORTED:-0}" = "1" ] && return 0
  bad="$(malformed_lesson_entries "$1")"
  is_blank "$bad" && return 0
  MALFORMED_LESSONS_REPORTED=1
  payload_bad="$(malformed_lesson_entries "$PAYLOAD" 2>/dev/null || true)"
  # Matched on the entry's TEXT, not on "file:line:text": a line number that differs between the
  # two copies is not evidence about where the entry came from, and the two files routinely differ
  # in length.
  ptexts="$(printf '%s\n' "$payload_bad" | cut -d: -f3-)"
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    txt="$(printf '%s' "$line" | cut -d: -f3-)"
    case "
$ptexts" in
      *"
$txt"*) arrived="${arrived:+$arrived; }$line" ;;
      *)      local_only="${local_only:+$local_only; }$line" ;;
    esac
  done <<MALFORMED
$bad
MALFORMED
  # BOTH are reported, never as an else-if: one file routinely commits the two at once, and dying
  # at the first sends somebody back for a second run to discover the second (L11).
  if [ -n "$local_only" ]; then
    echo "claude-sync: these lesson entries were WRITTEN ON THIS MAC and are not written as '- **Lnnn. ...', so nothing here can read them: not the $LESSON_INDEX_FILE index that loads into every session in every project, not 'claude-sync lesson', not the duplicate check, and not the number minter. $local_only. Rewrite each one to start with '- **L<number>. ' and it becomes visible to all four; until then that file is held back from the next send." >&2
    notify "unreadable lesson entry written on this Mac"
  fi
  if [ -n "$arrived" ]; then
    echo "claude-sync: these lesson entries ARRIVED with the payload and are not written as '- **Lnnn. ...', so nothing here can read them: not the $LESSON_INDEX_FILE index that loads into every session in every project, not 'claude-sync lesson', not the duplicate check, and not the number minter. $arrived. They were written on the other Mac, so the fix belongs there; rewriting them here works too and publishes on the next send." >&2
    notify "unreadable lesson entry arrived on this Mac"
  fi
  return 0
}

# The derived index must never be COMBINED by git (claude-config#200).
#
# LESSONS-INDEX.md is generated from LESSONS.md and regenerated on every send and every apply, and
# the apply already knows it is derived and skips it. The git layer did not: the file is committed,
# so git combined it as though somebody maintained it by hand, and any two sided lesson addition
# stopped the rebase on a content conflict. The header line carries a count that both Macs rewrite,
# so this is guaranteed rather than occasional, and it landed the operator in a by-hand recovery
# that means nothing to somebody who does not live in a terminal (2026-08-29, L265 to L269 here
# against L522 and L523 there).
#
# Written to .git/info/attributes rather than to a committed .gitattributes, so it is in force on
# the FIRST run on a clone rather than only once the file has arrived, which is the run where the
# conflict would otherwise happen. It is per clone and never travels, so both Macs get it from
# here.
#
# SYNC_DERIVED_MERGE_RULE=0 turns this off. Not a convenience: it is the only way to reach the
# RECOVERY below it, because when this works there is no conflict for the recovery to handle, and a
# recovery nobody can exercise is a branch that ships untested (L142, L535).
ensure_derived_file_merge_rule(){
  local info rule
  [ "${SYNC_DERIVED_MERGE_RULE:-1}" = "0" ] && return 0
  [ -d "$SYNC_REPO" ] || return 0
  git -C "$SYNC_REPO" rev-parse --git-dir >/dev/null 2>&1 || return 0
  # `true` as the driver keeps whichever side is checked out and exits 0, so git never stops. What
  # it keeps does not matter: the file is regenerated from the merged lessons a few steps later.
  git -C "$SYNC_REPO" config merge.ours.driver true >/dev/null 2>&1 || true
  info="$(git -C "$SYNC_REPO" rev-parse --absolute-git-dir 2>/dev/null || printf '%s' "$SYNC_REPO/.git")/info"
  mkdir -p "$info" 2>/dev/null || return 0
  rule="payload/$LESSON_INDEX_FILE merge=ours"
  [ -f "$info/attributes" ] && grep -qF -- "$rule" "$info/attributes" 2>/dev/null && return 0
  printf '%s\n' "$rule" >> "$info/attributes" 2>/dev/null || true
  return 0
}

# TWO MACS APPENDING TO ONE SECTION OF THE LESSONS FILE (claude-config#315).
#
# On 2026-09-04 L396 was appended at the end of "Proof over green" on one Mac and L588 at the end of
# the same section on the other. Git reported a content conflict on payload/LESSONS.md and the sync
# died telling Dan to reconcile by hand, which is not something he can act on. Two appended entries
# carrying DIFFERENT numbers never contradict each other, so the right merge is to keep both.
#
# ---- why this is not a git merge driver ----
#
# The obvious shape is a union merge rule in .git/info/attributes beside the `ours` rule for the
# derived index. It was rejected, and the reason is the gate rather than the plumbing: a rule that
# resolves the file INSIDE the rebase resolves it before anything can look at the result, so the
# one case that must stop the sync, both Macs using one number for different entries, would be
# committed and pushed as two entries under that number. Nothing downstream can read those apart,
# and the stage time duplicate check cannot help because by then the commit exists. Resolving in
# the recovery keeps the union and the refusal in the same place, at the moment the rebase can
# still be abandoned. It also needs no per clone config and no path to this script, so it is in
# force on a clone that has never run it and under every rebase backend (L173).
#
# Returns 0 when the union was written, 1 when it could not be produced at all, and 2 when the two
# sides genuinely clash on a number. Those are three different outcomes needing three different
# messages, so they are three different answers rather than one failure (L11).
LESSON_UNION_CLASH=""
lesson_union_merge(){   # $1 = base  $2 = ours  $3 = theirs  $4 = where the result is written
  local base="$1" ours="$2" theirs="$3" dest="$4" raw out rc=1 mine dups pre fresh lost
  LESSON_UNION_CLASH=""
  [ -f "$ours" ] && [ -f "$theirs" ] || return 1
  [ -f "$base" ] || return 1
  raw="$(scratch_file)"
  # --union keeps both sides of every conflicted hunk and never writes a marker, so this cannot
  # leave the file in a state that loads as rules.
  git merge-file --union -q -p "$ours" "$base" "$theirs" > "$raw" 2>/dev/null || { rm -f "$raw"; return 1; }
  [ -s "$raw" ] || { rm -f "$raw"; return 1; }
  out="$(scratch_file)"
  # An entry BOTH Macs wrote IDENTICALLY is one entry written twice, not two. The union keeps the
  # line from each side, and keeping both would publish a duplicate number over text nobody
  # disagrees about. Matched on the whole line, so two entries that merely share a number are left
  # alone and reach the refusal below, which is where they belong.
  if ! awk '!/^- \*\*L[0-9]+\./ || !seen[$0]++' "$raw" > "$out" 2>/dev/null; then
    rm -f "$raw" "$out"; return 1
  fi
  rm -f "$raw"
  # A number used twice in the result, that was not ALREADY used twice on one of the sides. A
  # pre-existing duplicate is a fault in a file this run never touched, and refusing it here would
  # block every sync until somebody fixed it, which is a different remedy for a different problem
  # (L324).
  dups="$(lesson_numbers_in "$out" | sort | uniq -d || true)"
  pre="$( { lesson_numbers_in "$ours" | sort | uniq -d; lesson_numbers_in "$theirs" | sort | uniq -d; } | sort -u || true)"
  fresh="$(comm -23 <(printf '%s\n' "$dups" | grep -E '^[0-9]+$' | sort -u || true) \
                    <(printf '%s\n' "$pre"  | grep -E '^[0-9]+$' | sort -u || true) || true)"
  if [ -n "$fresh" ]; then
    LESSON_UNION_CLASH="$(printf '%s\n' "$fresh" | sed 's/^/L/' | tr '\n' ' ' | sed 's/ $//')"
    rm -f "$out"; return 2
  fi
  # NOTHING MAY BE LOST. Every check above asks whether the result holds too much; this is the one
  # that asks whether it holds too little, and a dropped entry is the worse failure and the only
  # one the others cannot see (L283).
  mine="$(scratch_file)"
  { lesson_numbers_in "$ours"; lesson_numbers_in "$theirs"; } | sort -u > "$mine"
  lost="$(comm -23 "$mine" <(lesson_numbers_in "$out" | sort -u) || true)"
  rm -f "$mine"
  if [ -n "$lost" ]; then rm -f "$out"; return 1; fi
  cat "$out" > "$dest" 2>/dev/null && rc=0
  rm -f "$out"
  return "$rc"
}

# One conflicted path's three sides, as git holds them mid rebase. Stage 1 is the common ancestor,
# 2 is what the branch being rebased onto has, 3 is the commit being replayed. Which of 2 and 3 is
# "this Mac" changes with the direction of the rebase and does not matter to a union.
lesson_stage_file(){   # $1 = the conflicted path  $2 = the stage number -> prints a scratch file
  local out; out="$(scratch_file)"
  git -C "$SYNC_REPO" show ":$2:$1" > "$out" 2>/dev/null || : > "$out"
  printf '%s' "$out"
}

# The lessons file, resolved from those three sides. Same three answers as lesson_union_merge.
resolve_lessons_conflict(){
  local b o t rc
  b="$(lesson_stage_file "payload/$LESSONS_FILE" 1)"
  o="$(lesson_stage_file "payload/$LESSONS_FILE" 2)"
  t="$(lesson_stage_file "payload/$LESSONS_FILE" 3)"
  rc=0; lesson_union_merge "$b" "$o" "$t" "$PAYLOAD/$LESSONS_FILE" || rc=$?
  rm -f "$b" "$o" "$t"
  return "$rc"
}

# THE RECOVERY, for when the rule above did not prevent the conflict (claude-config#282).
#
# `ensure_derived_file_merge_rule` writes to `.git/info/attributes`, which is PER CLONE and never
# travels, so it is absent on a clone that has not yet run a version of this tool that writes it,
# and it is not consulted by every rebase backend git has. On 2026-09-03 the conflict happened
# anyway: five new lessons on one Mac against twenty commits on the other, `payload/LESSONS.md`
# merged cleanly, and `payload/LESSONS-INDEX.md` was the only conflicted path, purely on the count
# line in its header. The sync died telling Dan to reconcile by hand, which is not something he can
# act on, and the sync stayed blocked until somebody drove git by hand.
#
# There is nothing to reconcile about two correct renderings of two different inputs. The input
# merged; the rendering is regenerated from it. So when EVERY conflicted path is a derived file,
# each is rebuilt from its source, staged, and the rebase continued.
#
# THE STAND DOWN IS NO BROADER THAN THE REASON (L324): one conflicted path that nobody generates
# and this does nothing, because continuing then would commit whichever side git happened to leave
# in the tree. It also refuses when git reports NO conflicted path at all, because a rebase stopped
# for some other reason is not this, and treating it as this would continue through something
# nobody has looked at (L98).
#
# It LOOPS, because a rebase replays one commit at a time and can stop on the next one for the same
# reason. Bounded, because an unbounded loop around a command that can keep failing is a hang, and
# a hang is worse than a failure (L110).
resolve_derived_conflicts(){   # -> 0 carried through, 1 not this, 2 a real lesson number clash
  local i=0 paths p rel handled any=0 lessons rc unioned=0 derived=0
  while [ "$i" -lt 100 ]; do
    i=$(( i + 1 ))
    paths="$(git -C "$SYNC_REPO" diff --name-only --diff-filter=U 2>/dev/null)"
    # No conflicted path means either the rebase is finished or it stopped for a reason this
    # cannot see. `rebase --continue` decides which, and a rebase that is already done is not
    # still in progress, so the loop ends either way.
    if [ -z "$paths" ]; then
      [ "$any" -eq 1 ] || return 1
      git -C "$SYNC_REPO" rev-parse --absolute-git-dir >/dev/null 2>&1 || return 1
      break
    fi
    handled=0; lessons=0
    while IFS= read -r p; do
      [ -n "$p" ] || continue
      rel="${p#payload/}"
      # A path outside payload/ is not a synced rule file at all, and is_derived_rule_file would
      # be answering about a name it never meant. Refuse rather than guess.
      [ "$rel" = "$p" ] && return 1
      if is_derived_rule_file "$rel"; then handled=$(( handled + 1 )); derived=1; continue; fi
      # The lessons file itself, which is a SOURCE and used to be refused here (claude-config#315).
      # Two appended entries never contradict each other, so the sides are combined; a genuine
      # clash on a number is answered separately below and stops the sync.
      if [ "$rel" = "$LESSONS_FILE" ]; then handled=$(( handled + 1 )); lessons=1; continue; fi
      return 1
    done <<DERIVED_PATHS
$paths
DERIVED_PATHS
    [ "$handled" -gt 0 ] || return 1
    # The lessons file FIRST, because the index below is regenerated from whatever it ends up
    # holding, so resolving them the other way round would render the unmerged copy.
    if [ "$lessons" -eq 1 ]; then
      rc=0; resolve_lessons_conflict || rc=$?
      # 2 travels all the way out unchanged. It is the one outcome the caller must NOT report as a
      # failure to auto-merge, because the remedy is a renumber rather than a reconcile (L11).
      [ "$rc" -eq 2 ] && return 2
      [ "$rc" -eq 0 ] || return 1
      unioned=1
    fi
    # Rebuilt from the source sitting beside it in the working tree, which is the MERGED one:
    # either LESSONS.md combined cleanly by git, or it was just combined above.
    regenerate_payload_index_from_worktree || return 1
    # STAGED EXPLICITLY, not left to appear in the conflicted list (claude-config#329). The
    # `merge=ours` rule a few functions up means git resolves the index ITSELF and never reports it
    # as conflicted, so it is not among the paths staged below. Regenerating it then leaves a
    # modified file nothing has added, and `rebase --continue` refuses the whole rebase with "You
    # must edit all merge conflicts". Measured 2026-09-07 against a repository built the same way:
    # with the rule on, only the lessons file comes back unmerged, and an unstaged change to the
    # auto resolved one is enough for git to refuse. On Dans-MacBook-Pro that left the clone mid
    # rebase for about four hours, eight commits behind, unable to send or receive, until somebody
    # ran git add by hand. The two fixes each worked alone and cancelled each other combined, which
    # is why the rule being on is the case that has to be tested.
    git -C "$SYNC_REPO" add -- "payload/$LESSON_INDEX_FILE" >/dev/null 2>&1 || true
    while IFS= read -r p; do
      [ -n "$p" ] || continue
      git -C "$SYNC_REPO" add -- "$p" >/dev/null 2>&1 || return 1
    done <<DERIVED_ADD
$paths
DERIVED_ADD
    any=1
    # GIT_EDITOR=true, or a continue that wants a commit message opens an editor nobody is sitting
    # at and the daemon hangs on it.
    if GIT_EDITOR=true git -C "$SYNC_REPO" "${SYNC_GIT_IDENTITY[@]}" rebase --continue >/dev/null 2>&1; then
      # Finished, unless it stopped again, which the next turn of the loop finds out.
      git -C "$SYNC_REPO" rev-parse --verify -q REBASE_HEAD >/dev/null 2>&1 || break
    else
      # A REFUSED continue is a failure, not something to go round again (claude-config#329). The
      # loop used to ignore the exit code and fall through to `any=1`, so a rebase that never
      # finished was reported as a recovery that worked, and the clone was left mid rebase while
      # the sync said it had completed. Judge it by its exit code, never by having reached the end
      # of the loop (L184).
      return 1
    fi
  done
  [ "$any" -eq 1 ] || return 1
  # Said out loud, and the two causes said SEPARATELY. A run that recovered and one that never
  # conflicted would otherwise read the same, and a run that combined two Macs' lesson entries is
  # different news from one that merely re-rendered an index (L11, L98).
  if [ "$unioned" -eq 1 ]; then
    echo "claude-sync: both Macs added lesson entries to the same part of $LESSONS_FILE. Entries with different numbers never contradict each other, so the merge kept both and the sync carried on. Nothing needs reconciling."
  fi
  # Only when the index was ACTUALLY one of the conflicted paths. Saying it whenever this function
  # ran would be a claim about a file git never stopped on, on the very run where the news is that
  # something else did (L11).
  if [ "$derived" -eq 1 ]; then
    echo "claude-sync: both Macs changed $LESSON_INDEX_FILE, which is generated from LESSONS.md rather than written by hand, so it was regenerated from the merged lessons and the sync carried on. Nothing needs reconciling."
  fi
  return 0
}

# The same rebuild as regenerate_payload_index, without its publish time assertions, because this
# runs MID REBASE where the working tree is a half applied state and the counts are checked once at
# the end by regenerate_payload_index itself.
regenerate_payload_index_from_worktree(){
  local src="$PAYLOAD/LESSONS.md" out
  [ -f "$src" ] || return 1
  out="$(scratch_file)"
  lesson_index_body "$src" > "$out" 2>/dev/null || { rm -f "$out"; return 1; }
  [ -s "$out" ] || { rm -f "$out"; return 1; }
  cat "$out" > "$PAYLOAD/$LESSON_INDEX_FILE" 2>/dev/null || { rm -f "$out"; return 1; }
  rm -f "$out"
  return 0
}

# The index in the REPO, rebuilt from whatever the merge produced (claude-config#200). Both Macs
# publish this file, and after a rebase the copy sitting in the payload is one side's rendering of
# a lessons file that no longer exists. Regenerating is the whole point of a derived file.
regenerate_payload_index(){
  local src="$PAYLOAD/LESSONS.md" out nl ni
  [ -f "$src" ] || return 0
  out="$(scratch_file)"
  lesson_index_body "$src" > "$out" 2>/dev/null || { rm -f "$out"; return 0; }
  [ -s "$out" ] || { rm -f "$out"; return 0; }
  cmp -s "$out" "$PAYLOAD/$LESSON_INDEX_FILE" || cat "$out" > "$PAYLOAD/$LESSON_INDEX_FILE" 2>/dev/null || true
  rm -f "$out"
  # ASSERTED before it is published, not hoped for. A generator that half ran would otherwise send
  # the other Mac an index describing a different lessons file, and the index is what every session
  # in every project actually loads (L98).
  nl="$(lesson_numbers_in "$src" | sort -u | grep -c . || true)"
  ni="$(lesson_numbers_in "$PAYLOAD/$LESSON_INDEX_FILE" | sort -u | grep -c . || true)"
  # ZERO is refused before the two are compared. Both counts come from the same reader, so a reader
  # that failed returns zero on both sides, they agree, and the check passes on the permissive side
  # having measured nothing (L50, L98). A lessons file with no readable entry is not a state to
  # publish an index for.
  case "${nl:-}" in ''|*[!0-9]*) nl=0 ;; esac
  case "${ni:-}" in ''|*[!0-9]*) ni=0 ;; esac
  if [ "$nl" -eq 0 ]; then
    die "no readable lesson entry was found in $src after the merge, so the index cannot be rebuilt from it and nothing has been published. Look at that file."
  fi
  if [ "$nl" != "$ni" ]; then
    die "the lessons index regenerated after the merge lists $ni entries while the LESSONS.md beside it holds $nl. Nothing has been published. Run 'claude-sync status' and look at $PAYLOAD/$LESSON_INDEX_FILE."
  fi
  return 0
}

write_lesson_index(){   # $1 = tree holding LESSONS.md
  local src="$1/LESSONS.md" out
  [ -f "$src" ] || return 0
  out="$(scratch_file)"
  lesson_index_body "$src" > "$out" 2>/dev/null || { rm -f "$out"; return 0; }
  [ -s "$out" ] || { rm -f "$out"; return 0; }
  if ! cmp -s "$out" "$1/$LESSON_INDEX_FILE"; then cat "$out" > "$1/$LESSON_INDEX_FILE" 2>/dev/null || true; fi
  rm -f "$out"
  # Checked against what is actually on disk afterwards, which is the point: every path above
  # returns 0 whether it wrote anything or not, and the write itself can fail (#195).
  verify_lesson_index "$1" || true
  # An entry nothing can read is an entry the index above could not carry, so this is where the
  # omission actually happens and where it is worth saying (claude-config#249).
  report_malformed_lessons "$1"
  return 0
}

# THE IDENTITY OF A LESSON, which the number is only a display of (claude-config#199).
#
# Both Macs mint numbers from their own band and a collision still happened: each had used L521 for
# a different entry, and the pull renumbered this Mac's unsent one to L523. The tool's own message
# names the risk it cannot fix, that something already refers to the number that moved, and numbers
# ARE referred to: ~/.claude/CLAUDE.md points at L174 as its worked example, the generated index is
# built on them, and `claude-sync lesson L<n>` resolves by one.
#
# The identity is DERIVED from the lesson's own rule sentence rather than stored anywhere, so there
# is no registry for two Macs to disagree about and no state a merge can lose. A renumber does not
# touch the rule text, so the id survives it; editing the rule text changes the id, which is
# correct, because that is the lesson itself changing rather than its presentation.
lesson_rule_text(){   # $1 = lessons file  $2 = number, e.g. L174 -> the rule sentence, one line
  # The rule runs to the closing `**`, which is usually SEVERAL lines down: almost every entry in
  # the real file wraps. Reading only the first line would give two entries whose openings happen
  # to match the same id, and would move an id whenever a line was re-wrapped.
  awk -v want="$2" '
    $0 ~ ("^- \\*\\*" want "\\.") {
      buf = $0
      sub("^- \\*\\*" want "\\. *", "", buf)
      while (buf !~ /\*\*/) {
        if ((getline nxt) <= 0) break
        sub(/^[[:space:]]+/, " ", nxt)
        buf = buf nxt
      }
      sub(/\*\*.*$/, "", buf)
      print buf
      exit
    }
  ' "$1" 2>/dev/null
}

# Whitespace is collapsed first, so a lesson re-wrapped to a different line width keeps its id: the
# words are the lesson and the wrapping is not (L278).
lesson_id_of_text(){   # rule text on stdin -> a short stable id
  tr -s '[:space:]' ' ' | sed -e 's/^ //' -e 's/ $//' \
    | { shasum -a 256 2>/dev/null || sha256sum 2>/dev/null; } \
    | awk '{ print substr($1, 1, 10) }'
}

lesson_id(){   # $1 = lessons file  $2 = number -> the id, or nothing when there is no such entry
  local text; text="$(lesson_rule_text "$1" "$2")"
  [ -n "$text" ] || return 1
  printf '%s' "$text" | lesson_id_of_text
}

# The number a given id currently sits at. Every entry is hashed rather than a registry consulted,
# because a registry is state two Macs can disagree about and this is a pure function of the file.
lesson_number_for_id(){   # $1 = lessons file  $2 = id -> the number, or nothing
  local n
  while IFS= read -r n; do
    [ -n "$n" ] || continue
    if [ "$(lesson_id "$1" "L$n")" = "$2" ]; then printf 'L%s' "$n"; return 0; fi
  done < <(lesson_numbers_in "$1" | sort -un)
  return 1
}

# One entry, in full, with its provenance: what the index sends you to.
do_lesson(){   # $1 = a number (L174) or an id, which survives a renumber
  local num="${1:-}" src out
  src="$CLAUDE_HOME/LESSONS.md"
  [ -f "$src" ] || die "no LESSONS.md at $src, so nothing can be looked up."
  case "$num" in
    L[0-9]*) : ;;
    # An ID is what somebody quoting a lesson somewhere this tool cannot reach should write down,
    # because it is the one reference a renumber cannot invalidate (claude-config#199).
    [0-9a-f][0-9a-f][0-9a-f][0-9a-f]*)
      local found; found="$(lesson_number_for_id "$src" "$num")"
      [ -n "$found" ] || die "no lesson in $src has the id '$num'. Ids are printed beside the number by 'claude-sync lesson'."
      num="$found" ;;
    *) die "lesson needs a number, e.g. lesson L174, or an id (got '${num:-<nothing>}')" ;;
  esac
  out="$(awk -v want="$num" '
    $0 ~ ("^- \\*\\*" want "\\.") { printing = 1; print; next }
    printing && /^- \*\*L[0-9]+\./ { exit }
    printing && /^## / { exit }
    printing { print }
  ' "$src")"
  # An empty answer is a REFUSAL, not a lesson with nothing in it: printing nothing and exiting 0
  # would read exactly like a lesson that says nothing (L98).
  if is_blank "$out"; then
    # Not found in the canonical form is not the same fact as not present, and answering the second
    # when the first is what happened is how the state in claude-config#164 stayed believable:
    # three tools agreed the number was free, and the one that could have contradicted them said
    # the entry did not exist while the file plainly held it (L11).
    local unreadable; unreadable="$(malformed_lesson_entries "$CLAUDE_HOME" | grep -E "(^|:)[[:blank:]#*+-]*(\*\*)?${num}\." || true)"
    if ! is_blank "$unreadable"; then
      die "$num is in $src but not written as '- **$num. ...', so nothing here can read it: $(printf '%s' "$unreadable" | tr '\n' ';' | sed 's/;$//'). Rewrite it to start with '- **$num. ' and it becomes readable."
    fi
    die "$num is not in $src. 'claude-sync next-lesson' prints the next free number if you are adding one."
  fi
  # The id is printed WITH the entry, so the stable reference is in front of whoever is reading it
  # rather than in a document they would have to know about (claude-config#199).
  printf 'id: %s (this survives a renumber; %s may not)\n' "$(lesson_id "$src" "$num")" "$num"
  printf '%s\n' "$out"
  return 0
}

# ---- lesson number bands (#44) ----
# Both Macs used to allocate the next free number from their own copy of the rules, so any two
# lessons written between syncs claimed the same number by construction. It happened on 2026-07-29
# (four renumbers) and again on 2026-08-17 (three). The merge settles it and loses no text, but a
# renumber leaves references nothing local can reach: a number quoted in a filed issue, in a PR
# comment, or on a line the other Mac has already published stays pointing at whichever entry kept
# the number.
#
# So each Mac owns a band and mints only inside it. One file per Mac, named after the Mac, holding
# the first number of its band: one file per writer means two Macs can never edit the same file, so
# a claim can never produce a merge conflict of its own.
LESSON_BAND_SIZE="${SYNC_LESSON_BAND_SIZE:-500}"

# Every band any Mac has claimed, as "host<TAB>start". A file that does not hold a number is
# skipped rather than read as zero: a zero would look like a legitimate band below everyone else's
# and quietly hand this Mac numbers another Mac is already using (L50).
lesson_bands(){
  local f v
  [ -d "$LESSON_BANDS_DIR" ] || return 0
  for f in "$LESSON_BANDS_DIR"/*; do
    [ -f "$f" ] || continue
    v="$(tr -dc '0-9' < "$f" 2>/dev/null || true)"
    [ -n "$v" ] || continue
    printf '%s\t%s\n' "${f##*/}" "$v"
  done
  return 0
}

recorded_lesson_band(){
  local f v
  f="$LESSON_BANDS_DIR/$(sync_hostname)"
  [ -f "$f" ] || return 0
  v="$(tr -dc '0-9' < "$f" 2>/dev/null || true)"
  printf '%s' "$v"
  return 0
}

# One band past the highest claimed, or the first band when none is. Bands are contiguous, so the
# numbers stay readable: 1 to 500, 501 to 1000, and so on.
next_free_band(){
  local h start highest=0
  while IFS="$(printf '\t')" read -r h start; do
    [ -n "${start:-}" ] || continue
    [ "$start" -gt "$highest" ] && highest="$start"
  done < <(lesson_bands)
  if [ "$highest" -eq 0 ]; then printf '1'; else printf '%s' "$((highest + LESSON_BAND_SIZE))"; fi
  return 0
}

# Any OTHER Mac holding the band this one holds, and sorting ahead of it by name. Two Macs can only
# land on one band by claiming while unable to see each other, and there is nobody to arbitrate, so
# the rule has to give the same answer run on either Mac: the lower name keeps the band and the
# other moves. One definition, used both to decide whether a write is needed and to do it.
colliding_band_holders(){   # $1 = this Mac's band
  local h start me
  me="$(sync_hostname)"
  while IFS="$(printf '\t')" read -r h start; do
    [ -n "${h:-}" ] || continue
    [ "$h" = "$me" ] && continue
    [ "${start:-}" = "$1" ] || continue
    [ "$h" \< "$me" ] || continue
    printf '%s\n' "$h"
  done < <(lesson_bands)
  return 0
}

# A band is worth nothing to the other Mac until it can see it, and only a commit carries it. This
# is one commit per Mac for the life of the repo, not a marker written on every apply, so it cannot
# start the republishing exchange that the design record rejects markers on the branch for.
record_lesson_band(){   # $1 = band start
  local host rel
  host="$(sync_hostname)"; rel="lesson-bands/$host"
  mkdir -p "$LESSON_BANDS_DIR"
  printf '%s\n' "$1" > "$LESSON_BANDS_DIR/$host"
  have_git || return 0
  git -C "$SYNC_REPO" rev-parse --git-dir >/dev/null 2>&1 || return 0
  git -C "$SYNC_REPO" add -- "$rel" >/dev/null 2>&1 || return 0
  git -C "$SYNC_REPO" diff --cached --quiet -- "$rel" 2>/dev/null && return 0
  git -C "$SYNC_REPO" "${SYNC_GIT_IDENTITY[@]}" commit -q -m "$host mints lesson numbers from $1" -- "$rel" >/dev/null 2>&1 || true
  return 0
}

# This Mac's band, claiming one if it has none and moving off a band another Mac holds. Prints the
# first number of the band.
lesson_band(){
  local host mine loser
  host="$(sync_hostname)"
  mine="$(recorded_lesson_band)"
  # A band file holding something that is not a number is NOT the same as having no band: reading
  # it as absent would quietly hand this Mac the whole range again, which is the very collision
  # this exists to prevent, and nothing would say so (L50, L11).
  if [ -z "$mine" ] && [ -f "$LESSON_BANDS_DIR/$host" ]; then
    die "lesson-bands/$host holds no number, so which numbers belong to this Mac cannot be answered and minting one would risk taking a number the other Mac has already used. Put the band start back, or delete the file to claim a fresh band on the next run."
  fi
  if [ -z "$mine" ]; then
    mine="$(next_free_band)"
    record_lesson_band "$mine"
    echo "claude-sync: this Mac ($host) had no lesson number band, so it claimed $mine to $((mine + LESSON_BAND_SIZE - 1)) and every lesson written here now takes a number from it. Two Macs can then never mint the same number, however long they go without seeing each other." >&2
    LESSON_BAND="$mine"; return 0
  fi
  loser="$(colliding_band_holders "$mine" | awk 'NR <= 1')"
  if [ -n "$loser" ]; then
    local moved; moved="$(next_free_band)"
    record_lesson_band "$moved"
    echo "claude-sync: $loser already mints from band $mine, so this Mac ($host) moved to $moved to $((moved + LESSON_BAND_SIZE - 1)). Both Macs claimed while unable to see each other; whichever runs this next moves the same one, so they agree without talking." >&2
    notify "lesson band moved to $moved"
    mine="$moved"
  fi
  LESSON_BAND="$mine"
  return 0
}

# Claiming and moving both WRITE, so they are done while holding the lock. Reading is not, because
# a number is asked for while the watcher is syncing all the time, and a command that refuses for
# that reason is one nobody would use.
# Answers into LESSON_BAND rather than onto stdout, deliberately. Read through a command
# substitution, its refusal would die inside that subshell and the caller would carry on with an
# empty band, which is the whole range: the one outcome this must never reach (L50).
lesson_band_locked(){
  local mine
  mine="$(recorded_lesson_band)"
  if [ -n "$mine" ] && [ -z "$(colliding_band_holders "$mine")" ]; then LESSON_BAND="$mine"; return 0; fi
  with_lock lesson_band
}

# The highest number in use inside one band, or one below the band when it holds none.
highest_lesson_in_band(){   # $1 = band start  $2.. = files
  local band="$1"; shift
  local n highest=$((band - 1)) top=$((band + LESSON_BAND_SIZE - 1))
  while IFS= read -r n; do
    [ -n "$n" ] || continue
    [ "$n" -ge "$band" ] && [ "$n" -le "$top" ] && [ "$n" -gt "$highest" ] && highest="$n"
  done < <(lesson_numbers_in "$@")
  printf '%s' "$highest"
  return 0
}

next_lesson_number(){   # $1 = tree  $2 = this Mac's band, or empty for the whole range
  local f highest=0 n band="${2:-}" files=()
  for f in $(top_files_in "$1"); do
    [ -f "$1/$f" ] || continue
    # The generated index is skipped here too. It mirrors the numbers beside it, so including it
    # normally changes nothing, and the one time it differs is the time it is stale, which would
    # let a number no lesson holds any more decide what the next one is.
    lesson_source_file "$f" || continue
    files+=("$1/$f")
  done
  if [ -n "$band" ] && [ "${#files[@]}" -gt 0 ]; then
    highest="$(highest_lesson_in_band "$band" "${files[@]}")"
    if [ "$((highest + 1))" -gt "$((band + LESSON_BAND_SIZE - 1))" ]; then
      # Spilling into the next band would put the collisions back with nothing saying so, which is
      # the one failure this whole mechanism exists to prevent.
      die "this Mac's lesson band ($band to $((band + LESSON_BAND_SIZE - 1))) is full, so there is no number left to mint that another Mac could not also choose. Widen it with SYNC_LESSON_BAND_SIZE, or give this Mac a fresh band by editing lesson-bands/$(sync_hostname) in the sync repo."
    fi
    printf 'L%s\n' "$((highest + 1))"
    return 0
  fi
  [ -n "$band" ] && { printf 'L%s\n' "$band"; return 0; }
  for f in ${files[@]+"${files[@]}"}; do
    # The trailing "|| true" is load-bearing: under pipefail a grep that matches
    # nothing fails the whole substitution, and an assignment that fails is fatal
    # under set -e, so a rule file with no lessons in it aborted the command
    # outright and printed nothing at all.
    n="$(lesson_numbers_in "$f" | sort -n | tail -1 || true)"
    if [ -n "$n" ] && [ "$n" -gt "$highest" ]; then highest="$n"; fi
  done
  printf 'L%s\n' "$((highest + 1))"
}

# THE HOOKS BLOCK MERGE, in one place, used by both directions (claude-config#300).
#
# The rule: the result is PRIMARY, plus every entry in SECONDARY that is in neither primary nor
# BASE. An entry missing from primary but present in base was deliberately removed and stays
# removed; one missing from both is something the other side has not seen yet and is kept.
#
# It was written once, for the apply, in claude-config#13, because replacing the block wholesale
# silently unregistered a hook added here since the last send. The send did the mirror image of
# that and nobody had written the rule there: `stage_local_to_payload` rebuilt the payload's copy
# wholesale from ~/.claude/settings.json, and it runs BEFORE the apply, so anything the payload
# already held that this Mac had not applied was destroyed. Traced in the history on 2026-09-03:
# eb6ce56 registered payload-revert-warning.sh and f0cd3c7, a sync commit, deleted exactly those
# five lines. The hook and its test both travelled; only the line that activates it was lost, so it
# shipped inert.
#
# Sharing the DATA while copying the code that applies it is not consolidation (L370), so this is
# the code, and both callers pass their own three arguments to it.
merge_hook_blocks(){   # $1 primary  $2 secondary  $3 base  -> the merged hooks object, or nothing
  jq -cn --argjson pri "$1" --argjson sec "$2" --argjson bas "$3" '
    def cmds($h): [ $h | to_entries[] | .value[]? | .hooks[]? | .command ];
    cmds($pri) as $priC
    | cmds($bas) as $basC
    | [ ($sec | to_entries[])
        | .key as $k
        | [ .value[]? | .hooks[]? | select( ([.command] - $priC - $basC) | length > 0 ) ]
        | select(length > 0) | {key: $k, keep: .} ] as $keeps
    | reduce $keeps[] as $e ($pri;
          if ((.[$e.key] // []) | length) > 0
            then .[$e.key] = (.[$e.key] | (.[0].hooks = ((.[0].hooks // []) + $e.keep)))
            else .[$e.key] = [ {hooks: $e.keep} ]
          end)
  ' 2>/dev/null
}

# The hooks block of the commit this Mac LAST APPLIED, which is the base both directions compare
# against. Without it there is no way to tell "the other Mac removed this" from "this Mac has not
# seen it yet", so an empty base means keep, in both directions.
last_applied_hook_block(){   # -> the hooks object of the last applied payload, or {}
  local last basefrag
  have_git || { printf '{}'; return 0; }
  last="$(cat "$LAST_APPLIED_FILE" 2>/dev/null || true)"
  [ -n "$last" ] || { printf '{}'; return 0; }
  basefrag="$(git -C "$SYNC_REPO" show "$last:payload/settings.hooks.json" 2>/dev/null | detok || true)"
  [ -n "$basefrag" ] || { printf '{}'; return 0; }
  printf '%s' "$basefrag" | jq -c '.hooks // {}' 2>/dev/null || printf '{}'
}

# copy local config -> repo payload (no git)
# A LEFTOVER COPY MUST NOT UNDO A DELETION (claude-config#331).
#
# stage_local_to_payload mirrors this Mac's ~/.claude over the payload, so an entry the shared
# config has deleted, but which is still sitting in this Mac's home, is re-added by the next send
# and the deletion is undone with nothing reporting it. Observed on 2026-09-07: a skill folder
# renamed on the other Mac came back three sends later as 96 lines of new file, and the two folders
# were then a loadable skill each with identical description frontmatter, so the assistant saw two
# skills competing for one job. The same route can resurrect a deliberately deleted hook or agent.
#
# Written against the STATE rather than against a sequence: the repo has deleted it, this Mac has
# recorded that it applied that, and the file is here anyway. That pair is what the production
# commit shows, and it is what a run that died between merging and applying leaves behind.
#
# Content decides. A leftover is the deleted copy byte for byte; a deliberate re-creation under the
# same name is different content and publishes normally, because a deletion must not become a
# permanent ban on a name (L116, L362).
refuse_resurrected_deletions(){
  local p delcommit restored="" removed="" lastdel=""
  have_git || return 0
  git -C "$SYNC_REPO" rev-parse --verify -q HEAD >/dev/null 2>&1 || return 0
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    # Has the shared repo ever DELETED this path? Asked of the whole history rather than of the
    # range since this Mac last applied, because the marker is routinely already up to date by the
    # time the leftover is noticed: the run that merged the deletion recorded it as applied, and
    # the file is still here. A range keyed on that marker is empty exactly when this is needed.
    # `-1` stops git at the most recent deletion, so this costs one walk per untracked file and
    # untracked files in the payload are rare.
    delcommit="$(git -C "$SYNC_REPO" log --format=%H --diff-filter=D -1 HEAD -- "$p" 2>/dev/null || true)"
    [ -n "$delcommit" ] || continue
    # And is it still deleted? A path deleted and later re-added deliberately is an ordinary file
    # again, and blocking it would make one old deletion a permanent ban on the name (L362).
    git -C "$SYNC_REPO" cat-file -e "HEAD:$p" 2>/dev/null && continue
    # The content the repo deleted, read from the commit before the one that removed it. If it
    # cannot be read the file is LEFT ALONE: refusing to publish on the strength of a comparison
    # that could not be made would discard somebody's work on a guess (L50).
    git -C "$SYNC_REPO" show "$delcommit^:$p" 2>/dev/null | cmp -s - "$SYNC_REPO/$p" 2>/dev/null || continue
    rm -f "$SYNC_REPO/$p" 2>/dev/null || true
    # The LOCAL copy goes too, which completes the deletion in one step and ends the matter. That
    # is a product decision and not one this tool got to pick, so it was put to Dan and it is his
    # (2026-09-07). What makes it safe is the byte for byte comparison above: this is the copy the
    # shared config deleted, unchanged, so nothing unique to this Mac is removed and git still
    # holds it in the commit the message names (L5, L9). SYNC_ACCEPT_DELETIONS=0 leaves it alone
    # for anybody who wants to decide file by file, and then the message is said once per file
    # rather than on every save, because the file stays and the watcher fires on every edit.
    if [ "${SYNC_ACCEPT_DELETIONS:-1}" != "0" ]; then
      rm -f "$CLAUDE_HOME/${p#payload/}" 2>/dev/null || true
      rmdir "$(dirname "$CLAUDE_HOME/${p#payload/}")" 2>/dev/null || true
      removed="${removed:+$removed }${p#payload/}"
    fi
    restored="${restored:+$restored }${p#payload/}"
    lastdel="$delcommit"
  done < <(git -C "$SYNC_REPO" ls-files --others --exclude-standard -- payload 2>/dev/null || true)
  [ -n "$restored" ] || return 0
  # Once per path, not on every edit. The watcher fires on every save and the file stays where it
  # is by default, so a message per send is the alert that gets ignored (L36). The record is keyed
  # on the path AND the content, so a file that CHANGES is a new decision and is reported again.
  local stamp fresh=""
  for p in $restored; do
    stamp="$(printf '%s %s' "$p" "$(shasum "$CLAUDE_HOME/$p" 2>/dev/null | awk 'NR==1{print $1}')")"
    grep -qxF -- "$stamp" "$RESURRECTED_REPORTED_FILE" 2>/dev/null && continue
    printf '%s\n' "$stamp" >> "$RESURRECTED_REPORTED_FILE" 2>/dev/null || true
    fresh="${fresh:+$fresh }$p"
  done
  if [ -n "$removed" ]; then
    echo "claude-sync: $removed was deleted from the shared config and this Mac still had that deleted copy unchanged, so it was NOT published back (that would undo the deletion for both Macs) and the local copy has been removed here too, which is what applying that deletion should have done. Set SYNC_ACCEPT_DELETIONS=0 if you would rather decide file by file. It is recoverable from ${lastdel:0:8}, the commit that removed it." >&2
  elif [ -n "$fresh" ]; then
    echo "claude-sync: $fresh was deleted from the shared config and this Mac still has that deleted copy unchanged, so it was NOT published back: publishing it would undo the deletion for both Macs. Your copy is untouched and nothing here will remove it. Delete it yourself to accept the deletion, or change it and it publishes as your own. It is in ${lastdel:0:8}, the commit that removed it, if you want it back. Said once per file rather than on every edit." >&2
  fi
  return 0
}

stage_local_to_payload(){
  [ -d "$CLAUDE_HOME" ] || die "no config dir at $CLAUDE_HOME"
  mkdir -p "$PAYLOAD"
  # -c is load-bearing, not a nicety. Without it rsync quick-checks on size plus
  # mtime at ONE-SECOND granularity, so a same-size edit (a one character fix in
  # a hook, a swapped word in CLAUDE.md) whose timestamp lands in the same second
  # as the last sync is skipped: rsync fixes the mode bit and leaves the OLD
  # content, and the edit silently never leaves this Mac. `status` already
  # documented this hazard; push and apply were still exposed to it.
  # Hold back the paths this Mac has not applied yet, per subtree (rsync excludes
  # are relative to the transfer root, and each mirror below has its own root).
  local protected; protected="$(unapplied_paths)"
  for d in "${MIRROR_DIRS[@]}" skills; do
    [ -d "$CLAUDE_HOME/$d" ] || continue
    local ex=() p
    if [ "$d" = skills ]; then
      local s; for s in $(skill_excludes); do ex+=("$s"); done
      REFUSED_SKILL_EXCLUDES=()
      refuse_unloadable_skills "$CLAUDE_HOME/skills" "sent"
      ex+=(${REFUSED_SKILL_EXCLUDES[@]+"${REFUSED_SKILL_EXCLUDES[@]}"})
    fi
    while IFS= read -r p; do
      case "$p" in "$d"/?*) ex+=(--exclude="/${p#"$d"/}") ;; esac
    done <<PROT
$protected
PROT
    mkdir -p "$PAYLOAD/$d"
    rsync -ac --delete "${COMMON_EXCLUDES[@]}" ${ex[@]+"${ex[@]}"} "$CLAUDE_HOME/$d/" "$PAYLOAD/$d/"
  done
  # hooks block of settings.json, with this Mac's home path tokenized, MERGED against what the
  # payload already holds rather than replacing it (claude-config#300). See merge_hook_blocks.
  if [ -f "$CLAUDE_HOME/settings.json" ]; then
    local _sh_local _sh_pay _sh_base _sh_merged
    _sh_local="$(jq -c '.hooks // {}' "$CLAUDE_HOME/settings.json" 2>/dev/null || true)"
    if [ -z "$_sh_local" ]; then
      # Not writing is the safe direction: a payload left as it is can still be published next
      # time, and one overwritten from an unreadable local file cannot be recovered (L5).
      echo "claude-sync: $CLAUDE_HOME/settings.json could not be read as JSON, so the hooks block was NOT published and the repo keeps the copy it had. Check it with 'jq . $CLAUDE_HOME/settings.json'." >&2
    else
      _sh_pay='{}'
      if [ -f "$PAYLOAD/settings.hooks.json" ]; then
        _sh_pay="$(detok < "$PAYLOAD/settings.hooks.json" | jq -c '.hooks // {}' 2>/dev/null || echo '{}')"
      fi
      _sh_base="$(last_applied_hook_block)"
      _sh_merged="$(merge_hook_blocks "$_sh_local" "$_sh_pay" "$_sh_base")"
      if [ -n "$_sh_merged" ]; then
        printf '%s' "$_sh_merged" | jq '{hooks: .}' | tok > "$PAYLOAD/settings.hooks.json"
      else
        echo "claude-sync: the hooks block could not be merged for publishing, so the repo keeps the copy it had and this Mac's hook changes have NOT been sent. Check $CLAUDE_HOME/settings.json and the payload's settings.hooks.json with jq." >&2
      fi
    fi
  fi
  # A rule file whose lesson numbers have collided is held back rather than
  # published, so the broken numbering does not spread to the other Mac. Only that
  # file waits: failing the whole send would stop hooks and skills moving between
  # Macs, which is the wedge this tool has already been bitten by twice.
  local dupfiles="" duplines="" badlines=""
  if [ "${SYNC_SKIP_LESSON_CHECK:-0}" != "1" ]; then
    # An entry nothing can read is held back for the same reason a collided number is: it is not
    # merely useless where it sits, it claims a number the other Mac's minter cannot see, so
    # sending it plants the collision there rather than here (claude-config#164). Same override,
    # same "only that file waits" rule, and reported separately from a duplicate because the two
    # need different fixes (L11).
    badlines="$(malformed_lesson_entries "$CLAUDE_HOME")"
    if ! is_blank "$badlines"; then
      dupfiles="$(printf '%s\n' "$badlines" | cut -d: -f1 | sort -u)"
      echo "claude-sync: NOT publishing $(printf '%s' "$dupfiles" | tr '\n' ' ')because it holds lesson entries not written as '- **Lnnn. ...', which nothing here can read: $(printf '%s' "$badlines" | tr '\n' ';' | sed 's/;$//'). Rewrite each one to start with '- **L<number>. ' and it publishes on the next send. Everything else synced normally. Override with SYNC_SKIP_LESSON_CHECK=1." >&2
      notify "held back $(printf '%s' "$dupfiles" | tr '\n' ' '): unreadable lesson entry"
    fi
    # The third fault of the same kind, held back the same way and reported separately, because a
    # stray paragraph, an unreadable entry and a collided number need three different fixes (L11).
    local orphlines; orphlines="$(orphaned_lesson_prose "$CLAUDE_HOME")"
    if ! is_blank "$orphlines"; then
      dupfiles="$(printf '%s\n%s\n' "$dupfiles" "$(printf '%s\n' "$orphlines" | cut -d: -f1)" | grep -v '^$' | sort -u)"
      echo "claude-sync: NOT publishing $(printf '%s' "$dupfiles" | tr '\n' ' ')because it holds text that belongs to no lesson: a non blank line at the top level, after a section has started, that is neither a heading nor an entry nor an indented continuation of one. $(printf '%s' "$orphlines" | tr '\n' ';' | sed 's/;$//'). Indent it under the entry it belongs to, or make it its own entry, and it publishes on the next send. Everything else synced normally. Override with SYNC_SKIP_LESSON_CHECK=1." >&2
      notify "held back $(printf '%s' "$dupfiles" | tr '\n' ' '): text belonging to no lesson"
    fi
    duplines="$(duplicate_lesson_numbers "$CLAUDE_HOME")"
    if ! is_blank "$duplines"; then
      dupfiles="$(printf '%s\n%s\n' "$dupfiles" "$duplines" | cut -d: -f1 | grep -v '^$' | sort -u)"
      echo "claude-sync: NOT publishing $(printf '%s' "$dupfiles" | tr '\n' ' ')because the same lesson number is used twice, which silently breaks every reference to it: $(printf '%s' "$duplines" | tr '\n' ';' | sed 's/;$//'). Renumber the later entry ('claude-sync next-lesson' prints the next free number) and it publishes on the next send. Everything else synced normally. Override with SYNC_SKIP_LESSON_CHECK=1." >&2
      notify "held back $(printf '%s' "$dupfiles" | tr '\n' ' '): duplicate lesson number"
    fi
  fi
  # Regenerated here rather than trusted, so the copy that travels always matches the lessons file
  # sitting beside it, whatever anybody has typed into it (#63).
  write_lesson_index "$CLAUDE_HOME"
  # top-level rule files, derived from CLAUDE.md's own imports, copied verbatim
  for f in $(top_files_in "$CLAUDE_HOME"); do
    case "
$protected" in *"
$f"*) continue ;; esac      # stale here; leave the repo's newer copy alone
    case "
$dupfiles" in *"
$f"*) continue ;; esac      # numbering collision here; do not spread it
    [ -f "$CLAUDE_HOME/$f" ] && cp "$CLAUDE_HOME/$f" "$PAYLOAD/$f"
  done
  # After everything has been mirrored in, and before the scan, so what is scanned and what is
  # committed are the same bytes the other Mac will receive.
  tokenize_payload
  scan_secrets   # never let a credential reach the shared remote  # LAST, once everything this send would carry is in the payload, so it sees the finished state
  # rather than one of the code paths that built it (L78).
  refuse_resurrected_deletions
}

# Block obvious credentials from being published. Uses gitleaks if installed,
# else a conservative set of distinctive token shapes (low false-positive).
# Override with SYNC_SKIP_SECRET_SCAN=1 if it ever flags a legitimate string.
scan_secrets(){
  [ "${SYNC_SKIP_SECRET_SCAN:-0}" = "1" ] && return 0
  [ -d "$PAYLOAD" ] || return 0
  local allow="$SYNC_REPO/.secret-allowlist"
  local q="[\"']?" pat apat
  pat='BEGIN [A-Z ]*PRIVATE KEY|AKIA[0-9A-Z]{16}|gh[posru]_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{20,}|xox[baprs]-[A-Za-z0-9-]{10,}|AIza[0-9A-Za-z_-]{35}|sk_live_[A-Za-z0-9]{20,}'
  apat="(secret|token|api[_-]?key|password|passwd)${q}[[:space:]]*[:=][[:space:]]*${q}[A-Za-z0-9_+/-]{24,}"
  local line file match fp findings=""
  # each grep -o hit is "path:matchedtext"; accept it if its fingerprint is allowlisted
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    file="${line%%:*}"; match="${line#*:}"
    fp="$(printf '%s' "$match" | shasum -a 256 | cut -d' ' -f1)"
    [ -f "$allow" ] && grep -q "^$fp" "$allow" && continue
    findings+="${file#$PAYLOAD/}
"
  done < <(grep -rIoE "$pat|$apat" "$PAYLOAD" 2>/dev/null || true)
  findings="$(printf '%s' "$findings" | sort -u | tr '\n' ' ')"
  is_blank "$findings" && return 0
  die "possible secret found in: ${findings}— remove it, allowlist its fingerprint in .secret-allowlist, or set SYNC_SKIP_SECRET_SCAN=1 to override"
}

# ---------- what the apply ACTUALLY wrote on this Mac ----------
# The pull summary used to be read off the shared repo's commit range, which is a
# proxy for the local result, not the result itself. The two disagreed in both
# directions: a pull announced "added LESSONS.md" when that file was never
# written, then reported "Already up to date" on the pull that finally wrote it.
# Record every real create/update/delete instead, and report from that.
APPLIED_LOG=""
# Removed however the run ends, including the early exit die() takes, so a pull
# never leaves a scratch file behind. Safe across the self-update hand-off: at
# that point the apply has not run yet, so there is nothing to clean.
cleanup_applied_log(){ if [ -n "$APPLIED_LOG" ]; then rm -f "$APPLIED_LOG"; fi; cleanup_expanded; cleanup_scratch_note; return 0; }
trap cleanup_applied_log EXIT
record_applied(){   # $1 = added|updated|removed   $2 = path relative to ~/.claude
  if [ -n "$APPLIED_LOG" ]; then printf '%s\t%s\n' "$1" "$2" >> "$APPLIED_LOG"; fi
  return 0
}
# Turn `rsync -i` itemized output into those records. $1 prefixes the subtree.
record_rsync(){
  local line change path kind prefix="${1:+$1/}"
  while IFS= read -r line; do
    change="${line%%[[:space:]]*}"
    path="${line#"$change"}"
    path="${path#"${path%%[![:space:]]*}"}"     # drop the separating spaces
    [ -n "$path" ] || continue
    case "$path" in */|.|./) continue ;; esac   # directories carry no information
    # Match on the presence of '+', not a fixed run of them: the flag field is 11
    # chars in rsync 3.x but 9 in the openrsync that ships with current macOS,
    # and a hard-coded '+++++++++' silently made every new file read as "updated".
    case "$change" in
      '*deleting')          kind=removed ;;
      *'+++'*)              kind=added ;;
      '>'*|'c'*|'h'*)       kind=updated ;;
      *)                    continue ;;         # '.' lines are metadata-only no-ops
    esac
    record_applied "$kind" "$prefix$path"
  done
  return 0
}

# THE RTK FINGERPRINT, derived from the hook that landed rather than trusted beside it
# (claude-config#296).
#
# rtk keeps a sha256 of hooks/rtk-rewrite.sh in hooks/.rtk-hook.sha256 and REFUSES TO RUN AT ALL
# when the two disagree: no rewriting, and a tampering banner on every Bash command. Observed
# 2026-09-02 in a trypennie session, which lost its command path entirely and worked around it by
# calling binaries by absolute path, with a failure that reads as the tool being broken rather than
# as a fingerprint mismatch.
#
# Both files are carried in the payload, so they normally arrive together, and test-rtk-rewrite.sh
# keeps that SOURCE pair honest on every run. What nothing did was hold them in step on a DEPLOYED
# Mac: however they come to arrive out of step, the result is a machine with no working Bash
# rewriting until somebody thinks to compare two hashes.
#
# So the installed baseline is DERIVED from the installed hook, the same way the lessons index is
# derived from the lessons. The two cannot then disagree here.
#
# It is REPORTED as well as corrected, because a wrong pair means a real defect in the source and
# fixing it in silence is how one would live in the repo unexamined (L11). Note what the correction
# actually does: hooks/ is fully mirrored, so the rebuilt copy is staged back on the next send and
# the repo converges on its own. The message says that rather than telling the reader the payload
# is still wrong, which it briefly did and which was simply untrue.
ensure_rtk_baseline(){
  local hook base want have
  hook="$CLAUDE_HOME/hooks/rtk-rewrite.sh"
  base="$CLAUDE_HOME/hooks/.rtk-hook.sha256"
  # No rewriter means nothing to describe. A baseline naming a hook that is not there is a claim
  # about a file nobody has (L98).
  [ -f "$hook" ] || return 0
  want="$(shasum -a 256 "$hook" 2>/dev/null | awk '{print $1}')"
  # A hash that could not be read is not a reason to write anything: an empty baseline is a
  # mismatch with every hook there is, which is the state this exists to prevent.
  case "$want" in ''|*[!0-9a-f]*) return 0 ;; esac
  have="$(awk 'NR==1{print $1}' "$base" 2>/dev/null || true)"
  [ "$have" = "$want" ] && return 0
  printf '%s  rtk-rewrite.sh\n' "$want" > "$base" 2>/dev/null || return 0
  # Said only when one was THERE and disagreed. An absent baseline is the recoverable case, which
  # rtk handles by establishing one, so reporting it would be a line about nothing.
  if [ -n "$have" ]; then
    echo "claude-sync: the rtk fingerprint that arrived describes a different hooks/rtk-rewrite.sh than the hook that arrived with it ($have against $want), so the copy on this Mac has been rebuilt from the hook, and the next send publishes that corrected copy. Left as it arrived, rtk refuses to run at all and prints a tampering banner on every Bash command. Nothing to do here; if it keeps happening, the pair in the checkout is what to look at, and test-rtk-rewrite.sh names it and says how to re-record it." >&2
  fi
  return 0
}

# copy repo payload -> local config, merging the hooks block (no git)
apply_payload_to_local(){
  # A TEST RUN may not write into the real config (claude-config#277, L2). This is the one place
  # the payload is installed, so it is the one place the refusal can live and the one place it can
  # be forgotten from (L30). The run id is exported by run-all-tests.sh to every suite it starts, so
  # a suite that reaches here with CLAUDE_HOME still pointing at the real home has bound to the live
  # path, which is exactly the mistake claude-config#216 was filed about.
  #
  # A refusal rather than a detection: the bracket that watched these files afterwards could never
  # say WHO wrote, because the sync daemon and other Claude sessions write them too, and it failed
  # three green runs in one day saying a suite had (L375).
  if [ -n "${CLAUDE_SUITE_RUN_ID:-}" ] && [ "${CLAUDE_HOME%/}" = "${HOME%/}/.claude" ]; then
    die "refusing to apply the payload into the real config at $CLAUDE_HOME: this is running under a test suite (CLAUDE_SUITE_RUN_ID=$CLAUDE_SUITE_RUN_ID). Point CLAUDE_HOME at that suite's own throwaway directory before calling this."
  fi
  [ -d "$PAYLOAD" ] || die "no payload in repo — run 'claude-sync push' on your other Mac first"
  mkdir -p "$CLAUDE_HOME"
  merge_rule_files           # entry level merge first: what merges is no conflict
  preserve_local_conflicts   # then whatever genuinely clashed, before it is overwritten
  # Hold back local edits the repo has not seen (see locally_ahead_paths): the
  # payload's copy of them is exactly what we last applied, so writing it back
  # would be a pure revert. During `sync` this list is empty by construction,
  # because stage_local_to_payload already mirrored these edits into the payload.
  # A file merged just above is held back the same way, so the apply does not
  # overwrite the merge, and the next send publishes it to the other Mac.
  local ahead; ahead="$(locally_ahead_paths)"
  local keep; keep="$ahead${MERGED_RULE_FILES:-}"
  # Explicit template, not a bare mktemp: BSD mktemp ignores TMPDIR unless the
  # template says so, which left the tests unable to see this file at all.
  APPLIED_LOG="$(mktemp "$(scratch_home_ready)/claude-sync-applied.XXXXXX")"
  # A merged rule file was rewritten on this Mac by merge_rule_files just above, and
  # it is EXCLUDED from the rsync below so the apply cannot clobber that merge. Both
  # facts are correct, and together they used to make the merge the one write nothing
  # reported: the summary read only this log, so a pull that merged lessons in printed
  # "nothing on this Mac needed changing" and named no file to restart for. Record it
  # here, where the log finally exists (merge_rule_files runs before it is created).
  # It matters most for the restart notice: a rule file is read at session start, so
  # an open session keeps the pre-merge copy until it is told to restart.
  local mp
  while IFS= read -r mp; do
    [ -n "$mp" ] || continue
    record_applied merged "$mp"
  done <<MERGED
${MERGED_RULE_FILES:-}
MERGED
  # -i itemizes so we can report the real writes; -c because -a quick-checks on
  # size plus mtime, and a same-size edit whose mtime git happens to preserve
  # would otherwise be neither copied nor reported. These trees are small.
  local kex p2
  for d in "${MIRROR_DIRS[@]}" skills; do
    [ -d "$PAYLOAD/$d" ] || continue
    mkdir -p "$CLAUDE_HOME/$d"
    # per-subtree excludes: the plugin-managed skills, plus the locally-ahead
    # paths being held back (rsync excludes are relative to the transfer root)
    kex=()
    if [ "$d" = skills ]; then
      local s2; for s2 in $(skill_excludes); do kex+=("$s2"); done
      REFUSED_SKILL_EXCLUDES=()
      refuse_unloadable_skills "$PAYLOAD/skills" "applied to this Mac" prune
      protect_unloadable_local_skills
      kex+=(${REFUSED_SKILL_EXCLUDES[@]+"${REFUSED_SKILL_EXCLUDES[@]}"})
    fi
    while IFS= read -r p2; do
      case "$p2" in "$d"/?*) kex+=(--exclude="/${p2#"$d"/}") ;; esac
    done <<KEEP
$keep
KEEP
    rsync -aic --delete "${COMMON_EXCLUDES[@]}" ${kex[@]+"${kex[@]}"} "$(apply_source_dir "$d")/" "$CLAUDE_HOME/$d/" | record_rsync "$d"
  done
  # Reported from $ahead, not $keep: a merged rule file is held back too, but it
  # already had its own clearer "these were MERGED" line and listing it again here
  # would read as two different things happening to the same file.
  if ! is_blank "$ahead"; then
    local keeplist; keeplist="$(printf '%s' "$ahead" | tr '\n' ' ')"
    # What this measured, not more. The old wording read as the COMPLETE set of what is waiting
    # to be sent, and it is narrower by construction: it is the paths THIS APPLY would otherwise
    # have reverted, which excludes anything the repo also changed (those are conflicts, handled
    # separately) and anything outside the trees it walks. On 2026-08-30 it named three files
    # while a status dry run moments later showed five, two of them skills (claude-config#227).
    # A sentence that is accurate about what it measured but reads as a claim about everything is
    # the shape of L287, and the fix is to state the scope inside the message.
    echo "claude-sync: this apply would have reverted these local edits, so it left them alone; they go up on the next send: ${keeplist}. That is what THIS APPLY touched, not everything unsent: run 'claude-sync status' for the full list of what differs from the shared copy." >&2
    notify "kept unsent local edits: ${keeplist}"
  fi
  chmod +x "$CLAUDE_HOME"/hooks/*.sh "$CLAUDE_HOME"/hooks/*.py 2>/dev/null || true
  find "$CLAUDE_HOME/skills" -name '*.sh' -exec chmod +x {} \; 2>/dev/null || true
  # top-level global rule files: only rewrite when changed, so a no-op sync leaves
  # mtime untouched (CLAUDE.md is a WatchPath; rewriting would re-trigger the watcher)
  # derived from the PAYLOAD's CLAUDE.md: it decides what this Mac is about to run
  local keeppad="
$keep
"
  for f in $(top_files_in "$PAYLOAD"); do
    [ -f "$PAYLOAD/$f" ] || continue
    # held back as a local edit the repo has not seen: writing the payload's copy
    # over it would be a pure revert of work that never left this Mac
    case "$keeppad" in *"
$f
"*) continue ;; esac
    if [ -f "$CLAUDE_HOME/$f" ] && cmp -s "$PAYLOAD/$f" "$CLAUDE_HOME/$f"; then continue; fi
    if [ -f "$CLAUDE_HOME/$f" ]; then
      keep_prior_copy "$CLAUDE_HOME/$f"
      record_applied updated "$f"
    else
      record_applied added "$f"
    fi
    cp "$PAYLOAD/$f" "$CLAUDE_HOME/$f"
  done
  if [ -f "$PAYLOAD/settings.hooks.json" ]; then
    local frag settings tmp inc_h bas_h added removed label
    settings="$CLAUDE_HOME/settings.json"
    [ -f "$settings" ] || echo '{}' > "$settings"
    frag="$(detok < "$PAYLOAD/settings.hooks.json")"
    inc_h="$(printf '%s' "$frag" | jq -c '.hooks // {}' 2>/dev/null || echo '{}')"
    # The hooks block used to be REPLACED wholesale, which silently unregistered a
    # hook added here since the last send: the hook script itself was held back as
    # locally ahead, but the line that activates it was not, so the hook shipped
    # inert. Seen on 2026-07-29 and once before during the send-wedge (#13).
    # So merge three ways instead. The base is the fragment this Mac last applied:
    # without it there is no way to tell "the other Mac deliberately removed this"
    # from "this Mac added it and has not sent it yet", so with no base we keep
    # local entries rather than drop work.
    bas_h="$(last_applied_hook_block)"
    tmp="$(scratch_file)"
    # The SAME rule the send applies, with the roles the other way round: what is arriving is
    # primary, what is registered here is secondary (claude-config#300, see merge_hook_blocks).
    local loc_h merged_h
    loc_h="$(jq -c '.hooks // {}' "$settings" 2>/dev/null || true)"
    merged_h=""
    [ -n "$loc_h" ] && merged_h="$(merge_hook_blocks "$inc_h" "$loc_h" "$bas_h")"
    if [ -z "$merged_h" ] || ! jq --argjson m "$merged_h" '.hooks = $m' "$settings" > "$tmp" 2>/dev/null; then
      # Fail loud and change nothing: a half-written hooks block is worse than an
      # unchanged one, and a silent skip would leave hooks quietly out of date.
      rm -f "$tmp"
      echo "claude-sync: could not merge the hooks block into settings.json, so it was left exactly as it was and your hooks may now be out of date. That usually means settings.json is not valid JSON: check with 'jq . $settings', fix it, then re-run the pull." >&2
      [ -t 2 ] || notify "hooks block could not be merged into settings.json"
      tmp=""
    fi
    if [ -n "$tmp" ]; then
      # Only replace settings.json when the result actually differs. settings.json
      # is a WatchPath; rewriting it on every sync would re-trigger the auto-sync
      # job forever. A no-op sync must leave the file (and its mtime) untouched.
      if cmp -s "$tmp" "$settings"; then
        rm -f "$tmp"
      else
        # Name the hooks that came and went. "updated settings.json" alone gave no
        # way to notice that a registration had just disappeared.
        added="$(jq -rn --argjson inc "$inc_h" --argjson bas "$bas_h" '
          def cmds($h): [ $h | to_entries[] | .value[]? | .hooks[]? | .command ];
          (cmds($inc) - cmds($bas)) | map(split("/") | last) | unique | join(", ")' 2>/dev/null || true)"
        removed="$(jq -rn --argjson inc "$inc_h" --argjson bas "$bas_h" '
          def cmds($h): [ $h | to_entries[] | .value[]? | .hooks[]? | .command ];
          (cmds($bas) - cmds($inc)) | map(split("/") | last) | unique | join(", ")' 2>/dev/null || true)"
        label="settings.json (hooks section)"
        [ -n "$added" ] && label="$label, registered: $added"
        [ -n "$removed" ] && label="$label, unregistered: $removed"
        keep_prior_copy "$settings"
        mv "$tmp" "$settings"
        record_applied updated "$label"
      fi
    fi
  fi
  # Before the imports are checked, and after the rule files have landed: on a Mac pulling for the
  # first time CLAUDE.md arrives importing an index that does not exist here yet, and after a merge
  # or a renumber the index that does exist is one edit behind (#63).
  write_lesson_index "$CLAUDE_HOME"
  # Derived from the hook that just landed, for the same reason and at the same moment
  # (claude-config#296).
  ensure_rtk_baseline
  verify_rule_imports
  # A collision the merge creates is settled there by renumbering the unsent
  # entry, so what reaches this point is one that cannot be settled on this Mac:
  # it arrived with the payload already published (both numbers may be referenced
  # on the other Mac), or it predates the sync entirely. It is in the file now, so
  # say so at once: the L43 duplicate went unnoticed for a day because nothing
  # ever looked (#15).
  # An entry in a shape nothing here can read (claude-config#164) is reported by
  # report_malformed_lessons, which write_lesson_index just above called. It used to be reported
  # HERE, in words that presumed the other Mac had written it, and that presumption was wrong in
  # the case that actually turned up (claude-config#248). One reporter, which reads where the
  # entry is rather than presuming, and which runs on every path that regenerates the index rather
  # than on this one alone (claude-config#249).
  local applied_dups; applied_dups="$(duplicate_lesson_numbers "$CLAUDE_HOME")"
  if ! is_blank "$applied_dups"; then
    echo "claude-sync: the same lesson number is now used twice on this Mac, which breaks every reference to it: $(printf '%s' "$applied_dups" | tr '\n' ';' | sed 's/;$//'). Renumber the later entry ('claude-sync next-lesson' prints the next free number). Until then that file is held back from the next send." >&2
    notify "duplicate lesson number on this Mac"
  fi
  report_pending_conflicts
  # Remember which commit's payload is now actually on this Mac. Everything that
  # publishes upward compares against this, so it can tell "the user edited a
  # file" apart from "this Mac is simply behind".
  if have_git; then repo_head > "$LAST_APPLIED_FILE" 2>/dev/null || true; fi
  # Only when a FILE actually landed. Two things are deliberately not enough (#75).
  #
  # An apply that found nothing to do has received nothing, so an empty log does not stamp.
  #
  # Neither does a log holding only "settings.json (hooks section)". That block is regenerated from
  # whatever payload is on disk, INCLUDING one this Mac staged from its own ~/.claude moments
  # earlier, so it is the single entry a first `sync` produces on a clone nobody has ever sent to.
  # Counting it would have this Mac reporting that config arrived when nothing did, which is the
  # exact false reassurance the stamps exist to prevent (L106).
  #
  # The stated cost of that: a change from the other Mac that touches ONLY the hooks registration
  # and no file will not move this stamp. That direction is the safe one for a drift report. It can
  # say "nothing has come down for a while" when something small did, which prompts a harmless
  # pull; the other way round hides the drift, which is the failure being fixed.
  if [ -n "$APPLIED_LOG" ] && [ -s "$APPLIED_LOG" ] \
     && grep -qv 'settings\.json (hooks section)' "$APPLIED_LOG"; then
    record_received
  fi
  # .last-applied stays local (it is this Mac's own bookkeeping); this is the published
  # half, so the OTHER Mac can be told apart from a Mac nobody has heard from. (#23)
  publish_applied_marker
  # Last, so the list of kept copies sits under everything this run reported doing, and only on a
  # run that actually wrote one (claude-config#158).
  sweep_old_syncbaks
  report_syncbaks
}

# The previous copy of a file about to be overwritten, kept beside it (claude-config#158).
#
# ONE place, because the flag below has to be set wherever a backup is written and three call sites
# each setting it is three chances to forget: a fact assembled in several places has nowhere its
# completeness can be seen (L94).
#
# Nothing here ever deletes one. An automatic retention policy is a product decision and not a
# silent default (L9), and the whole value of the file is still being there when somebody reaches
# for it (L5, L7). What was missing was never the deleting, it was that nobody was TOLD they
# existed or how old they were.
SYNCBAK_WRITTEN=0
keep_prior_copy(){   # keep_prior_copy <file>   -> copies it to <file>.syncbak
  cp "$1" "$1.syncbak" || return 1
  SYNCBAK_WRITTEN=1
  return 0
}

# What is sitting beside the rule files now, with a date each. Said only on a run that WROTE one,
# which is the moment their age is knowable and also the only moment worth interrupting for: on
# every pull it would be the noise it exists to cut through (L36).
#
# Every copy is listed, not only the one just written. Telling a fresh backup from one left over
# days ago is the entire point, and the stale one is invisible precisely because nothing mentions
# it: four were sitting on each Mac on 2026-08-22, one two days older than the others, and no pull
# had ever named any of them.
report_syncbaks(){
  [ "${SYNCBAK_WRITTEN:-0}" -eq 1 ] || return 0
  [ -d "$CLAUDE_HOME" ] || return 0
  local list n
  # Bounded depth deliberately: these are written beside the top-level rule files and settings, and
  # an unbounded walk here would read every project transcript under the config directory on every
  # merge. If a backup is ever written deeper than this, the line below stops naming it, which is
  # why the wording says where it looked rather than claiming to have found them all (L11).
  list="$(find "$CLAUDE_HOME" -maxdepth 2 -name '*.syncbak' -type f 2>/dev/null | sort || true)"
  case "$list" in *[![:space:]]*) ;; *) return 0 ;; esac
  n="$(printf '%s\n' "$list" | grep -c . || true)"
  echo "claude-sync: $n previous copy(ies) are kept beside their files as .syncbak, in $CLAUDE_HOME and one level below it:" >&2
  local f
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    # Through the portable helpers, never `date -r <file>`: that takes a TIMESTAMP on BSD and a
    # FILE on GNU, so the same line means two different things on the two machines this runs on
    # (#38). A date that cannot be read says so rather than being rendered as some default, since
    # the date is the entire reason this list exists (L67).
    local when
    when="$(date_from_epoch "$(file_mtime "$f")" '+%Y-%m-%d %H:%M' || true)"
    [ -n "$when" ] || when="date unreadable"
    printf '  %-16s  %s\n' "$when" "${f#"$CLAUDE_HOME"/}" >&2
  done <<SYNCBAKS
$list
SYNCBAKS
  echo "  Any past $(duration_in_words "$(( $(backup_keep_days) * 86400 ))") old are removed on the next run that writes one; 'claude-sync clean-backups' removes them all now." >&2
  return 0
}

# How long a .syncbak is kept. Generous on purpose: the backup has to outlive any window in which
# the pull that wrote it could still turn out to have been wrong, and being wrong the other way
# costs only disk (L5, L7).
#
# KEEP_DAYS rather than MAX_AGE, and that is not cosmetic. DESIGN.md's measured numbers table
# holds every SYNC_*_MAX_AGE and SYNC_*_TIMEOUT, and every row in it states what its number is
# derived FROM. This one is derived from nothing: it is a product choice about how long somebody
# might want to reach back for a pre-merge copy, in the same family as SYNC_INTERVAL, which that
# table deliberately excludes for the same reason. A row for it would have to invent a
# derivation. It is held honest the way SYNC_INTERVAL is, by appearing in the README on the line
# that names it.
backup_keep_days(){
  local d="${SYNC_BACKUP_KEEP_DAYS:-90}"
  case "$d" in ''|*[!0-9]*|0) d=90 ;; esac
  printf '%s' "$d"
}

# Reclaim the ones nobody is coming back for. Before this the only exit was deleting files by
# hand, so the reminder above became permanent noise and the whole line stopped being read: two
# backups from 2026-08-31 were still being announced on every pull (claude-config#240, L523).
#
# Every removal is ANNOUNCED. A cleanup that quietly deletes the only copy of something is the one
# thing this must not be, and a run that removed nothing must not read like one that removed ten
# (L98).
sweep_old_syncbaks(){   # -> removes backups older than the age above, naming each
  [ -d "$CLAUDE_HOME" ] || return 0
  local days f n=0 gone="" cutoff now when
  days="$(backup_keep_days)"
  now="$(date +%s)"
  cutoff=$(( now - days * 86400 ))
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    when="$(file_mtime "$f" 2>/dev/null || true)"
    # A date nothing can read is a reason to KEEP the file, not to delete it: this is the only
    # copy of somebody's work and a guess in the deleting direction cannot be taken back (L5).
    case "$when" in ''|*[!0-9]*) continue ;; esac
    [ "$when" -lt "$cutoff" ] || continue
    rm -f "$f" 2>/dev/null || continue
    n=$(( n + 1 )); gone="${gone:+$gone }${f#"$CLAUDE_HOME"/}"
  done <<OLDBAKS
$(find "$CLAUDE_HOME" -maxdepth 2 -name '*.syncbak' -type f 2>/dev/null | sort || true)
OLDBAKS
  [ "$n" -gt 0 ] && echo "claude-sync: removed $n .syncbak copy(ies) older than $(duration_in_words "$(( days * 86400 ))"): $gone" >&2
  return 0
}

do_clean_backups(){
  local f n=0
  [ -d "$CLAUDE_HOME" ] || die "no config dir at $CLAUDE_HOME"
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    rm -f "$f" 2>/dev/null || continue
    n=$(( n + 1 ))
    echo "  removed ${f#"$CLAUDE_HOME"/}"
  done <<ALLBAKS
$(find "$CLAUDE_HOME" -maxdepth 2 -name '*.syncbak' -type f 2>/dev/null | sort || true)
ALLBAKS
  if [ "$n" -eq 0 ]; then
    echo "No .syncbak copies in $CLAUDE_HOME or one level below it, so none were removed."
  else
    echo "Removed $n .syncbak copy(ies)."
  fi
  return 0
}

# Is the shared repo holding payload content this Mac has never applied? That is
# the state right after ANY merge, and it is when publishing upward is destructive:
# stage_local_to_payload mirrors ~/.claude over the payload with --delete and no
# regard for what is already there, so a send in this state silently reverts the
# other Mac's work. On 2026-07-27 that wiped a rules entry the other Mac had just
# written, 20 seconds after a merge left this Mac behind.
# The payload paths whose content in the repo is newer than what this Mac has
# applied, relative to payload/. Staging must not mirror over these: this Mac's
# copy of them is stale, so copying it up reverts the other Mac. Everything else
# still mirrors normally, so a genuine local edit (or a brand new file) still goes
# up in the same run. Receiving first instead would be wrong: the apply mirrors
# with --delete and would erase local files that have never been sent.
unapplied_paths(){
  local last head
  have_git || return 0
  last="$(cat "$LAST_APPLIED_FILE" 2>/dev/null || true)"
  [ -n "$last" ] || return 0
  head="$(repo_head)"
  [ -n "$head" ] || return 0
  [ "$head" != "$last" ] || return 0
  git -C "$SYNC_REPO" diff --name-only "$last" "$head" -- payload 2>/dev/null \
    | sed 's|^payload/||'
  return 0
}

# Paths where THIS Mac's copy differs from the payload while the repo has NOT
# touched them since our last apply: a local edit that was never sent, because
# the watcher was down or the edit is seconds old. Applying the payload over
# these would revert real work with a copy that carries no news (on 2026-07-28
# that silently destroyed a fix to a skill script, with the original mtime
# restored so the loss was invisible). The apply skips them and the next send
# publishes them. Repo-changed paths are deliberately NOT listed here: those
# are stale or conflicted, and preserve_local_conflicts owns the conflicts.
locally_ahead_paths(){
  local last unapplied d line change path
  have_git || return 0
  last="$(cat "$LAST_APPLIED_FILE" 2>/dev/null || true)"
  [ -n "$last" ] || return 0
  unapplied="
$(unapplied_paths)
"
  for d in "${MIRROR_DIRS[@]}" skills; do
    [ -d "$PAYLOAD/$d" ] || continue
    [ -d "$CLAUDE_HOME/$d" ] || continue
    local ex=()
    [ "$d" = skills ] && { local s; for s in $(skill_excludes); do ex+=("$s"); done; }
    while IFS= read -r line; do
      change="${line%%[[:space:]]*}"
      path="${line#"$change"}"
      path="${path#"${path%%[![:space:]]*}"}"
      [ -n "$path" ] || continue
      case "$path" in */|.|./) continue ;; esac
      case "$change" in '*deleting'|'>'*|'c'*|'h'*) ;; *) continue ;; esac
      [ -f "$CLAUDE_HOME/$d/$path" ] || continue
      case "$unapplied" in *"
$d/$path
"*) continue ;; esac
      printf '%s\n' "$d/$path"
      # From the expanded view, the same source the apply itself copies from. Against the raw
      # payload every tokenized file differs by construction, so all of them read as locally
      # ahead: held back on every apply, announced on every pull as unsent edits, and the other
      # Mac's changes to them would never land (#87).
    done < <(rsync -ainc --delete "${COMMON_EXCLUDES[@]}" ${ex[@]+"${ex[@]}"} "$(apply_source_dir "$d")/" "$CLAUDE_HOME/$d/" 2>/dev/null || true)
  done
  # Top-level rules files reach ~/.claude by a plain copy, not by the rsync above,
  # and were left out of this protection when it was written. So the revert this
  # function exists to prevent still happened to them, and they are the files that
  # matter most: CLAUDE.md, LESSONS.md, RTK.md and whatever those import carry the
  # rules every session loads. Seen for real on 2026-07-28, when a pull run seconds
  # after another session appended a lesson deleted it, leaving only a .syncbak.
  # Same test as above: the repo has not touched it since our last apply, so this
  # Mac's copy is ahead, not stale. A file the repo DID change is deliberately left
  # out, exactly as above, because preserve_local_conflicts owns that case.
  local tf
  for tf in $(top_files_in "$CLAUDE_HOME"); do
    [ -f "$CLAUDE_HOME/$tf" ] || continue
    [ -f "$PAYLOAD/$tf" ] || continue
    # A DERIVED file is never locally ahead (claude-config#238). LESSONS-INDEX.md is regenerated
    # from LESSONS.md at the end of every apply and every send, on each Mac independently, so the
    # two copies differ whenever the lessons differ, by construction and with no work at risk.
    # Reported as an unsent local edit it named itself on every pull where lessons had moved: a
    # false positive on the one message that protects an edit from being silently reverted, which
    # is what teaches a reader to skip it, so the one time it names a genuinely unsent edit it
    # reads like all the noise (L36). Three other readers already skip derived files for the same
    # reason; this was the one left out.
    is_derived_rule_file "$tf" && continue
    if cmp -s "$PAYLOAD/$tf" "$CLAUDE_HOME/$tf"; then continue; fi
    case "$unapplied" in *"
$tf
"*) continue ;; esac
    printf '%s\n' "$tf"
  done
  return 0
}

# A path this Mac is stale on is only safe to overwrite if this Mac did not also
# change it. When both sides did, the apply is about to discard one person's work,
# and holding the path back from the send just moves that loss to the local copy
# instead of the remote one. Keep the local version beside the file and say so:
# whichever copy is wanted, it still exists. Suffixed per host so two Macs never
# collide, and excluded from the mirror so the copy stays local.
conflict_suffix(){ printf '.conflict-%s\n' "${SYNC_HOSTNAME:-$(hostname -s)}"; }

# ---------- what each Mac has applied, published (#23) ----------
# Every other check in this tool reports on the sync PROCESS. Nothing reported the OUTCOME
# the product exists for, which is that both Macs hold the same config: .last-applied is
# gitignored and never leaves the machine that wrote it, so the repo knew nothing about the
# other Mac at all and the only evidence of agreement was that no error had appeared.
sync_hostname(){ printf '%s' "${SYNC_HOSTNAME:-$(hostname -s)}"; }
payload_tree(){ git -C "$SYNC_REPO" rev-parse -q --verify HEAD:payload 2>/dev/null || true; }

STATE_REF_PREFIX="refs/claude-sync-state"   # one ref per Mac, never on the config branch

publish_applied_marker(){
  have_git || return 0
  local tree host file ts blob treeobj commit agents agentblob prev_tree prev_agents
  tree="$(payload_tree)"; [ -n "$tree" ] || return 0
  host="$(sync_hostname)"; file="$STATE_DIR/$host.applied"
  # What this Mac's launch agents are, published alongside what it applied (claude-config#328). It
  # is the same kind of fact: something only this Mac can see about itself, which the other Mac
  # needs in order to report it. Without it a Mac still running last month's schedule is invisible
  # from anywhere but its own screen.
  agents="$(agents_state)"
  # Records the payload TREE, never HEAD. Keyed on HEAD the two Macs republish markers at
  # each other for ever: publishing moves HEAD, so the other Mac sees a new commit, applies,
  # publishes its own marker, which moves HEAD again. A marker-only commit does not change
  # the payload tree, so the exchange settles after one round and then writes nothing.
  # Republished when EITHER changes. The tree alone would leave a Mac that re-installed its agents
  # publishing the old answer until something unrelated changed the payload (L40). Markers live on
  # their own refs, never on the config branch, so republishing moves no HEAD and cannot restart
  # the exchange this early return was originally written to settle.
  if [ -f "$file" ]; then
    prev_tree="$(awk 'NR==1{print $1}' "$file" 2>/dev/null || true)"
    prev_agents="$(awk 'NR==2' "$file" 2>/dev/null || true)"
    if [ "$prev_tree" = "$tree" ] && [ "$prev_agents" = "$agents" ]; then return 0; fi
  fi
  ts="$(date +%s)"
  mkdir -p "$STATE_DIR" 2>/dev/null || return 0
  printf '%s %s\n%s\n' "$tree" "$ts" "$agents" > "$file" 2>/dev/null || true

  # Published on its OWN ref, NEVER as a commit on the config branch. Measured, not feared:
  # committing markers alongside the payload turned 27 unrelated tests red, because a marker
  # commit is a commit the other Mac does not have, and the guard that stops a Mac
  # publishing while it is behind reads that as behind and skips every send until somebody
  # pulls. That guard already has history (it once dropped 81 minutes of sends on
  # 2026-07-28), so it is the last thing that should be taught about a new exception.
  # One ref per Mac, so two Macs can never contend for the same one.
  blob="$(printf '%s %s\n' "$tree" "$ts" | git -C "$SYNC_REPO" hash-object -w --stdin 2>/dev/null || true)"
  [ -n "$blob" ] || return 0
  # A SECOND blob rather than a third field on the first one. Every existing reader of `applied`
  # takes the last space separated field as the timestamp, so adding a field there would have made
  # each of them read the agent state as a date (L510).
  agentblob="$(printf '%s\n' "$agents" | git -C "$SYNC_REPO" hash-object -w --stdin 2>/dev/null || true)"
  [ -n "$agentblob" ] || return 0
  treeobj="$(printf '100644 blob %s\tagents\n100644 blob %s\tapplied\n' "$agentblob" "$blob" | git -C "$SYNC_REPO" mktree 2>/dev/null || true)"
  [ -n "$treeobj" ] || return 0
  commit="$(git -C "$SYNC_REPO" "${SYNC_GIT_IDENTITY[@]}" \
              commit-tree "$treeobj" -m "applied by $host" 2>/dev/null || true)"
  [ -n "$commit" ] || return 0
  git -C "$SYNC_REPO" update-ref "$STATE_REF_PREFIX/$host" "$commit" 2>/dev/null || true
  # Best effort. A push that fails only means verify sees staler data from this Mac, and it
  # reports the date it has rather than presenting it as current.
  git -C "$SYNC_REPO" push -q --force origin "$STATE_REF_PREFIX/$host:$STATE_REF_PREFIX/$host" 2>/dev/null || true
}

fetch_state_refs(){
  git -C "$SYNC_REPO" fetch -q --force origin "$STATE_REF_PREFIX/*:$STATE_REF_PREFIX/*" 2>/dev/null || true
}

# The top-level rule files are append-only lists: a lesson, a rule, one entry per
# item. When both Macs add to one, the two sides touch different lines, so there is
# a real merge to be had and no reason for either copy to win. Picking a winner cost
# two lessons on 2026-07-29 that existed nowhere else (#14).
#
# So merge three ways first, against the copy this Mac last applied. What merges
# cleanly is not a conflict at all: the merged file is written here and held back
# from the apply, and the next send publishes it so the other Mac gets both sides.
# Only a genuine same-line clash falls through to preserve_local_conflicts below.
# Sets MERGED_RULE_FILES (newline separated) for the caller.
#
# Both Macs appending a DIFFERENT entry to the end of the same list is the common
# case, and to a three-way merge that is one conflict at one spot, because both
# sides inserted where there was nothing. Those hunks are safe to settle by keeping
# both sides. A hunk whose base side is NOT empty means the two Macs rewrote the
# same existing text, which no rule can settle, so the whole file is left to the
# conflict path rather than guessing.
# Reads a --diff3 merge on stdin, writes the resolved file, exits non-zero if any
# hunk was a real clash.
resolve_add_add_hunks(){
  awk '
    BEGIN { state = 0; clash = 0; no = 0; nb = 0; nt = 0 }
    /^<<<<<<< / { state = 1; no = 0; nb = 0; nt = 0; next }
    /^\|\|\|\|\|\|\| / { if (state == 1) { state = 2; next } }
    /^=======$/ { if (state == 2 || state == 1) { state = 3; next } }
    /^>>>>>>> / {
      if (state == 3) {
        if (nb > 0) { clash = 1 }            # both sides changed existing text
        else {
          for (i = 1; i <= nt; i++) print theirs[i]   # incoming first, ours after
          for (i = 1; i <= no; i++) print ours[i]
        }
        state = 0; next
      }
    }
    { if (state == 1) { ours[++no] = $0 }
      else if (state == 2) { base[++nb] = $0 }
      else if (state == 3) { theirs[++nt] = $0 }
      else print }
    END { exit (clash ? 1 : 0) }
  '
}

# Settling a number collision means renumbering the copy that was never published,
# and that fix has to survive the very next merge. It did not: the merge above is
# additive by design, so an entry this Mac still holds under its OLD number and the
# arriving copy of the SAME entry under its new one are different lines, and both were
# kept. The lesson then sat in the file twice, the duplicate numbers the renumber had
# just resolved came straight back, and the duplicate guard held that one file back
# from every send with no wedge notification (seen 2026-08-05, the third collision).
#
# So after merging, drop a local entry that the arriving file carries under a different
# number. Bodies must be byte-identical apart from the number, which is what a pure
# renumber produces; anything else is a real edit and is left alone. Prints one report
# line per drop, because an entry that vanishes silently reads as a clean merge (#14).
drop_renumbered_duplicates(){   # $1 = merged file, rewritten in place  $2 = arriving file
  local out; out="$(scratch_file)"
  local report; report="$(awk -v out="$out" '
    function entry_start(s) { return (s ~ /^- \*\*L[0-9]+\./) }
    function sig_of(s)      { sub(/^- \*\*L[0-9]+\./, "- **L#.", s); return s }
    function num_of(s)      { match(s, /L[0-9]+/); return substr(s, RSTART, RLENGTH) }
    function close_block() {
      if (nb == 0) return
      s = sig_of(blk[1]); for (i = 2; i <= nb; i++) s = s "\n" blk[i]
      n = num_of(blk[1])
      if (pass == 1) { if (!(s in authnum)) authnum[s] = n }
      else if (pass == 2) { seen[s]++; if (!(s in firstnum)) firstnum[s] = n }
      else {
        keep = (s in authnum) ? authnum[s] : firstnum[s]
        if (seen[s] > 1 && (n != keep || (s SUBSEP n) in taken)) {
          # Two different situations reach this drop and they are not the same news.
          # n != keep is a real renumber: the entry lives on under another number, and
          # every mention of the old one has to follow it. n == keep is reachable only
          # through the taken arm, which means the identical entry arrived twice under
          # ONE number: nothing was renumbered, nothing needs chasing, and saying
          # "Lx became Lx" is a false alarm on the one message that reports a drop
          # (L11, L36, #257).
          if (n == keep) printf "%s duplicate\n", n
          else printf "%s became %s\n", n, keep
        } else {
          taken[s SUBSEP n] = 1
          for (i = 1; i <= nb; i++) print blk[i] > out
        }
      }
      nb = 0
    }
    FNR == 1 { close_block(); pass++ }
    {
      if (entry_start($0)) { close_block(); blk[++nb] = $0 }
      else if (nb > 0 && $0 ~ /^  /) { blk[++nb] = $0 }
      else { close_block(); if (pass == 3) print > out }
    }
    END { close_block() }
  ' "$2" "$1" "$1")"
  if [ -n "$report" ]; then
    cat "$out" > "$1"
    printf '%s' "$report"
  fi
  rm -f "$out"
  return 0
}

# The merge above can CREATE a collision: both Macs reached for the same next
# number for different lessons, and keeping both sides (correct) leaves the number
# used twice. The settled rule for that (2026-08-05, and done by hand again
# 2026-08-11) is mechanical: the published copy keeps the number, because the
# other Mac may already reference it, and the entry that has never left this Mac
# takes the next free number. The script knows both facts at merge time, so it
# does the renumber itself instead of holding the file back for a by-hand fix.
# An entry counts as published only if the ARRIVING file carries this exact body
# under this exact number; everything else holding a contested number is local and
# safe to renumber. A collision entirely between published entries (the other Mac
# shipped a duplicate) is NOT ours to settle, because both numbers may be
# referenced there: those are left alone for the apply-time warning below.
# Prints one "Lx became Ly" line per renumber; empty output means nothing changed.
renumber_merge_collisions(){   # $1 = merged file, rewritten in place  $2 = arriving file  $3 = first free number (digits)
  local out; out="$(scratch_file)"
  local report; report="$(awk -v out="$out" -v next_free="$3" '
    function entry_start(s) { return (s ~ /^- \*\*L[0-9]+\./) }
    function sig_of(s)      { sub(/^- \*\*L[0-9]+\./, "- **L#.", s); return s }
    function num_of(s)      { match(s, /L[0-9]+/); return substr(s, RSTART, RLENGTH) }
    function close_block() {
      if (nb == 0) return
      s = sig_of(blk[1]); for (i = 2; i <= nb; i++) s = s "\n" blk[i]
      n = num_of(blk[1])
      if (pass == 1) { pub[s SUBSEP n] = 1 }
      else if (pass == 2) { cnt[n]++; if ((s SUBSEP n) in pub) claimed[n] = 1 }
      else {
        if (cnt[n] > 1 && !((s SUBSEP n) in pub)) {
          if (n in claimed) {
            newn = "L" next_free; next_free++
            sub(/^- \*\*L[0-9]+\./, "- **" newn ".", blk[1])
            printf "%s became %s\n", n, newn
          } else claimed[n] = 1
        }
        for (i = 1; i <= nb; i++) print blk[i] > out
      }
      nb = 0
    }
    FNR == 1 { close_block(); pass++ }
    {
      if (entry_start($0)) { close_block(); blk[++nb] = $0 }
      else if (nb > 0 && $0 ~ /^  /) { blk[++nb] = $0 }
      else { close_block(); if (pass == 3) print > out }
    }
    END { close_block() }
  ' "$2" "$1" "$1")"
  if [ -n "$report" ]; then
    cat "$out" > "$1"
    printf '%s' "$report"
  fi
  rm -f "$out"
  return 0
}

# Lines mentioning a lesson number in body text, counted with each entry's own
# heading number stripped first. Lessons routinely cite each other by number, so
# after a renumber a mention of the OLD number may point at the wrong lesson. In
# the file being MERGED the tool can settle that itself (rewrite_local_mentions
# below); in any OTHER rule file it cannot, so there it counts the mentions and
# sends a human to look rather than rewriting or staying silent.
stale_number_mentions(){   # $1 = file  $2 = number, e.g. L2
  sed -E 's/^- \*\*L[0-9]+\./- **/' "$1" | grep -cE "(^|[^A-Za-z0-9])${2}([^0-9]|\$)" || true
}

# A renumber must carry its body mentions with it, and at merge time the tool DOES
# know which lesson a mention in the merged file meant: a line this Mac wrote
# (absent from the arriving published file) could only ever have meant this Mac's
# own entry, because the other Mac's entry did not exist here until this pull. A
# line present verbatim in the arriving file is published text, whose mention means
# the entry that KEEPS the number, so it is left alone. Rewrites the merged file in
# place and prints the number of mentions rewritten (0 means it wrote nothing).
# Matching uses the same boundary rule as stale_number_mentions, so L2 never
# matches inside L12, L20, or a word.
rewrite_local_mentions(){   # $1 = merged file, rewritten in place  $2 = arriving file  $3 = old, e.g. L2  $4 = new, e.g. L5
  local out; out="$(scratch_file)"
  local count; count="$(awk -v out="$out" -v old="$3" -v new="$4" '
    function rewrite(line,   res, seg) {
      res = ""
      while (match(line, "(^|[^A-Za-z0-9])" old "([^0-9]|$)")) {
        seg = substr(line, RSTART, RLENGTH)
        sub(old, new, seg)
        res = res substr(line, 1, RSTART - 1) seg
        line = substr(line, RSTART + RLENGTH)
        rewritten++
      }
      return res line
    }
    FNR == 1 { pass++ }
    pass == 1 { arriving[$0] = 1; next }
    { if ($0 in arriving) print $0 > out; else print rewrite($0) > out }
    END { print rewritten + 0 }
  ' "$2" "$1")"
  if [ "${count:-0}" -gt 0 ] 2>/dev/null; then cat "$out" > "$1"; fi
  rm -f "$out"
  printf '%s' "${count:-0}"
  return 0
}

# Everything a settled renumber owes the rest of the config, given the merge's
# "Lold became Lnew" report lines on stdin: carry the merged file's own local
# mentions to the new number (published lines keep the old one, which now names
# the other Mac's entry), and warn about mentions in any OTHER synced rule file,
# which is not being merged this pull so its lines' ownership cannot be read.
# Every synced file a lesson citation could be sitting in, as paths relative to CLAUDE_HOME.
#
# This used to be CLAUDE_HOME/*.md and nothing else, which meant the renumber report covered
# the two rule files and was blind to everywhere else the config cites a lesson by number.
# That is not a corner: hooks/lessons-advisory.sh alone carries sixteen citations, and seven
# files across hooks/ and skills/ carry twenty-seven distinct numbers between them. A renumber
# left every one of them pointing at a different lesson and said nothing, which is the worst
# shape a wrong reference can take, because the file still reads as though it means what it
# says (#43).
#
# Report only, exactly as before. Nothing here is rewritten: outside the file being merged the
# tool cannot tell which lesson a citation meant, and guessing would silently rewrite a correct
# reference into a wrong one.
#
# Paths are RELATIVE, never basenames. SKILL.md is the commonest filename in the config, so
# "SKILL.md also mentions L2" names nothing anybody can go and open.
#
# Binary files are skipped with grep -I: an image under skills/ is not a citation, and byte
# soup run through the matcher below produces counts nobody can act on.
#
# The candidates are found by ONE grep over the tree rather than by testing each file in turn.
# The per-file walk cost 8.4 seconds per renumbered lesson against the real config (800 files, 747
# of them under skills/, roughly 2,400 processes), and the watcher runs this in the background on
# every config edit, so a three-lesson renumber stalled it for about 25 seconds. The same answer
# takes 0.022 seconds in one pass (#53).
#
# The pre-filter is deliberately a SUPERSET of what counts as a citation: it matches the raw text,
# while stale_number_mentions strips each entry's own heading number before counting, so a file
# whose only occurrence is its own `- **L2.` heading is a candidate here and is correctly counted
# as zero afterwards. The count stays the single definition; this only decides which files it is
# worth running.
#
# SYNC_NO_CITATION_PREFILTER=1 keeps the old whole-tree walk reachable, so the two can be compared
# on one fixture rather than the fast path becoming a second definition of a citation (L107).
citation_candidates(){   # $1 = number, e.g. L2
  local num="$1" f g d
  local -a roots=()
  for f in "$CLAUDE_HOME"/*.md; do
    [ -f "$f" ] || continue
    roots+=("$f")
  done
  for d in "${MIRROR_DIRS[@]}" skills; do
    [ -d "$CLAUDE_HOME/$d" ] || continue
    roots+=("$CLAUDE_HOME/$d")
  done
  [ "${#roots[@]}" -gt 0 ] || return 0
  if [ "${SYNC_NO_CITATION_PREFILTER:-0}" = "1" ]; then
    for f in "${roots[@]}"; do
      if [ -d "$f" ]; then
        while IFS= read -r g; do
          [ -n "$g" ] || continue
          grep -Iq . "$g" 2>/dev/null || continue
          printf '%s\n' "${g#"$CLAUDE_HOME"/}"
        done < <(find "$f" -type f 2>/dev/null)
      else
        printf '%s\n' "${f#"$CLAUDE_HOME"/}"
      fi
    done
    return 0
  fi
  # -I skips binary files, which the per-file walk did with its own grep. -l stops at the first
  # match per file, and a symlink is skipped so that both paths answer with the same set: the walk
  # used `find -type f`, which never yielded one.
  while IFS= read -r g; do
    [ -n "$g" ] || continue
    [ -L "$g" ] && continue
    printf '%s\n' "${g#"$CLAUDE_HOME"/}"
  done < <(grep -rIlE "(^|[^A-Za-z0-9])${num}([^0-9]|\$)" "${roots[@]}" 2>/dev/null || true)
  return 0
}

# The synced files that CITE a number, as "path<TAB>count" lines, paths relative to CLAUDE_HOME.
# Candidate paths arrive on stdin. One definition, used by the renumber report and by `cite-scan`.
count_citations_in(){   # $1 = number, e.g. L2; candidate paths on stdin
  local num="$1" f stale
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    # The lessons index is generated from LESSONS.md on every send and every apply, so a number in
    # it is never something to go and check by hand: it is rewritten in the same run (#63).
    is_derived_rule_file "$f" && continue
    [ -f "$PAYLOAD/$f" ] || continue   # only synced files are in scope
    stale="$(stale_number_mentions "$CLAUDE_HOME/$f" "$num")"
    [ "${stale:-0}" -gt 0 ] 2>/dev/null || continue
    printf '%s\t%s\n' "$f" "$stale"
  done
  return 0
}

citing_synced_files(){   # $1 = number, e.g. L2
  citation_candidates "$1" | count_citations_in "$1"
}

# WHICH lesson numbers the config quotes, and what each one MEANT when it was pinned
# (claude-config#199).
#
# A renumber changes what a number names. Inside the file being merged the tool rewrites the
# mentions itself, and in other synced files it counts them and sends a person to look, but nothing
# recorded what a citation was written ABOUT, so a number that moved and a number that did not read
# the same afterwards. The pin file records the id of the entry each cited number named at the time,
# and the check re-derives them: an id that has changed is a citation now pointing somewhere else.
#
# It lives in the repo, beside lesson-bands, rather than in the payload: it is about the config
# rather than part of it, and nothing loads it into a session.
LESSON_PIN_FILE="$SYNC_REPO/lesson-citations.tsv"

# Every lesson number quoted anywhere in the payload except the lessons files themselves, which are
# where the entries live rather than places that cite them.
cited_lesson_numbers(){   # -> one Lnnn per line, distinct, sorted
  [ -d "$PAYLOAD" ] || return 0
  grep -rhoE '(^|[^A-Za-z0-9])L[0-9]{1,4}([^0-9]|$)' "$PAYLOAD" \
      --exclude=LESSONS.md --exclude="$LESSON_INDEX_FILE" 2>/dev/null \
    | grep -oE 'L[0-9]{1,4}' | sort -u
}

do_cite_pin(){
  local src="$CLAUDE_HOME/LESSONS.md" num id tmp n=0
  [ -f "$src" ] || die "no LESSONS.md at $src, so there is nothing to pin citations against."
  tmp="$(scratch_file)"
  while IFS= read -r num; do
    [ -n "$num" ] || continue
    id="$(lesson_id "$src" "$num" 2>/dev/null || true)"
    # A number nothing defines is not a citation of a lesson, it is a version string, a label or a
    # coincidence. Pinning it would put a row in this file that can never be satisfied.
    [ -n "$id" ] || continue
    printf '%s\t%s\n' "$num" "$id" >> "$tmp"
    n=$(( n + 1 ))
  done < <(cited_lesson_numbers)
  if [ "$n" -eq 0 ]; then
    rm -f "$tmp"
    die "found no lesson citation anywhere in $PAYLOAD, which cannot be right. Nothing was written; the old pin file is untouched."
  fi
  cat "$tmp" > "$LESSON_PIN_FILE" && rm -f "$tmp"
  echo "claude-sync: pinned $n cited lesson number(s) in $LESSON_PIN_FILE to the entry each one names now."
  return 0
}

do_cite_check(){
  local src="$CLAUDE_HOME/LESSONS.md" num id want moved="" gone="" unpinned="" n=0
  [ -f "$src" ] || die "no LESSONS.md at $src, so nothing can be checked."
  if [ ! -f "$LESSON_PIN_FILE" ]; then
    die "there is no pin file at $LESSON_PIN_FILE, so nothing records what any cited number was written about. Run 'claude-sync cite-pin' once to record it."
  fi
  while IFS="$(printf '\t')" read -r num want; do
    [ -n "$num" ] && [ -n "$want" ] || continue
    n=$(( n + 1 ))
    id="$(lesson_id "$src" "$num" 2>/dev/null || true)"
    if [ -z "$id" ]; then
      gone="$gone $num"
    elif [ "$id" != "$want" ]; then
      moved="$moved $num"
    fi
  done < "$LESSON_PIN_FILE"
  # Reading an empty pin file is not a clean answer (L98).
  [ "$n" -gt 0 ] || die "the pin file at $LESSON_PIN_FILE holds no rows, so nothing was checked."
  while IFS= read -r num; do
    [ -n "$num" ] || continue
    lesson_id "$src" "$num" >/dev/null 2>&1 || continue
    grep -q "^$num	" "$LESSON_PIN_FILE" 2>/dev/null || unpinned="$unpinned $num"
  done < <(cited_lesson_numbers)
  local bad=0
  if [ -n "$moved" ]; then
    bad=1
    echo "claude-sync: these cited lesson numbers name a DIFFERENT entry than when they were pinned:$moved" >&2
    echo "  Something renumbered them, so every citation of them now points at the wrong lesson. 'claude-sync cite-scan <number>' lists who cites one. Fix the citations, then re-run 'claude-sync cite-pin'." >&2
  fi
  if [ -n "$gone" ]; then
    bad=1
    echo "claude-sync: these cited lesson numbers no longer exist in $src at all:$gone" >&2
    echo "  A citation of one resolves to nothing. Fix or remove them, then re-run 'claude-sync cite-pin'." >&2
  fi
  if [ -n "$unpinned" ]; then
    # SAID, and deliberately NOT counted. A citation written since the last pin is not a fault, it
    # is just unprotected, and failing on it would mean re-pinning on every commit that quotes a
    # lesson, which is most of them. What the check exists to catch is a number that came to mean
    # something ELSE (L324: the refusal is no broader than the reason for it).
    echo "claude-sync: cited but not pinned, so nothing would notice if these moved:$unpinned" >&2
    echo "  Run 'claude-sync cite-pin' to record what each of them names now." >&2
  fi
  [ "$bad" -eq 0 ] || return 1
  echo "claude-sync: all $n pinned citation(s) still name the entry they were written about."
  return 0
}

# `claude-sync cite-scan L2` answers, on demand, the question the renumber report answers as a side
# effect: which synced files cite this lesson number. It also says how many files it had to open to
# find out, because that is the quantity #53 is about and a scan that quietly went back to opening
# all 800 would otherwise look identical.
do_cite_scan(){   # $1 = number
  local num="${1:-}" cands n
  case "$num" in
    L[0-9]*) : ;;
    *) die "cite-scan needs a lesson number, e.g. cite-scan L2 (got '${num:-<nothing>}')" ;;
  esac
  cands="$(scratch_file)"
  citation_candidates "$num" > "$cands"
  n="$(grep -c . "$cands" 2>/dev/null || true)"
  echo "claude-sync: cite-scan: examined ${n:-0} candidate file(s) for $num" >&2
  count_citations_in "$num" < "$cands"
  rm -f "$cands"
  return 0
}


settle_renumber_mentions(){   # $1 = merged file (tmp)  $2 = arriving file  $3 = display name; report lines on stdin
  local renline oldnum newnum rewritten othern stale
  while IFS= read -r renline; do
    [ -n "$renline" ] || continue
    oldnum="${renline%% became *}"; newnum="${renline##* became }"
    [ "$oldnum" != "$renline" ] && [ "$newnum" != "$renline" ] || continue
    # A number that became itself is not a renumber, so there is nothing here to rewrite
    # and nothing for the reader to go and check. Guarded where the assumption lives, not
    # only at the one caller: rewrite_local_mentions counts MATCHES rather than changes, so
    # an equal-number line makes it report rewriting mentions of Lx to Lx, and the loop
    # below would ask the reader to check every citation of Lx against Lx (#257).
    [ "$oldnum" != "$newnum" ] || continue
    rewritten="$(rewrite_local_mentions "$1" "$2" "$oldnum" "$newnum")"
    if [ "${rewritten:-0}" -gt 0 ] 2>/dev/null; then
      echo "claude-sync: $3: rewrote $rewritten body mention(s) of $oldnum to $newnum on lines this Mac wrote, which could only have meant the renumbered lesson; mentions on published lines keep $oldnum, which now names the other Mac's entry." >&2
      notify "$3: rewrote mentions of $oldnum to $newnum"
    fi
    while IFS="$(printf '\t')" read -r othern stale; do
      [ -n "$othern" ] || continue
      [ "$othern" = "$3" ] && continue
      echo "claude-sync: $othern also mentions $oldnum on $stale line(s). $oldnum now names the other Mac's entry, so check whether each mention meant the renumbered lesson (now $newnum); nothing was rewritten there." >&2
      notify "$othern: check mentions of $oldnum after the renumber"
    done < <(citing_synced_files "$oldnum")
  done
  return 0
}

# The highest lesson number visible in the given files, 0 when there are none.
# The renumber must clear every number in use anywhere, not just the contested
# one: next_lesson_number covers the local tree, this covers the two merge inputs.
highest_lesson_in(){   # $@ = files
  local n
  n="$(grep -hoE '^- \*\*L[0-9]+\.' "$@" 2>/dev/null | grep -oE '[0-9]+' | sort -n | tail -1 || true)"
  printf '%s' "${n:-0}"
}

merge_rule_files(){
  local last p local_f tmpb tmpm tmpr reported="" resolved renumbered start fmax collided band
  MERGED_RULE_FILES=""
  have_git || return 0
  last="$(cat "$LAST_APPLIED_FILE" 2>/dev/null || true)"
  [ -n "$last" ] || return 0
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    case "$p" in */*) continue ;; esac   # top-level rule files only
    # A generated file is rebuilt from its source at the end of this same apply, so merging two
    # renderings of it is work whose result is thrown away, and FAILING to merge them is worse:
    # it hands the file to the conflict path below, which announces that config was nearly lost
    # (#83). What merges is LESSONS.md, and the index follows from that.
    is_derived_rule_file "$p" && continue
    local_f="$CLAUDE_HOME/$p"
    [ -f "$local_f" ] && [ -f "$PAYLOAD/$p" ] || continue
    tmpb="$(scratch_file)"
    if ! git -C "$SYNC_REPO" show "$last:payload/$p" > "$tmpb" 2>/dev/null; then rm -f "$tmpb"; continue; fi
    # nothing of ours to merge, or already exactly what is arriving
    if cmp -s "$tmpb" "$local_f" || cmp -s "$PAYLOAD/$p" "$local_f"; then rm -f "$tmpb"; continue; fi
    tmpm="$(scratch_file)"; tmpr="$(scratch_file)"; resolved=""
    if git merge-file --quiet -p "$local_f" "$tmpb" "$PAYLOAD/$p" > "$tmpm" 2>/dev/null; then
      cp "$tmpm" "$tmpr"; resolved=1
    else
      git merge-file --diff3 -p "$local_f" "$tmpb" "$PAYLOAD/$p" > "$tmpm" 2>/dev/null || true
      if [ -s "$tmpm" ] && resolve_add_add_hunks < "$tmpm" > "$tmpr" 2>/dev/null; then resolved=1; fi
    fi
    # Never write a file still carrying conflict markers: these load as rules.
    if [ -n "$resolved" ] && [ -s "$tmpr" ] && ! grep -q '^<<<<<<< \|^>>>>>>> ' "$tmpr"; then
      renumbered="$(drop_renumbered_duplicates "$tmpr" "$PAYLOAD/$p")"
      # Split by CAUSE, not just reported together. A renumber and an exact duplicate both
      # remove a copy, but they are different news and only one of them leaves mentions to
      # chase, so they get separate messages and only the renumbers reach the mention
      # settling below (#257).
      dropdup=""; droprenum=""
      if [ -n "$renumbered" ]; then
        droprenum="$(printf '%s\n' "$renumbered" | grep ' became ' 2>/dev/null || true)"
        dropdup="$(printf '%s\n' "$renumbered" | grep ' duplicate$' 2>/dev/null | sed 's/ duplicate$//' | awk '!seen[$0]++' || true)"
      fi
      if [ -n "$droprenum" ]; then
        echo "claude-sync: the other Mac renumbered an entry you had not sent yet, so your old-numbered copy was dropped and its renumbered version kept ($p: $(printf '%s' "$droprenum" | tr '\n' ';' | sed 's/;$//')). Nothing was lost: the text is identical and your previous copy is beside it as .syncbak." >&2
        notify "$p: dropped an entry the other Mac renumbered"
        settle_renumber_mentions "$tmpr" "$PAYLOAD/$p" "$p" <<RENUMBERED
$droprenum
RENUMBERED
      fi
      if [ -n "$dropdup" ]; then
        echo "claude-sync: both Macs held the same entry under the same number, so the duplicate copy was dropped and one kept ($p: $(printf '%s' "$dropdup" | tr '\n' ';' | sed 's/;$//')). No number changed here and nothing needs chasing: the two copies were byte identical, and your previous copy is beside it as .syncbak." >&2
        notify "$p: dropped a duplicate copy of an entry"
      fi
      # Read-only here, deliberately: a pull is not where a Mac should be claiming anything, and
      # a Mac that has never asked for a number has no band yet. With one, the renumbered entry
      # lands inside this Mac's own band, which is the point; without one this behaves exactly as
      # it always did.
      band="$(recorded_lesson_band)"
      start="$(next_lesson_number "$CLAUDE_HOME" "$band")"; start="${start#L}"
      if [ -n "$band" ]; then fmax="$(highest_lesson_in_band "$band" "$tmpr" "$PAYLOAD/$p")"
      else fmax="$(highest_lesson_in "$tmpr" "$PAYLOAD/$p")"; fi
      [ "$((fmax + 1))" -gt "$start" ] && start="$((fmax + 1))"
      collided="$(renumber_merge_collisions "$tmpr" "$PAYLOAD/$p" "$start")"
      if [ -n "$collided" ]; then
        echo "claude-sync: both Macs had used the same lesson number for different entries, so this Mac's unsent entry was renumbered to the next free number and the published one keeps the number, which the other Mac may already reference ($p: $(printf '%s' "$collided" | tr '\n' ';' | sed 's/;$//')). The renumbered entry publishes on the next send; your previous copy is beside it as .syncbak." >&2
        notify "$p: renumbered an unsent entry after a number collision"
        settle_renumber_mentions "$tmpr" "$PAYLOAD/$p" "$p" <<COLLIDED
$collided
COLLIDED
      fi
      keep_prior_copy "$local_f"
      cp "$tmpr" "$local_f"
      MERGED_RULE_FILES="$MERGED_RULE_FILES
$p"
      reported="$reported$p "
    fi
    rm -f "$tmpb" "$tmpm" "$tmpr"
  done < <(unapplied_paths)
  if ! is_blank "$reported"; then
    echo "claude-sync: both Macs had edited these rule files, so their entries were MERGED and nothing was dropped (your previous copy is beside them as .syncbak): ${reported}" >&2
    notify "merged rule files: ${reported}"
  fi
  return 0
}

# WHAT A MERGE PRODUCED HAS TO REACH THE REPO (claude-config#312).
#
# On 2026-09-04 a reconcile merged LESSONS.md and printed both "nothing was dropped" and
# "Synced (sent local changes, pulled remote)". Both sentences were true ABOUT THE LIVE COPY under
# ~/.claude, which held 472 lessons, while the copy committed in the repo held 468. Four entries
# existed on one machine only, so the other Mac would never have received them and anything that
# overwrote that file would have destroyed them. The regenerated index made it worse by sitting in
# three states at once: 463 committed, 468 uncommitted in the payload, and 472 live.
#
# The mechanism is the ORDER, not the merge. Staging holds back a path this Mac has not applied
# yet, so the local entry is not published; the pull brings the other Mac's version; and the apply
# merges the two into the LIVE file, which by then nothing sends. So the run that merges cannot say
# whether its merge reached the repo, and it reported success either way (L3, L98).
#
# Two halves, and the second is the one that matters. The merge is staged and pushed through the
# ONE path that publishes anything, so every guard deciding what may travel still decides it, and
# the regenerated index rides in the same commit as the file it describes. Then the repo is READ
# BACK and the run refuses its success line until the entries are actually there. Compared in the
# unit the meaning lives in, the entry labels, not whole lines, because a re-wrap changes every
# line boundary and loses no words (L278).
publish_merged_rule_files(){
  local p detail missing="" published="" branch tmp
  is_blank "${MERGED_RULE_FILES:-}" && return 0
  if ! have_git; then
    # Said rather than skipped. Without git there is no repo to reach, so the merge is genuinely
    # local, and that is a different answer from "it got there" (L11, L98).
    echo "claude-sync: rule files were merged on this Mac, and there is no git here, so nothing could be published and they exist only in $CLAUDE_HOME." >&2
    return 0
  fi
  stage_local_to_payload
  commit_if_changed || true
  # Not pushed at a GUESSED ref: with HEAD detached the old fallback pushed at the literal `main`
  # while something else was checked out (claude-config#324). The commit is made either way and
  # goes out on the next run, so saying so beats acting on a ref nobody chose.
  if branch="$(sync_branch)"; then
    if git -C "$SYNC_REPO" remote get-url origin >/dev/null 2>&1; then
      git -C "$SYNC_REPO" push -u origin "$branch" -q 2>/dev/null || true
    fi
  else
    echo "claude-sync: the merged rule files were committed here but NOT pushed, because this clone has no branch checked out (HEAD is detached), so there is no ref to push them at. They go out on the next run once $SYNC_REPO is back on a branch." >&2
  fi
  # Read back from the COMMIT, never from the payload directory. A file sitting in the working tree
  # is exactly the state this issue is about: it looks published and is not (L3).
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    tmp="$(scratch_file)"
    if ! git -C "$SYNC_REPO" show "HEAD:payload/$p" > "$tmp" 2>/dev/null; then
      missing="${missing:+$missing; }$p (the repo has no copy of it at all)"
      rm -f "$tmp"; continue
    fi
    detail="$(only_in_first "$CLAUDE_HOME/$p" "$tmp")"
    rm -f "$tmp"
    if is_blank "$detail"; then published="$published$p "
    else missing="${missing:+$missing; }$p ($detail)"; fi
  done <<MERGED_PUBLISH
${MERGED_RULE_FILES:-}
MERGED_PUBLISH
  if [ -n "$missing" ]; then
    notify "a merged rule file did NOT reach the shared repo"
    die "the entries merged on this Mac did NOT reach the repo: $missing. They exist only in $CLAUDE_HOME, so the other Mac cannot receive them and anything that overwrites that file destroys them. Nothing is lost yet, and this is NOT a failure of the merge. A message above says why the file was held back; settle that and run 'claude-sync sync' again."
  fi
  is_blank "$published" && return 0
  # Level with the shared repo, or not, said either way. Committed and unpushed is a real state
  # with a real remedy (the next send carries it), and reporting it as published would be the same
  # false success one level along (L11).
  if unpushed_commits; then
    echo "claude-sync: the entries merged on this Mac were committed here (${published% }) and the push did NOT go through, so they are safe but the other Mac has not got them yet. The next send carries them." >&2
  else
    echo "claude-sync: the entries merged on this Mac were published to the shared repo (${published% }), so the other Mac receives them and the two copies hold the same entries." >&2
  fi
  return 0
}

# The same fact on a path that does not send (claude-config#312). A pull RECEIVES, so the merge it
# produces is genuinely local until something sends it, and saying nothing left "nothing was
# dropped" and "Pulled shared config onto this Mac" reading as though the two copies now agreed.
report_unpublished_merge(){
  is_blank "${MERGED_RULE_FILES:-}" && return 0
  echo "claude-sync: the entries merged on this Mac are in $CLAUDE_HOME only. A pull does not send, so they reach the other Mac on the next send: the watcher picks the change up on its own, or run 'claude-sync sync' now." >&2
  return 0
}

# Entry labels present in the first file but not the second, where an entry is a
# self naming list item ("- **L47. ...**"). Naming only the FILE, as this used to,
# reads as resolved when a lesson that existed nowhere else has just left it.
local_only_entries(){   # $1 = ours  $2 = theirs
  comm -23 \
    <(grep -oE '^- \*\*[^.*]+\.' "$1" 2>/dev/null | sed 's/^- \*\*//; s/\.$//' | sort -u) \
    <(grep -oE '^- \*\*[^.*]+\.' "$2" 2>/dev/null | sed 's/^- \*\*//; s/\.$//' | sort -u) \
    2>/dev/null | tr '\n' ' '
}

# What one file holds that the other does not: the entry names when it is a rule file, and a line
# count when it is anything else. Empty means nothing at all is only in the first, which is a
# DIFFERENT answer from "could not tell" and is what lets a set-aside copy be called resolved.
#
# One definition, used both when a conflict is created and every time one is reported afterwards.
# Written twice, the two would answer differently about the same pair of files, and the report that
# persists is the one nobody would check (L16).
# How many of the first file's lines hold WORDS the second file does not already carry somewhere.
#
# Counting lines that differ was the whole defect (claude-config#212). Re-flowing a paragraph keeps
# every word and changes every line boundary, so a copy whose sentences were all present verbatim in
# the live file, merely wrapped differently, was reported as 4 lines "still only there". The one
# report of content that exists in no loaded file cannot afford to fire on files needing no action,
# because that is what teaches the reader to skim it (L36). L278 is the rule: compare in the unit
# the meaning lives in, not the unit the file happens to be stored in.
#
# So a line is accounted for when its own words appear, in order and together, anywhere in the other
# file read as one body. Re-wrapping preserves word order, so a re-wrap goes quiet; a deleted clause
# does not appear at all and is still counted. A leading comment marker is stripped from both sides
# first, or the "#" starting each wrapped line lands in the middle of the body and no re-wrapped line
# can ever match (the observed case was a comment header, so this is the case, not a corner).
#
# One awk process reading both, rather than a shell loop spawning two per candidate line: the inputs
# here are whole rule files, and this runs once per set-aside copy on every status and every pull.
unaccounted_line_count(){   # $1 = ours  $2 = theirs
  comm -23 <(sort -u "$1") <(sort -u "$2") 2>/dev/null | awk -v theirs="$2" '
    function collapse(s) {
      sub(/^[[:space:]]*#+[[:space:]]*/, "", s)
      gsub(/[[:space:]]+/, " ", s)
      sub(/^ /, "", s); sub(/ $/, "", s)
      return s
    }
    BEGIN {
      body = ""
      while ((getline l < theirs) > 0) body = body " " collapse(l)
      gsub(/[[:space:]]+/, " ", body)
    }
    { c = collapse($0); if (c == "") next; if (index(body, c) == 0) n++ }
    END { print n+0 }
  '
}

only_in_first(){   # $1 = ours  $2 = theirs
  local detail n
  [ -f "$1" ] || return 0
  if [ ! -f "$2" ]; then printf 'the live file is gone'; return 0; fi
  detail="$(local_only_entries "$1" "$2")"
  if is_blank "$detail"; then
    n="$(unaccounted_line_count "$1" "$2")"
    [ "${n:-0}" -gt 0 ] && detail="${n} lines"
  fi
  printf '%s' "${detail% }"
  return 0
}

# Does the local side hold anything the arriving side does not already have (claude-config#177)?
#
# The 2026-08-22 pull wrote a .conflict copy of hooks/test-run-all-tests.sh whose every line was
# already in the applied version. Each of those costs a manual line by line comparison to find out
# that nothing was at stake, and leaves a stale file in ~/.claude/hooks that nobody deletes.
#
# It is TWO questions, not one, and answering only the first would destroy work. A local file that
# adds nothing is contained. So is a local file that DELETED a line the arriving side still
# carries, and that one has work to lose with no other copy of it anywhere (L5). The base, meaning
# the version this Mac last applied, is the only thing that tells them apart, so a base that cannot
# be read is a refusal rather than a permission: nothing is resolved on a question this could not
# ask (L42).
# A copy of what an automatic resolution dropped, and the sweep that eventually removes it
# (claude-config#183).
#
# #177 takes the arriving version and writes no .conflict copy when this Mac's version held nothing
# extra. That is the single path where a locally modified file is replaced with nothing kept
# anywhere, and while the judgement is guarded in both directions a guard is not a recovery (L5).
#
# It expires on its own rather than being reported until somebody deletes it, which is the standing
# nag #177 removed. Two weeks is twice the longest real gap between one Mac's syncs, re-derived
# 2026-08-21 by tools/measure-sync-gaps.sh as 6.79 days, so a Mac that was away for the worst
# absence ever measured still comes back to find the copy there.
SYNC_RESOLVED_MAX_AGE_DEFAULT=1209600
keep_resolved_copy(){   # $1 = payload path  $2 = the live local file about to be replaced
  local flat
  mkdir -p "$RESOLVED_DIR" 2>/dev/null || return 0
  flat="${1//\//_}"
  cp "$2" "$RESOLVED_DIR/$flat.$(date +%s)" 2>/dev/null || true
  return 0
}
sweep_resolved_copies(){
  local now f m max
  max="${SYNC_RESOLVED_MAX_AGE:-1209600}"
  case "$max" in ''|*[!0-9]*) max="$SYNC_RESOLVED_MAX_AGE_DEFAULT" ;; esac
  [ "$max" -gt 0 ] || return 0
  [ -d "$RESOLVED_DIR" ] || return 0
  now="$(date +%s)"
  for f in "$RESOLVED_DIR"/*; do
    [ -f "$f" ] || continue
    m="$(file_mtime "$f")"
    # Unreadable age counts as recent, so a copy whose date cannot be read is kept rather than
    # deleted on a guess: this directory exists to hold the only copy of something (L5).
    case "$m" in ''|*[!0-9]*) continue ;; esac
    [ "$(( now - m ))" -gt "$max" ] && rm -f "$f" 2>/dev/null
  done
  return 0
}

local_side_contained(){   # $1 = payload path  $2 = the live local file  $3 = last applied commit
  local ours theirs base rc=0 left
  [ -f "$PAYLOAD/$1" ] || return 1
  ours="$(scratch_file)" || return 1
  theirs="$(scratch_file)" || { rm -f "$ours"; return 1; }
  base="$(scratch_file)" || { rm -f "$ours" "$theirs"; return 1; }
  # Line ORDER is deliberately not part of this. Two files holding the same lines in a different
  # order are a reordering, and the applied version's order is the one both Macs will converge on.
  sort -u "$2" > "$ours" 2>/dev/null || rc=1
  payload_local_view "$1" 2>/dev/null | sort -u > "$theirs" || rc=1
  blob_local_view "$1" "$3" 2>/dev/null | sort -u > "$base" || rc=1
  if [ "$rc" -eq 0 ]; then
    # Anything only in ours is work that exists nowhere else.
    left="$(comm -23 "$ours" "$theirs" 2>/dev/null | grep -c . || true)"
    case "$left" in ''|*[!0-9]*) rc=1 ;; *) [ "$left" -eq 0 ] || rc=1 ;; esac
  fi
  if [ "$rc" -eq 0 ]; then
    # A line the base and the arriving side BOTH still carry, missing from ours, is a deletion this
    # Mac made and has not sent. Contained by lines, and not contained by intent.
    left="$(comm -12 "$base" "$theirs" 2>/dev/null | comm -23 - "$ours" 2>/dev/null | grep -c . || true)"
    case "$left" in ''|*[!0-9]*) rc=1 ;; *) [ "$left" -eq 0 ] || rc=1 ;; esac
  fi
  rm -f "$ours" "$theirs" "$base"
  return "$rc"
}

preserve_local_conflicts(){
  local last p local_f sfx saved="" detail resolved=""
  have_git || return 0
  last="$(cat "$LAST_APPLIED_FILE" 2>/dev/null || true)"
  [ -n "$last" ] || return 0
  sfx="$(conflict_suffix)"
  sweep_resolved_copies
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    # merged above, so both sides are already in the file: not a conflict
    case "${MERGED_RULE_FILES:-}" in *"
$p"*) continue ;; esac
    # Generated from another file, and regenerated later in this same apply, so the two copies
    # cannot represent work that is at risk. On 2026-08-18 this path announced that both Macs had
    # changed LESSONS-INDEX.md and that YOUR version had been kept beside it, when the arriving
    # file was a strict superset of the preserved one and the only line unique to it was a stale
    # header count. That is a false alarm on the most safety critical message this tool prints,
    # and false alarms are what teach a person to skim past a real one (L36). It also left a
    # .conflict copy that status went on naming until somebody deleted it by hand.
    is_derived_rule_file "$p" && continue
    local_f="$CLAUDE_HOME/$p"
    [ -f "$local_f" ] || continue
    # unchanged here since our last apply: nothing of ours to lose. Compared as the file LOOKS
    # here, not as it is stored: a tokenized file differs from its stored form by construction,
    # and reading that as an edit would set aside a copy of every one of them on every pull (#87).
    if blob_local_view "$p" "$last" 2>/dev/null | cmp -s - "$local_f"; then continue; fi
    # already identical to what is arriving: not a conflict either
    if [ -f "$PAYLOAD/$p" ] && payload_local_view "$p" | cmp -s - "$local_f"; then continue; fi
    # Nothing of ours is missing from what is arriving, and nothing of ours was a deletion, so the
    # arriving version already holds every line this one had. Taken, with no copy set aside, and
    # SAID: this file did conflict and was decided in favour of the other Mac, and a decision
    # settled in silence is one nobody can disagree with (L11, claude-config#177).
    if local_side_contained "$p" "$local_f" "$last"; then
      keep_resolved_copy "$p" "$local_f"
      resolved+="$p "
      continue
    fi
    cp "$local_f" "$local_f$sfx"
    # This run's own copies, so the standing report below does not repeat what the line beneath is
    # about to say. It is only ever about copies an EARLIER run left behind.
    PRESERVED_CONFLICTS="$PRESERVED_CONFLICTS
$p$sfx"
    # Say what is actually at stake in this file, not just its name.
    detail=""
    [ -f "$PAYLOAD/$p" ] && detail="$(only_in_first "$local_f" "$PAYLOAD/$p")"
    if ! is_blank "$detail"; then saved+="$p [only in yours: ${detail% }] "; else saved+="$p "; fi
  done < <(unapplied_paths)
  if ! is_blank "$resolved"; then
    # Its own message, and deliberately not folded into the one below: a file that needed no copy
    # and one whose only copy is now sitting beside it are different outcomes, and reporting them
    # in one sentence would make the second read as reassuring as the first (L11).
    echo "claude-sync: both Macs changed these files, but this Mac's version held no line the other Mac's version did not already have, so the other Mac's version was applied and nothing was set aside beside them. A copy of what this Mac had is in $RESOLVED_DIR for $(duration_in_words "${SYNC_RESOLVED_MAX_AGE:-$SYNC_RESOLVED_MAX_AGE_DEFAULT}"): ${resolved}" >&2
  fi
  is_blank "$saved" && return 0
  echo "claude-sync: both Macs changed these files and they could NOT be merged automatically, so the other Mac's version was applied and YOUR version was kept next to it with the suffix $sfx: ${saved}" >&2
  notify "conflict kept as *$sfx: ${saved}"
  return 0
}

# Is one payload path already in effect on this Mac? Comparing bytes is right for
# everything the apply writes as a plain file, and wrong for everything it does
# not. settings.hooks.json is merged INTO settings.json and never lands under its
# own name; a plugin-managed skill is deliberately never applied at all. Compared
# against a counterpart that will never exist, those read as "not applied" on
# every run, which is the same permanent wedge this guard was just fixed for.
payload_path_applied(){   # $1 = path relative to payload/
  local p="$1" frag s name
  case "$p" in
    settings.hooks.json)
      [ -f "$PAYLOAD/$p" ] || return 0
      command -v jq >/dev/null 2>&1 || return 0
      [ -f "$CLAUDE_HOME/settings.json" ] || return 1
      frag="$(detok < "$PAYLOAD/$p")" || return 1
      # Compare the hooks block itself, not the file's bytes. settings.json is
      # hand-edited and tool-edited, so its formatting drifts from what jq would
      # emit; asking whether the rendered file matches would answer "no" forever
      # on nothing but whitespace, and wedge sending all over again.
      jq -e --argjson frag "$frag" '(.hooks // {}) == ($frag.hooks // {})' \
        "$CLAUDE_HOME/settings.json" >/dev/null 2>&1
      return $?
      ;;
    settings.json) return 0 ;;   # never applied wholesale; the hooks block owns it
  esac
  for s in $(skill_excludes); do
    name="${s#--exclude=}"
    [ -n "$name" ] || continue
    case "$p" in "skills/$name"|"skills/$name"/*) return 0 ;; esac
  done
  if [ ! -e "$PAYLOAD/$p" ]; then
    # the repo removed it: applied here once this Mac no longer has it either
    [ ! -e "$CLAUDE_HOME/$p" ]
    return $?
  fi
  [ -f "$CLAUDE_HOME/$p" ] || return 1
  # Through the local view, never the raw bytes: a tokenized file cannot equal its payload copy,
  # so a raw comparison answers "not applied" for ever (#87).
  payload_local_view "$p" | cmp -s - "$CLAUDE_HOME/$p"
}

unapplied_remote_changes(){
  have_git || return 1
  local head last branch upstream p
  git -C "$SYNC_REPO" fetch -q origin 2>/dev/null || true
  head="$(repo_head)"
  last="$(cat "$LAST_APPLIED_FILE" 2>/dev/null || true)"
  # Never applied here yet (fresh clone, or first run of this version): there is
  # no recorded state to protect, and blocking would wedge a first push.
  [ -n "$last" ] || return 1
  # The server holding commits this Mac does not have is the real "behind": their
  # work is on its way here and mirroring over it reverts them. Mind the
  # direction. A commit made here and not yet pushed also makes HEAD differ from
  # origin, and reading THAT as behind wedges sending in the one state where
  # sending is exactly what resolves it.
  # Fails CLOSED (L42). This decides whether it is safe to mirror upward, and mirroring while the
  # clone is in a state this cannot read is exactly how the other Mac's work gets reverted. With
  # HEAD detached the old fallback compared against `origin/main` regardless of what was checked
  # out, which is a comparison against a ref nobody chose (claude-config#324).
  if ! branch="$(sync_branch)"; then
    echo "claude-sync: treating this Mac as behind, because this clone has no branch checked out (HEAD is detached) and there is no ref to compare against the shared repo. Nothing will be sent until $SYNC_REPO is back on a branch." >&2
    return 0
  fi
  upstream="$(git -C "$SYNC_REPO" rev-parse --verify -q "origin/$branch" 2>/dev/null || true)"
  if [ -n "$upstream" ] && [ -n "$head" ]; then
    if ! git -C "$SYNC_REPO" merge-base --is-ancestor "$upstream" "$head" 2>/dev/null; then
      return 0
    fi
  fi
  # This Mac now holds every commit the server does, so the only question left is
  # whether HEAD's payload is really on disk here. HEAD versus .last-applied
  # cannot answer it: a commit authored HERE moves HEAD with no apply step behind
  # it, while its content is already applied by construction. That is any hand
  # commit made while editing this tool, and every `claude-sync push`. On
  # 2026-07-28 it read as behind and dropped 81 minutes of sends, each one
  # notifying that the user should pull, with nothing to pull. Compare the bytes
  # of what the repo actually changed, and repair the marker when they agree so
  # the state cannot persist.
  [ "$head" != "$last" ] || return 1
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    payload_path_applied "$p" || return 0
  done < <(unapplied_paths)
  printf '%s\n' "$head" > "$LAST_APPLIED_FILE" 2>/dev/null || true
  return 1
}

# Fail loud when the global rule files reference something that is not here.
# CLAUDE.md pulls in extra rule files with a leading "@file" line; when the
# target is missing, Claude Code loads nothing from it and reports nothing, so an
# entire rules file can be silently absent from every session. A sync that leaves
# that state must not report success.
# Walks every rule file in the derived set, not just CLAUDE.md: a reference two
# hops down is just as silent when it dangles.
verify_rule_imports(){
  local f line target missing=""
  [ -f "$CLAUDE_HOME/CLAUDE.md" ] || return 0
  for f in $(top_files_in "$CLAUDE_HOME"); do
    [ -f "$CLAUDE_HOME/$f" ] || continue
    while IFS= read -r line; do
      case "$line" in '@'?*) ;; *) continue ;; esac
      target="${line#@}"
      target="${target%%[[:space:]]*}"
      [ -n "$target" ] || continue
      case "$target" in
        '~/'*) target="$HOME/${target#\~/}" ;;
        /*)    ;;
        *)     target="$CLAUDE_HOME/$target" ;;
      esac
      [ -e "$target" ] || missing+="${line#@} "
    done < "$CLAUDE_HOME/$f"
  done
  is_blank "$missing" && return 0
  die "these rule files are referenced but are not on this Mac: ${missing}(referenced but never copied, so their rules load silently as nothing). Re-run 'claude-sync pull'; if it persists, check that the referencing file is itself synced."
}

# Commit synced config changes (identity baked in so it works headless). Scoped to
# payload/ ONLY: the auto-sync must never sweep up an in-progress edit to the tool
# itself (claude-sync/tests/README) — those are committed deliberately by hand and
# ride up on the next push.
commit_if_changed(){
  # ONLY payload. The applied-markers (#23) deliberately do NOT ride along here: staging them
  # was tried and measured, and it turned 27 unrelated tests red, because a marker commit is
  # a commit the other Mac does not have, which the guard against publishing while behind
  # reads as behind and then skips every send. They go on their own ref instead, see
  # publish_applied_marker.
  git -C "$SYNC_REPO" add -A -- payload
  git -C "$SYNC_REPO" diff --cached --quiet -- payload && return 1
  git -C "$SYNC_REPO" "${SYNC_GIT_IDENTITY[@]}" \
    commit -m "sync from $(hostname -s)" >/dev/null
  # This run now holds something the repo does not. Recorded here, at the one place a commit is
  # ever made, rather than at each push site: which subcommand ran is not what decides whether a
  # send happened (#79).
  note_unsent_work
  return 0
}

# True when this branch holds commits the remote does not have. The "ride up on the
# next push" promise in the comment above was not kept: push and sync both decided
# whether to push from whether commit_if_changed had just made one, so a deliberate
# commit to the tool itself was never sent and push printed "already up to date" over
# a branch that was ahead. Ask the repo what is unpushed instead of inferring it from
# what we happened to do this run, so it holds for a commit made by hand, by an
# editor, or by an earlier run that died between committing and pushing.
# No upstream yet means there is nothing to be ahead OF: the caller's -u push creates
# it, so report false rather than guessing at a branch name.
unpushed_commits(){
  local up n
  up="$(git -C "$SYNC_REPO" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)"
  [ -n "$up" ] || return 1
  n="$(git -C "$SYNC_REPO" rev-list --count "$up..HEAD" 2>/dev/null || echo 0)"
  [ "${n:-0}" -gt 0 ]
}

# ---------- push ----------
# ---------- an unfinished rebase a previous run left behind (claude-config#324) ----------
#
# The tool resolves conflicts INSIDE its own rebase, but nothing ever asked whether a PREVIOUS run
# left one unfinished. Found on 2026-09-07: ~/claude-config-sync had been on `(no branch, rebasing
# main)` since 2026-09-06 12:16, about 23 hours. The rebase had applied its commit and had an empty
# todo with a clean tree, so it was nobody's conflict to resolve, just a rebase nobody concluded.
# `main` still pointed at the pre rebase commit while HEAD held the rebased one, the clone stopped
# exchanging config, and no run noticed.
#
# Three states, told apart because they need three different actions and one message covering them
# would hide the two it did not name (L11):
#   none         nothing in progress
#   concludable  in progress, no work left in the todo, nothing unmerged: finishing it is safe
#   conflict     in progress with paths still unmerged: only a person can settle that
sync_rebase_dir(){   # prints the directory of an in progress rebase, or nothing
  local d
  for d in rebase-merge rebase-apply; do
    d="$(git -C "$SYNC_REPO" rev-parse --git-path "$d" 2>/dev/null || true)"
    [ -n "$d" ] || continue
    case "$d" in /*) ;; *) d="$SYNC_REPO/$d" ;; esac
    [ -d "$d" ] && { printf '%s' "$d"; return 0; }
  done
  return 1
}

# The paths git is still waiting on. Named rather than counted, because "resolve the conflict" with
# no path is an instruction somebody has to go and reconstruct (L80, L399).
sync_rebase_conflict_paths(){
  git -C "$SYNC_REPO" diff --name-only --diff-filter=U 2>/dev/null | sort -u
}

sync_rebase_state(){   # -> none | concludable | conflict
  local dir todo left
  dir="$(sync_rebase_dir)" || { printf 'none'; return 0; }
  if [ -n "$(sync_rebase_conflict_paths)" ]; then printf 'conflict'; return 0; fi
  # A todo still holding work is not this run's to finish either: continuing it would replay
  # commits nobody here asked for. Comments and blank lines are not work.
  todo="$dir/git-rebase-todo"
  if [ -f "$todo" ]; then
    left="$(grep -cEv '^[[:space:]]*(#|$)' "$todo" 2>/dev/null || true)"
    case "$left" in ''|*[!0-9]*) left=0 ;; esac
    [ "$left" -gt 0 ] && { printf 'conflict'; return 0; }
  fi
  printf 'concludable'
}

# Called once per mutating run, from with_lock, which is the one place every one of them passes
# through and where the lock makes it safe to touch the repository at all.
recover_unfinished_rebase(){
  local state paths err
  have_git || return 0
  [ -d "$SYNC_REPO/.git" ] || [ -f "$SYNC_REPO/.git" ] || return 0
  state="$(sync_rebase_state)"
  case "$state" in
    none) return 0 ;;
    conflict)
      paths="$(sync_rebase_conflict_paths | tr '\n' ' ' | sed 's/ $//')"
      die "this clone was left mid rebase by an earlier run and is still waiting on a conflict in: ${paths:-a step of the rebase that has not been applied}. NOTHING was changed here. Settle it in $SYNC_REPO, then 'git -C $SYNC_REPO rebase --continue', or abandon that rebase with 'git -C $SYNC_REPO rebase --abort'. Until then this Mac cannot send or receive config." ;;
  esac
  # Concludable. GIT_EDITOR is disarmed because `rebase --continue` opens one for the commit
  # message of a step it is finishing, and a run under launchd has no terminal to open it in: it
  # would hang rather than fail, which is worse (L110).
  # The tool's OWN identity, the same one every other commit it makes is signed with
  # (claude-config#335). Concluding a rebase writes a commit, and this ran without one: on a
  # machine where git can find an identity it borrowed the operator's and worked, and on a machine
  # where it cannot, which is every CI runner and any Mac nobody has configured git on, git refused
  # with "Committer identity unknown" and this clone was declared unable to send or receive. The
  # tool has never needed the operator's identity for anything it does by itself.
  if err="$(cd "$SYNC_REPO" && GIT_EDITOR=true git "${SYNC_GIT_IDENTITY[@]}" rebase --continue 2>&1)"; then
    echo "claude-sync: concluded an unfinished rebase an earlier run left in this clone. There was no conflict outstanding and nothing to merge, only a rebase nobody finished, and it was holding this Mac off the shared config. Now on $(git -C "$SYNC_REPO" symbolic-ref --short HEAD 2>/dev/null || echo 'no branch')." >&2
    notify "concluded an unfinished rebase in the sync clone"
    return 0
  fi
  die "this clone was left mid rebase by an earlier run, and concluding that rebase failed, so NOTHING was changed here. git said: ${err:-<no output>}. Settle it in $SYNC_REPO by hand ('git -C $SYNC_REPO rebase --continue' or 'git -C $SYNC_REPO rebase --abort'). Until then this Mac cannot send or receive config."
}

# The branch this clone is on, or a REFUSAL (claude-config#324).
#
# Five call sites each read this as `symbolic-ref --short HEAD || echo main`. When HEAD is detached
# that fallback hands every one of them the literal string `main` while something else is checked
# out, so a run can commit, push or compare against a ref nobody chose, and nothing says so (L320).
# One reader, and it answers "I cannot tell you" rather than guessing; each caller decides what to
# do with that, because refusing a push and refusing a comparison are not the same decision.
sync_branch(){   # prints the branch and returns 0, or prints nothing and returns 1
  git -C "$SYNC_REPO" symbolic-ref --short HEAD 2>/dev/null
}

do_push(){
  stage_local_to_payload
  echo "Staged config into $PAYLOAD"
  if have_git; then
    local staged=0
    commit_if_changed && staged=1
    if [ "$staged" -eq 1 ] || unpushed_commits; then
      git -C "$SYNC_REPO" push && echo "Pushed."
    else echo "Nothing changed — repo already up to date."; fi
  fi
}

# ---------- self-change detection + watch-daemon restart ----------
# The watch daemon (launchd KeepAlive) loads this script once at process
# start and keeps running that code for its whole lifetime -- a pulled edit
# to claude-sync itself does NOT take effect until the daemon restarts.
# Detect that case around every git pull and restart it automatically so a
# script fix from either Mac always takes effect without a manual step.
# --verify -q, not bare rev-parse: on a repo with no commits yet (a brand new
# Mac's clone before its first pull), bare rev-parse prints the literal string
# "HEAD" to stdout, which then masquerades as a diffable commit downstream.
repo_head(){ git -C "$SYNC_REPO" rev-parse --verify -q HEAD 2>/dev/null || true; }
script_changed_between(){
  local before="$1" after="$2"
  [ -n "$after" ] || return 1
  # First pull into an empty-history clone: the script itself just arrived, so
  # a watcher running any older copy must restart. Treat as changed.
  [ -n "$before" ] || return 0
  [ "$before" != "$after" ] || return 1
  # Read once into a variable, then matched. Written as `git diff ... | grep -qx`, the consumer
  # exits on its first match, the producer dies of SIGPIPE, and under `pipefail` the pipeline's
  # status becomes that death: the answer would then be "claude-sync did not change" precisely
  # when it DID, and the run would go on applying stale logic on the very pull that delivered the
  # new version (L183). Whether it fires depends on nothing but whether git finished writing
  # first, so it is rare, silent, and worst on the biggest pulls.
  local changed
  changed="$(git -C "$SYNC_REPO" diff --name-only "$before" "$after" 2>/dev/null || true)"
  case "
$changed" in *"
claude-sync
"*|*"
claude-sync") return 0 ;; esac
  return 1
}
# A pull that updates claude-sync itself has been executing the OLD copy since
# the process started, so the apply step that follows runs stale logic: anything
# the new version added to the synced set (a TOP_FILES entry, a mirrored dir) is
# skipped on the very pull that delivered it, and only lands on the NEXT pull.
# That is how CLAUDE.md once arrived importing a LESSONS.md that was never
# copied. Hand off to the freshly pulled copy BEFORE applying anything.
# SYNC_PULL_BASE carries the pre-pull commit so the child still reports the whole
# pull; SYNC_REEXECED makes a second hand-off (and so a loop) impossible.
reexec_after_self_update(){   # $1 before  $2 after  $3 command for the child
  [ "${SYNC_REEXECED:-0}" = "1" ] && return 1
  script_changed_between "$1" "$2" || return 1
  [ -s "$SYNC_REPO/claude-sync" ] || return 1
  pulled_script_ok || return 1
  # SYNC_LOCK travels too: the resumed run must look at the same lock this one is holding,
  # not fall back to the default path and take a second one.
  export SYNC_REEXECED=1 SYNC_PULL_BASE="$1" CLAUDE_HOME SYNC_REPO SYNC_LOCK
  # exec REPLACES this process, so its EXIT trap never runs and the send stamp taken there would
  # be lost. A sync whose push went up and which then handed off to the updated script would
  # report "never sent" for work that provably left this Mac, which is the defect this stamp
  # exists to fix arriving by a different door (#79).
  record_sent_if_shipped
  exec bash "$SYNC_REPO/claude-sync" "$3"
}

# Never hand control to, or restart the watch daemon into, a script that cannot
# parse. Bash executes a script incrementally, so where the error sits decides the
# damage: a trailing one runs the whole pull and only then complains, while an
# error early in the file aborts before anything is applied, which would leave
# this Mac's config frozen until someone fixed the other Mac. Degrading to the
# copy already loaded keeps the sync working with older logic in the meantime.
SCRIPT_SELF_BROKEN=0
pulled_script_ok(){
  [ "$SCRIPT_SELF_BROKEN" -eq 1 ] && return 1
  if bash -n "$SYNC_REPO/claude-sync" 2>/dev/null; then
    # Parsing is not enough. A script can parse and still die on its first real step: an
    # unbound variable under `set -u`, a helper that was renamed, a command absent from THIS
    # Mac. This path then re-execs automatically on both Macs with nobody watching, and a
    # bad version breaks the very thing that would otherwise deliver the fix. So run it, in
    # throwaway directories where it can touch nothing real, and require it to finish. (#28)
    local d rc=0
    # Named, not a bare `mktemp -d`: an anonymous directory cannot be attributed to this tool
    # afterwards, so a run killed here leaves scratch nothing can ever reclaim (#36).
    d="$(mktemp -d "$(scratch_home_ready)/claude-sync-selftest.XXXXXXXX")" || return 0
                                    # cannot test it: fall back to the parse result, which is
                                    # what this gate did before, rather than block an update
                                    # over a temp directory problem
    mkdir -p "$d/home" "$d/repo/payload" 2>/dev/null && printf '{"hooks":{}}\n' > "$d/home/settings.json" 2>/dev/null || { rm -rf "$d"; return 0; }
    CLAUDE_HOME="$d/home" SYNC_REPO="$d/repo" SYNC_NO_GIT=1 SYNC_NO_NOTIFY=1 \
      SYNC_LOCK="$d/lock" bash "$SYNC_REPO/claude-sync" status >/dev/null 2>&1 || rc=$?
    rm -rf "$d" 2>/dev/null || true
    [ "$rc" -eq 0 ] && return 0
    SCRIPT_SELF_BROKEN=1
    # Deliberately its own message. A script that will not parse and one that parses but
    # cannot run are different faults with different causes, and reporting them identically
    # sends the diagnosis to the wrong place.
    echo "claude-sync: the pulled claude-sync parses but cannot complete a run (it exited $rc on a harmless read-only check), so this run kept the copy already running and left the watch daemon alone. That version is on disk here and later runs of it will fail until the Mac that pushed it pushes a fix; recover with: git -C $SYNC_REPO pull" >&2
    notify "pulled claude-sync fails to run; kept the older copy"
    return 1
  fi
  SCRIPT_SELF_BROKEN=1
  echo "claude-sync: the pulled claude-sync does not parse, so this run kept the copy already running and left the watch daemon alone. That broken copy is now on disk here, so later runs of it will fail until the Mac that pushed it pushes a fix; recover with: git -C $SYNC_REPO pull" >&2
  notify "pulled claude-sync does not parse; kept the older copy"
  return 1
}
restart_watch_daemon_if_installed(){
  local agentdir="${SYNC_LAUNCHAGENTS:-$HOME/Library/LaunchAgents}"
  [ -f "$agentdir/com.claudesync.watch.plist" ] || return 0
  if [ "${SYNC_NO_LAUNCHCTL:-0}" = "1" ]; then
    echo "claude-sync script changed: would restart the watch daemon (SYNC_NO_LAUNCHCTL=1, skipped)."
    return 0
  fi
  if launchctl kickstart -k "gui/$(id -u)/com.claudesync.watch" 2>/dev/null; then
    echo "claude-sync script changed: restarted the watch daemon to pick it up."
  fi
}

# Which of the received paths a session that is ALREADY running will keep
# ignoring. Claude Code reads the rule files (CLAUDE.md and its @imports) once, at
# session start, and builds its list of available skills/agents/commands then too,
# so those changes reach only the NEXT session. Hook SCRIPTS are deliberately NOT
# listed: Claude Code re-reads the script from disk every time the hook fires, so
# an edit to one is already live. Naming them would turn this into a line that
# prints on nearly every pull, and a notice people scroll past protects nobody.
#
# Which hooks are REGISTERED is the opposite, and used to be skipped with the
# scripts (claude-config#176). Claude Code takes its snapshot of the hooks block at
# session start, so a hook this pull just registered is inert in every session
# already running, and the pull said nothing: the 2026-08-22 pull registered
# project-list-nudge.sh in silence and it fired for nobody until the next session.
# The old line claimed a file watcher picked the block up live, which is the claim
# that made the skip look reasoned; it was not true.
#
# The set that moved is not recomputed here. The merge above already worked it out
# from the incoming and last-applied fragments, and wrote it into the label it
# records, so this reads the producer's own answer rather than a second definition
# of the same question drifting beside it (L107).
# Reads the applied list (kind<TAB>path) on stdin, prints one name per line.
REGISTERED_MARK=", registered: "
UNREGISTERED_MARK=", unregistered: "
registration_names(){   # $1 = an applied label -> one hook script name per line
  local rest part
  rest="$1"
  case "$rest" in
    *"$REGISTERED_MARK"*)
      part="${rest#*"$REGISTERED_MARK"}"
      part="${part%%"$UNREGISTERED_MARK"*}"
      printf '%s\n' "$part" | tr ',' '\n'
      ;;
  esac
  case "$rest" in
    *"$UNREGISTERED_MARK"*)
      part="${rest#*"$UNREGISTERED_MARK"}"
      part="${part%%"$REGISTERED_MARK"*}"
      printf '%s\n' "$part" | tr ',' '\n'
      ;;
  esac
}
needs_new_session(){
  local kind name out="" hook
  while IFS=$'\t' read -r kind name; do
    [ -n "$name" ] || continue
    case "$name" in
      settings.json*)
        # An edit that leaves the same hooks registered (a matcher reworded, an
        # entry moved between events) changes nothing a running session holds, so
        # it stays quiet, exactly as an edit to an already listed skill does.
        while IFS= read -r hook; do
          hook="${hook#"${hook%%[![:space:]]*}"}"
          hook="${hook%"${hook##*[![:space:]]}"}"
          [ -n "$hook" ] || continue
          out+="hooks/$hook
"
        done <<REGEOF
$(registration_names "$name")
REGEOF
        continue
        ;;
      skills/*|agents/*|commands/*)
        # Only gaining or losing one changes what the running session can reach.
        # An edit to one already in its list is re-read when it is next invoked.
        [ "$kind" = added ] || [ "$kind" = removed ] || continue
        # A skill is a directory of files; report the skill, not each file in it.
        case "$name" in skills/*) name="${name#skills/}"; name="skills/${name%%/*}" ;; esac
        ;;
      # hooks/ lands here, and so does anything else living in a subtree: none of
      # it is read at session start, so a running session is already using it.
      */*) continue ;;
    esac
    out+="$name
"
  done
  printf '%s' "$out" | sort -u | grep . || true
  return 0
}

# Print the notice for those paths, if any. Capped like the change list: the point
# is to name what is stale, not to reprint a first pull's entire config.
NOTICE_MAX=6
print_new_session_notice(){   # $1 = applied list (kind<TAB>path per line)
  local names n shown
  names="$(printf '%s\n' "$1" | needs_new_session)"
  is_blank "$names" && return 0
  n="$(printf '%s' "$names" | grep -c . || true)"
  shown="$(printf '%s' "$names" | awk -v n="$NOTICE_MAX" 'NR <= n' | tr '\n' ' ')"
  shown="${shown% }"
  [ "$n" -gt "$NOTICE_MAX" ] && shown="${shown} and $((n - NOTICE_MAX)) more"
  # Names last: the reader needs the instruction first, and putting the list at
  # the end keeps the sentence intact however many names it carries.
  echo "Start a new Claude Code session to pick these up (a session already running keeps the copy it loaded at startup): ${shown}"
  return 0
}

# Summarize what the apply actually wrote on this Mac, so "it worked" is visible
# instead of implied. Built from the recorded writes, never from the repo's commit
# range: the range describes the shared repo, and a file can be missing here while
# the range is empty (or present here while the range claims it arrived).
SUMMARY_MAX=20
summarize_applied(){   # $1 pre-pull commit  $2 post-pull commit (for the first-pull note)
  local list n kind name
  list=""
  if [ -n "$APPLIED_LOG" ] && [ -s "$APPLIED_LOG" ]; then list="$(sort -u "$APPLIED_LOG")"; fi
  n="$(printf '%s' "$list" | grep -c . || true)"
  if [ "$n" -eq 0 ]; then
    echo "Already up to date: nothing on this Mac needed changing."
    return 0
  fi
  # A first pull writes the whole config; naming every file is noise, not proof.
  if [ -n "$2" ] && [ -z "$1" ]; then
    echo "Received the shared config (first pull into this clone): $n file(s) written."
    print_new_session_notice "$list"
    return 0
  fi
  echo "Received changes from the shared repo:"
  printf '%s\n' "$list" | awk -v n="$SUMMARY_MAX" 'NR <= n' | while IFS=$'\t' read -r kind name; do
    printf '  %-8s %s\n' "$kind" "$name"
  done
  if [ "$n" -gt "$SUMMARY_MAX" ]; then echo "  and $((n - SUMMARY_MAX)) more"; fi
  print_new_session_notice "$list"
  return 0
}

# ---------- pull ----------
# A count of commits, said the way the message needs to read it. Written once rather than at each
# call site, so the three refusals below cannot drift into describing the same number differently.
commits_in_words(){   # $1 = a count
  case "${1:-0}" in
    1) printf '1 commit' ;;
    *) printf '%s commits' "${1:-0}" ;;
  esac
}

# The receiving half of a pull, with git's answer READ rather than discarded.
#
# `--ff-only` stays: refusing to invent a merge is the correct behaviour. What was wrong was that
# its exit status was thrown away (#78), so a pull git ABORTED fell through to the reachability
# stamp, the apply, and the closing "Pulled shared config onto this Mac" line. A Mac that received
# nothing because the pull FAILED then said exactly what a Mac with nothing to receive says (L98),
# which is judging a command by a line of its output instead of by its exit code (L184). Measured
# on 2026-08-18: seven commits behind, "fatal: Not possible to fast-forward", exit 0, and the
# session went on working against a LESSONS.md that was two lessons out of date.
#
# Three ways this can fail and three messages, because "the pull failed" names nothing anybody can
# act on (L11, L151): the repo could not be REACHED, the two Macs have DIVERGED (which --ff-only
# cannot resolve by design, so the message has to name what does, #80), or git refused for a reason
# only git can describe. The last one quotes git rather than guessing, because a cause asserted
# from a state is confidently wrong when it is wrong, and #52 was exactly that.
pull_from_repo_or_die(){
  local branch ahead behind err
  # No origin configured is not a failure to report: a repo with no remote has nothing to receive,
  # and the offline paths (and the suite's local-only fixtures) drive the payload directly.
  git -C "$SYNC_REPO" remote get-url origin >/dev/null 2>&1 || return 0
  # THE STATE OF THE REPOSITORY, BEFORE ANY READING TAKEN FROM IT (claude-config#325). Mid rebase
  # this reported "this Mac and the shared repo have diverged", with both counts true and the
  # conclusion wrong: the ahead count came from the stranded branch label, the commit it named was
  # already the rebased result of the ones it called missing, and the remedy it gave reads the
  # branch through the same fallback that misreads a detached HEAD. A message may claim only what
  # its check measured (L11), and an ahead/behind count measures nothing about whether the repo is
  # in a normal state. A mutating run has already been through recover_unfinished_rebase by now, so
  # what reaches here is a rebase that could not be concluded, or a read only caller.
  case "$(sync_rebase_state)" in
    concludable)
      die "this clone is mid rebase, left unfinished by an earlier run, so NOTHING was received and nothing on this Mac was changed. This is not a divergence between the two Macs and 'claude-sync sync' is not the remedy: conclude it with 'git -C $SYNC_REPO rebase --continue', or abandon it with 'git -C $SYNC_REPO rebase --abort'." ;;
    conflict)
      die "this clone is mid rebase with a conflict still waiting in: $(sync_rebase_conflict_paths | tr '\n' ' ' | sed 's/ $//'). NOTHING was received and nothing on this Mac was changed. This is not a divergence between the two Macs: settle those paths in $SYNC_REPO, then 'git -C $SYNC_REPO rebase --continue', or abandon it with 'git -C $SYNC_REPO rebase --abort'." ;;
  esac
  if ! branch="$(sync_branch)"; then
    die "this clone has no branch checked out (HEAD is detached) and no rebase is in progress, so there is no ref to receive onto. NOTHING was received and nothing on this Mac was changed. Put $SYNC_REPO back on a branch, then run this again."
  fi
  # Fetched separately, and first, for two reasons. Reaching the remote is the only thing a pull
  # can prove about the network, and it is what the outage clock measures, so it is stamped the
  # moment it is observed rather than at the end of a run that can still fail for reasons saying
  # nothing about reachability (the argument do_sync already makes at its own fetch). And the
  # ahead/behind counts below are meaningless until the remote-tracking ref has been updated.
  if ! err="$(git -C "$SYNC_REPO" fetch -q origin 2>&1)"; then
    die_transient "could not reach the shared repo, so nothing was received and no file on this Mac was changed. git said: ${err:-<no output>}"
  fi
  # A pull that went through is proof the repo was reachable, exactly as a push is. Only send and
  # sync stamped it before, so a Mac that ONLY ever pulls reported that it had never reached the
  # shared repo while pulling successfully every day, which #76 surfaced by putting the fact on
  # screen. The same argument written at the push site, one command over. (#22, #76)
  record_sync_success
  # No remote branch yet (a fresh clone of a repo nobody has pushed to). Nothing to receive, which
  # is not a failure.
  git -C "$SYNC_REPO" rev-parse --verify -q "origin/$branch" >/dev/null 2>&1 || return 0
  ahead="$(git -C "$SYNC_REPO" rev-list --count "origin/$branch..HEAD" 2>/dev/null || echo 0)"
  behind="$(git -C "$SYNC_REPO" rev-list --count "HEAD..origin/$branch" 2>/dev/null || echo 0)"
  case "$ahead" in ''|*[!0-9]*) ahead=0 ;; esac
  case "$behind" in ''|*[!0-9]*) behind=0 ;; esac
  if [ "$ahead" -gt 0 ] && [ "$behind" -gt 0 ]; then
    # Named as its own condition, with both counts, because a divergence cannot fix itself: every
    # later pull refuses in the same way, so a message that reads like a transient hiccup leaves
    # the Mac behind indefinitely. The resolution is `sync`, which rebases this Mac's commits onto
    # the repo's and pushes them, and which already has the wording for a real content clash, so
    # this points at it rather than writing a second explanation of the same thing (#80).
    die "this Mac and the shared repo have diverged: $(commits_in_words "$ahead") here the repo has not seen, and $(commits_in_words "$behind") there this Mac does not have. NOTHING was received and nothing on this Mac was changed, because a pull can only fast-forward. Reconcile with: claude-sync sync"
  fi
  if ! err="$(git -C "$SYNC_REPO" pull --ff-only -q 2>&1)"; then
    die "git refused to fast-forward this Mac onto the shared repo, so NOTHING was received and nothing on this Mac was changed. The two sides have not diverged ($(commits_in_words "$ahead") here the repo has not seen, $(commits_in_words "$behind") there), so this is git's own refusal: ${err:-<no output>}"
  fi
  return 0
}

# What a pull says about the config it just installed (claude-config#178).
#
# `pull` printed its received-changes summary and ended with "Pulled shared config onto this Mac"
# without executing any of it. The 2026-08-22 pull landed a hook whose own suite failed on this
# Mac, and that was found only because somebody ran the tests by hand afterwards. A pull is exactly
# the moment config arrives that has never executed here, and a conflict resolved in favour of the
# other Mac is the strongest case of it: success reported without running anything is
# indistinguishable from success actually verified (L98).
#
# Three things this is careful about.
#
# It is judged by the runner's EXIT CODE and by nothing else. A test runner's last line of output
# is routinely a different measurement than its verdict, and usually the more reassuring of the two
# (L184).
#
# A suite that could not be RUN is its own outcome, never folded into failed. One says a check on
# this config does not pass; the other says nothing checked it, and a reader sent looking for a
# fault that is not there is its own defect (L11, L98).
#
# It only runs when a HOOK actually landed. The suite is minutes of work, and the watch daemon
# pulls constantly: a pull carrying a rule file has installed nothing this runner checks. That,
# rather than an unconditional run somebody would end up switching off, is what keeps the cost
# where the value is. SYNC_NO_HOOK_TESTS=1 turns it off outright, and the runner is TOLD that in
# its own environment, because the suite's fixtures run pulls of their own and a pull that runs the
# suite would otherwise recurse without end.
# The verdict, kept where something other than this terminal can find it (claude-config#182).
# Written only when a verdict was actually REACHED: a pull that carried no hook, or one told to
# skip, has verified nothing, and overwriting an outstanding failure with its silence would clear a
# report nothing had settled.
# Five fields since claude-config#185, and the last two are the coverage: how many suites ran and
# how many could not. `?` where the runner's report could not be read, never 0, because 0 is the
# reassuring answer and would be indistinguishable from a run that genuinely covered everything.
# NAMED fields, not positions (claude-config#233). The record grew twice by appending, and every
# growth was read by `IFS=tab read -r a b c d e f`, which puts every REMAINING field into the LAST
# name. So a record widened without widening the read does not fail: the last variable silently
# absorbs the new field and is reported as itself. It happened once already, where the exit code
# came out as "3<tab>?<tab>?", and #218 then added a check that the reader stops at its own field,
# which catches today's shape and not the next one (L317, L505). It has worked twice; the third
# addition is this one, which is where it would have bitten.
#
# With key=value an unknown field is harmlessly ignored and a missing one is detectable by name,
# so the reader can say WHICH field it could not make sense of rather than calling the whole
# record unreadable (L11).
record_hook_suite_result(){   # $1 = outcome  $2 = exit status  $3 = a file of output, or nothing
                              # $4 = suites that ran  $5 = suites that could not; number or ?
                              # $6 = how many seconds it took, or ? when it was never timed
                              # $7 = the suites that could not run, comma separated, or ?
  local tmp
  tmp="$(scratch_file)" || return 0
  printf 'outcome=%s\tat=%s\texit=%s\tran=%s\tnotrun=%s\tseconds=%s\tnotrun_names=%s\n' \
    "$1" "$(date +%s)" "$2" "${4:-?}" "${5:-?}" "${6:-?}" "${7:-?}" > "$tmp"
  # Capped: the point is the reason, not a transcript, and this file is read by a person.
  [ -n "${3:-}" ] && [ -f "$3" ] && tail -50 "$3" >> "$tmp"
  mv "$tmp" "$HOOK_TESTS_FILE" 2>/dev/null || rm -f "$tmp"
  return 0
}

# How much of the suite a passing run actually COVERED, read from the runner's own report
# (claude-config#185).
#
# run-all-tests.sh exits 0 when suites merely COULD NOT RUN, and says so itself. Six of them audit
# the repository and declare SUITE-NOT-RUN anywhere else, which is every deployed Mac, so "the hook
# suite passed here" covered materially less than it sounded like. That is the fold this tool
# refuses everywhere else: a check that did not run must not read as one that passed (L98).
#
# The count is READ from the line the runner already prints, never counted a second time here. A
# second definition of one quantity drifts, and drifts towards flattering the sentence quoting it
# (L107).
#
# It reads the VERDICT line, which a passing run always prints in one of exactly two shapes, rather
# than the "N SUITE(S) COULD NOT RUN HERE" block, which appears only when N is non-zero. An absent
# block would be indistinguishable from a runner too old to report one, and would be read as full
# coverage: the pleasant answer, arrived at by matching nothing (L98, L215). A report matching
# neither shape is answered with `?`, and the closing line says so in its own words.
# The names of the suites that could not run, from the runner's own block. Only consulted when
# the verdict already says some did not run: an absent block is then a real disagreement with the
# runner rather than a normal state, and it is answered with `?` rather than with an empty list,
# because "none could not run" and "this could not be read" are different facts (L98, L215).
hook_suite_notrun_names(){   # $1 = the file holding the runner's output -> comma separated, or ?
  local block
  block="$(grep -E '^[0-9]+ SUITE\(S\) COULD NOT RUN HERE:' "$1" 2>/dev/null | tail -1 || true)"
  [ -n "$block" ] || { printf '?'; return 0; }
  block="${block#*COULD NOT RUN HERE:}"
  block="$(printf '%s' "$block" | tr -s ' ' ' ' | sed 's/^ //; s/ $//; s/ /,/g')"
  case "$block" in ''|,) printf '?' ;; *) printf '%s' "$block" ;; esac
  return 0
}

hook_suite_coverage(){   # $1 = the file holding the runner's output -> "<ran>\t<notrun>", ? if unread
  local line
  line="$(grep -E '^ALL [0-9]+ SUITES PASSED$' "$1" 2>/dev/null | tail -1 || true)"
  if [ -n "$line" ]; then
    printf '%s\t0' "$(printf '%s' "$line" | sed -E 's/^ALL ([0-9]+) SUITES PASSED$/\1/')"
    return 0
  fi
  line="$(grep -E '^ALL [0-9]+ SUITES THAT COULD RUN PASSED, and [0-9]+ could not run here$' "$1" 2>/dev/null | tail -1 || true)"
  if [ -n "$line" ]; then
    printf '%s\t%s' \
      "$(printf '%s' "$line" | sed -E 's/^ALL ([0-9]+) SUITES THAT COULD RUN PASSED.*$/\1/')" \
      "$(printf '%s' "$line" | sed -E 's/^.*, and ([0-9]+) could not run here$/\1/')"
    return 0
  fi
  printf '?\t?'
  return 0
}

hook_suite_verdict(){   # prints the clause to fold into the closing line, or nothing at all
  local runner out pid started now limit rc=0 killed=0 ran='?' notrun='?' took='?' nrnames='?'
  [ "${SYNC_NO_HOOK_TESTS:-0}" = "1" ] && return 0
  # Normally this runs only when an apply actually wrote a hook, which is the right trigger for a
  # receive. It is also the ONLY writer of the record, so a Mac that FIXED a failure without a hook
  # arriving had no way to say so and went on reporting the old one (claude-config#305). HOOK_SUITE_FORCE
  # is `claude-sync recheck` asking for that same run deliberately, which is what makes the remedy
  # the failure message names one that can actually clear it (L144, L111).
  if [ "${HOOK_SUITE_FORCE:-0}" != "1" ]; then
    [ -n "${APPLIED_LOG:-}" ] || return 0
    [ -s "$APPLIED_LOG" ] || return 0
    # The log is kind<TAB>path, so the tab is part of the match: without it a file merely NAMED
    # hooks/something in a label would answer for one.
    grep -q "$(printf '\t')hooks/" "$APPLIED_LOG" 2>/dev/null || return 0
  fi
  runner="$CLAUDE_HOME/hooks/run-all-tests.sh"
  if [ ! -f "$runner" ]; then
    notify "hooks arrived with no run-all-tests.sh to check them"
    record_hook_suite_result notrun 0 "" "?" "?"
    printf ', and the hook suite could NOT be run here: hooks arrived and there is no %s to check them with, so nothing that just landed has been verified' "$runner"
    return 0
  fi
  out="$(scratch_file)" || {
    printf ', and the hook suite could NOT be run here: no scratch file could be made to hold its output'
    return 0
  }
  # A wait with no deadline cannot fail, it can only hang, and this one holds the sync lock while
  # it does (L110). Generous rather than tight: the real suite was measured between 220 and 400
  # seconds on this hardware, and a deadline that fires on a loaded Mac would report a stopped run
  # as an unverified one on exactly the days everything is busy.
  limit="${SYNC_HOOK_TESTS_TIMEOUT:-1800}"
  case "$limit" in ''|*[!0-9]*) limit=1800 ;; esac
  # The checkout is handed to the runner, never guessed by it (claude-config#237). Three suites
  # audit the repository and declare SUITE-NOT-RUN in a deployed copy, which is every Mac, so the
  # pull announced the same unverified gap on every single run and never closed it. This clone IS
  # the repository those hooks came from and it is on this same Mac, so the runner can re-run them
  # from it and report a real pass or fail instead.
  SYNC_NO_HOOK_TESTS=1 RUN_ALL_TESTS_CHECKOUT="$SYNC_REPO" bash "$runner" > "$out" 2>&1 &
  pid=$!
  started="$(date +%s)"
  while kill -0 "$pid" 2>/dev/null; do
    # Against the clock, never by adding up the sleeps below: a timer built from its own sleeps
    # measures iterations rather than elapsed time (L226).
    now="$(date +%s)"
    if [ "$limit" -gt 0 ] && [ "$(( now - started ))" -ge "$limit" ]; then
      killed=1
      kill -TERM "$pid" 2>/dev/null || true
      break
    fi
    sleep "$SYNC_POLL_INTERVAL"
  done
  wait "$pid" 2>/dev/null || rc=$?
  # How long it actually took (claude-config#218). Measured from THIS process's clock, which
  # already holds `started` for the deadline, rather than read out of the runner's printed report.
  # The runner prints a per suite profile and no total, and a measurement that reaches its reader
  # only by being printed is lost the moment the work moves behind a worker, a background job or a
  # parallel lane, while the work itself goes on succeeding (L325).
  #
  # There was no duration anywhere. The only statement of how long a receive costs was a comment
  # beside the timeout, which is a claim nothing re-measures (L32, L210), and the suite had grown
  # from 38 to 42 to 44 suites in a fortnight.
  took=$(( $(date +%s) - started ))
  [ "$took" -ge 0 ] || took=0
  if [ "$killed" -eq 1 ]; then
    notify "the hook suite was still running after ${limit}s and was stopped"
    record_hook_suite_result incomplete 0 "$out" "?" "?" "$took"
    printf ', and the hook suite could NOT be completed here: it was still running after %ss and was stopped, so nothing that just landed has been verified' "$limit"
    return 0
  fi
  if [ "$rc" -eq 0 ]; then
    IFS="$(printf '\t')" read -r ran notrun <<HSCOVEOF
$(hook_suite_coverage "$out")
HSCOVEOF
    case "$ran$notrun" in *[!0-9]*) ran='?'; notrun='?' ;; esac
    nrnames='?'
    case "$notrun" in [1-9]*) nrnames="$(hook_suite_notrun_names "$out")" ;; 0) nrnames='' ;; esac
    record_hook_suite_result passed 0 "" "$ran" "$notrun" "$took" "$nrnames"
    if [ "$ran" = '?' ]; then
      printf ', and the hook suite passed here, though its own report did not say how many of its suites ran, so how much of the suite that covers is unknown'
    elif [ "$notrun" -gt 0 ]; then
      # NAMED, not counted (claude-config#250). A count cannot say whether the ones that sat out
      # are trivial or cover the most important behaviour, and nothing can notice it growing.
      printf ', and the hook suite passed here, but only %s of its %s suites could run on this Mac, so %s are unverified here: %s' \
        "$ran" "$(( ran + notrun ))" "$notrun" \
        "$(case "$nrnames" in ''|'?') printf 'and the runner did not name them' ;; *) printf '%s' "$nrnames" | tr ',' ' ' ;; esac)"
    else
      printf ', and the hook suite passed here, all %s of its suites' "$ran"
    fi
    return 0
  fi
  # The runner's own report goes to stderr, where the rest of this run's diagnostics are, so the
  # closing line stays one sentence and the detail is still in front of whoever reads it.
  echo "claude-sync: the hook suite on this Mac exited $rc after the pull. What it said:" >&2
  tail -25 "$out" >&2 || true
  notify "the hook suite FAILED after a pull"
  # A run that FAILED is timed like any other. What is being recorded is what the receive path
  # costs this Mac, and a suite that failed after doing its work cost exactly what it did.
  record_hook_suite_result failed "$rc" "$out" "?" "?" "$took"
  printf ', but the hook suite FAILED here (it exited %s). The config is on disk and at least one check on it does not pass: run  bash %s  to see which' "$rc" "$runner"
  return 0
}

do_pull(){
  # ${VAR-default}, not ${VAR:-default}: after a hand-off SYNC_PULL_BASE is set
  # but EMPTY on a first pull, and that empty value is meaningful (no prior
  # commit). :- would discard it and lose the "first pull" case.
  local before="" after=""
  if have_git; then
    before="${SYNC_PULL_BASE-$(repo_head)}"
    pull_from_repo_or_die
    after="$(repo_head)"
    reexec_after_self_update "$before" "$after" pull || true
  fi
  apply_payload_to_local
  report_unpublished_merge
  script_changed_between "$before" "$after" && pulled_script_ok && restart_watch_daemon_if_installed
  summarize_applied "$before" "$after"
  # Read only, and it fetches nothing: the ref this run already has is what the other clones are
  # measured against (claude-config#266).
  report_other_clones_position
  report_when_lock_released "Pulled shared config onto this Mac (memory/permissions untouched)"
}

# The closing line, and the verification behind it, deliberately OUTSIDE the locked region
# (claude-config#181), on EVERY path that receives config rather than on pull alone
# (claude-config#184).
#
# The suite is minutes of work. Run inside do_pull it held the sync lock for its whole duration, so
# every watch daemon pull starting in that window refused rather than queueing: the job whose only
# purpose is keeping this Mac current was starved by the step that checks this Mac is current, and
# an interactive run in the same window simply looked wedged.
#
# Nothing is left for the lock to protect by then. The payload is applied, the summary is printed,
# and this reads files that are already on disk. What it must NOT do is move: the verdict still
# belongs in the closing line, because a run that reports success without running any of what it
# installed says exactly what a verified one says (L98), so the line is printed after the suite
# rather than before it.
#
# Why it is flushed from with_lock rather than added beside each command. #178 and #181 both hung
# off do_pull, and do_sync applies the payload through the same apply_payload_to_local without ever
# reaching that code, so config arriving by sync was installed with nothing checking it. The
# scheduled job runs pull and was covered; the watch daemon runs send, which falls through to
# do_sync, and the timer's reconcile runs sync, so the two UNATTENDED receive paths were the
# unverified ones. Asking every future receive path to remember one more call is a rule that lives
# in somebody's head (L27), and the path that forgot would be the one nobody is watching. So the
# lock's own release point flushes it, once, and a receive path cannot be added without it.
#
# The applied log outlives the lock: it is removed by the EXIT trap, not by release_lock, so the
# decision about whether a hook landed can still be taken here from the same record.
REPORT_PENDING=""
report_when_lock_released(){   # $1 = the closing sentence, without its verdict clause or full stop
  REPORT_PENDING="$1"
  return 0
}
flush_pending_report(){
  local stem="$REPORT_PENDING" verdict
  # Cleared FIRST, so a second flush cannot print the same line twice however this is reached.
  REPORT_PENDING=""
  [ -n "$stem" ] || return 0
  verdict="$(hook_suite_verdict)"
  echo "${stem}${verdict}."
  return 0
}

# Resume point after claude-sync updated itself mid-`sync` (internal use only).
# `sync` must NOT be resumed by re-running `sync`: its first step copies local
# files into the payload, which after a pull would push this Mac's older copy of
# a file back over the change the pull just received.
do_apply_only(){
  local before="${SYNC_PULL_BASE-}" after=""
  have_git && after="$(repo_head)"
  apply_payload_to_local
  script_changed_between "$before" "$after" && pulled_script_ok && restart_watch_daemon_if_installed
  # The resume point after a self update finishes the same sync, so it owes the same report
  # (claude-config#283). Leaving it out here would make what a run says depend on whether the tool
  # happened to update itself in the middle of it.
  summarize_applied "$before" "$after"
  report_when_lock_released "Synced (sent local changes, pulled remote; memory/permissions untouched)"
}

# ---------- sync (two-way, used by the background job) ----------
# ---------- only a commit CI has passed reaches this Mac automatically (claude-config#221) ----
#
# THE DECISION. The watcher used to integrate whatever was on the shared repo the moment it had a
# reason to pull, which is before anything had judged it. 32 of 233 CI runs in 30 days were red,
# almost all on direct pushes to main, so config that fails CI was installed on the other Mac
# FIRST and caught only by the suite that runs after installation: ship first, verify after, with
# the CI run as a second opinion nothing read. Three of this session's own pushes were green on a
# Mac and red on the Linux runner, and every one of them would have landed there.
#
# THE PREMISE, in a form that can be re-measured rather than believed (L316): the wait this buys is
# one CI run, which `gh run list --limit 20 --json startedAt,updatedAt` prices at about four
# minutes today, against a red commit being live on the other Mac for the three to four minutes
# until its own suite says so, and longer if nobody reads the notification. If CI ever becomes slow
# enough that the wait costs more than the exposure, this is the trade to look at again.
#
# THE SCOPE. The WATCHER is gated and the weekly receive timer is not, deliberately: a four minute
# CI wait is noise against a week, and an explicit `claude-sync pull` or `sync` typed by a person is
# the escape hatch, so there is no flag to remember and no way to be stuck.
#
# It FAILS CLOSED. Unreadable, no check at all, or a run the concurrency group cancelled all skip
# the pull and say which, because a control that exists to protect someone fails closed rather than
# open (L42), and because "green" and "nobody could tell" must never be the same answer (L98).
sync_gh(){ printf '%s' "${SYNC_GH:-gh}"; }

repo_slug(){   # -> owner/name from the origin url, or nothing
  local url
  # A seam, because the fixtures push to a bare repo on disk and no derivation can turn a local
  # path into an owner and a name. The derivation itself is tested directly against the URL forms
  # below rather than through this, so the seam cannot hide it (L322).
  [ -n "${SYNC_REPO_SLUG:-}" ] && { printf '%s' "$SYNC_REPO_SLUG"; return 0; }
  url="$(git -C "$SYNC_REPO" remote get-url origin 2>/dev/null || true)"
  [ -n "$url" ] || return 1
  url="${url%.git}"
  case "$url" in
    *github.com[:/]*) printf '%s' "${url##*github.com}" | sed -e 's|^[:/]||' ;;
    *) return 1 ;;
  esac
}

# One of: green red pending cancelled none unreadable. The distinctions matter because each needs a
# different sentence and a different remedy (L11): pending resolves itself, cancelled never will,
# and unreadable is about this Mac rather than about the commit.
remote_ci_state(){   # $1 = commit sha
  local gh slug out
  gh="$(sync_gh)"
  command -v "$gh" >/dev/null 2>&1 || { printf 'unreadable'; return 0; }
  slug="$(repo_slug)" || { printf 'unreadable'; return 0; }
  [ -n "${1:-}" ] || { printf 'unreadable'; return 0; }
  out="$("$gh" api "repos/$slug/commits/$1/check-runs" \
        --jq '.check_runs[] | (.conclusion // .status)' 2>/dev/null)" || { printf 'unreadable'; return 0; }
  # Read in order of what stops a pull. A failure anywhere is a red commit whatever else passed; a
  # run still going means the answer is coming; only then can success mean success.
  case "
$out" in *"
failure"*|*"
timed_out"*|*"
action_required"*|*"
startup_failure"*) printf 'red'; return 0 ;; esac
  case "
$out" in *"
queued"*|*"
in_progress"*|*"
pending"*|*"
waiting"*|*"
requested"*) printf 'pending'; return 0 ;; esac
  case "
$out" in *"
success"*) printf 'green'; return 0 ;; esac
  # Cancelled with nothing else is the state that would otherwise read as pending for ever: the
  # concurrency group cancels a superseded run, and no verdict is coming for this commit.
  case "
$out" in *"
cancelled"*|*"
skipped"*|*"
neutral"*) printf 'cancelled'; return 0 ;; esac
  printf 'none'
  return 0
}

# The gate itself. Prints nothing and returns 0 when the pull may go ahead.
ci_gate_blocks_pull(){   # -> 0 when the automatic pull must be skipped
  local branch sha state
  [ "${SYNC_IN_WATCH:-0}" = "1" ] || return 1
  have_git || return 1
  git -C "$SYNC_REPO" remote get-url origin >/dev/null 2>&1 || return 1
  # Does NOT block when it cannot read the branch, matching every other thing this gate cannot
  # judge: the pull is what recovers a clone in a bad state, and a gate that blocks it would hold
  # the remedy shut (L362).
  branch="$(sync_branch)" || return 1
  sha="$(git -C "$SYNC_REPO" rev-parse "origin/$branch" 2>/dev/null || true)"
  [ -n "$sha" ] || return 1
  # Nothing to integrate means nothing to gate: this Mac's own work must never be held up by a
  # question about a commit it already has (L324). The question is whether the remote holds
  # anything we do NOT, which is an ancestry test, not an inequality: do_sync commits local changes
  # BEFORE this runs, so our head always differs from theirs and comparing the two would gate every
  # run for ever. Mind the direction, the same way unapplied_remote_changes does.
  # Nothing to integrate also means the unreadable clock has nothing to be about: no verdict is
  # being asked for, so leaving it armed would let `status` report a verdict as unreadable when
  # nothing had tried to read one (L11). Cleared here as well as on every readable verdict below,
  # because this arm returns before the classifier is ever called.
  if git -C "$SYNC_REPO" merge-base --is-ancestor "$sha" HEAD 2>/dev/null; then
    rm -f "$CI_UNREADABLE_SINCE_FILE" 2>/dev/null || true
    # And the red clock, for the same reason: nothing is being held back, so there is no run of
    # refusals to be counting (claude-config#336).
    rm -f "$CI_RED_SINCE_FILE" 2>/dev/null || true
    return 1
  fi
  state="$(remote_ci_state "$sha")"
  # ANY readable verdict clears the unreadable clock (claude-config#327), including the ones that
  # block: red, pending and cancelled are answers, and they mean the lookup is working. Only
  # "nobody could tell" arms it, and only being able to tell again ends it, or a Mac that was
  # briefly offline goes on counting towards an escape it no longer needs (L160).
  #
  # Read, then CLEARED unconditionally, and re-armed by the unreadable arm below. Written the
  # obvious way it needed a second list of the readable states beside the one the case already
  # names, and two lists of one vocabulary drift silently (L113). This way the case that ACTS is
  # the only list: whatever its catch-all catches is what arms the clock, by construction, so a
  # state added later cannot be handled in one place and forgotten in the other.
  local ci_since ci_told
  ci_since="$(awk 'NR==1{print $1}' "$CI_UNREADABLE_SINCE_FILE" 2>/dev/null)"
  ci_told="$(awk 'NR==1{print $2}' "$CI_UNREADABLE_SINCE_FILE" 2>/dev/null)"
  rm -f "$CI_UNREADABLE_SINCE_FILE" 2>/dev/null || true
  # The red clock is read and cleared here for exactly the reason the unreadable one is: the case
  # below is then the ONLY list of states, so the arm that acts is what re-arms the clock and a
  # state added later cannot be handled in one place and forgotten in the other (L113).
  local rd_since rd_told rd_n
  # Fields are since, count, told, and the ONLY one that may be empty is the last. Written with the
  # empty one in the middle, awk collapses the run of spaces and reads the count out of the wrong
  # column, so the count silently stayed at 1 however long the repo had been red while the start
  # time survived perfectly and every other check passed.
  rd_since="$(awk 'NR==1{print $1}' "$CI_RED_SINCE_FILE" 2>/dev/null)"
  rd_n="$(awk 'NR==1{print $2}' "$CI_RED_SINCE_FILE" 2>/dev/null)"
  rd_told="$(awk 'NR==1{print $3}' "$CI_RED_SINCE_FILE" 2>/dev/null)"
  rm -f "$CI_RED_SINCE_FILE" 2>/dev/null || true
  case "$state" in
    green) return 1 ;;
    red)
      # HOW LONG this has been going on, not just that it is (claude-config#336). Refusing a red
      # head is right and stays right, but a refusal with no bound on it means a shared repo that
      # stays red stops every Mac receiving config for as long as it stays red, and the only place
      # that was said was the output of a run nobody was watching. It ran for seven hours on
      # 2026-09-07 across fourteen commits.
      #
      # The clock is on the CONDITION, not on the commit: keyed per commit it would reset on every
      # push and never reach its own window, which is the key mistake L186 describes, and a push
      # is exactly what happens repeatedly while somebody is trying to fix the red.
      local rd_now rd_window="${SYNC_CI_RED_ALERT_AFTER:-3600}" rd_age
      rd_now="$(date +%s)"
      case "$rd_since" in ''|*[!0-9]*) rd_since="$rd_now"; rd_told="" ;; esac
      case "$rd_told" in *[!0-9]*) rd_told="" ;; esac
      case "$rd_n" in ''|*[!0-9]*) rd_n=0 ;; esac
      rd_n=$(( rd_n + 1 ))
      rd_age=$(( rd_now - rd_since ))
      echo "claude-sync: the shared repo's newest commit (${sha:0:8}) FAILED its tests, so it was not applied here. Nothing is lost: it applies as soon as a green commit lands, or now if you run 'claude-sync pull' yourself." >&2
      # Past the window it is a different event and gets different words, because "it failed this
      # time" and "it has been failing all day" need different actions from the reader and one
      # sentence covering both hides whichever it did not name (L11). It is never applied anyway:
      # unlike an unreadable verdict, a red one is something a person can act on, so the escape is
      # to tell them rather than to lower the gate (L42).
      if [ "$rd_age" -ge "$rd_window" ] 2>/dev/null; then
        echo "claude-sync: and it has been red for $(age_in_words "$rd_age") now, $(commits_in_words "$rd_n" 2>/dev/null || printf '%s run(s)' "$rd_n") in a row. Nothing on this Mac receives config until a green commit lands, so this needs fixing rather than waiting: look at the failing run with 'gh run list --limit 5'." >&2
        # Told ONCE, on the transition, not on every automatic tick. A notification repeated every
        # few minutes is what teaches somebody to dismiss the whole channel (L36).
        if [ -z "$rd_told" ]; then
          rd_told="$rd_now"
          notify "receiving is stuck: the shared repo has been red for $(age_in_words "$rd_age")"
        fi
      else
        notify "not applied: the shared repo's head failed CI"
      fi
      # Written back on EVERY path out of this arm, because the read above cleared the file. Miss
      # one and the clock restarts on each run, so it can never reach its own window and the
      # escalation never fires while every other check here still passes (L514).
      printf '%s %s %s\n' "$rd_since" "$rd_n" "$rd_told" > "$CI_RED_SINCE_FILE" 2>/dev/null || true
      send_outcome ci-red ;;
    pending)
      echo "claude-sync: the shared repo's newest commit (${sha:0:8}) is still being tested, so it was not applied here yet. It applies once the tests finish." >&2
      send_outcome ci-pending ;;
    cancelled)
      echo "claude-sync: the tests for the shared repo's newest commit (${sha:0:8}) were cancelled, so no verdict is coming for it and it was not applied here. Push again, or run 'claude-sync pull' yourself if you know it is good." >&2
      notify "not applied: the tests for the shared repo's head were cancelled"
      send_outcome ci-cancelled ;;
    none)
      # NOTHING JUDGED IT, and Dan's call (2026-09-03) is that nothing to fail is not a failure: a
      # commit that will never have a check must not hold up config for ever.
      #
      # But "no checks yet" and "no checks at all" are the same empty answer for the first minute
      # of a commit's life, and taking the young one as green would defeat this gate in exactly the
      # common case, a push whose run has not been created yet (L11, L214). So a commit is only
      # read as unjudged once it is old enough that a check would have appeared by now.
      local age now
      now="$(date +%s)"
      age="$(git -C "$SYNC_REPO" log -1 --format=%ct "$sha" 2>/dev/null || true)"
      case "$age" in ''|*[!0-9]*) age="$now" ;; esac
      if [ "$(( now - age ))" -lt "${SYNC_CI_GRACE:-600}" ]; then
        echo "claude-sync: the shared repo's newest commit (${sha:0:8}) has no test run yet and is less than $(duration_in_words "${SYNC_CI_GRACE:-600}") old, so it was not applied here yet. It applies once a run appears, or once it is old enough that none is coming." >&2
        send_outcome ci-pending
        return 0
      fi
      echo "claude-sync: the shared repo's newest commit (${sha:0:8}) has no test run at all and is older than $(duration_in_words "${SYNC_CI_GRACE:-600}"), so nothing is going to judge it and it was applied." >&2
      send_outcome ci-none
      return 1 ;;
    *)
      # UNREADABLE, which is not a verdict at all (claude-config#327). Failing closed is right while
      # an answer might still arrive and wrong once it is clear none is coming: gh not logged in, no
      # network, or a remote that is not GitHub produce this state permanently, and the gate then
      # holds config back for ever on a question nothing can answer. That is a gate with no way out
      # (L362), and it is the residual of the 46 hours of silent drift in claude-config#323.
      #
      # So it blocks for a WINDOW and then stops. The clock is on the CONDITION, not on the commit:
      # keyed per commit it would reset on every push to the shared repo and never expire, which is
      # the key mistake L186 describes. It is armed here and cleared by any readable verdict above.
      #
      # It is not cleared by expiring. Once the verdict is judged unobtainable, config keeps
      # arriving until the lookup works again; restarting the clock would deliver config in three
      # hour bursts, which is a worse thing than either state.
      local ci_now ci_expired=0 ci_window="${SYNC_CI_UNREADABLE_AFTER:-10800}"
      ci_now="$(date +%s)"
      case "$ci_since" in
        ''|*[!0-9]*)
          # The transition into the condition. Told once, here: the watcher fires on every edit and
          # this used to raise a desktop alert on each one, which is the alert that gets ignored and
          # is why the drift in claude-config#323 went unread for two days (L36).
          ci_since="$ci_now"; ci_told=""
          notify "not applied: could not read CI for the shared repo's head" ;;
      esac
      case "$ci_told" in *[!0-9]*) ci_told="" ;; esac
      [ "$(( ci_now - ci_since ))" -ge "$ci_window" ] 2>/dev/null && ci_expired=1
      if [ "$ci_expired" = 1 ] && [ -z "$ci_told" ]; then
        ci_told="$ci_now"
        notify "applying shared config without a CI verdict: gh has been unreadable for $(age_in_words "$(( ci_now - ci_since ))")"
      fi
      # Written back on EVERY path out of this arm, because the read above cleared the file. Miss
      # one and the clock silently restarts on each run, so it can never reach its own window and
      # the escape this whole arm exists for never fires (L514).
      printf '%s %s\n' "$ci_since" "$ci_told" > "$CI_UNREADABLE_SINCE_FILE" 2>/dev/null || true
      if [ "$ci_expired" = 1 ]; then
        echo "claude-sync: whether the shared repo's newest commit (${sha:0:8}) passed its tests has been unreadable for $(age_in_words "$(( ci_now - ci_since ))") ($state), which is longer than the $(duration_in_words "$ci_window") this waits, so it was applied here WITHOUT a verdict. Nothing judged it but the hook suite this Mac runs after an apply. Check that gh is installed and logged in, because until it is, every commit arrives this way." >&2
        send_outcome ci-unreadable-expired
        return 1
      fi
      echo "claude-sync: could not read whether the shared repo's newest commit (${sha:0:8}) passed its tests ($state), so it was not applied here. It has been unreadable for $(age_in_words "$(( ci_now - ci_since ))"); after $(duration_in_words "$ci_window") it is applied anyway rather than held for ever. Run 'claude-sync pull' yourself, or check that gh is installed and logged in." >&2
      send_outcome ci-unreadable ;;
  esac
  return 0
}

do_sync(){
  # Staging is protected against the paths this Mac has not applied yet (see
  # unapplied_paths), so the original order is safe: send local changes, integrate
  # theirs, then apply. Receiving first is NOT an option here, because the apply
  # mirrors with --delete and would erase a local file that has never been sent.
  stage_local_to_payload
  local pushed=0 branch before="" after=""
  local fetch_err="" pull_err="" stash_before=0 stash_after=0 stash_top="" gitdir=""
  local derived_rc=0
  if have_git; then
    commit_if_changed && pushed=1
    # recover_unfinished_rebase has already run for this command, so a detached HEAD here is
    # something else again, and guessing `main` would push at a ref nobody checked out
    # (claude-config#324).
    branch="$(sync_branch)" || die "this clone has no branch checked out (HEAD is detached), so there is no ref to send at or receive onto. Nothing was sent. Put $SYNC_REPO back on a branch, then run this again."
    before="$(repo_head)"
    # A failed FETCH means the repo could not be REACHED (offline, VPN, asleep, revoked
    # credentials). That used to be swallowed by `|| true`, so the pull below failed a
    # moment later and was reported as a two-Mac conflict: on 2026-08-16 a connection
    # failure that lasted two milliseconds sent Dan to investigate a Mac that had been
    # switched off for two days. Only fatal when an origin is actually configured, so a
    # local-only repo (and the offline tests) still work exactly as before.
    if git -C "$SYNC_REPO" remote get-url origin >/dev/null 2>&1; then
      if ! fetch_err="$(git -C "$SYNC_REPO" fetch -q origin 2>&1)"; then
        die_transient "could not reach the shared repo, so nothing was sent or received this time. Nothing is lost: this Mac's changes are committed locally and go up on the next edit. git said: ${fetch_err:-<no output>}"
      fi
      # Reaching the remote IS the success this is measuring, so it is recorded here rather
      # than at the end of the run: a later step failing for its own reasons says nothing
      # about whether the repo was reachable, and would restart the outage clock wrongly.
      record_sync_success
    fi
    # THE CI GATE, before anything of theirs is integrated (claude-config#221). Only the automatic
    # watcher is gated; a person running this by hand is the escape hatch. Returning here leaves
    # this Mac's own commit local and unpushed, which the next tick retries, and the message above
    # names the one command that settles it now.
    if ci_gate_blocks_pull; then return 0; fi
    # integrate the other Mac's changes (only if the remote branch exists yet)
    ensure_derived_file_merge_rule
    if git -C "$SYNC_REPO" rev-parse --verify -q "origin/$branch" >/dev/null 2>&1; then
      # Counted around the pull because git DROPS the autostash on a clean restore and
      # KEEPS it on a conflicted one. See the check after the pull for why that matters.
      stash_before="$(git -C "$SYNC_REPO" stash list 2>/dev/null | wc -l | tr -d ' ')"
      if ! pull_err="$(git -C "$SYNC_REPO" "${SYNC_GIT_IDENTITY[@]}" pull --rebase --autostash -q origin "$branch" 2>&1)"; then
        # Which failure this is, decided from git's own STATE rather than from the words
        # in its message: a real content conflict is the only one that leaves a rebase
        # half finished. Matching on message text would be a second, drifting definition.
        # --absolute-git-dir, NOT --git-path: with -C, git answers --git-path with a
        # path relative to the REPO while `[ -d ... ]` resolves it against the caller's
        # own working directory, so the test never fired and every real conflict fell
        # through to the catch-all below. Caught by the guard kept for exactly this.
        gitdir="$(git -C "$SYNC_REPO" rev-parse --absolute-git-dir 2>/dev/null || echo "$SYNC_REPO/.git")"
        derived_recovered=0
        if [ -d "$gitdir/rebase-merge" ] || [ -d "$gitdir/rebase-apply" ]; then
          # A conflict only in files this tool GENERATES, or only in appended lesson entries, is
          # not two people's work in conflict (claude-config#282, claude-config#315). Tried BEFORE
          # the abort, because after an abort there is nothing left to continue, and it refuses on
          # anything else, so the die below is still reached for every conflict that really is two
          # people's work.
          # `|| rc=$?` rather than `; rc=$?`: this file runs under `set -e`, and a bare call
          # that returns non-zero would take the whole run down, while a call in a condition
          # context also turns -e off inside the function, which every early return here needs.
          derived_rc=0; resolve_derived_conflicts || derived_rc=$?
          if [ "$derived_rc" -eq 0 ]; then
            derived_recovered=1
          elif [ "$derived_rc" -eq 2 ]; then
            # A REAL clash on a lesson number, which is neither a merge failure nor something to
            # reconcile by hand: both Macs wrote a different entry under one number, and the
            # remedy is to renumber one of them. Its own message, because the catch-all's advice
            # would send Dan to drive git for a problem git cannot solve (L11, L399).
            git -C "$SYNC_REPO" rebase --abort 2>/dev/null || true
            notify "lesson number clash in $LESSONS_FILE"
            die "both Macs wrote a DIFFERENT lesson under the same number in $LESSONS_FILE ($LESSON_UNION_CLASH), so they cannot both keep it: every reference to that number would point at two different rules. Nothing was published and nothing was lost. Renumber this Mac's entry to the number 'claude-sync next-lesson' prints, then run 'claude-sync sync' again."
          else
            git -C "$SYNC_REPO" rebase --abort 2>/dev/null || true
            # git's own words are carried, and that is not decoration. This branch ASSERTS a cause
            # from a state rather than reading it, so when it is wrong it is confidently wrong and
            # there is nothing left to diagnose from: the catch-all beneath it quotes git and this
            # one did not, which made a misclassification here the only failure in the tool that
            # says nothing about what actually happened (L11, and #52 was exactly this).
            die "both Macs changed the same config and it couldn't auto-merge. Run 'claude-sync status' and reconcile by hand. git said: ${pull_err:-<no output>}"
          fi
        fi
        if [ "$derived_recovered" -ne 1 ]; then
          git -C "$SYNC_REPO" rebase --abort 2>/dev/null || true
          # Deliberately NOT folded into either message above. An unknown failure defaulted
          # to a known cause is how the original defect read as a confident diagnosis.
          die "the shared repo was reachable and this is NOT a two-Mac content conflict, but git refused to combine the two sides. git said: ${pull_err:-<no output>}"
        fi
      fi
      stash_after="$(git -C "$SYNC_REPO" stash list 2>/dev/null | wc -l | tr -d ' ')"
      stash_top="$(git -C "$SYNC_REPO" stash list 2>/dev/null | awk 'NR <= 1' || true)"
      # A pull that EXITED ZERO can still have gone wrong, measured against real git, not
      # assumed: when re-applying the edits it set aside conflicts, git prints
      # "Successfully rebased", returns 0, writes conflict markers into the working tree
      # and leaves the edits in a stash. commit_if_changed only ever commits payload/, so
      # the file left holding those markers is claude-sync itself or its tests, and the
      # next run would then execute a script full of conflict markers.
      # Both halves are required: the count alone would also fire on a stash somebody
      # created by hand in this folder while the background sync was mid-run, and the
      # marker alone would re-fire forever on a conflicted autostash left from last time.
      if [ "${stash_after:-0}" -gt "${stash_before:-0}" ] && \
         grep -q 'autostash' <<< "$stash_top"; then
        die "your uncommitted edits inside $SYNC_REPO clashed with the other Mac's version, so git parked them in a stash and left conflict markers in the working tree. The sync tool's own files are the ones affected. Fix the marked files, then run 'git -C $SYNC_REPO stash drop'"
      fi
      # The merge kept one side's rendering of a lessons file that no longer exists. Rebuilt here,
      # before anything is committed or published (claude-config#200).
      regenerate_payload_index
    fi
    after="$(repo_head)"
    # Re-checked AFTER the rebase, not from $pushed alone: the daemon runs this, so a
    # hand commit to the tool would otherwise sit unsent with nobody watching.
    # No record_sent here: whether this run sent anything is decided once, from the finished
    # state, by record_sent_if_shipped. Stamping inside the branch that happens to push is what
    # left `push` and every other route unstamped (#79, #82).
    { [ "$pushed" -eq 1 ] || unpushed_commits; } && git -C "$SYNC_REPO" push -u origin "$branch" -q || true
    # send half is done; hand off so the apply below runs the pulled logic
    reexec_after_self_update "$before" "$after" apply-only || true
  fi
  apply_payload_to_local
  # The apply may have MERGED a rule file, which lives only here until something sends it, and this
  # is the path that sends (claude-config#312). Before the summary, so the closing line is only
  # reached once the merge is provably in the repo.
  publish_merged_rule_files
  script_changed_between "$before" "$after" && pulled_script_ok && restart_watch_daemon_if_installed
  # WHAT ARRIVED, on this path too (claude-config#283). do_pull has always listed what it wrote and
  # added the start a new session notice when an arriving file cannot be seen by a running session;
  # this path called neither, so the route that RECEIVES the most reported the least. On 2026-09-03
  # a reconcile delivered 20 commits and 82 payload files, including CLAUDE.md, RTK.md, LESSONS.md
  # and LESSONS-INDEX.md, and said nothing about any of it. The sync-config skill deliberately tells
  # Claude not to invent its own version of that notice, because this script owns the decision, so
  # on this path the notice did not exist at all and had to be reconstructed from git by hand. A
  # silent path passes every check there is (L98).
  summarize_applied "$before" "$after"
  report_when_lock_released "Synced (sent local changes, pulled remote; memory/permissions untouched)"
}

# ---------- send (one-way, used by the change watcher) ----------
# Sends local changes only. Deliberately NO apply step: writing the payload back
# onto ~/.claude is what (a) let a sync resurrect a file deleted mid-run and
# (b) self-triggered the watcher. Receiving stays the timer's job (do_sync). If
# the remote moved on, fall back to a full reconcile so our commit still rides up.
# ---- the send-side hook suite gate (claude-config#244) ----
#
# The pre push test gate is a Claude Code PreToolUse hook on `git push`, so it only fires for a push
# a session makes by hand. The watcher mirrors ~/.claude into the payload and commits and pushes on
# its own, and nothing in that path asked whether the change carried a test.
#
# Not hypothetical: on 2026-08-31 commit f094409 pushed a 41 line change to hooks/lib/issue-spool.sh
# with no test at all. The test for it had been written in ~/.claude at the same time, failed to
# merge on the next pull, and was set aside as a .conflict copy, so it reached nobody. It was only
# carried into the repo because a later pull happened to collide with it and the conflict notice was
# read. Code written directly in the live config governs every session in every project, and it was
# the one path with no coverage requirement on it.
#
# ONLY the suites covering what actually changed, so a send that touches no hook costs nothing and a
# hook edit costs one or two suites rather than the whole set. That is the difference between this
# and the pull's full run, and it is what makes holding the lock across it acceptable.

# Which suites cover this file? Asked exactly as test-hook-coverage.sh asks it: a suite covers a hook
# when the suite's text names it. Written twice, the two would drift, and the send would verify a
# different set from the one the ratchet calls covered (L263, L41).
# The whole NAME, not a substring of a line (claude-config#268). `grep -lF` matched a hook whose
# name is a SUFFIX of another hook's name in every suite that mentions the longer one: `spool.sh`
# was answered for by five suites that all say `issue-spool.sh` and none of which mention a hook
# by that name. Here that means a send publishes a hook having run five irrelevant suites against
# it and reports it as checked. The boundary excludes the characters a hook name is made of, so a
# `/`, a quote or a space before the name still matches and a `-` does not. Written the same way
# in test-hook-coverage.sh's hook_name_pattern, deliberately, and each side has its own check that
# the suffix case is refused, because a shared name is read as evidence of shared behaviour and
# nothing otherwise compares them (L263).
send_hook_name_pattern(){   # $1 = a hook basename -> an ERE matching it as a whole name
  local esc
  esc="$(printf '%s' "$1" | sed 's/[][^$.*+?(){}|\\]/\\&/g')"
  printf '(^|[^A-Za-z0-9_-])%s([^A-Za-z0-9_-]|$)' "$esc"
}

send_suites_covering(){   # $1 = a hook's basename -> the suites naming it, one per line
  local f suites=()
  for f in "$SYNC_REPO"/payload/hooks/test-*.sh "$SYNC_REPO"/tests/test-*.sh; do
    [ -f "$f" ] && suites+=("$f")
  done
  [ "${#suites[@]}" -gt 0 ] || return 0
  grep -lE "$(send_hook_name_pattern "$1")" "${suites[@]}" 2>/dev/null || true
}

# A digest of the hook set this send is about to publish, taken from the INDEX so it is the bytes
# the commit would carry rather than whatever the working tree holds a moment later. Deliberately
# the WHOLE staged hook set rather than only the files one suite happens to name: a suite reads
# its helpers, its fixtures and the library beside it, so a key narrowed to the covered file alone
# would go on reporting a pass across a change to any of them (L336, L40). Empty when it cannot be
# computed, and the caller then runs everything rather than sharing one blank key between suites.
send_hooks_digest(){
  local d
  d="$(git -C "$SYNC_REPO" ls-files -s -- payload/hooks 2>/dev/null | shasum -a 256 2>/dev/null | cut -d' ' -f1)"
  case "$d" in ''|*[!0-9a-f]*) printf '' ;; *) printf '%s' "$d" ;; esac
}

send_verdict_recall(){   # $1 = suite basename  $2 = digest -> prints pass|fail, or nothing
  [ -n "$2" ] || return 0
  [ -f "$SEND_VERDICTS_FILE" ] || return 0
  awk -v s="$1" -v d="$2" '$1 == d && $2 == s { print $3 }' "$SEND_VERDICTS_FILE" 2>/dev/null | tail -1
  return 0
}

send_verdict_record(){   # $1 = suite basename  $2 = digest  $3 = pass|fail
  local tmp
  [ -n "$2" ] || return 0
  tmp="$(scratch_file)" || return 0
  # One line per suite, REPLACED rather than appended. A verdict is only ever asked for against the
  # current digest, so keeping the superseded ones grows a file nothing will read again, and a
  # capped store would start evicting the entries that are still live (L191).
  if [ -f "$SEND_VERDICTS_FILE" ]; then
    awk -v s="$1" '$2 != s' "$SEND_VERDICTS_FILE" > "$tmp" 2>/dev/null || : > "$tmp"
  else
    : > "$tmp"
  fi
  printf '%s %s %s %s\n' "$2" "$1" "$3" "$(date +%s)" >> "$tmp"
  mv -f "$tmp" "$SEND_VERDICTS_FILE" 2>/dev/null || true
  return 0
}

# Put back the copy the repo already holds, so this send publishes everything EXCEPT this path.
# A path the repo has never seen has no published copy to restore, and that is the branch that
# matters: getting it wrong publishes exactly the file the red suite refused (L214). So the
# restore is attempted and its failure is the signal to remove instead, rather than the two cases
# being told apart by guessing which one this is.
send_hold_back_path(){   # $1 = path relative to the repo
  git -C "$SYNC_REPO" checkout HEAD -- "$1" 2>/dev/null && return 0
  git -C "$SYNC_REPO" rm -q --cached -- "$1" 2>/dev/null || true
  rm -f "$SYNC_REPO/$1" 2>/dev/null || true
  return 0
}

send_hook_tests(){
  local f base suite out pairs rc=0 ran=0 reused=0 uncovered="" limit pid started now killed
  local digest verdict failed_suites="" files p
  case "${SYNC_NO_SEND_TESTS:-0}${SYNC_NO_HOOK_TESTS:-0}" in *1*) return 0 ;; esac

  # What this send is about to publish. `add -A` first, so the comparison is against the index the
  # commit will be made from rather than against a working tree nobody is committing.
  git -C "$SYNC_REPO" add -A -- payload 2>/dev/null || true

  limit="${SYNC_SEND_TESTS_TIMEOUT:-600}"
  case "$limit" in ''|*[!0-9]*) limit=600 ;; esac

  # The shortlist goes to scratch, never into $SYNC_REPO: a tool that leaves a file inside the repo
  # it is about to commit from is one `add -A` away from publishing its own working notes.
  pairs="$(scratch_file)" || return 0

  # Every (suite, file) pair this send has to judge, rather than a list of suites. Which files a
  # red suite costs a trip is the whole of #269, and a list of suites alone cannot answer it.
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    case "$f" in *.sh|*.py) ;; *) continue ;; esac
    base="$(basename "$f")"
    # A changed SUITE is its own relevant suite: a test edited in the live config is exactly as
    # unverified as the hook it covers, and that is how f094409's missing test went out.
    case "$base" in
      test-*) suite="$SYNC_REPO/payload/hooks/$base"
              [ -f "$suite" ] && printf 'C\t%s\t%s\n' "$suite" "$f" ;;
      run-all-tests.sh) ;;
      *) out="$(send_suites_covering "$base")"
         if [ -n "$out" ]; then
           while IFS= read -r suite; do
             [ -n "$suite" ] && printf 'C\t%s\t%s\n' "$suite" "$f"
           done <<COVERS
$out
COVERS
         else
           # Said out loud rather than passed over. The coverage ratchet is what GATES an uncovered
           # hook; what this must not do is publish one having run nothing and read the same as a
           # send whose suites all passed (L98).
           printf 'U\t-\t%s\n' "$base"
         fi ;;
    esac
  done < <(git -C "$SYNC_REPO" diff --cached --name-only -- payload/hooks 2>/dev/null) > "$pairs" 2>/dev/null

  uncovered="$(awk -F'\t' '$1=="U"{print $3}' "$pairs" 2>/dev/null | sort -u | tr '\n' ' ')"

  # Taken BEFORE anything is held back, because holding back rewrites the index, and the verdict
  # has to be remembered against what was actually judged.
  digest="$(send_hooks_digest)"

  # Deduplicated. A suite that both changed itself and covers a changed hook appears twice, and
  # running it twice is the cost this issue exists to bound.
  while IFS= read -r suite; do
    [ -n "$suite" ] || continue
    verdict="$(send_verdict_recall "$(basename "$suite")" "$digest")"
    if [ -n "$verdict" ]; then
      reused=$(( reused + 1 ))
    else
      ran=$(( ran + 1 ))
      out="$(scratch_file)" || out="/dev/null"
      # Same shape as the pull's runner: a background child against the clock, because a wait with
      # no deadline cannot fail, it can only hang, and this one holds the sync lock while it does
      # (L110).
      SYNC_NO_SEND_TESTS=1 SYNC_NO_HOOK_TESTS=1 bash "$suite" > "$out" 2>&1 &
      pid=$!
      started="$(date +%s)"; killed=0
      while kill -0 "$pid" 2>/dev/null; do
        now="$(date +%s)"
        if [ "$(( now - started ))" -ge "$limit" ]; then
          killed=1
          kill -TERM "$pid" 2>/dev/null || true
          break
        fi
        sleep "$SYNC_POLL_INTERVAL"
      done
      if [ "$killed" -eq 1 ]; then
        wait "$pid" 2>/dev/null || true
        verdict=fail
      elif wait "$pid" 2>/dev/null; then
        verdict=pass
      else
        verdict=fail
      fi
      [ "$out" = "/dev/null" ] || rm -f "$out" 2>/dev/null || true
      # A killed run is recorded as a failure like any other, and deliberately so: what the
      # remembered verdict has to survive is a change to the inputs, and a deadline that fired
      # once will fire again on the same bytes on the same machine.
      send_verdict_record "$(basename "$suite")" "$digest" "$verdict"
    fi
    [ "$verdict" = fail ] && failed_suites="$failed_suites$suite
"
  done < <(awk -F'\t' '$1=="C"{print $2}' "$pairs" 2>/dev/null | sort -u)

  if [ -n "$uncovered" ]; then
    echo "claude-sync: sent, but NO SUITE covers these changed hook(s), so nothing verified them here: $uncovered" >&2
  fi

  # #269: hold back the hooks the red suite covers, and send everything else. Refusing the WHOLE
  # send was the first shape and it is the more expensive failure of the two: an unrelated red
  # suite stopped rule files, skills and lessons reaching the other Mac as well, and #196 records
  # that a watcher which has stopped sending is already hard to notice from outside. This is the
  # same "only that file waits" rule the malformed rule file check above already uses.
  if [ -n "$failed_suites" ]; then
    while IFS= read -r suite; do
      [ -n "$suite" ] || continue
      files="$(awk -F'\t' -v s="$suite" '$1=="C" && $2==s {print $3}' "$pairs" 2>/dev/null | sort -u)"
      while IFS= read -r p; do
        [ -n "$p" ] && send_hold_back_path "$p"
      done <<HELD
$files
HELD
      # The suite AND the files it cost a trip, on ONE line. A sentence naming the suite and a
      # different sentence naming the file cannot answer between them about which hook is waiting
      # (L178, L80).
      echo "claude-sync: NOT publishing $(printf '%s' "$files" | sed 's|^payload/hooks/||' | tr '\n' ' ')because $(basename "$suite") fails here, so nothing verified them. Everything else in this send went out normally. Run it to see why: bash $CLAUDE_HOME/hooks/$(basename "$suite"). The edits are untouched in $CLAUDE_HOME and go out on the next send once it passes. Deliberate override for one run: SYNC_NO_SEND_TESTS=1 claude-sync send" >&2
      notify "held back $(printf '%s' "$files" | sed 's|^payload/hooks/||' | tr '\n' ' '): $(basename "$suite") fails here"
    done <<FAILED
$failed_suites
FAILED
  fi

  [ "$ran" -gt 0 ] && echo "claude-sync: ran $ran suite(s) covering the hook(s) in this send."
  # Said out loud rather than silently saved. A saving that has quietly stopped happening looks
  # exactly like one still working (L289), and this is the number that says the gate's cost is
  # bounded rather than paid again on every keystroke.
  [ "$reused" -gt 0 ] && echo "claude-sync: reused the remembered verdict for $reused suite(s), whose inputs are unchanged since it was measured."
  return "$rc"
}

# Seconds left on a LIVE hold, printed on stdout; nothing, and a non-zero return, for every other
# state. The three states are told apart in their own words rather than folded together, because a
# marker nothing can read is neither "no hold" nor "held for ever": obeying it stops the sync until
# somebody finds the file, and ignoring it silently discards a decision somebody made (L11, L50).
hold_remaining(){
  local until taken now
  [ -f "$SYNC_HOLD_FILE" ] || return 1
  until="$(awk 'NR==1{print $1}' "$SYNC_HOLD_FILE" 2>/dev/null)"
  taken="$(awk 'NR==1{print $2}' "$SYNC_HOLD_FILE" 2>/dev/null)"
  case "$until" in
    ''|*[!0-9]*)
      echo "claude-sync: the watcher hold marker at $SYNC_HOLD_FILE could not be read, so it has been cleared and the watcher is sending again. Take another with 'claude-sync hold' if you still need one." >&2
      rm -f "$SYNC_HOLD_FILE" 2>/dev/null || true
      return 1 ;;
  esac
  now="$(date +%s)"
  if [ "$now" -ge "$until" ]; then
    case "$taken" in ''|*[!0-9]*) taken="$until" ;; esac
    echo "claude-sync: the watcher hold taken $(age_in_words "$(( now - taken ))") has expired, so it has been cleared and the watcher is sending again." >&2
    rm -f "$SYNC_HOLD_FILE" 2>/dev/null || true
    return 1
  fi
  printf '%s' "$(( until - now ))"
  return 0
}

do_hold(){   # $1 = minutes (optional)  $2.. = why (optional)
  local mins="${1:-$SYNC_HOLD_MINUTES}" why now
  case "$mins" in ''|*[!0-9]*|0) mins="$SYNC_HOLD_MINUTES" ;; esac
  shift 2>/dev/null || true
  why="$*"
  [ -n "$why" ] || why="a session is committing by hand"
  now="$(date +%s)"
  printf '%s %s %s %s\n' "$(( now + mins * 60 ))" "$now" "$(sync_hostname)" "$why" > "$SYNC_HOLD_FILE"
  echo "Watcher held off for $(duration_in_words "$(( mins * 60 ))") ($why). It resumes on its own when that runs out, or now with: claude-sync release"
  return 0
}

do_release(){
  if [ -f "$SYNC_HOLD_FILE" ]; then
    rm -f "$SYNC_HOLD_FILE" 2>/dev/null || true
    echo "Watcher hold released; the next edit sends normally."
  else
    # Said rather than passed over in silence: "nothing to release" and "released" are different
    # answers, and a release that reports success over a hold somebody else still holds is the
    # one that costs something (L98).
    echo "No watcher hold was in force, so nothing was released."
  fi
  return 0
}

# What this send DID, in one agreed shape, for the watcher to read back (claude-config#196).
#
# Local config changes sat unsent for 29 hours on 2026-08-23 while the watch daemon was running,
# and nothing anywhere reported it. The reason it could not be diagnosed is the logging: the watch
# loop wrote a timestamped line ONLY when a send exited non-zero, so a successful send wrote
# nothing at all and the log could not tell a watcher sending normally from one that had silently
# stopped. In 22 KB covering weeks there was exactly one line, a network blip. That is L98 exactly.
#
# A MARKER rather than the watcher matching prose: a classification built by grepping sentences
# breaks silently the first time one is reworded, and it would be wrong in the reassuring
# direction. Printed only under the watcher, because a person running `claude-sync send` by hand
# has the sentences and does not need the token; the watcher sets SYNC_IN_WATCH itself, and a
# reader that finds no marker says so rather than assuming success.
send_outcome(){   # $1 = sent|nothing|behind|held|failed
  [ "${SYNC_IN_WATCH:-0}" = "1" ] || return 0
  printf 'SEND-OUTCOME %s\n' "$1"
  return 0
}

# ---------- sends that could not go out because this Mac is behind (claude-config#323) ----------
#
# Being behind blocked the send, and nothing but the weekly receive timer could clear it, so the
# state sustained itself: measured in ~/.claude-sync.log on 2026-09-07, 21 consecutive skips over
# 46 hours, 26 commits behind, 15 lessons written here and unpublished. The only trace was log
# lines nothing reads, and the notify that did exist fired on EVERY edit, which is the alert that
# gets ignored (L36, L98, L51).
#
# So a send that finds itself behind now RECONCILES, which is the actual remedy, and only counts a
# skip when that reconcile did not clear it. The count is the thing worth having: one failure is a
# hiccup, twenty in a row is a Mac that has stopped syncing, and nothing could tell them apart.
BEHIND_ESCALATE_AFTER="${SYNC_BEHIND_ESCALATE_AFTER:-3}"   # skips in a row before anybody is told
BEHIND_ESCALATE_EVERY="${SYNC_BEHIND_ESCALATE_EVERY:-10}"  # and how often after that

# The reconcile, behind a seam. do_sync is the real one and is what runs unless a test says
# otherwise; the seam exists so the "it did not clear" path can be driven without a deliberately
# broken remote, which would be testing git rather than this (L291).
send_reconcile(){
  if [ -n "${SYNC_SEND_RECONCILE:-}" ]; then bash -c "$SYNC_SEND_RECONCILE"; return $?; fi
  do_sync
}

behind_skips_count(){
  local n
  [ -f "$BEHIND_SKIPS_FILE" ] || { printf '0'; return 0; }
  n="$(awk 'NR==1{print $1}' "$BEHIND_SKIPS_FILE" 2>/dev/null)"
  case "$n" in ''|*[!0-9]*) n=0 ;; esac
  printf '%s' "$n"
}

behind_skips_since(){   # the epoch of the FIRST skip in this run of them, or nothing
  local t
  [ -f "$BEHIND_SKIPS_FILE" ] || return 1
  t="$(awk 'NR==1{print $2}' "$BEHIND_SKIPS_FILE" 2>/dev/null)"
  case "$t" in ''|*[!0-9]*) return 1 ;; esac
  printf '%s' "$t"
}

# Cleared by anything that actually got through, or the count stops being a measurement and becomes
# a standing accusation that only ever grows (L344).
clear_behind_skips(){ rm -f "$BEHIND_SKIPS_FILE" 2>/dev/null || true; }

# Read from the FINISHED state rather than from whichever code path happened to fix it, and wired
# into the one trap every mutating command passes through, so a pull, a sync, a push and a send all
# clear it without any of them having to remember to (L78, L370). A count nothing clears stops
# being a measurement and becomes a standing accusation that only grows (L344).
clear_behind_skips_if_caught_up(){
  [ -f "$BEHIND_SKIPS_FILE" ] || return 0
  have_git || return 0
  unapplied_remote_changes || clear_behind_skips
}

# When the reconcile was last actually ATTEMPTED, so it is not attempted on every keystroke while
# it is being refused for the same reason each time (claude-config#327). A record with no fourth
# field is one written before this existed, and reads as "never attempted", which errs toward
# attempting: delaying the remedy is the worse mistake of the two (L223).
behind_last_reconcile(){
  local t
  [ -f "$BEHIND_SKIPS_FILE" ] || return 1
  t="$(awk 'NR==1{print $4}' "$BEHIND_SKIPS_FILE" 2>/dev/null)"
  case "$t" in ''|*[!0-9]*) return 1 ;; esac
  printf '%s' "$t"
}

record_behind_skip(){   # $1 = when the reconcile was last attempted -> the sentence for the caller
  local n first now tried="${1:-}"
  now="$(date +%s)"
  n="$(behind_skips_count)"; n=$(( n + 1 ))
  first="$(behind_skips_since || printf '%s' "$now")"
  case "$tried" in ''|*[!0-9]*) tried="$now" ;; esac
  printf '%s %s %s %s\n' "$n" "$first" "$now" "$tried" > "$BEHIND_SKIPS_FILE" 2>/dev/null || true
  # Told once at the threshold, then rarely. Every edit was the old behaviour and is why the real
  # one was ignored for two days.
  if [ "$n" -eq "$BEHIND_ESCALATE_AFTER" ] \
     || { [ "$n" -gt "$BEHIND_ESCALATE_AFTER" ] && [ "$(( n % BEHIND_ESCALATE_EVERY ))" -eq 0 ]; }; then
    notify "config has not sent for $(age_in_words "$(( now - first ))"): $n sends skipped"
  fi
  printf 'skipped %s send(s) in a row now, the first %s ago' "$n" "$(age_in_words "$(( now - first ))")"
}

do_send(){
  local hold_left
  # The lessons index is derived BEFORE either gate below (claude-config#320).
  #
  # It used to be derived only inside stage_local_to_payload, which this function reaches only
  # after both gates have let it past. On 2026-09-06 Dans-MacBook-Pro had been behind the shared
  # repo for two days, so every watcher fire took the `behind` branch and returned here, and the
  # three sessions that wrote lessons into its LESSONS.md in that window never reached the
  # derivation. LESSONS-INDEX.md is the file CLAUDE.md imports, so every session on both Macs was
  # loading an index missing those lessons, and nothing said so.
  #
  # The index is a purely LOCAL derivation of the LOCAL lessons file, into this Mac's own
  # ~/.claude. It touches neither the payload nor the repo, so whether a send is ALLOWED has
  # nothing to do with whether the index is correct, and gating one on the other was the defect.
  # A held or behind Mac at least loads its own lessons now.
  #
  # It runs again inside stage_local_to_payload on a send that does go through, which is where it
  # has to be for do_push, and that second derivation is silent: it rewrites nothing (the file
  # already matches) and its reports speak only when a lesson is malformed. Measured on
  # 2026-09-07, a full pass over the 6294 line LESSONS.md costs about 0.15s, against a send that
  # already checksums the whole config tree.
  write_lesson_index "$CLAUDE_HOME"
  # #262: the automatic send is what takes a deliberate commit's message and cancels its CI run,
  # so it is the one a hold stops. An explicit `claude-sync send` is unaffected.
  if [ "${SYNC_IN_WATCH:-0}" = "1" ] && hold_left="$(hold_remaining)"; then
    echo "claude-sync: the watcher is on hold for another $(duration_in_words "$hold_left"), so this edit was not sent. It goes out when the hold runs out, or immediately after: claude-sync release" >&2
    send_outcome held
    return 0
  fi
  # Never publish while this Mac is behind: send has no apply step, so it cannot
  # reconcile, and mirroring upward from here would revert the other Mac. Skipping
  # is safe because the receive timer (and any manual pull) will apply, after which
  # the next edit sends normally. Deliberately not an error: the watcher fires on
  # every edit, and a failure per edit while behind would be noise, not signal.
  if unapplied_remote_changes; then
    # RECONCILE, rather than skip and hope something else does it (claude-config#323). A send
    # cannot mirror upward while behind, because that reverts the other Mac, but the thing that
    # makes it safe again is a pull, and this is the moment we know one is needed. do_sync pulls,
    # applies and then sends, and it keeps every gate it already had: the CI gate still holds back
    # an untested shared head, and a real content clash is still reported in its own words.
    # In a SUBSHELL, and that is load-bearing rather than style. The reconcile is do_sync, and
    # do_sync reports several conditions through die(), which calls exit: run inline, a reconcile
    # that legitimately refuses (a real divergence, an unreachable repo) would end the whole send
    # with it, and `|| true` catches nothing because there is no subshell for it to catch. Measured
    # against the suite's own behind fixtures, that took out both the honest skip message and the
    # skip count. A subshell exit does not fire the parent's EXIT trap, so the lock is still held
    # and released exactly once.
    # Attempted at most once every SYNC_RECONCILE_RETRY seconds. While it is being refused for the
    # same reason each time (gh unreadable, no network) every single edit used to pay for a fetch
    # and a rebase against the shared repo. Backing off delays the remedy by at most that window,
    # which is nothing against the weekly timer this whole path replaced (claude-config#327).
    local bh_now bh_last bh_tried bh_window="${SYNC_RECONCILE_RETRY:-300}"
    bh_now="$(date +%s)"
    if bh_last="$(behind_last_reconcile)" && [ "$(( bh_now - bh_last ))" -lt "$bh_window" ] 2>/dev/null; then
      # Held off. Said in its own words, because "the reconcile just attempted did not clear it"
      # would be a claim about something this run did not do (L11).
      echo "claude-sync: this edit was not sent, because the shared repo holds changes this Mac has not applied. The reconcile that would fix it was attempted $(age_in_words "$(( bh_now - bh_last ))") ago and refused, so it is held off for another $(duration_in_words "$(( bh_window - (bh_now - bh_last) ))") rather than retried on every edit ($(record_behind_skip "$bh_last")). Run 'claude-sync pull' and read what it says." >&2
      send_outcome behind
      return 0
    fi
    bh_tried="$bh_now"
    ( send_reconcile ) || true
    if ! unapplied_remote_changes; then
      # It worked, and the send that follows is the one the edit asked for. Nothing is skipped, so
      # nothing is counted. The trap clears the record itself, from the finished state.
      :
    else
      # It did not clear. THIS is the state worth counting: one is a hiccup, twenty in a row is a
      # Mac that has stopped syncing, and before this nothing could tell them apart.
      echo "claude-sync: this edit was not sent, because the shared repo holds changes this Mac has not applied and the reconcile just attempted did not clear them ($(record_behind_skip "$bh_tried")). Run 'claude-sync pull' and read what it says; until then nothing leaves this Mac." >&2
      send_outcome behind
      return 0
    fi
  fi
  stage_local_to_payload
  have_git || return 0
  send_hook_tests                        # holds back the hooks a red suite covers; the rest sends (#269)
  commit_if_changed || { send_outcome nothing; return 0; }   # nothing changed -> nothing to send
  # A commit we just made from our OWN ~/.claude is applied here by construction:
  # stage_local_to_payload mirrored this Mac's files into it moments ago. Record it
  # as applied, or .last-applied stays at the previous commit and the guard above
  # reads this Mac's own send as "behind the other Mac", dropping every later send
  # until something runs an apply. Only on a clean push: a failed push falls through
  # to do_sync, whose rebase rewrites this SHA and whose apply records the real one.
  if git -C "$SYNC_REPO" push -q 2>/dev/null; then
    repo_head > "$LAST_APPLIED_FILE" 2>/dev/null || true
    # A push that succeeded is proof the repo was reachable, which is exactly what the
    # outage clock measures. Without this only the two-way sync stamps it, so a Mac edited
    # all day but synced weekly reads as "last reached GitHub days ago" while perfectly
    # online, and the next harmless blip gets reported as a long outage. (#22)
    record_sync_success
    echo "Sent."; send_outcome sent; return 0
  fi
  do_sync                                # behind remote: reconcile (pull+apply+push)
}

# ---------- status ----------
# A conflict copy is the ONLY record of work that lost a merge, and preserve_local_conflicts
# announces it exactly once, in a desktop notification, at the moment it is made. It is also
# in COMMON_EXCLUDES, so it never travels and the other Mac cannot see it either. That left a
# condition which PERSISTS in the data with nothing but a transient surface to report it, and
# a copy from 2026-07-29 duly sat in ~/.claude unnoticed for nearly three weeks. status is the
# surface that describes state, so it reports them for as long as they exist. (#20)
# Every set-aside copy on this Mac, absolute paths, sorted. Only the places
# preserve_local_conflicts can write one (it copies to CLAUDE_HOME plus a payload-relative path),
# never a sweep of the whole config folder, which holds the session history and every plugin and
# would make this cost real time on every status.
conflict_copy_paths(){
  local d
  {
    find "$CLAUDE_HOME" -maxdepth 1 -name '*.conflict-*' -type f 2>/dev/null
    for d in "${MIRROR_DIRS[@]}" skills; do
      [ -d "$CLAUDE_HOME/$d" ] || continue
      find "$CLAUDE_HOME/$d" -name '*.conflict-*' -type f 2>/dev/null
    done
  } | sort
  return 0
}

# The live file a copy was set aside from: the same path with the suffix removed.
conflict_copy_live(){   # $1 = absolute path of a .conflict-* copy
  printf '%s' "${1%.conflict-*}"
}

report_conflict_copies(){
  local f age now found="" live outstanding
  now="$(date +%s)"
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    # Seconds, not whole days: a copy made this morning used to report itself as zero of them,
    # and the shared renderer has words for spans shorter than a day (#77).
    age=$(( now - $(file_mtime "$f" | grep . || echo "$now") ))
    live="$(conflict_copy_live "$f")"
    outstanding="$(only_in_first "$f" "$live")"
    # The two states get different words, because "a conflict copy exists" says nothing about
    # whether anything is still at stake in it, and a copy whose content is now all in the live
    # file reads identically to one holding the last surviving version of a lesson (L11).
    if ! is_blank "$outstanding"; then
      found+="  ${f#"$CLAUDE_HOME"/} ($(duration_in_words "$age") old, STILL only here: ${outstanding})"$'\n'
    else
      found+="  ${f#"$CLAUDE_HOME"/} ($(duration_in_words "$age") old, nothing in it is missing from the live file: safe to delete)"$'\n'
    fi
  done < <(conflict_copy_paths)
  # Silent when there are none. A standing line saying "no conflicts" would be printed on
  # every single status and stop being read long before a real one ever appeared.
  [ -z "$found" ] && return 0
  echo "--- unresolved conflict copies (YOUR version, kept when a merge could not be done) ---"
  printf '%s' "$found"
  echo "  Compare each with the live file next to it, then delete the copy once you have what you need."
}

# The standing report, run at the end of every apply. The conflict itself is announced once, by
# preserve_local_conflicts, and NOTHING said so again: the live file matches the payload exactly
# afterwards, so status read healthy, verify read healthy, and the only copy of the entry that lost
# the merge sat beside it unmentioned. On 2026-08-17 a lesson survived only because that single
# line of output happened to be read (#45, L148, L152).
#
# Judged by what is still only in the copy, on this run, so it goes quiet the moment the content is
# back in the live file or the copy is deleted, and never before. A report keyed on the file merely
# existing would cry wolf until somebody deleted a file they had already dealt with, and one keyed
# on a marker written when the conflict happened could not notice either (L121).
report_pending_conflicts(){
  local f live outstanding pending=""
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    case "$PRESERVED_CONFLICTS" in *"
${f#"$CLAUDE_HOME"/}"*) continue ;; esac   # announced by this very run, a line above
    live="$(conflict_copy_live "$f")"
    outstanding="$(only_in_first "$f" "$live")"
    is_blank "$outstanding" && continue
    pending+="${f#"$CLAUDE_HOME"/} [still only there: ${outstanding}] "
  done < <(conflict_copy_paths)
  is_blank "$pending" && return 0
  echo "claude-sync: an earlier conflict set a copy of your version aside and it is STILL not resolved, so this content is in no file anything loads: ${pending}Take what you need into the live file beside it, then delete the copy. Nothing else reports this." >&2
  notify "still unresolved: ${pending}"
  return 0
}

# ---------- forget a Mac that is genuinely gone (#26) ----------
# A Mac you KNOW is gone should not need a 60 day wait to stop being reported. Deliberately
# manual: retiring a machine is a decision about the world, not something the tool can infer,
# and the automatic rule above only ever changes the WORDING, never removes anything.
do_forget_mac(){
  local host="${1:-}" me
  have_git || die "forget-mac needs the shared repo's git."
  [ -n "$host" ] || die "which Mac? Usage: claude-sync forget-mac <hostname>. Run 'claude-sync verify' to see the names."
  me="$(sync_hostname)"
  # Refused for THIS Mac: dropping your own marker does not retire anything, it just makes
  # this Mac invisible to the other one until its next apply republishes it.
  [ "$host" = "$me" ] && die "that is this Mac ($me). Dropping its own marker would only hide it from the other Mac until the next sync puts it back."
  fetch_state_refs
  git -C "$SYNC_REPO" rev-parse -q --verify "$STATE_REF_PREFIX/$host" >/dev/null 2>&1 \
    || die "no Mac called '$host' has published anything. Run 'claude-sync verify' to see the names on record."
  git -C "$SYNC_REPO" update-ref -d "$STATE_REF_PREFIX/$host" 2>/dev/null || true
  # Best effort on the remote: if it fails the ref comes back on the next fetch, so say so
  # rather than reporting a removal that will silently undo itself.
  if git -C "$SYNC_REPO" push -q origin ":$STATE_REF_PREFIX/$host" 2>/dev/null; then
    echo "Forgot $host. It will no longer appear in verify."
  else
    echo "claude-sync: removed $host locally, but could not reach the shared repo to remove it there, so it will come back on the next fetch. Run this again when you are online." >&2
    return 1
  fi
  return 0
}

# ---------- verify: do the Macs actually hold the same config? (#23) ----------
do_verify(){
  have_git || die "verify needs the shared repo's git history, and this run has git disabled."
  local tree me host file mtree mtime others=0 agreed=0 behind=0 retired=0 line now unsent rc=0 agentline
  now="$(date +%s)"
  tree="$(payload_tree)"
  me="$(sync_hostname)"
  [ -n "$tree" ] || die "the shared repo has no payload yet, so there is nothing to compare."

  # What this Mac holds that the shared config does NOT (claude-config#320).
  #
  # Everything below reads the marker each Mac published, which records the payload tree it
  # APPLIED. That answers whether a Mac has received the shared config and says nothing whatever
  # about whether it has sent its own, so a Mac whose watcher had stopped sending read as "up to
  # date" for two days on 2026-09-06 while three sessions' lessons sat unsent on it, and `status`
  # was saying LESSONS.md differs the whole time. Two checks over one state that answer differently
  # means at least one is not measuring what its sentence claims, and the reassuring one is the one
  # a person reads (L11, L53).
  #
  # Measured through the SAME enumerator `status` lists from, so the two cannot drift into
  # disagreeing again (L70). Only for THIS Mac: what another Mac holds locally is not visible from
  # here, and its line must go on claiming no more than the marker it published supports.
  unsent="$(local_unsent_count)"

  fetch_state_refs
  for file in $(git -C "$SYNC_REPO" for-each-ref --format='%(refname)' "$STATE_REF_PREFIX" 2>/dev/null || true); do
    [ -n "$file" ] || continue
    host="${file##*/}"
    line="$(git -C "$SYNC_REPO" cat-file blob "$file:applied" 2>/dev/null || true)"
    [ -n "$line" ] || continue
    mtree="${line%% *}"
    mtime="${line##* }"
    case "$mtime" in ''|*[!0-9]*) mtime="" ;; esac
    if [ "$mtree" = "$tree" ]; then
      # `agreed` still counts this Mac, because it HAS applied the shared config and that is the
      # question this counter asks. The unsent work is a separate condition with its own verdict
      # below, rather than being folded into agreement, so neither answer has to stand in for the
      # other (L53).
      if [ "$host" = "$me" ] && [ "$unsent" -gt 0 ]; then
        line="This Mac ($host): holds the shared config, but $unsent local change(s) have NOT been sent, so no other Mac can have them"
      elif [ "$host" = "$me" ]; then
        line="This Mac ($host): up to date with the shared config"
      else
        line="$host: up to date with the shared config"
      fi
      agreed=$((agreed+1))
    elif [ "$host" != "$me" ] && [ -n "$mtime" ] \
         && [ "$((now - mtime))" -ge "${SYNC_MAC_RETIRE_AFTER:-5184000}" ] 2>/dev/null; then
      # Inclusive, and that is not cosmetic. Written as "more than", a window of 0 does not retire
      # a marker recorded in the same SECOND, so whether the rule fires depended on how long the
      # machine took to get from writing it to reading it: green on a Mac, and green or red on a
      # runner depending on the run. The same commit produced both in two runs two seconds apart.
      # Two values read off a live clock whose whole margin is one tick of that clock's own
      # granularity (L134). At the real 60 day default the difference is one second and means
      # nothing; at the boundary it is the difference between a rule and a coin toss.
      # Silent for so long that "behind" is the wrong word: this reads as a Mac that was
      # retired, renamed or reinstalled. Its marker is keyed on hostname, a mutable string,
      # so a rename abandons the old one rather than moving it (L15, and the reason #26
      # exists at all). Left as BEHIND it would hold the verdict negative for ever, and a
      # check that can only ever say no stops being read.
      # 60 days, from the real history rather than a guess: the worst gap either Mac showed
      # in the window is 6.79 days, so this is 8.8x the longest real absence and a holiday
      # cannot trip it. Re-derive it with tools/measure-sync-gaps.sh rather than trusting
      # this comment: the figure was frozen here for eleven days with no cheap way to check
      # it, which is how the suite's own deadline drifted unnoticed (claude-config#113).
      # STILL NAMED, never dropped from the report: a Mac that genuinely fell behind must
      # not vanish from the surface that exists to notice exactly that.
      line="$host: RETIRED, no sign of it since $(date_from_epoch "$mtime" '+%Y-%m-%d' | grep . || echo 'an unknown date'). Run 'claude-sync forget-mac $host' to drop it."
      retired=$((retired+1))
    else
      # Counted from the HISTORY, never from the marker's clock. Counting commits since a
      # timestamp is a stand-in for the real quantity and it is wrong exactly when the two
      # Macs' clocks disagree, which is routine after a laptop sleeps. So: find the newest
      # commit whose payload tree is the one that Mac actually has, and count the
      # payload-changing commits after it. Falls back to the clock only when that commit is
      # no longer in history, and SAYS which of the two it used rather than presenting a
      # guess as a measurement.
      local n="" when="an unknown time" at=""
      at="$(git -C "$SYNC_REPO" rev-list HEAD 2>/dev/null | while read -r c; do
              [ "$(git -C "$SYNC_REPO" rev-parse -q --verify "$c:payload" 2>/dev/null)" = "$mtree" ] && { printf '%s' "$c"; break; }
            done || true)"
      if [ -n "$at" ]; then
        n="$(git -C "$SYNC_REPO" rev-list --count "$at..HEAD" -- payload 2>/dev/null || true)"
      fi
      if [ -z "$n" ]; then n="an unknown number of"; fi
      if [ -n "$mtime" ]; then
        when="$(date_from_epoch "$mtime" '+%Y-%m-%d %H:%M' | grep . || echo 'an unknown time')"
      fi
      line="$host: BEHIND by $n config change(s), last applied $when"
      behind=$((behind+1))
    fi
    echo "  $line"
    # The launch agents that Mac published, said on its own line (claude-config#328). Separate from
    # the marker verdict above because they are a different question: a Mac can hold exactly the
    # right config and still be running a schedule that stopped being current a month ago, and
    # folding the two into one line would make each read as a comment on the other.
    #
    # A marker with NO agents field is one published before this existed, and nothing is said about
    # it: claiming it is fine would be a claim about something nobody measured, and claiming it is
    # unknown on every Mac for the first day would be noise nobody can act on (L98, L223). Every
    # Mac republishes on its next sync, so the gap closes on its own.
    agentline="$(git -C "$SYNC_REPO" cat-file blob "$file:agents" 2>/dev/null || true)"
    case "$agentline" in
      stale\ *)
        echo "  $host: launch agent(s) out of date there: ${agentline#stale }. That Mac is running a definition its own claude-sync no longer writes, so its automatic sending or receiving is on old settings. On that Mac: claude-sync install-autosync" ;;
      none)
        echo "  $host: launch agent(s) not installed there at all, so that Mac never sends or receives on its own and every sync of its config is one somebody typed. On that Mac: claude-sync install-autosync" ;;
    esac
    others=$((others+1))
  done

  # Nothing published is UNKNOWN, never agreement. An empty result arrives exactly when
  # nothing has been checked, which is the moment a clean verdict is most likely believed.
  if [ "$others" -eq 0 ]; then
    echo "claude-sync: no Mac has published what it applied yet, so whether they hold the same config cannot be answered. Run a sync on each Mac once, then verify again." >&2
    return 1
  fi
  [ "$retired" -gt 0 ] && echo "  ($retired Mac(s) reported as retired above are not counted in the verdict)"
  # Its own message and its own remedy, because "the other Mac has not applied yet" and "this Mac
  # never sent" need different actions and one sentence covering both would hide whichever it did
  # not name (L11). It does not suppress the marker verdict beneath it: both facts are true, and a
  # reader needs to see which of them applies.
  if [ "$unsent" -gt 0 ]; then
    rc=1
    echo "claude-sync: this Mac holds $unsent change(s) the shared config does not have, so the markers below cannot mean the Macs agree on them. Run 'claude-sync status' to see what, then 'claude-sync sync' to send it." >&2
  fi
  if [ "$behind" -eq 0 ]; then
    # One Mac agreeing with itself is agreement with nobody, and saying "agree" there is the
    # same vacuous success the no-markers case above exists to prevent. Found on the real
    # repo minutes after shipping, where it read "all 1 Mac(s) agree" while the second Mac
    # had simply never published.
    # The "cannot be answered yet" refusal is for the case where another Mac is EXPECTED to
    # report and has not. When the only other Mac is retired there is nothing outstanding and
    # nothing to wait for, so telling you to go and sync it would be wrong advice, and a
    # verdict that can never be positive is the very thing #26 is about.
    if [ "$agreed" -le 1 ] && [ "$retired" -eq 0 ]; then
      echo "This Mac is up to date, but only this Mac has published what it applied, so whether the Macs agree cannot be answered yet. Run a sync on the other Mac, then verify again." >&2
      return 1
    fi
    # The word "Verified" is a clean bill of health and is spoken only when there is one to give.
    # With work still unsent the markers genuinely do agree, so the same fact is stated as an
    # observation about the markers rather than as a verdict about the config: a reader who sees
    # "Verified" stops reading, and the sentence they would have stopped before is the one telling
    # them their lessons never left this Mac (L11, L152).
    local marker_fact
    if [ "$agreed" -le 1 ]; then
      marker_fact="this Mac is up to date, and the only other Mac on record is retired"
    elif [ "$agreed" -eq 2 ]; then
      marker_fact="both Macs agree on the same config"
    else
      marker_fact="all $agreed Macs agree on the same config"
    fi
    if [ "$rc" -eq 0 ]; then
      echo "Verified: ${marker_fact}."
    else
      echo "  (on what each Mac has applied, ${marker_fact}; the unsent changes above are the outstanding part)"
    fi
    return "$rc"
  fi
  echo "claude-sync: $behind of $others Mac(s) have not applied the current config. Run 'claude-sync pull' on each one named above." >&2
  return 1
}

# One stamp, rendered. Three states, deliberately worded so they cannot be mistaken for each other
# (L11): it never happened, the record is unreadable, or here is when and how long ago. Reporting an
# unreadable record as "never" would be a confident claim that this Mac has never sent, which is a
# different and wrong thing to tell somebody.
stamp_in_words(){   # $1 = stamp file  $2 = now (epoch)  $3 = what "never" means for this one
  local raw when
  [ -f "$1" ] || { printf 'never, %s' "$3"; return 0; }
  raw="$(cat "$1" 2>/dev/null || true)"
  case "$raw" in ''|*[!0-9]*)
    printf 'the record exists but could not be read (%s), so this is unknown' "$1"; return 0 ;;
  esac
  when="$(date_from_epoch "$raw" '+%Y-%m-%d %H:%M')"
  [ -n "$when" ] || { printf 'the record exists but could not be read (%s), so this is unknown' "$1"; return 0; }
  printf '%s (%s)' "$when" "$(age_in_words "$(( $2 - raw ))")"
}

# The header the pending list below is read against (#75). Four files pending means one thing if
# this Mac sent an hour ago and something very different if it last sent three weeks ago, and
# without this the two read identically.
report_sync_times(){
  local now; now="$(date +%s)"
  echo "--- when config last moved between this Mac and the shared repo ---"
  printf '  last sent:      %s\n' "$(stamp_in_words "$LAST_SENT_FILE" "$now" 'nothing has gone up from this clone')"
  printf '  last received:  %s\n' "$(stamp_in_words "$LAST_RECEIVED_FILE" "$now" 'nothing has come down into this clone')"
  # The third fact, without which the first two are ambiguous (#76). A long gap since the last send
  # means something is stuck if the repo was reachable throughout, and means an outage if it was
  # not, and those want opposite responses. .last-success has recorded this since #22 and nothing
  # showed it.
  printf '  repo reachable: %s\n' "$(stamp_in_words "$LAST_SUCCESS_FILE" "$now" 'this clone has never reached the shared repo')"
  echo "  The first two are the last time something actually moved, not the last time a sync ran."
  echo "  The third only means the repo could be reached; it moves on every successful run and says nothing about whether anything crossed."
}

# Other clones of this repo on this Mac (claude-config#187).
#
# .hook-tests lives in $SYNC_REPO, so it belongs to whichever clone did the work. This Mac has two
# on purpose: ~/claude-config-sync, which the scheduled job and the watch daemon run from and which
# holds .last-applied and .last-received, and the development checkout, which holds none of them.
# status run from the development checkout therefore could not see a failure the scheduled clone
# had recorded, and the scheduled clone is the one that pulls unattended, so its failures are
# exactly the ones nobody is watching for.
#
# They are found from the launch agent plists, which NAME the script each job runs, so this reads
# what actually runs rather than a list maintained beside it, which would only ever check what
# somebody remembered to add (L41, L96).
#
# A plist naming a script that is not there is skipped rather than reported. That job is broken,
# which is worth saying, but it is not this line's business and saying it here would put a second
# unrelated fault in the middle of a verdict.
#
# Compared with pwd -P on both sides, because the two clones can be reached through symlinked paths
# and a textual comparison would report a clone as a stranger to itself.
other_sync_clones(){   # prints one absolute directory per line, this clone excluded
  local agentdir="${SYNC_LAUNCHAGENTS:-$HOME/Library/LaunchAgents}" plist path dir mine _reg_d
  mine="$(cd "$SYNC_REPO" 2>/dev/null && pwd -P)" || mine=""
  {
    if [ -d "$agentdir" ]; then
      for plist in "$agentdir"/com.claudesync.*.plist; do
        [ -f "$plist" ] || continue
        sed -n 's|.*<string>\(/[^<]*/claude-sync\)</string>.*|\1|p' "$plist" 2>/dev/null || true
      done
    fi
    # And every clone that has recorded itself (claude-config#189). A launch agent only ever names
    # the clone a background job runs from, so on its own this found the scheduled clone from the
    # development checkout and never the other way round.
    if [ -f "$CLONE_REGISTRY" ]; then
      # Disposable entries are dropped here too (claude-config#295), or a throwaway clone recorded
      # before the refusal existed goes on answering for a verdict nobody can act on.
      while IFS= read -r _reg_d; do
        [ -n "$_reg_d" ] || continue
        is_under_temp_dir "$_reg_d" && continue
        printf '%s/claude-sync\n' "$_reg_d"
      done < "$CLONE_REGISTRY"
    fi
  } | while IFS= read -r path; do
      [ -n "$path" ] || continue
      # An entry naming a directory that no longer holds a claude-sync is skipped rather than
      # reported: a clone that has been deleted is not a clone whose verdict anybody can read.
      [ -f "$path" ] || continue
      dir="$(cd "$(dirname "$path")" 2>/dev/null && pwd -P)" || continue
      [ -n "$dir" ] || continue
      [ "$dir" = "$mine" ] && continue
      printf '%s\n' "$dir"
    done | sort -u
  return 0
}

# What the last hook suite decided, while it is still outstanding (claude-config#182), for THIS
# clone and for every other clone on this Mac (claude-config#187).
#
# Quiet on a pass and quiet with no record at all, because status reports what needs attention and
# neither of those does. Loud on every other outcome, and each in its own words: a suite that FAILED
# says a check on this config does not pass, one that could NOT be run says nothing checked it, and
# they send a reader to different places (L11). A record nothing can read is said to be unreadable
# rather than skipped, or a half written or restored file reads as a clean Mac (L98).
#
# A record found in ANOTHER clone says so, and names it. Which clone recorded a verdict is which
# config was verified, and a line that leaves that out tells a reader a suite failed while denying
# them the one fact they need to act on it (L11).
# The record carries the coverage counts too since claude-config#185. They are read here so the
# exit code stops at its own field: `read` puts every remaining field in the LAST name, so a widened
# record read by the old three-name form reports "it exited 3<tab>?<tab>?". Nothing is SAID about
# coverage here, because this surface is quiet on a pass by design and a partial pass is still a
# pass; where that number belongs is the closing line of the pull that produced it, and the record
# keeps it for anyone reading the file afterwards.
# How much of the deadline the last receive actually used (claude-config#218). The whole point is
# that growth shows up as HEADROOM SHRINKING rather than as a timeout on the day it runs out: a
# suite that outgrows SYNC_HOOK_TESTS_TIMEOUT reports "the hook suite could NOT be completed here",
# which sends the reader to look for a hang rather than for a suite that simply got longer (L11).
#
# Half is the line. A run past that has doubled its share of a deadline that was set at four times
# the worst observed, so it is the point at which the number is worth re-deriving rather than the
# point at which anything is wrong.
#
# "No duration recorded" is its own answer and never folded into "within budget": every record
# written before this existed carries none, and reading that absence as comfortable is exactly the
# reassuring default this refuses (L98, L11).
hook_suite_headroom(){   # $1 = seconds the run took, or ? -> a clause, or nothing
  local d="${1:-?}" limit half
  case "$d" in ''|*[!0-9]*) printf ' with no duration recorded, so how much of the deadline it used is unknown'; return 0 ;; esac
  limit="${SYNC_HOOK_TESTS_TIMEOUT:-1800}"
  case "$limit" in ''|*[!0-9]*) limit=1800 ;; esac
  [ "$limit" -gt 0 ] || { printf ' in %ss' "$d"; return 0; }
  half=$(( limit / 2 ))
  if [ "$d" -ge "$half" ]; then
    printf ' in %ss, which is over HALF the %ss it is given. It is on course to be cut off, and a run that is cut off reports that nothing was verified rather than that the suite got longer' "$d" "$limit"
  else
    printf ' in %ss of the %ss it is given' "$d" "$limit"
  fi
  return 0
}

# What to say about the suites that could not run. Three answers, kept apart: none, some named,
# and some whose names this record does not carry (L11).
hook_suite_skipped(){   # $1 = the notrun count  $2 = the names, or ? / empty
  case "${1:-}" in ''|'?'|0) return 0 ;; *[!0-9]*) return 0 ;; esac
  case "${2:-}" in
    ''|'?') printf ', though %s of its suites could not run here and this record does not name them' "$1" ;;
    *)      printf ', though %s of its suites could not run here: %s' "$1" "$(printf '%s' "$2" | tr ',' ' ')" ;;
  esac
  return 0
}

# One field out of a key=value record, by name. Empty when the field is not there, which the
# caller has to tell apart from a field that is present and empty: every field this writes is
# non-empty by construction, so an empty answer means absent.
hook_suite_field(){   # $1 = the record line  $2 = the field name
  # Pure parameter expansion, no pipeline. `... | head -1` is a short circuiting consumer, and
  # under this file's pipefail that kills its producer and reports a failure that never
  # happened (L183).
  local rest="$1" pair
  while [ -n "$rest" ]; do
    pair="${rest%%$'\t'*}"
    case "$pair" in "$2="*) printf '%s' "${pair#"$2="}"; return 0 ;; esac
    case "$rest" in *$'\t'*) rest="${rest#*$'\t'}" ;; *) rest="" ;; esac
  done
  return 0
}

report_hook_suite_record(){   # $1 = the record file  $2 = the clone it belongs to, or empty for this one
  local line outcome when code ran notrun took notrun_names now age prefix="hook suite: "
  [ -n "${2:-}" ] && prefix="hook suite (recorded by another clone on this Mac, $2, which a background job runs from): "
  [ -f "$1" ] || return 0
  line="$(head -1 "$1" 2>/dev/null || true)"
  # Named fields since claude-config#233. A record written before that has no `=` in its first
  # field, and is read positionally so an upgrade does not turn every existing record into an
  # unreadable one; nothing writes that shape any more.
  case "$line" in
    *=*)
      outcome="$(hook_suite_field "$line" outcome)"
      when="$(hook_suite_field "$line" at)"
      code="$(hook_suite_field "$line" exit)"
      ran="$(hook_suite_field "$line" ran)"
      notrun="$(hook_suite_field "$line" notrun)"
      took="$(hook_suite_field "$line" seconds)"
      notrun_names="$(hook_suite_field "$line" notrun_names)" ;;
    *)
      IFS="$(printf '\t')" read -r outcome when code ran notrun took <<HSREOF
$line
HSREOF
      notrun_names="?" ;;
  esac
  case "$when" in ''|*[!0-9]*) when="" ;; esac
  case "$outcome" in
    passed)
      # This surface is otherwise quiet on a pass, deliberately. It speaks here because the
      # headroom is the one thing a passing run has to say: it only ever shrinks, and the moment
      # it stops being reported is the moment the next timeout arrives with no warning.
      [ -n "$when" ] || return 0
      now="$(date +%s)"
      # A count of suites that could not run cannot be acted on and cannot be tracked: there is no
      # way to tell whether the three that sat out are trivial or cover the most important
      # behaviour, and no way to notice the number quietly growing (claude-config#250, L98). So the
      # NAMES ride in the record and are said here. A record written before they did says so in
      # those words rather than reading as none.
      echo "${prefix}passed $(age_in_words "$(( now - when ))")$(hook_suite_headroom "$took")$(hook_suite_skipped "$notrun" "$notrun_names")."
      return 0 ;;
    failed|notrun|incomplete)
      [ -n "$when" ] || outcome="" ;;
    *) outcome="" ;;
  esac
  if [ -z "$outcome" ]; then
    echo "${prefix}the record in $1 is unreadable, so what that run's checks decided cannot be answered from here. Run them again and record what they say with: claude-sync recheck"
    return 0
  fi
  now="$(date +%s)"
  age="$(age_in_words "$(( now - when ))")"
  case "$outcome" in
    failed)
      echo "${prefix}FAILED $age (it exited ${code:-?})$(hook_suite_headroom "$took"). The config that run installed is on disk, and at least one check on it does not pass. What it said is in $1. Once it is fixed, run  claude-sync recheck  to run them again and replace this record: running the suite on its own does not, because this is the only thing that writes it" ;;
    notrun)
      echo "${prefix}could NOT be run $age, because hooks arrived and there was no $CLAUDE_HOME/hooks/run-all-tests.sh to check them with. Nothing that landed has been verified." ;;
    incomplete)
      echo "${prefix}could NOT be completed $age, because it was still running when the run that started it stopped waiting. Nothing that landed has been verified. What it managed to say is in $1, and  claude-sync recheck  runs them again and records what they say" ;;
  esac
  return 0
}

# This clone first, then any other on this Mac, so the record a reader is most likely to be asking
# about leads and the rest are labelled as coming from somewhere else.
report_hook_suite_result(){
  local d
  report_hook_suite_record "$HOOK_TESTS_FILE" ""
  while IFS= read -r d; do
    [ -n "$d" ] || continue
    report_hook_suite_record "$d/.hook-tests" "$d"
  done <<OTHERCLONEEOF
$(other_sync_clones)
OTHERCLONEEOF
  return 0
}

# A hold stops the watcher sending, and nothing else says so. A suppression set by hand has to be
# listed somewhere a person actually looks, or it becomes the reason the sync stopped that nobody
# can find (L523). Silent when there is none, like everything else here: status reports what needs
# attention.
# The count on screen, because a log line is not a report: the real one left 21 skips in
# ~/.claude-sync.log and nothing anybody would look at (claude-config#323). Silent when there is
# nothing to say, so it distinguishes something when it does speak (L36).
# An error waved through as expected still has to be counted somewhere a person looks (L77). Once
# the unreadable window has passed, every commit arrives unjudged and the alert has already been
# given once, so without this the only remaining trace is a log line nobody opens, which is the
# same silence claude-config#323 was about. Says nothing when there is nothing to say.
# The one state that stops ALL syncing, said on the surface built to report on syncing
# (claude-config#330). status reported how far ahead or behind a clone was and when config last
# moved, and said nothing about a clone that could not move anything at all: on 2026-09-07 it
# printed "[ahead 1, behind 8]" and "last received 4 hours ago" for a clone stuck mid rebase, and
# being behind reads as a clone that will catch up on its next run, which is exactly wrong here.
#
# status never takes the lock and recovers nothing, by design, so reporting it IS the job here. A
# mutating run recovers it instead, which is why this names both what is wrong and what fixes it.
report_blocked_clone(){
  local state paths
  have_git || return 0
  state="$(sync_rebase_state)"
  case "$state" in
    concludable)
      echo "this clone CANNOT send or receive: it was left mid rebase by an earlier run. Nothing is conflicted and nothing needs deciding, so the next sync, send or pull concludes it by itself. Run one, or conclude it yourself: git -C $SYNC_REPO rebase --continue" ;;
    conflict)
      paths="$(sync_rebase_conflict_paths | tr '\n' ' ' | sed 's/ $//')"
      echo "this clone CANNOT send or receive: it was left mid rebase by an earlier run and is still waiting on a conflict in ${paths:-a step that has not been applied}. No sync can clear that, because only a person can settle it. In $SYNC_REPO, settle those paths and then 'git rebase --continue', or abandon it with 'git rebase --abort'." ;;
    *) return 0 ;;
  esac
  # Said whatever the counts above showed. Ahead and behind are true and beside the point while
  # nothing can move in either direction (L11).
  return 0
}

report_ci_unreadable(){
  local since now elapsed window="${SYNC_CI_UNREADABLE_AFTER:-10800}"
  [ -f "$CI_UNREADABLE_SINCE_FILE" ] || return 0
  since="$(awk 'NR==1{print $1}' "$CI_UNREADABLE_SINCE_FILE" 2>/dev/null)"
  case "$since" in ''|*[!0-9]*) return 0 ;; esac
  now="$(date +%s)"; elapsed=$(( now - since ))
  if [ "$elapsed" -ge "$window" ] 2>/dev/null; then
    echo "config is arriving WITHOUT a verdict: whether the shared repo's head passed its tests could not be read for $(age_in_words "$elapsed"), which is past the $(duration_in_words "$window") this waits, so it is being applied unjudged. Only the hook suite run after each apply is judging it. Check that gh is installed and logged in."
  else
    echo "the shared repo's test verdict could not be read for the last $(age_in_words "$elapsed"), so config is being held back. After $(duration_in_words "$window") it is applied anyway rather than held for ever. Check that gh is installed and logged in."
  fi
}

report_behind_skips(){
  local n first now
  n="$(behind_skips_count)"
  [ "$n" -gt 0 ] 2>/dev/null || return 0
  now="$(date +%s)"
  first="$(behind_skips_since || printf '%s' "$now")"
  echo "sending is stuck: skipped $n send(s) in a row, the first $(age_in_words "$(( now - first ))") ago, because this Mac is behind the shared repo and the reconcile each one tried did not clear it. Run 'claude-sync pull' and read what it says."
}

# What a shared repo that stays red is doing to this Mac (claude-config#336). The gate says it on
# the run that refused, which reaches the watcher log and nothing else; this is the surface built to
# answer the question, and it said nothing at all while every Mac sat not receiving for seven hours.
report_red_skips(){
  local n first now
  [ -f "$CI_RED_SINCE_FILE" ] || return 0
  n="$(awk 'NR==1{print $2}' "$CI_RED_SINCE_FILE" 2>/dev/null)"
  case "$n" in ''|*[!0-9]*) n=0 ;; esac
  [ "$n" -gt 0 ] || return 0
  now="$(date +%s)"
  first="$(awk 'NR==1{print $1}' "$CI_RED_SINCE_FILE" 2>/dev/null)"
  case "$first" in ''|*[!0-9]*) first="$now" ;; esac
  echo "receiving is stuck: the shared repo's newest commit has failed its tests $n time(s) in a row, the first $(age_in_words "$(( now - first ))") ago. Nothing here receives config until a green commit lands. Look at the failing run: gh run list --limit 5"
  return 0
}

report_watcher_hold(){
  local left
  if left="$(hold_remaining)"; then
    echo "watcher hold: the automatic send is held for another $(duration_in_words "$left") ($(awk 'NR==1{$1="";$2="";$3="";sub(/^ +/,"");print}' "$SYNC_HOLD_FILE" 2>/dev/null)). Lift it now with: claude-sync release"
  fi
  return 0
}

# Where the OTHER clones on this Mac stand against the shared repo (claude-config#266).
#
# `pull` reports what changed in the deployed copy under ~/.claude, and rule-files-changed.sh
# reports a rule file going stale inside a running session. Nothing reported that the DEVELOPMENT
# CHECKOUT, which is a different directory and the one the config is actually edited in, had
# fallen behind. On 2026-09-02 it was 40 commits behind immediately after a pull, missing three
# helper scripts that had just landed in ~/.claude. An edit made in a stale checkout looks correct
# locally, and pushing it builds on work that is already in the shared repo but absent there.
#
# The clones are read from the registry, which is derived from what has actually taken the lock
# rather than from prose somebody maintains by hand (L41, L244). Nothing is FETCHED: this run has
# just fetched its own remote, and both clones share it, so the other clone's HEAD is measured
# against the ref this run already has. That also means a clone holding a commit this one has
# never seen cannot be judged from here, and that is said rather than reported as up to date
# (L98).
report_other_clones_position(){
  local up d head n line said=0
  have_git || return 0
  up="$(git -C "$SYNC_REPO" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)"
  [ -n "$up" ] || return 0
  [ -f "$CLONE_REGISTRY" ] || return 0
  while IFS= read -r d; do
    [ -n "$d" ] || continue
    [ "$d" = "$SYNC_REPO" ] && continue
    # An entry recorded before the refusal above existed, and nothing prunes the register
    # (claude-config#295). Skipped silently: there is nothing a reader could do about it and saying
    # so on every run is the noise this removes.
    is_under_temp_dir "$d" && continue
    if [ ! -d "$d/.git" ]; then
      echo "claude-sync: the clone recorded at $d is not there any more, so how far behind it is cannot be answered. If it has gone for good: claude-sync forget-clone $d" >&2
      said=1; continue
    fi
    head="$(git -C "$d" rev-parse HEAD 2>/dev/null || true)"
    if [ -z "$head" ]; then
      echo "claude-sync: the checkout at $d has no commit this could read, so how far behind it is cannot be answered." >&2
      said=1; continue
    fi
    if ! git -C "$SYNC_REPO" cat-file -e "${head}^{commit}" 2>/dev/null; then
      echo "claude-sync: the checkout at $d is on a commit this clone has never seen ($head), so how far behind it is cannot be answered from here. Run 'git -C $d fetch' there." >&2
      said=1; continue
    fi
    n="$(git -C "$SYNC_REPO" rev-list --count "${head}..${up}" 2>/dev/null || true)"
    case "$n" in ''|*[!0-9]*) continue ;; esac
    [ "$n" -gt 0 ] || continue
    echo "claude-sync: the checkout at $d is $n commit(s) behind $up. Config edited there is being written against a copy the shared repo has already moved past: run 'git -C $d pull' before working in it." >&2
    said=1
  done < "$CLONE_REGISTRY"
  return 0
}

# Which automatic jobs this Mac runs, and which of their receives waits for CI (claude-config#280).
#
# claude-config#221 gated the automatic receive, and the answer to "is THIS Mac gated" was a plist
# somebody had to open and read. Two Macs could sit in different states with nothing able to tell
# them apart.
#
# The issue was filed believing the gate travelled in the plist, as a SYNC_AUTOMATIC variable.
# It does not, and nothing here ever read one: writeplist puts only PATH in a plist's environment,
# and the gate turns on because watch_tick sets SYNC_IN_WATCH itself, inside whichever claude-sync
# the job runs (L61). So an old PLIST is not the divergence. What is, is a plist naming a
# claude-sync in a clone that has not been updated, because a plist records an absolute path and
# this Mac has more than one clone.
#
# THE MARKER is the gate function's own name, which the function and its caller both spell, so it
# cannot appear in a copy written before the gate. A rename would make every copy read as ungated,
# which is the report going wrong in the direction that raises a false alarm on a correctly gated
# Mac, so the suite asserts THIS script satisfies it: a rename turns that check red rather than
# turning this report into a lie (L96, L103).
CI_GATE_MARKER="ci_gate_blocks_pull"

#
# Both read sed's whole output into a variable and take the first line with a parameter expansion,
# rather than piping it to `head -1`. A reader that leaves on the first line kills the producer with
# SIGPIPE, and under `set -o pipefail` the pipeline then reports a failure that never happened
# (L183); test-pipefail-shortcircuit.sh caught both of these on the way in.
plist_program(){   # $1 = plist -> the claude-sync it runs, or nothing
  local out
  out="$(sed -n 's|.*<string>\(/[^<]*/claude-sync\)</string>.*|\1|p' "$1" 2>/dev/null)"
  printf '%s' "${out%%$'\n'*}"
}
plist_interval(){  # $1 = plist -> StartInterval in seconds, or nothing
  local out
  out="$(sed -n 's|.*<key>StartInterval</key><integer>\([0-9][0-9]*\)</integer>.*|\1|p' "$1" 2>/dev/null)"
  printf '%s' "${out%%$'\n'*}"
}

# One line per job. Every state gets its own sentence, because "not installed", "installed but
# pointing at nothing", "installed and ungated" and "installed and gated" need four different
# remedies and only one of them is a fault worth acting on (L11).
report_automatic_jobs(){
  local agentdir="${SYNC_LAUNCHAGENTS:-$HOME/Library/LaunchAgents}"
  local tp="$agentdir/com.claudesync.timer.plist" wp="$agentdir/com.claudesync.watch.plist"
  local prog interval

  if [ ! -f "$tp" ] && [ ! -f "$wp" ]; then
    echo "automatic sync: neither launch agent is installed on this Mac, so nothing here sends or receives on its own and every sync is one somebody typed. Install both with: claude-sync install-autosync"
    return 0
  fi

  if [ -f "$tp" ]; then
    prog="$(plist_program "$tp")"
    interval="$(plist_interval "$tp")"
    case "$interval" in ''|*[!0-9]*) interval="" ;; esac
    if [ -z "$prog" ]; then
      echo "receive timer: installed, but $tp names no claude-sync to run, so what it does cannot be read. Rewrite it with: claude-sync install-autosync"
    elif [ ! -f "$prog" ]; then
      echo "receive timer: installed, but there is no claude-sync at $prog, so this job cannot run at all. Rewrite it with: claude-sync install-autosync"
    else
      echo "receive timer: ${interval:+every $(duration_in_words "$interval"), }running $prog. Its receive is deliberately not gated on CI: a CI wait of a few minutes is noise against that interval, and a pull somebody types is never gated either."
    fi
  else
    echo "receive timer: not installed, so this Mac receives the other Mac's config only when somebody runs 'claude-sync pull'. Install it with: claude-sync install-autosync"
  fi

  if [ -f "$wp" ]; then
    prog="$(plist_program "$wp")"
    if [ -z "$prog" ]; then
      echo "change watcher: installed, but $wp names no claude-sync to run, so what it does cannot be read. Rewrite it with: claude-sync install-autosync"
    elif [ ! -f "$prog" ]; then
      echo "change watcher: installed, but there is no claude-sync at $prog, so this job cannot run at all. Rewrite it with: claude-sync install-autosync"
    elif [ ! -r "$prog" ]; then
      # Not the same as having no gate. A copy nobody can read is a question nobody can answer, and
      # answering it as "ungated" would raise an alarm about the wrong thing (L98).
      echo "change watcher: running $prog, and whether that copy has the CI gate could not be read, so it is not known whether this Mac's automatic receive waits for CI."
    elif grep -qF "$CI_GATE_MARKER" "$prog" 2>/dev/null; then
      echo "change watcher: running $prog, and that copy has the CI gate, so what this Mac receives automatically waits for CI to pass first."
    else
      echo "change watcher: running $prog, and that copy has NO CI gate, so this Mac integrates whatever is on the shared repo the moment the watcher pulls, before anything has judged it. Update that clone, or point the job at one that has the gate: claude-sync install-autosync"
    fi
  else
    echo "change watcher: not installed, so this Mac sends nothing instantly and has no gated automatic receive. Install it with: claude-sync install-autosync (it needs fswatch)"
  fi
  # Installed, but not what this copy of the script would write now (claude-config#328). Said here
  # rather than in a report of its own, because this is the section about these same agents and one
  # subject split across two places reads as two subjects (L118).
  local stale_agents
  stale_agents="$(agents_out_of_date | tr '\n' ' ' | sed 's/ $//')"
  if [ -n "$stale_agents" ]; then
    echo "launch agents out of date on this Mac: $stale_agents. What is installed is not what this copy of claude-sync would write now (a changed interval, a changed path to the script, a new key), and a launch agent is a COPY: it goes on running the old definition until it is rewritten. Rewrite them with: claude-sync install-autosync"
  fi
  return 0
}

# Every path where THIS Mac's ~/.claude differs from the payload it would send, as tagged records
# on stdout, one per line: a tab separated TAG and text.
#
#   note      something the reader needs before believing the lines under it
#   diff      a real difference inside a mirrored directory
#   timeonly  a difference of timestamp alone, which a send carries nothing for
#   expanded  a file differing ONLY where the payload holds the home path token, which is the
#             substitution working rather than drift
#   topdiff   a real difference in one of the top level files
#
# It exists because two commands ask this same question and used to answer it in different places
# (claude-config#320). `status` listed the differences; `verify` did not look at all, and said "up
# to date" on the strength of a marker that only records what this Mac has RECEIVED. Two
# implementations of one question drift, and the drift is invisible because each reads correct on
# its own (L70, L263), so there is one enumerator and both callers read it.
#
# It only PRINTS. Nothing here creates a directory or touches the payload, because `status` and
# `verify` are both inspections and a tool named like one must not write (L206).
local_vs_payload_records(){
  local line rel d ex f flags rest
  for d in "${MIRROR_DIRS[@]}" skills; do
    [ -d "$CLAUDE_HOME/$d" ] || continue
    # Said outright, because the two rsyncs this Mac might have disagree about it
    # (claude-config#258). Measured on Dans-MacBook-Pro 2026-09-01: with the destination
    # directory ABSENT, the openrsync macOS ships itemizes every file under it as `>f.......`,
    # whose flags mean nothing about this file differs; rsync 3.4.1, which the other Mac and the
    # CI runner have, marks the same files `>f+++++++`, newly created. A whole directory that is
    # new in the payload is exactly the case where every file in it is new, and that is the run
    # where the lines below can describe them as unchanged.
    if [ ! -d "$PAYLOAD/$d" ]; then
      printf 'note\t%s\n' "$d: the payload has no $d yet, so EVERY file under $CLAUDE_HOME/$d is new. The lines below may show them as unchanged: the rsync on this Mac itemizes files under a missing destination that way."
    fi
    ex=""; [ "$d" = skills ] && ex="$(skill_excludes)"
    # -i is load-bearing: plain `rsync -an` prints NOTHING whatever differs, so
    # this whole section used to be decorative and status always read clean.
    # -c because -a quick-checks on size plus mtime, and a config edit that
    # keeps both (a one character swap) is otherwise invisible. These trees are
    # small, so the checksum costs nothing worth saving.
    # COMMON_EXCLUDES must match stage_local_to_payload: status is only useful
    # if it describes what a push would ACTUALLY do, and some skills are git
    # clones whose .git would otherwise dominate the output. (#737)
    #
    # Each line is then asked whether the two sides differ only by the home path placeholder
    # (claude-config#313). rsync compares bytes and cannot know about the substitution, so the
    # answer comes from payload_local_view, which is the same view the apply uses. Only the files
    # rsync already flagged are re-read, so the ordinary case, where nothing differs, costs nothing
    # extra, and every other kind of difference is still reported exactly as before.
    while IFS= read -r line; do
      [ -n "$line" ] || continue
      # rsync -i prints the itemize flags, one space, then the path. A `*deleting` line has more
      # than one space, so its "path" keeps a leading space, fails the file test below and is
      # reported unchanged, which is what a deletion should do.
      rel="${line#* }"
      if payload_differs_only_by_home_path "$d/$rel"; then
        printf 'expanded\t%s\n' "$d/$rel"
        continue
      fi
      # A difference of TIMESTAMP ONLY is not a change the shared config lacks, and after any
      # apply it is the state of nearly every file, because the apply rewrites them. Measured on
      # Daniels-MacBook-Pro-2 on 2026-09-07, minutes after a pull: 159 files itemized `.f..t`,
      # content identical on both sides, nothing for a send to carry, since git records no mtime.
      # Counted as unsent they would leave verify permanently red the moment anybody pulled, and a
      # check that can only ever say no stops being read, which is the same failure #26 is about.
      #
      # Still LISTED by status, exactly as before: status describes what a push would touch, and a
      # push does restamp them. Only the count that decides verify's verdict leaves them out, which
      # is the difference between the two questions rather than a disagreement about the answer.
      # Asked as a pattern rather than by substituting the harmless characters away and testing
      # for blank, which test-blank-check-cost.sh bans in this repo.
      flags="${line%% *}"; rest="${flags:2}"
      if [ "${flags:0:1}" = "." ]; then
        case "$rest" in
          *[!.t]*) ;;                                          # something other than the time differs
          *) printf 'timeonly\t%s\n' "$d: $line"; continue ;;
        esac
      fi
      printf 'diff\t%s\n' "$d: $line"
    done < <(rsync -ainc --delete "${COMMON_EXCLUDES[@]}" $ex "$CLAUDE_HOME/$d/" "$PAYLOAD/$d/" 2>/dev/null | grep -vE '^$' || true)
  done
  for f in $(top_files_in "$CLAUDE_HOME"); do
    [ -f "$CLAUDE_HOME/$f" ] || continue
    cmp -s "$CLAUDE_HOME/$f" "$PAYLOAD/$f" 2>/dev/null || printf 'topdiff\t%s\n' "$f: differs"
  done
}

# How many REAL differences that enumerator found: what a send would carry. Home path expansions
# are excluded because they are the substitution working, and the notices are not differences at
# all, so counting every line would report a healthy Mac as holding unsent work.
local_unsent_count(){
  local n tab
  # The tab is PRODUCED, never written as an escape in the pattern (claude-config#335). BSD grep,
  # which is what a Mac has, matches a backslash-t as a tab; GNU grep, which every Linux runner
  # has, matches a literal `t`, so the pattern matched nothing there and this returned 0 whatever
  # the enumerator found. `verify` then called a Mac holding unsent work up to date and exited 0,
  # which is the answer #320 exists to stop it giving. Neither grep errors, so it was green on both
  # Macs and red on every Linux run.
  tab="$(printf '\t')"
  n="$(local_vs_payload_records | grep -cE "^(diff|topdiff)$tab" || true)"
  case "$n" in ''|*[!0-9]*) n=0 ;; esac
  printf '%s' "$n"
}

do_status(){
  local line tag text
  local DRIFT_EXPANSIONS=0
  if have_git; then git -C "$SYNC_REPO" fetch -q 2>/dev/null || true; git -C "$SYNC_REPO" status -sb; fi
  report_sync_times
  echo "--- local config vs repo payload (dry run) ---"
  local RECORDS; RECORDS="$(local_vs_payload_records)"
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    tag="${line%%$'\t'*}"; text="${line#*$'\t'}"
    case "$tag" in
      note|diff|timeonly) echo "$text" ;;
      expanded)  DRIFT_EXPANSIONS=$(( DRIFT_EXPANSIONS + 1 )) ;;
    esac
  done <<< "$RECORDS"
  # COUNTED and said, never silently dropped. A section that quietly stops naming files cannot be
  # told from one that has stopped looking (L98, L11), and the number is what makes a change in it
  # visible without anybody having to remember the old one.
  if [ "$DRIFT_EXPANSIONS" -gt 0 ]; then
    echo "$DRIFT_EXPANSIONS file(s) differ from the payload only where it holds $TOKEN and this Mac holds its own home path, which is that substitution working. They are not drift and are not listed above."
  fi
  # After the expansions line, exactly where it was before this became one enumerator: the top
  # level files are reported last.
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    tag="${line%%$'\t'*}"; text="${line#*$'\t'}"
    [ "$tag" = topdiff ] && echo "$text"
  done <<< "$RECORDS"
  report_user_scope_plugins
  report_duplicate_plugin_skills || true
  report_duplicate_skill_jobs || true
  report_conflict_copies
  report_blocked_clone
  report_ci_unreadable
  report_behind_skips
  report_red_skips
  report_watcher_hold
  report_automatic_jobs
  report_hook_suite_result
  report_outage_tally
  report_stray_processes
  report_scratch_leftovers
}


# The process table, behind one seam so a test never reads or reports what happens to be running
# on the real machine (L2). SYNC_PS_FIXTURE holds the same four fields in the same order.
sync_process_list(){
  if [ -n "${SYNC_PS_FIXTURE:-}" ]; then cat "$SYNC_PS_FIXTURE" 2>/dev/null || true
  else ps -eo pid=,ppid=,etime=,command= 2>/dev/null || true
  fi
}

# Processes this tool left behind (#33). Nothing watched for these: seventeen suite processes were
# running and spawning each other on 2026-08-17, found only because Dan asked an unrelated
# question, having silently doubled every run time for the session beforehand.
#
# It counts ROOTS and DEPTH rather than how many processes match, and that is the whole design.
# A plain count catches several independent copies, and misses the shape that actually happened: a
# run that spawned a run that spawned a run grows ONE process at a time, so the real runaway
# peaked at seven and an alarm set at six never fired once. A chain is one root nested deep, and
# depth is the thing that makes it visible.
report_process_family(){
  local pattern="$1" label="$2" ok_roots="$3" ok_depth="$4" advice="$5" out summary n roots maxd
  out="$(sync_process_list | awk -v pat="$pattern" '
    {
      p=$1; pp=$2; et=$3; cmd=""
      for (i = 4; i <= NF; i++) cmd = cmd (i > 4 ? " " : "") $i
      parent[p] = pp; age[p] = et; keep[p] = cmd
      if (index(cmd, pat) > 0 && index(cmd, "awk") == 0) matched[p] = 1
    }
    END {
      n = 0; roots = 0; maxd = 0
      for (p in matched) {
        n++
        d = 0; q = parent[p]
        # Bounded, because a process table read while things are exiting can present a cycle, and
        # an unbounded ancestry walk over one would hang the very command you run to diagnose it.
        while ((q in parent) && d < 64) { if (q in matched) d++; q = parent[q] }
        if (d == 0) roots++
        if (d > maxd) maxd = d
        printf "  pid %s, running %s%s\n", p, age[p], (d > 0 ? ", nested " d " deep inside another" : "")
      }
      printf "SUMMARY %d %d %d\n", n, roots, maxd
    }' )"
  summary="$(printf '%s' "$out" | grep '^SUMMARY ' || true)"
  n="$(printf '%s' "$summary" | awk '{print $2}')"; roots="$(printf '%s' "$summary" | awk '{print $3}')"
  maxd="$(printf '%s' "$summary" | awk '{print $4}')"
  [ -n "$n" ] || return 0
  # Silent when the machine looks the way it should. What "should" means is MEASURED per family,
  # not assumed to be one process: a healthy watcher is a parent plus one forked helper, both
  # matching, and a rule of "nothing nested" reported every healthy machine on the first try. A
  # line printed on every status stops being read long before a real pile-up appears, which is
  # exactly how the seventeen went unnoticed (L36, L147).
  [ "$roots" -le "$ok_roots" ] && [ "$maxd" -le "$ok_depth" ] && return 0
  echo "--- $label the tool left running ---"
  grep -v '^SUMMARY ' <<< "$out"
  echo "  $n in total, $roots started independently, nested up to $maxd deep."
  echo "  $advice"
}

# ---------- scratch a killed run left behind (#36) ----------
# The suite and every apply create scratch under the system temp directory and remove it on the
# way out. A run that is force-killed never reaches that, so its scratch is abandoned, and nothing
# ever reclaimed one. Measured on this Mac on 2026-08-17: 37 abandoned suite directories holding
# 475 MB, and 92 abandoned apply logs, from a single day of interrupted runs. It grows with how
# OFTEN runs are interrupted rather than with how much work is done, it is invisible until the
# disk is under pressure, and the runs likeliest to be killed are the hangs and pile-ups this repo
# has spent the day fixing. It is the disk half of #33, which watches for leftover processes and
# says nothing about leftover space.
#
# Swept BY NAME, from the list of prefixes this tool owns, and never as "old temp directories".
# The same temp directory held 542 anonymous `tmp.*` directories belonging to OTHER tools on the
# day this was measured, holding 33 MB between them, and a sweep written by age alone would have
# deleted every one (L8: own your paths). The names are also why the suite's scratch is now
# created from an explicit template rather than a bare `mktemp -d`: an anonymous directory cannot
# be attributed to anything afterwards, which is why the 37 above had to be identified by peering
# inside them.
#
# The suite LOCK lives beside these and is deliberately not swept. Whether a lock may be removed
# is decided by its own ownership rules, and a reaper second-guessing them from outside is exactly
# how a live lock gets deleted (L157).
SYNC_SCRATCH_ROOT="${SYNC_SCRATCH_ROOT:-${TMPDIR:-/tmp}}"
# An automatic deletion policy is the user's decision, never a silent default (L9), so it has an
# off switch and it is the same one the deadline uses: 0 means never sweep. Anything that is not a
# whole number is REFUSED rather than guessed at, because this value guards an `rm -rf` and an
# unparseable one must not land on the permissive side of it (L50).
SYNC_SCRATCH_MAX_AGE="${SYNC_SCRATCH_MAX_AGE:-14400}"
case "$SYNC_SCRATCH_MAX_AGE" in
  ''|*[!0-9]*)
    echo "claude-sync: SYNC_SCRATCH_MAX_AGE='$SYNC_SCRATCH_MAX_AGE' is not a whole number of seconds. Refusing to run rather than sweeping to an age nobody can read. Set it to 0 to turn the sweep off." >&2
    exit 2 ;;
esac
# Overridable so a test can point the scan at names of its own. It is not a knob anybody needs in
# normal use: the default IS the list of every prefix this tool creates.
SYNC_SCRATCH_NAMES="${SYNC_SCRATCH_NAMES:-claude-sync-applied. claude-sync-selftest. claude-sync-work. claude-sync-expand. claude-sync-run. claude-sync-suite-work. claude-sync-suite-section. claude-sync-suite-run.}"

# ---------- a directory of the tool's own, inside the temp root (#116) ----------
# The sweep above globs the temp root, and that root belongs to the whole machine: 113,912 entries
# measured here on 2026-08-21, 25 of them ours. #115 cut six reads of it to one and took `status`
# from 1.74s to 0.36s; the one read left is most of what remains, and the suite pays it 270 times.
# The cost is set by how much OTHER software puts in that directory, which nothing here controls
# and which only grows.
#
# So new scratch is created inside ONE directory of our own and the sweep reads that instead: tens
# of entries rather than six figures, and a cost that no longer depends on an unrelated
# machine-wide quantity.
SYNC_SCRATCH_DIRNAME="${SYNC_SCRATCH_DIRNAME:-claude-sync}"
# Checked, because this name is half of the pattern that decides what `reap-scratch` is allowed to
# `rm -rf`, and a value carrying a slash or a parent reference would point both the scan and that
# permission at a directory nobody chose. It is a single path component or nothing at all (L50).
# An EMPTY value is not listed: `:-` above has already replaced it with the default, which is the
# ordinary meaning of an unset variable and is not a value this ever sees.
case "$SYNC_SCRATCH_DIRNAME" in
  */*|.|..)
    echo "claude-sync: SYNC_SCRATCH_DIRNAME='$SYNC_SCRATCH_DIRNAME' is not a single directory name. Refusing to run rather than pointing the scratch sweep, which removes what it finds, at a path assembled from that." >&2
    exit 2 ;;
esac
# The old FLAT location is still swept, because every Mac that has run an earlier version has
# scratch sitting in it and a change that stopped looking would abandon exactly what this feature
# exists to reclaim. It is read on an interval rather than on every call, which is where the saving
# actually comes from; `reap-scratch` reads it every time whatever this says, so there is always a
# way back to it that does not wait. The cost is stated rather than hidden: a leftover in the old
# location can go unreported for up to this long, and 0 means read it on every call.
SYNC_SCRATCH_LEGACY_EVERY="${SYNC_SCRATCH_LEGACY_EVERY:-86400}"
case "$SYNC_SCRATCH_LEGACY_EVERY" in
  ''|*[!0-9]*)
    echo "claude-sync: SYNC_SCRATCH_LEGACY_EVERY='$SYNC_SCRATCH_LEGACY_EVERY' is not a whole number of seconds. Refusing to run rather than sweeping the old scratch location on a schedule nobody can read. Set it to 0 to read that location on every call." >&2
    exit 2 ;;
esac

# How often a mutating run reclaims the abandoned scratch in the tool's own directory
# (claude-config#314). Checked for the same reason as the two above: an unreadable value would
# either sweep on every run or never, and both read as the feature working. 0 means every run.
SYNC_REAP_INTERVAL="${SYNC_REAP_INTERVAL:-86400}"
case "$SYNC_REAP_INTERVAL" in
  ''|*[!0-9]*)
    echo "claude-sync: SYNC_REAP_INTERVAL='$SYNC_REAP_INTERVAL' is not a whole number of seconds. Refusing to run rather than reclaiming scratch on a schedule nobody can read. Set it to 0 to sweep on every mutating run." >&2
    exit 2 ;;
esac

# Where new scratch goes. Derived from SYNC_SCRATCH_ROOT rather than read from TMPDIR a second
# time, so there is ONE answer to where scratch lives and a test can point every part of this at a
# throwaway root (L2).
scratch_home(){ printf '%s' "${SYNC_SCRATCH_ROOT%/}/$SYNC_SCRATCH_DIRNAME"; }
# The stamp recording when the old flat location was last read. It lives INSIDE the new home, so a
# test root carries its own and a temp cleaner removing it means the location is read again, which
# is the safe direction to be wrong in.
scratch_legacy_stamp(){ printf '%s' "$(scratch_home)/.legacy-swept"; }
# THE CADENCE OF THE AUTOMATIC SWEEP, ON DISK (claude-config#314).
#
# claude-config#251 put a daily sweep in the watch daemon and it never fired once. Its clock was a
# variable set to "now" when the loop STARTED and held in memory only, and the daemon is restarted
# every time claude-sync itself changes, which is most days here. A twenty four hour timer that
# restarts more often than daily can never reach its own deadline (L169, L175), so status went on
# reporting a growing pile (73 items, 43 MB) whose only remedy was a command somebody had to type,
# and a report like that is one people stop reading (L36).
#
# It lives in the scratch directory it governs, so a test root carries its own and a temp cleaner
# removing it means the sweep runs again, which is the safe direction to be wrong in.
scratch_reap_stamp(){ printf '%s' "$(scratch_home)/.last-reap"; }
scratch_home_ready(){   # prints the directory to create scratch in; falls back to the flat root
  local d; d="$(scratch_home)"
  # A fallback that lands in the OLD location, deliberately, and not one that fails the run: the
  # flat location is still swept, so scratch written there is still reclaimed. What it gets wrong
  # is the cost, not the correctness, and it can only happen where the temp root itself is
  # unwritable, in which case nothing else here would work either (L93).
  if mkdir -p "$d" 2>/dev/null; then :; else d="${SYNC_SCRATCH_ROOT%/}"; fi
  # HERE, not in each maker (claude-config#314). Every piece of scratch in this tool is created in
  # the directory this function names, and the apply log is made with its own mktemp rather than
  # through scratch_file, so hanging the note off the two makers left the commonest run of all
  # writing none. One derivation, at the point they share (L41).
  scratch_note_this_run "$d"
  printf '%s' "$d"
}

# Every short-lived temp FILE in this tool is made here rather than by each call site writing its
# own `mktemp`. One name, so every one of them is reclaimable, and one place to change it if that
# name ever has to move. Seven call sites used a bare `mktemp`, which is anonymous the moment the
# run holding it is killed, and 92 of those were on this Mac when #36 was measured.
# WHAT A KILLED RUN WAS DOING (claude-config#314).
#
# status reported 73 abandoned scratch items on 2026-09-04, and a count is not something anybody
# can act on: 73 of them is a signal about the tool rather than about the temp folder, and the
# scratch is the only surviving evidence of each one. So a run that creates any scratch also leaves
# ONE note beside it naming itself, and the note is removed on the way out like everything else, so
# only a run that was killed leaves one behind (L114, L148).
#
# One per run, created lazily on the first piece of scratch, so a run that needs none writes none.
#
# NAMED FROM THE PID, never from mktemp, and that is load-bearing rather than a style choice. The
# directory this is handed comes from scratch_home_ready, which every caller reaches through
# `$(...)`, and a command substitution runs in a SUBSHELL: a path remembered in a variable there is
# lost the moment it returns, so the parent could neither find the note again nor remove it, and
# every single scratch file made another one. A name the parent can recompute needs no shared state
# at all. It also survives reexec_after_self_update, which `exec`s and keeps the same pid, so the
# resumed run adopts and removes the note its earlier self wrote.
#
# The cost is stated: a pid this machine hands out again, to a run starting inside the sweep's four
# hour window, adopts a killed run's note and removes it on the way out. That loses one trace. It
# cannot report a wrong one as current, which is the direction that would matter.
scratch_note_this_run(){   # $1 = the directory scratch is being created in
  [ "${SYNC_SCRATCH_NOTE:-1}" = "0" ] && return 0
  local f="${1%/}/claude-sync-run.$$"
  # Already written by this run. One stat per scratch file, against a write per scratch file.
  [ -s "$f" ] && return 0
  # Tab separated, and the command is the LAST field, so a report can read it with `cut` however
  # many spaces the arguments hold.
  printf '%s\t%s\t%s\n' "$(date '+%Y-%m-%dT%H:%M:%S')" "$$" "$SYNC_RUN_ARGV" > "$f" 2>/dev/null || true
  # A named seam so the WRITER can be watched working (SYNC_SCRATCH_NOTE_ECHO=1). Without it the
  # only thing any check can see is a note that a killed run left behind, which a test has to plant
  # by hand, so the whole feature could be inert and every check would still pass (L1, L98, L159).
  # The alternative is racing a real SIGKILL against a run that takes milliseconds, and a window
  # that happens not to open proves nothing.
  [ "${SYNC_SCRATCH_NOTE_ECHO:-0}" = "1" ] && printf 'SCRATCH-NOTE %s %s\n' "$f" "$(cat "$f" 2>/dev/null | tr '\t' ' ')" >&2
  return 0
}
# Both locations, because scratch_home_ready falls back to the flat root when its own directory
# cannot be made, and a cleanup that only knows the usual place leaves a note exactly on the runs
# that were already having trouble.
cleanup_scratch_note(){
  rm -f "$(scratch_home)/claude-sync-run.$$" "${SYNC_SCRATCH_ROOT%/}/claude-sync-run.$$" 2>/dev/null || true
  return 0
}

scratch_file(){ mktemp "$(scratch_home_ready)/claude-sync-work.XXXXXXXX"; }
# The same rule for a temp DIRECTORY. Only the apply needs one, to hold the payload with this
# Mac's home path put back (see apply_source_dir), and it is removed on every exit path.
scratch_dir(){ mktemp -d "$(scratch_home_ready)/claude-sync-expand.XXXXXXXX"; }

# Old enough that no live run can own it, and that is a RATIO against the longest run the tool
# permits rather than a duration that sounds generous. The suite's own ceiling is what sets it:
# four hours is 4x the 3600s ceiling and 2400x the 6 second sync measured on 2026-08-17.
#
# It was an hour, and for as long as the ceiling was 900 that was the same 4x. #152 raised the
# ceiling to 3600 and left this at 3600, so the margin went to zero without either number moving in
# the file it lives in: a run near its own deadline could have this very sweep delete its working
# directory, its extracted copy and its section mark, and the scheduled sync is exactly the
# concurrent invocation that would do it (claude-config#160). The two are now compared against each
# other by a check in the suite, so the margin cannot close again in silence (L174).
#
# Being wrong LOW here deletes the scratch of something still using it, which is the one outcome
# worse than the litter, so it is deliberately generous. The cost is accepted and stated: a burst
# of interrupted runs is not reclaimed until four hours after the last of them.
scratch_in_dir(){   # $1 = a directory to read -> prints the abandoned scratch in it
  local root="${1%/}" now p n age m pre first base matched cand=""
  [ -d "$root" ] || return 0
  now="$(date +%s)"
  # ONE pass over the directory, not one per name. Each glob reads and sorts the WHOLE directory,
  # and the temp directory on a real Mac is enormous: 113,000 entries measured here, six names, so
  # six full reads costing 1.28 seconds of every single `status` call, which was 79% of it and the
  # largest single cost in the test suite as well (claude-config#115).
  #
  # The prefix is DERIVED from the names, never written down. Hard-coding the one they happen to
  # share today makes this silently stop reporting anything outside it, and a leftover nobody
  # reports is a leftover nobody reclaims, which is the entire point of the feature (L96). Derived,
  # a name that does not share it simply shortens the prefix; in the worst case it shortens to
  # nothing and this reads the directory once unfiltered, which is slower than ideal and still
  # correct. That failure direction is the one worth having, and the guard for it was watched
  # failing against the hard-coded version before this was written.
  pre=""; first=1
  for n in $SYNC_SCRATCH_NAMES; do
    if [ "$first" -eq 1 ]; then pre="$n"; first=0; continue; fi
    while [ -n "$pre" ]; do
      case "$n" in "$pre"*) break ;; esac
      pre="${pre%?}"
    done
  done
  for p in "$root/$pre"*; do
    [ -e "$p" ] || continue
    base="${p##*/}"
    # The directory the scratch now LIVES in is not itself scratch, and sweeping it would take
    # every live run's scratch with it. Its name cannot match a scratch prefix today (those all
    # carry a trailing dash it does not have), but the name list is overridable and a shortened
    # prefix makes this glob read the whole directory, so it is refused by name rather than left
    # to a coincidence of spelling.
    [ "$base" = "$SYNC_SCRATCH_DIRNAME" ] && continue
    matched=0
    for n in $SYNC_SCRATCH_NAMES; do
      case "$base" in "$n"*) matched=1; break ;; esac
    done
    [ "$matched" -eq 1 ] || continue
    cand="$cand$p
"
  done
  [ -n "$cand" ] || return 0
  # The names are collected first and their mtimes read together, because asking one process per
  # entry is what made this the largest cost in the command (claude-config#191).
  while IFS="$(printf '\t')" read -r m p; do
    [ -n "$p" ] || continue
    # An mtime that cannot be read is treated as YOUNG, so a path is never removed on no
    # evidence at all (L50: an unparseable value must land on the safe side).
    case "$m" in ''|*[!0-9]*) continue ;; esac
    age=$(( now - m ))
    if [ "$age" -ge "$SYNC_SCRATCH_MAX_AGE" ]; then printf '%s\n' "$p"; fi
  done <<SCRATCHDIREOF
$(printf '%s' "$cand" | file_mtimes)
SCRATCHDIREOF
  # Said explicitly, and not left to whatever the last comparison happened to leave behind. This
  # file runs under `set -e`, so a function ending on a false test returns 1 and kills its caller.
  # Written as a trailing `&&` it did exactly that, and the trigger is not rare: the LAST name in
  # the list is the suite's section mark, and a suite run always has a live one, so every call
  # made DURING a run ended on a false age test. The command then printed nothing at all and
  # exited 1, which the self-update gate reads as a pulled script that cannot run, so it declared
  # a perfectly good version broken and kept the old one. Six checks went red for that.
  return 0
}

# Is the old flat location due to be read? Every way of failing to answer lands on YES, because
# reading it costs time and NOT reading it costs a leftover nobody ever hears about, and only one
# of those two is recoverable (L93).
scratch_legacy_due(){   # $1 = "force" to read it whatever the interval says
  local stamp m now
  [ "${1:-}" = "force" ] && return 0
  [ "$SYNC_SCRATCH_LEGACY_EVERY" -eq 0 ] && return 0
  stamp="$(scratch_legacy_stamp)"
  [ -f "$stamp" ] || return 0
  m="$(file_mtime "$stamp")"
  case "$m" in ''|*[!0-9]*) return 0 ;; esac
  now="$(date +%s)"
  [ $(( now - m )) -ge "$SYNC_SCRATCH_LEGACY_EVERY" ]
}

scratch_leftovers(){   # $1 = "force" to read the old flat location whatever the interval says
  # Off means off: nothing is listed, so nothing is reported and nothing is removed.
  [ "$SYNC_SCRATCH_MAX_AGE" -eq 0 ] && return 0
  # The tool's own directory, always. This is the read that replaced the six-figure one.
  scratch_in_dir "$(scratch_home)"
  # And the location every earlier version wrote to, on an interval. Stamped AFTER the read rather
  # than before it, so a run killed part way through does not record a sweep that never finished.
  if scratch_legacy_due "${1:-}"; then
    scratch_in_dir "${SYNC_SCRATCH_ROOT%/}"
    mkdir -p "$(scratch_home)" 2>/dev/null && : > "$(scratch_legacy_stamp)" 2>/dev/null || true
  fi
  return 0
}

scratch_total_kb(){   # reads paths on stdin
  local list; list="$(cat)"
  [ -n "$list" ] || { echo 0; return 0; }
  # `du` is allowed to fail on a path that vanished between the listing and here, and the total is
  # reported from whatever it could read. Under `pipefail` an unguarded pipeline would take the
  # whole command down over scratch that has already gone, which is the one outcome nobody needs
  # reporting.
  printf '%s\n' "$list" | tr '\n' '\0' | xargs -0 du -sk 2>/dev/null | awk '{s+=$1} END{print s+0}' || echo 0
}

# Reported in the unit that says something. 92 abandoned apply logs really do come to under a
# megabyte, and rounding them to "0 MB" reads as nothing worth reclaiming while the count is the
# part that matters; 37 abandoned suite directories really are 475 MB, and reporting those in KB
# reads as noise. A message may only claim what it measured (L11).
scratch_human_size(){   # kb
  if [ "${1:-0}" -ge 1024 ]; then echo "$(( ($1 + 512) / 1024 )) MB"; else echo "$1 KB"; fi
}

report_scratch_leftovers(){
  local list n kb doing
  list="$(scratch_leftovers)"
  n="$(printf '%s' "$list" | grep -c . || true)"
  [ "${n:-0}" -gt 0 ] || return 0
  kb="$(printf '%s\n' "$list" | scratch_total_kb)"
  echo "--- scratch the tool left behind ---"
  echo "  $n abandoned, holding $(scratch_human_size "$kb") under $SYNC_SCRATCH_ROOT, each older than ${SYNC_SCRATCH_MAX_AGE}s."
  echo "  Every one belongs to a run that was killed before it could clean up after itself. A mutating run reclaims them on its own every $(duration_in_words "$SYNC_REAP_INTERVAL"); to take them now: claude-sync reap-scratch"
  # WHAT THOSE RUNS WERE DOING (claude-config#314). A count says the temp folder is filling up; the
  # commands say which part of the tool is being killed, and only one of those can be acted on
  # (L148). Runs from before the notes existed simply carry none, so this stays quiet rather than
  # claiming they were doing nothing (L223, L11).
  doing="$(scratch_run_summary "$list")"
  [ -n "$doing" ] && echo "  Those runs were running: $doing."
  return 0
}

# The commands named by whichever leftovers are run notes, counted, commonest first. One `cut` per
# note and no shell loop building strings, because this runs inside `status`.
scratch_run_summary(){   # $1 = the leftover paths, one per line
  local notes
  notes="$(printf '%s\n' "$1" | grep '/claude-sync-run\.' || true)"
  [ -n "$notes" ] || return 0
  printf '%s\n' "$notes" | tr '\n' '\0' | xargs -0 cut -f3 2>/dev/null \
    | sed 's/^[[:space:]]*$/unknown/' \
    | sort | uniq -c | sort -rn \
    | awk '{ c=$1; $1=""; sub(/^ /, ""); out = out (out == "" ? "" : ", ") $0 " (" c ")" } END { printf "%s", out }'
  return 0
}

do_reap_scratch(){
  local list n kb p removed=0
  # `force`, always. This is the command somebody is TOLD to run, and it is the one way back to
  # the old flat location that does not wait for an interval to come round.
  list="$(scratch_leftovers force)"
  n="$(printf '%s' "$list" | grep -c . || true)"
  # Finding nothing is its own outcome, said out loud. A reaper that prints the same thing whether
  # it swept a gigabyte or was pointed at the wrong directory is one nobody can check (L98).
  # Turned OFF and found nothing are different answers, and saying "nothing to reclaim" to somebody
  # who has switched the sweep off would be a claim this never checked (L11).
  if [ "$SYNC_SCRATCH_MAX_AGE" -eq 0 ]; then
    echo "claude-sync: the scratch sweep is off (SYNC_SCRATCH_MAX_AGE=0), so nothing under $SYNC_SCRATCH_ROOT was looked at or removed."
    return 0
  fi
  if [ "${n:-0}" -eq 0 ]; then
    echo "claude-sync: no abandoned scratch to reclaim in $(scratch_home) or beside it in $SYNC_SCRATCH_ROOT (nothing in either, older than ${SYNC_SCRATCH_MAX_AGE}s, carries a name this tool owns)."
    return 0
  fi
  kb="$(printf '%s\n' "$list" | scratch_total_kb)"
  removed="$(printf '%s\n' "$list" | remove_scratch_paths)"
  echo "claude-sync: reclaimed $removed abandoned scratch item(s) holding $(scratch_human_size "$kb") under $SYNC_SCRATCH_ROOT."
  return 0
}

# The delete itself, written ONCE and used by the command somebody types and by the automatic sweep
# alike. Two copies of an `rm -rf` guarded by a pattern would be two chances for the pattern to
# drift, and only one of them would be the one anybody re-read (L370).
remove_scratch_paths(){   # reads paths on stdin -> prints how many it removed
  local p removed=0
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    # Judged again, independently, immediately before the delete. The list was built from the
    # names above and this asks the question a second way, because everything after it is an
    # `rm -rf` on a path assembled from the environment (L5).
    case "$p" in
      "${SYNC_SCRATCH_ROOT%/}/$SYNC_SCRATCH_DIRNAME"/claude-sync-*) rm -rf "$p" && removed=$((removed + 1)) ;;
      "${SYNC_SCRATCH_ROOT%/}"/claude-sync-*) rm -rf "$p" && removed=$((removed + 1)) ;;
      *) echo "claude-sync: refusing to remove '$p', which is not scratch this tool owns." >&2 ;;
    esac
  done
  printf '%s' "$removed"
  return 0
}

# THE AUTOMATIC SWEEP. Run by every MUTATING command, through the same trap that releases the lock,
# and by no read-only one: status is an inspection and a command whose name reads like a look must
# not remove anything (L206).
#
# It sweeps only the tool's OWN scratch directory, never the flat location beside it. That one
# belongs to the whole machine and is read on its own interval by `status` and unconditionally by
# `reap-scratch`, which stays the way back to it that does not wait.
reap_scratch_if_due(){
  local stamp m now list n
  [ "$SYNC_SCRATCH_MAX_AGE" -eq 0 ] && return 0
  [ -d "$(scratch_home)" ] || return 0
  stamp="$(scratch_reap_stamp)"
  now="$(date +%s)"
  if [ -f "$stamp" ]; then
    m="$(file_mtime "$stamp")"
    # An unreadable stamp is treated as OVERDUE, because not sweeping costs a leftover nobody
    # hears about and sweeping costs one directory read, and only one of those two accumulates.
    case "$m" in ''|*[!0-9]*) m=0 ;; esac
    if [ "$(( now - m ))" -lt "$SYNC_REAP_INTERVAL" ]; then return 0; fi
  fi
  list="$(scratch_in_dir "$(scratch_home)")"
  # Stamped once the READ has finished, which is the expensive half and the half this cadence
  # exists to ration. Finding nothing is a completed sweep, so it stamps too: otherwise a clean
  # machine re-reads the directory on every single run for ever (L98).
  : > "$stamp" 2>/dev/null || true
  is_blank "$list" && return 0
  n="$(printf '%s\n' "$list" | remove_scratch_paths)"
  case "${n:-0}" in ''|*[!0-9]*) n=0 ;; esac
  [ "$n" -gt 0 ] || return 0
  # Said out loud. A sweep that reclaimed a pile and one that ran and found nothing are different
  # events, and the first is the one worth seeing (L11, L98).
  echo "claude-sync: reclaimed $n abandoned scratch item(s) that earlier runs were killed before they could remove, in $(scratch_home)." >&2
  return 0
}

report_stray_processes(){
  # One watcher, which is two processes: the launcher and the subshell it forks around fswatch.
  # Measured on this Mac 2026-08-17 (pid 13658 with its child 13702), not assumed, because the
  # first version of this rule allowed no nesting at all and reported every healthy machine.
  report_process_family "claude-sync watch" "watcher processes" 1 1 \
    "One watcher is expected, running as two processes. Several started independently means an earlier one was never stopped, and they all react to the same edit."
  # One run, permitted to have spawned one child, which is what the suite's own depth limit allows
  # (SUITE_MAX_DEPTH defaults to 1 in tests/test-claude-sync.sh). Deeper than that is the runaway
  # that limit exists to stop, so seeing it here means the limit has been removed or bypassed.
  report_process_family "tests/test-claude-sync.sh" "test runs" 1 1 \
    "A run nested deeper than one is a run that spawned a run that spawned a run. It multiplies one process at a time, so it presents as slowness rather than as a failure."
}

# RUN THE HOOK SUITE AND RECORD WHAT IT SAID (claude-config#305).
#
# `.hook-tests` had exactly one writer, hook_suite_verdict, and that runs only when an apply wrote a
# file under hooks/. So the record was refreshed by an incoming change and by nothing a person could
# do: a Mac that FIXED a failure without a hook arriving reported the old one indefinitely, and the
# message telling the reader to "re-run with bash .../run-all-tests.sh" named a remedy that changes
# nothing, because the runner does not write the record. On 2026-09-03 the remedy actually reached
# for was deleting the file by hand, outside the repository.
#
# So this is the same run, asked for deliberately, through the one writer. Keeping a single writer
# is the point: two producers of one record format drift, and the reader cannot tell which of them
# it is looking at (L263).
#
# NOT under the sync lock. It writes one small file in this clone and touches nothing a mutating run
# touches, and a recheck that had to queue behind a long send would be useless exactly when somebody
# reaches for it, which is the reasoning `hold` and `release` already follow.
do_recheck(){
  local runner="$CLAUDE_HOME/hooks/run-all-tests.sh"
  if [ ! -f "$runner" ]; then
    die "there is no $runner on this Mac, so the hook suite could not be run and nothing was recorded. A pull that carries the hooks puts it there."
  fi
  echo "Running the hook suite from $runner; this takes a few minutes."
  HOOK_SUITE_FORCE=1 hook_suite_verdict >/dev/null
  # Reported by READING the record just written, through the same reporter `status` uses, so the
  # two can never describe the same run differently (L70).
  report_hook_suite_record "$HOOK_TESTS_FILE" ""
  return 0
}

# ---------- install-schedule ----------
do_install_schedule(){
  local agentdir="${SYNC_LAUNCHAGENTS:-$HOME/Library/LaunchAgents}"
  local plist="$agentdir/com.claudesync.pull.plist"
  local self; self="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/claude-sync"
  # launchd jobs get a minimal PATH that excludes Homebrew, so jq/gh/rsync the
  # sync depends on go missing. Give the job the same PATH a login shell has.
  local jobpath="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
  mkdir -p "$agentdir"
  cat > "$plist" <<PL
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.claudesync.pull</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>$self</string><string>pull</string></array>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>$jobpath</string></dict>
  <key>StartCalendarInterval</key><dict><key>Day</key><integer>1</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>$HOME/.claude-sync.log</string>
  <key>StandardErrorPath</key><string>$HOME/.claude-sync.log</string>
</dict></plist>
PL
  if [ "${SYNC_NO_LAUNCHCTL:-0}" != "1" ]; then
    launchctl unload "$plist" 2>/dev/null || true
    launchctl load "$plist"
  fi
  echo "Installed monthly auto-pull (1st of each month, 9:00am). Log: $HOME/.claude-sync.log"
  echo "To change cadence, edit StartCalendarInterval in: $plist"
}

# ---------- watch (long-lived): run a two-way sync on every file change ----------
# Recursively watches the synced folders via fswatch and syncs per change batch,
# so even an edit buried deep inside a skill folder is pushed immediately.
# One watcher on this Mac, refused automatically rather than reported after the fact
# (claude-config#251). status showed THREE watch processes on 2026-08-31 where one is expected,
# one of them started independently and nested two deep, and every one of them reacts to the same
# edit: that is a concurrency hazard rather than clutter, and the report told the reader to fix it
# by hand.
#
# The pid is confirmed against what that process actually IS, never taken from the file alone. A
# stale pid is reused by the system constantly, and a guard that trusts the number refuses to
# start because some unrelated process inherited it (L237, L70).
SYNC_WATCH_PID_FILE="${SYNC_WATCH_PID_FILE:-$HOME/.claude-sync-watch.pid}"
watch_already_running(){   # -> prints the live watcher's pid, or nothing
  local pid cmd
  [ -f "$SYNC_WATCH_PID_FILE" ] || return 1
  pid="$(head -1 "$SYNC_WATCH_PID_FILE" 2>/dev/null || true)"
  case "$pid" in ''|*[!0-9]*) return 1 ;; esac
  [ "$pid" = "$$" ] && return 1
  kill -0 "$pid" 2>/dev/null || return 1
  cmd="$(ps -o command= -p "$pid" 2>/dev/null || true)"
  case "$cmd" in *claude-sync*watch*) printf '%s' "$pid"; return 0 ;; esac
  return 1
}

do_watch(){
  local fs="${SYNC_FSWATCH:-fswatch}"
  command -v "$fs" >/dev/null 2>&1 || \
    die "fswatch not installed — run: brew install fswatch, then: claude-sync install-autosync"
  local live
  if live="$(watch_already_running)"; then
    die "a claude-sync watcher is already running on this Mac (process $live), and several watchers all react to the same edit. Nothing was started. End that one first if you meant to replace it: kill $live"
  fi
  printf '%s\n' "$$" > "$SYNC_WATCH_PID_FILE" 2>/dev/null || true
  # Removed on the way out however this ends, so the next watcher is not refused by a record of
  # one that has gone. Only OUR own record: a file another live watcher wrote must survive us.
  trap 'if [ "$(head -1 "$SYNC_WATCH_PID_FILE" 2>/dev/null || true)" = "$$" ]; then rm -f "$SYNC_WATCH_PID_FILE"; fi' EXIT
  local paths=() d
  for d in "${MIRROR_DIRS[@]}" skills; do [ -d "$CLAUDE_HOME/$d" ] && paths+=("$CLAUDE_HOME/$d"); done
  [ -f "$CLAUDE_HOME/settings.json" ] && paths+=("$CLAUDE_HOME/settings.json")
  for f in $(top_files_in "$CLAUDE_HOME"); do [ -f "$CLAUDE_HOME/$f" ] && paths+=("$CLAUDE_HOME/$f"); done
  echo "Watching ${#paths[@]} path(s) for changes (fswatch)…"
  # -o coalesces a burst into one event; `$(...)` runs do_send in its own
  # subshell so a conflict's or scan_secrets' die() can't kill the watch loop.
  # A failure already triggers die()'s own desktop notification, but that is
  # transient and easy to miss (e.g. overnight) -- also write a timestamped
  # line to this command's own output, which the launchd plist already sends
  # to ~/.claude-sync.log, so a silently-broken sync leaves a durable trail
  # instead of just a notification nobody saw.
  local again
  # Started at the clock, so the first sweep happens one interval in rather than on the first edit
  # of the day: a daemon restarted often would otherwise sweep on every restart.
  "$fs" -o -l "${SYNC_WATCH_LATENCY:-2}" "${paths[@]}" | while IFS= read -r _; do
    again=1
    while [ "$again" -eq 1 ]; do
      again=0
      # `if var=$(cmd)` (not a bare assignment) is the one form `set -e` does not
      # abort on when cmd fails -- a bare `out="$(do_send)"; rc=$?` would exit
      # the whole watch loop on failure before the check below ever ran.
      if out="$( watch_tick 2>&1 )"; then
        rc=0
      else
        rc=$?
      fi
      # EVERY outcome, not only the failures (claude-config#196). The log's job is to answer "is
      # this thing working", and a file that only ever holds failures cannot: silence in it means
      # both "sending normally" and "stopped sending weeks ago".
      if [ "$rc" -ne 0 ]; then
        echo "$(date '+%Y-%m-%d %H:%M:%S') claude-sync watch: sync FAILED (exit $rc): ${out:-<no output>}"
      else
        case "$out" in
          *"SEND-OUTCOME sent"*)    echo "$(date '+%Y-%m-%d %H:%M:%S') claude-sync watch: sent" ;;
          *"SEND-OUTCOME nothing"*) echo "$(date '+%Y-%m-%d %H:%M:%S') claude-sync watch: nothing to send" ;;
          *"SEND-OUTCOME behind"*)  echo "$(date '+%Y-%m-%d %H:%M:%S') claude-sync watch: skipped, this Mac is behind the shared repo" ;;
          *"SEND-OUTCOME held"*)    echo "$(date '+%Y-%m-%d %H:%M:%S') claude-sync watch: skipped, a hold is in force" ;;
          # The four CI gate outcomes, each said separately (claude-config#221). Folded into one
          # line they would read as one condition, and they need different remedies: pending
          # resolves itself, red needs a fix on the other Mac, cancelled needs another push, and
          # unreadable is about gh on THIS Mac (L11).
          *"SEND-OUTCOME ci-pending"*)    echo "$(date '+%Y-%m-%d %H:%M:%S') claude-sync watch: not applied yet, the shared repo's head is still being tested" ;;
          *"SEND-OUTCOME ci-red"*)        echo "$(date '+%Y-%m-%d %H:%M:%S') claude-sync watch: NOT applied, the shared repo's head failed its tests" ;;
          *"SEND-OUTCOME ci-cancelled"*)  echo "$(date '+%Y-%m-%d %H:%M:%S') claude-sync watch: NOT applied, the tests for the shared repo's head were cancelled, so no verdict is coming" ;;
          *"SEND-OUTCOME ci-none"*)       echo "$(date '+%Y-%m-%d %H:%M:%S') claude-sync watch: applied a commit that has no test run at all, and is old enough that none is coming" ;;
          # BEFORE the plain ci-unreadable arm, and that ordering is load-bearing: `ci-unreadable`
          # is a prefix of `ci-unreadable-expired`, so a substring pattern for the short one also
          # matches the long one, and the case that APPLIED config would be logged as the case that
          # refused it (claude-config#327).
          *"SEND-OUTCOME ci-unreadable-expired"*) echo "$(date '+%Y-%m-%d %H:%M:%S') claude-sync watch: applied WITHOUT a CI verdict, because none could be read for long enough that none is coming" ;;
          *"SEND-OUTCOME ci-unreadable"*) echo "$(date '+%Y-%m-%d %H:%M:%S') claude-sync watch: NOT applied, could not read whether the shared repo's head passed its tests" ;;
          # A send that exited 0 and said nothing about what it did. Recorded as unknown rather
          # than as success: that is the state this whole line exists to stop being invisible
          # (L98), and it is what a version too old to print the marker looks like.
          *) echo "$(date '+%Y-%m-%d %H:%M:%S') claude-sync watch: finished, but said nothing about what it did: ${out:-<no output>}" ;;
        esac
      fi
      # Scratch used to be reclaimed HERE, by the watcher, on a clock this loop held in memory
      # (claude-config#251). It never fired: the clock was set to "now" when the loop started, and
      # the daemon is restarted every time claude-sync changes, so a twenty four hour timer that
      # restarts more often than daily never reached its own deadline (claude-config#314, L169,
      # L175). The cadence is a stamp on disk now, and every mutating run reads it, including this
      # loop's own send, which takes the lock and so passes through the trap that runs the sweep.
      # Nothing is needed here.
      # #262: everything that arrived while that send was running becomes ONE more send, not one
      # send each. A send takes seconds and can take minutes, so a burst of saves used to produce
      # a commit per event: six on 2026-09-02, of which CI cancelled five.
      #
      # The drained events are NOT simply discarded. A drain that ends the round would lose the
      # last edit, which is a worse defect than the one this fixes (L368), so anything seen here
      # sends the loop round once more and that send carries all of them.
      while IFS= read -r -t "${SYNC_WATCH_DRAIN:-1}" _; do again=1; done
    done
  done
}

# What one turn of the watch loop DOES. Named so the loop's shape (how many times it acts on a
# burst) can be measured without a real send behind it, the same way SYNC_FSWATCH stands in for
# fswatch. SYNC_IN_WATCH is what tells do_send this is the automatic send rather than a person
# asking for one, which is the only send a hold stops.
watch_tick(){
  if [ -n "${SYNC_WATCH_SEND:-}" ]; then
    bash -c "$SYNC_WATCH_SEND"
    return $?
  fi
  SYNC_IN_WATCH=1 with_lock do_send
}

# THE LAUNCH AGENTS THIS SCRIPT WOULD WRITE, defined once (claude-config#328).
#
# They are written by install-autosync and by nothing else, so a change to what they should be
# applies only where somebody re-runs that command. Nothing detected a Mac still running the
# previous definition: #323 shortened the catch up timer from weekly to daily on 2026-09-07 and it
# took effect on one Mac, with the other needing a manual step nothing would have reported if it
# were skipped. The agents are what make syncing automatic at all, so a Mac quietly on an old
# definition is the drift this tool exists to prevent, and it is invisible from the other side.
#
# One definition, read by the installer that WRITES them and by the check that asks whether what is
# installed still matches. Two copies would drift and the check would then be about a definition
# nobody installs (L41, L70).
agent_labels(){ printf '%s\n' com.claudesync.timer com.claudesync.watch; }
agent_arg(){
  case "$1" in
    *.timer) printf 'sync' ;;
    *.watch) printf 'watch' ;;
  esac
}
agent_extra(){
  case "$1" in
    *.timer) printf '  <key>StartInterval</key><integer>%s</integer>' "${SYNC_INTERVAL:-86400}" ;;
    *.watch) printf '  <key>KeepAlive</key><true/>\n  <key>RunAtLoad</key><true/>' ;;
  esac
}

# The plist text itself, so the check can ask for it without writing anything. An inspection that
# wrote a file would be the defect in L206.
plist_text(){ # label  arg  extra-keys-xml
  local self; self="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/claude-sync"
  local jobpath="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
  cat <<PL
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$1</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>$self</string><string>$2</string></array>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>$jobpath</string></dict>
$3
  <key>StandardOutPath</key><string>$HOME/.claude-sync.log</string>
  <key>StandardErrorPath</key><string>$HOME/.claude-sync.log</string>
</dict></plist>
PL
}

writeplist(){ # label  arg  extra-keys-xml
  local agentdir="${SYNC_LAUNCHAGENTS:-$HOME/Library/LaunchAgents}"
  local plist="$agentdir/$1.plist"
  mkdir -p "$agentdir"
  plist_text "$1" "$2" "$3" > "$plist"
  if [ "${SYNC_NO_LAUNCHCTL:-0}" != "1" ]; then
    launchctl unload "$plist" 2>/dev/null || true
    launchctl load "$plist"
  fi
}

# Which INSTALLED agents no longer match what this script would write. Only ones that exist: an
# agent that was never installed is a different fact and report_automatic_jobs already makes it,
# and reporting it here as well would say one thing twice in different words (L118).
agents_out_of_date(){   # prints the labels that differ, one per line
  local agentdir="${SYNC_LAUNCHAGENTS:-$HOME/Library/LaunchAgents}" label plist want have
  while IFS= read -r label; do
    [ -n "$label" ] || continue
    plist="$agentdir/$label.plist"
    [ -f "$plist" ] || continue
    want="$(plist_text "$label" "$(agent_arg "$label")" "$(agent_extra "$label")" 2>/dev/null)"
    have="$(cat "$plist" 2>/dev/null)"
    [ "$want" = "$have" ] || printf '%s\n' "$label"
  done <<AGENT_LABELS
$(agent_labels)
AGENT_LABELS
}

# The one sentence this Mac publishes about its agents, so the OTHER Mac can report it. Three
# states, because "none installed" and "installed but out of date" need different actions and one
# word covering both would hide whichever it did not name (L11).
agents_state(){
  local agentdir="${SYNC_LAUNCHAGENTS:-$HOME/Library/LaunchAgents}" stale any=0 label
  while IFS= read -r label; do
    [ -n "$label" ] || continue
    [ -f "$agentdir/$label.plist" ] && any=1
  done <<AGENT_LABELS
$(agent_labels)
AGENT_LABELS
  [ "$any" = 1 ] || { printf 'none'; return 0; }
  stale="$(agents_out_of_date | tr '\n' ' ' | sed 's/ $//')"
  if [ -n "$stale" ]; then printf 'stale %s' "$stale"; else printf 'ok'; fi
}

# ---------- install-autosync: receive-timer + (if available) fswatch watcher ----------
# --- the claudesync shell alias -------------------------------------------
# The /sync-config skill lives under skills/, so it reaches every Mac on the next
# push. This alias does NOT: it lives in ~/.zshrc, which is deliberately outside the
# sync. So the shortcut had to be added by hand on each Mac while the skill arrived by
# itself. Installing it alongside the launch agents makes the whole setup travel
# together. SYNC_ZSHRC redirects the target so the tests can never touch a real one.
ensure_zsh_alias(){
  local rc="${SYNC_ZSHRC:-$HOME/.zshrc}"
  # SYNC_SELF_DIR lets a test pin the repo location without moving the script.
  local selfdir="${SYNC_SELF_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}"
  local self="$selfdir/claude-sync"
  local comment="# claude-config-sync: pull shared ~/.claude config onto this Mac"
  local want="alias claudesync='$self pull'"

  # No need to create the file first: the append below creates it when absent, and
  # the grep above tolerates a missing file. A separate touch was dead code that no
  # test could tell apart.

  # `|| true`: with `set -e` and `pipefail`, a grep that simply finds nothing would
  # abort the whole install silently, which is exactly what it did the first time.
  local existing
  existing="$(grep -n '^[[:space:]]*alias[[:space:]]\+claudesync=' "$rc" 2>/dev/null | awk 'NR <= 1' || true)"

  if [ -n "$existing" ]; then
    # `~/x` and `$HOME/x` are the same path, and the alias on this Mac was added by
    # hand with a tilde. Comparing the raw strings would call that a conflict and send
    # the user to fix something that is already correct.
    # Compare the COMMAND, not the raw line: quoting style and a tilde are noise.
    local found_cmd="${existing#*=}"        # everything after the first '='
    found_cmd="${found_cmd//\'/}"           # drop single quotes
    found_cmd="${found_cmd//\"/}"           # and double quotes
    found_cmd="${found_cmd//\~\//$HOME/}"   # a leading ~ is the home directory
    if [ "$found_cmd" = "$self pull" ]; then
      echo "Shell alias already installed: claudesync"
    else
      # Someone's own alias. Repointing a command they typed themselves, silently, is
      # worse than telling them it differs and letting them decide.
      echo "Left your existing claudesync alias alone: it already exists in $rc and points somewhere else."
      echo "  yours:  ${existing#*:}"
      echo "  ours:   $want"
      echo "  Change it by hand if you want the shared one."
    fi
    return 0
  fi

  # A newline first, so this never lands glued onto a line with no trailing newline.
  printf '\n%s\n%s\n' "$comment" "$want" >> "$rc"
  echo "Installed shell alias: claudesync (run it in a new terminal, or: source $rc)"
}

do_install_autosync(){
  local agentdir="${SYNC_LAUNCHAGENTS:-$HOME/Library/LaunchAgents}"
  # DAILY, not weekly (claude-config#323). This timer is the backstop for a Mac whose watcher is
  # not sending: since #323 a send that finds itself behind reconciles on the spot, so the timer no
  # longer has to be the only way out, but it is still the only thing that runs when the watcher is
  # dead or the reconcile keeps being refused. A weekly catch up cannot bound a problem that
  # appears daily (L51), and it cost 46 hours of silent drift on 2026-09-07. It takes effect on the
  # next `claude-sync install-autosync`, since that is what writes the launch agent.
  local interval="${SYNC_INTERVAL:-86400}"   # default daily
  local legacy lp
  # retire superseded agents (old monthly pull, old WatchPaths auto)
  for legacy in com.claudesync.pull com.claudesync.auto; do
    lp="$agentdir/$legacy.plist"
    [ -f "$lp" ] || continue
    [ "${SYNC_NO_LAUNCHCTL:-0}" != "1" ] && { launchctl unload "$lp" 2>/dev/null || true; }
    rm -f "$lp"
  done
  # receive-timer: two-way sync on a schedule (catches the other Mac's changes when idle).
  # The keys come from agent_extra, which is also what the out of date check compares against, so
  # the installer and the check cannot disagree about what current means (claude-config#328).
  writeplist com.claudesync.timer "$(agent_arg com.claudesync.timer)" "$(agent_extra com.claudesync.timer)"
  echo "Installed receive-timer: two-way sync every $(duration_in_words "$interval")."
  # change-watcher: instant push on any edit, however deep (needs fswatch)
  if command -v "${SYNC_FSWATCH:-fswatch}" >/dev/null 2>&1; then
    writeplist com.claudesync.watch "$(agent_arg com.claudesync.watch)" "$(printf '%b' "$(agent_extra com.claudesync.watch)")"
    echo "Installed change-watcher (fswatch): pushes instantly on any edit."
  else
    rm -f "$agentdir/com.claudesync.watch.plist"
    echo "fswatch not found — instant push disabled. For instant sync: brew install fswatch, then re-run: claude-sync install-autosync"
  fi
  ensure_zsh_alias
  echo "Log: $HOME/.claude-sync.log   (change interval: SYNC_INTERVAL=<seconds> claude-sync install-autosync)"
}

cmd="${1:-help}"
case "$cmd" in
  push) with_lock do_push ;;
  # No report step here. Every command that RECEIVES config hands its closing line to
  # report_when_lock_released, and with_lock prints it after releasing the lock, so `sync`, `send`'s
  # fall-through reconcile and the `apply-only` resume point all get the same verification as `pull`
  # without a call site being able to forget one (claude-config#184).
  pull) with_lock do_pull ;;
  sync) with_lock do_sync ;;
  send) with_lock do_send ;;
  # NOT locked as a whole: watch is a long-lived loop that would then hold the lock for
  # the entire life of the daemon. It takes the lock per event instead, around its send.
  watch) do_watch ;;
  # Neither takes the sync lock: they write one small marker outside every clone and touch nothing
  # a mutating run touches, and a hold that had to queue behind the very send it exists to hold off
  # would be useless exactly when it is reached for (#262).
  hold) do_hold "${2:-}" "${@:3}" ;;
  release) do_release ;;
  status) do_status ;;           # read-only, deliberately never blocked
  verify) do_verify ;;           # read-only too: it answers a question, it changes nothing
  # Not wrapped in with_lock: it touches only the tool's own scratch under the temp directory,
  # never the repo or the home, so it has nothing to serialize against.
  reap-scratch) do_reap_scratch ;;
  # Not locked: it removes copies beside the config that nothing else reads or writes, and the one
  # thing it must never do is queue behind a long send while somebody waits to reclaim disk.
  clean-backups) do_clean_backups ;;
  forget-mac) with_lock do_forget_mac "${2:-}" ;;   # mutating: it deletes a published ref
  # Locked, because register_this_clone appends from inside the lock and this rewrites that file.
  forget-clone) with_lock do_forget_clone "${2:-}" ;;
  apply-only) with_lock do_apply_only ;;   # internal: resume point after a self-update
  install-schedule) do_install_schedule ;;
  install-autosync) do_install_autosync ;;
  # Read-only about the config: it runs the checks and records what they said, nothing else.
  recheck) do_recheck ;;
  next-lesson) lesson_band_locked; next_lesson_number "$CLAUDE_HOME" "$LESSON_BAND" ;;
  repo-slug) repo_slug || { echo "claude-sync: origin is not a GitHub remote, so there is no owner and name to derive." >&2; exit 1; } ;;
  cite-scan) do_cite_scan "${2:-}" ;;   # read-only: which synced files cite a lesson number
  cite-pin) do_cite_pin ;;              # record what each cited lesson number names now
  cite-check) do_cite_check ;;          # read-only: has any cited number come to mean something else
  lesson) do_lesson "${2:-}" ;;         # read-only: one lesson in full, with its provenance
  check-skills) do_check_skills ;;      # read-only: is any skill provided by a plugin AND locally
  check-lessons)
    # Asked FIRST, because an entry nothing can read is also an entry the duplicate scan below
    # cannot count, so reporting sound numbering before this has been settled is reporting about a
    # file only partly read (claude-config#164).
    # BOTH faults are asked, and both are reported, never as an else-if: a file routinely commits
    # the two at once (an entry nobody can read is exactly the entry whose number gets claimed
    # twice), and dying at the first sends somebody back for a second run to discover the second.
    # The same rule check-home-paths follows for its three (claude-config#164, #108).
    badlessons="$(malformed_lesson_entries "$CLAUDE_HOME")"
    dups="$(duplicate_lesson_numbers "$CLAUDE_HOME")"
    lessonfaults=""
    if ! is_blank "$badlessons"; then
      lessonfaults="these lesson entries are not written as '- **Lnnn. ...', so nothing here can read them: not the index that loads into every session, not 'claude-sync lesson', not the duplicate check, and not the number minter. $(printf '%s' "$badlessons" | tr '\n' ';' | sed 's/;$//'). Rewrite each one to start with '- **L<number>. ' and it becomes visible to all four."
    fi
    if ! is_blank "$dups"; then
      lessonfaults="${lessonfaults:+$lessonfaults }duplicate lesson numbers: $(printf '%s' "$dups" | tr '\n' ';' | sed 's/;$//')"
    fi
    if ! is_blank "$lessonfaults"; then die "$lessonfaults"; fi
    lesson_band_locked
    echo "lesson numbering is sound (next free: $(next_lesson_number "$CLAUDE_HOME" "$LESSON_BAND"))"
    ;;
  # The usage block is DERIVED from where it ends rather than from a line number (claude-config#306).
  # It read '2,24p', and adding two commands to the list pushed the last two off the end of it, so
  # `help` silently stopped naming install-autosync and help itself. A fixed line count from an
  # anchor stops containing what it was written about the moment anything above it grows (L518).
  # The usage block ends at the first bare `#`, which is what separates it from the env notes.
  help|-h|--help) awk 'NR > 1 { if ($0 ~ /^# *Env overrides/) exit; buf[n++] = $0 }
                        END { while (n > 0 && buf[n-1] == "#") n--; for (i = 0; i < n; i++) print buf[i] }' \
                    "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' ;;
  *) die "unknown command '$cmd' (try: push, pull, sync, watch, hold, release, status, verify, recheck, reap-scratch, clean-backups, forget-mac, forget-clone, next-lesson, check-lessons, repo-slug, cite-scan, cite-pin, cite-check, check-skills, lesson, install-autosync, help)" ;;
esac
