{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "__CLAUDE_HOME__/hooks/rtk-rewrite.sh",
            "if": "Bash(git *)|Bash(npm *)|Bash(ls *)|Bash(cat *)|Bash(grep *)|Bash(find *)"
          },
          {
            "type": "command",
            "command": "__CLAUDE_HOME__/hooks/require-tests-before-push.sh",
            "timeout": 120,
            "statusMessage": "Checking pushed changes include tests"
          },
          {
            "type": "command",
            "command": "__CLAUDE_HOME__/hooks/check-style-guide.sh",
            "timeout": 30,
            "statusMessage": "Checking pushed changes for style-guide violations"
          },
          {
            "type": "command",
            "command": "__CLAUDE_HOME__/hooks/check-grep-quiet-invert.sh",
            "timeout": 30,
            "statusMessage": "Checking pushed changes for style-guide violations"
          },
          {
            "type": "command",
            "command": "__CLAUDE_HOME__/hooks/check-duplication.sh",
            "timeout": 60,
            "statusMessage": "Checking pushed changes for new duplicated code"
          },
          {
            "type": "command",
            "command": "__CLAUDE_HOME__/hooks/check-public-assets.sh",
            "timeout": 30,
            "statusMessage": "Checking pushed assets are referenced and images are within the size cap"
          },
          {
            "type": "command",
            "command": "__CLAUDE_HOME__/hooks/check-deferrals.sh",
            "timeout": 30,
            "statusMessage": "Checking pushed changes for a deferral with no issue number"
          },
          {
            "type": "command",
            "command": "__CLAUDE_HOME__/hooks/check-doc-issue-refs.sh",
            "timeout": 60,
            "statusMessage": "Checking the pushed docs' issue references against GitHub"
          },
          {
            "type": "command",
            "command": "__CLAUDE_HOME__/hooks/check-bundle-budget.sh",
            "timeout": 30,
            "statusMessage": "Weighing the client bundle against its recorded budget"
          },
          {
            "type": "command",
            "command": "__CLAUDE_HOME__/hooks/lessons-advisory.sh",
            "timeout": 30,
            "statusMessage": "Checking pushed changes against the recorded lessons"
          },
          {
            "type": "command",
            "command": "__CLAUDE_HOME__/hooks/check-closing-keyword.sh"
          },
          {
            "type": "command",
            "command": "__CLAUDE_HOME__/hooks/block-red-merge.sh",
            "if": "Bash(gh pr merge*)",
            "timeout": 30,
            "statusMessage": "Verifying the PR is green before merging"
          },
          {
            "type": "command",
            "command": "__CLAUDE_HOME__/hooks/require-changelog-tag.sh",
            "if": "Bash(gh pr merge*)",
            "timeout": 30,
            "statusMessage": "Checking the PR carries a changelog record"
          },
          {
            "type": "command",
            "command": "__CLAUDE_HOME__/hooks/require-issue-fields.sh",
            "timeout": 15,
            "statusMessage": "Checking the issue has a milestone, priority and category"
          },
          {
            "type": "command",
            "command": "__CLAUDE_HOME__/hooks/linux-sections-before-push.sh",
            "timeout": 300,
            "statusMessage": "Running the changed test sections on Linux"
          },
          {
            "type": "command",
            "command": "__CLAUDE_HOME__/hooks/scanners-before-push.sh",
            "timeout": 180,
            "statusMessage": "Running the scanners that read the whole repository"
          },
          {
            "type": "command",
            "command": "__CLAUDE_HOME__/hooks/payload-write-gate.sh"
          },
          {
            "type": "command",
            "command": "__CLAUDE_HOME__/hooks/check-add-scope.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "__CLAUDE_HOME__/hooks/payload-write-gate.sh"
          }
        ]
      },
      {
        "matcher": "mcp__playwright__.*|mcp__plugin_playwright_playwright__.*",
        "hooks": [
          {
            "type": "command",
            "command": "__CLAUDE_HOME__/hooks/playwright-subagent-gate.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "__CLAUDE_HOME__/hooks/durable-lesson-check.sh",
            "timeout": 10,
            "statusMessage": "Checking a just-filed issue for a durable lesson"
          },
          {
            "type": "command",
            "command": "__CLAUDE_HOME__/hooks/pr-merge-quiz.sh",
            "timeout": 15,
            "statusMessage": "Checking for a merged PR to quiz on"
          },
          {
            "type": "command",
            "command": "__CLAUDE_HOME__/hooks/ai-review-on-push.sh",
            "timeout": 15,
            "statusMessage": "Starting the advisory review of the pushed diff"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "__CLAUDE_HOME__/hooks/lesson-entry-check.sh"
          },
          {
            "type": "command",
            "command": "__CLAUDE_HOME__/hooks/deferral-edit-check.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "terminal-notifier -title 'Claude Code' -message \"What's next?\""
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "terminal-notifier -title 'Claude Code' -message 'Permission needed' -sound Glass"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 __CLAUDE_HOME__/hooks/no-ai-tells-detect.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "__CLAUDE_HOME__/hooks/session-namer.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "__CLAUDE_HOME__/hooks/tdd-nudge.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "__CLAUDE_HOME__/hooks/feature-discovery-nudge.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "__CLAUDE_HOME__/hooks/rule-files-changed.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "__CLAUDE_HOME__/hooks/project-list-nudge.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "__CLAUDE_HOME__/hooks/payload-revert-warning.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "__CLAUDE_HOME__/hooks/free-space-nudge.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "__CLAUDE_HOME__/hooks/sync-stuck-notice.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "__CLAUDE_HOME__/hooks/suite-pile-notice.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "__CLAUDE_HOME__/hooks/stale-worktree-nudge.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "__CLAUDE_HOME__/hooks/ai-review-nudge.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "__CLAUDE_HOME__/hooks/post-compact.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Blow.aiff"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "__CLAUDE_HOME__/hooks/feature-issue-review.sh",
            "timeout": 15,
            "statusMessage": "Reviewing session for issue-worthy ideas"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "__CLAUDE_HOME__/hooks/session-reflection.sh",
            "timeout": 15,
            "statusMessage": "Reflecting on uncertainties"
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__CLAUDE_HOME__/hooks/teammate-challenge-gate.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__CLAUDE_HOME__/hooks/subagent-issue-harvest.sh",
            "timeout": 180,
            "async": true
          }
        ]
      }
    ]
  }
}
